// Globaler Positionsverlauf (unabhängig von offenen Fahrten), gefüllt in onPos
const vehTrail = [];
function vehTrailPush(pos, ts) {
  const last = vehTrail[vehTrail.length - 1];
  if (last && ts - last.ts < 10000 && dist(last, pos) < 8) return;
  vehTrail.push({ lat: pos.lat, lon: pos.lon, ts });
  const cut = ts - 12 * 60 * 1000;
  while (vehTrail.length && (vehTrail[0].ts < cut || vehTrail.length > 90)) vehTrail.shift();
}

function vehHhmmMin(s) {
