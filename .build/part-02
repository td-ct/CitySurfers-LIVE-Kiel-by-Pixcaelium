// Assembliert den Gesamt-Zustand: cfg = { stamp, ver, appVer, gps,
// problem, addr, addrQ, pos, addrSug, stopS, stopQ, stopSug,
// rtabIdx, stabIdx, mtabIdx, addrFav, stopFav }.
function supportStateText(cfg) {
  let h = "CitySurfers-Zustand vom " + cfg.stamp + "\n" +
    "Service-Version: " + (cfg.ver || "?") +
    (cfg.appVer ? " · " + cfg.appVer : "") +
    (cfg.gps ? " · GPS " + cfg.gps : "");
  if (cfg.problem) h += "\n\n== Problembeschreibung ==\n" + cfg.problem;
  if (cfg.addr)
    h += "\n\n== Adresssuche ==\n" +
      "  Suchtext: " + (cfg.addrQ ? "„" + cfg.addrQ + "“" : "(leer)") + "\n" +
      "  Aktive Startadresse: " + (cfg.pos && cfg.pos.label ?
        "„" + cfg.pos.label + "“" + (cfg.pos.lat != null && cfg.pos.lon != null ?
          " (" + cfg.pos.lat + ", " + cfg.pos.lon + ")" : "") : "keine (GPS)") +
      (cfg.addrSug ? "\n  Offene Vorschläge: " + cfg.addrSug : "");
  if (cfg.stopS)
    h += "\n\n== Stationssuche ==\n" +
      "  Suchtext: " + (cfg.stopQ ? "„" + cfg.stopQ + "“" : "(leer)") +
      (cfg.stopSug ? "\n  Offene Vorschläge: " + cfg.stopSug : "");
  if (cfg.rtabIdx && cfg.rtabIdx.length) {
    h += "\n\n== Route-Reiter ==";
    cfg.rtabIdx.forEach(i => { h += "\n" + supportRouteTabText(i); });
  }
  if (cfg.stabIdx && cfg.stabIdx.length) {
    h += "\n\n== Stations-Reiter ==";
    cfg.stabIdx.forEach(i => { h += "\n" + supportStopTabText(i); });
  }
  if (cfg.mtabIdx && cfg.mtabIdx.length) {   // v1.4.15: MM-Reiter wie die anderen Reiter-Arten
    h += "\n\n== MM-Reiter (Micromobility) ==";
    cfg.mtabIdx.forEach(i => { h += "\n" + supportMMTabText(i); });
  }
  if (cfg.addrFav) h += "\n\n== " + supportAddrFavText();
  if (cfg.stopFav) h += "\n\n== " + supportStopFavText();
  return h;
}
