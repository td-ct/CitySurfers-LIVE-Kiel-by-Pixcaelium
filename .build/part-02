const ROUTE_CONS_GOAL = 10;   // so viele Verbindungen sammelt die Suche an (NAH.SH liefert max. 6 pro Anfrage)
const ROUTE_DIV_STARTS = 3;   // v1.6.18: so viele VERSCHIEDENE erste Fahrten (Einstiege) zeigt eine gute Suche mindestens
