// ---------- Entfernung & Fußweg-Routing ----------
const walkCache = JSON.parse(localStorage.getItem("kvg-walk2") || "{}"); // sn -> {m,lat,lon,ts}
function dist(pos, stop) {
  const R = 6371000, rad = Math.PI / 180;
  const dLat = (stop.lat - pos.lat) * rad, dLon = (stop.lon - pos.lon) * rad;
  const a = Math.sin(dLat / 2) ** 2 +
    Math.cos(pos.lat * rad) * Math.cos(stop.lat * rad) * Math.sin(dLon / 2) ** 2;
  return 2 * R * Math.asin(Math.sqrt(a));
}
function formatDist(m) {
  return m < 1000 ? Math.round(m) + " m" : (m / 1000).toFixed(1).replace(".", ",") + " km";
}
function saveWalkCache() {
  try { localStorage.setItem("kvg-walk2", JSON.stringify(walkCache)); } catch (e) {}
}
async function walkMeters(stop) {
  const pos = walkOrigin(stop.shortName);   // eigene Position des Reiters vorrangig
  if (!pos) return null;
  const c = walkCache[stop.shortName];
  // echte Wegdaten: 24 h gültig; Schätzung (~, Luftlinie × 1,3): nur 10 min, dann Router neu versuchen
  if (c && Math.abs(c.lat - pos.lat) < 0.0002 && Math.abs(c.lon - pos.lon) < 0.0002 &&
      Date.now() - c.ts < (c.est ? 6e5 : 864e5)) {
    return c.m;
  }
  const air = dist(pos, stop);
  try {
    const url = FOOT_ROUTER + "/" + pos.lon + "," + pos.lat + ";" + stop.lon + "," + stop.lat + "?overview=false";
    const res = await apiFetch("osrm", url);
    if (res.ok) {
      const data = await res.json();
      if (data.routes && data.routes[0]) {
        walkCache[stop.shortName] = { m: data.routes[0].distance, est: false, lat: pos.lat, lon: pos.lon, ts: Date.now() };
        saveWalkCache();
        return data.routes[0].distance;
      }
    }
  } catch (e) {}
  const est = air * 1.3; // Schätzung (Router nicht erreichbar): Luftlinie × 1,3
  walkCache[stop.shortName] = { m: est, est: true, lat: pos.lat, lon: pos.lon, ts: Date.now() };
  saveWalkCache();
  return est;
}
function isEst(sn) {
  const c = walkCache[sn];
  return !!(c && c.est);
}

