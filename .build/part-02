    if (currentTrip && currentTrip.tripId === tid) openAlarmDialog(tid);
    else {
      setLocNote("Fahrtverlauf wird geladen, Wecker-Dialog öffnet danach …");
      selectTrip(currentBus.sn, tid).then(() => {
        if (currentTrip && currentTrip.tripId === tid) openAlarmDialog(tid);
        else setLocNote("Fahrtverlauf gerade nicht verfügbar – Wecker-Dialog nicht geöffnet.");
      });
    }
    return;
  }
  const so = e.target.closest("[data-stopopen]");
  if (so) { openTab(so.dataset.stopopen); return; }   // Stationsname -> neuer Reiter
  const srq = e.target.closest("[data-stoprt]");
  if (srq) { rtStopOpenTap(srq.dataset.stoprt, srq.dataset.stoplat, srq.dataset.stoplon); return; }   // v1.6.23: Fern-Station zuzuordnen
  const al = e.target.closest("[data-alarmtrip]");
  if (al) {
    openAlarmDialog(al.dataset.alarmtrip);   // Glocke im Fahrtverlauf: Dialog mit Stationsauswahl
    return;
  }
  const tbk = e.target.closest(".thead [data-rtbike]");
  if (tbk && currentTrip) {
    // 🚲? im Fahrtverlauf-Kopf: dieselbe Stations-Undo-Logik wie beim Wecker –
    // tstops vs. Haltestellen-/DB-Koordinaten, nur verortbare Halte landen im Dialog
    const tsts = (currentTrip.stops || []).map(x => {
      const st = stops.find(s2 => s2.shortName === x.shortName) || dbStopOf(x.shortName);
      return st ? { name: st.name, lat: st.lat, lon: st.lon,
        time: (x.actualTime || x.time || x.plannedTime || "") || null } : null;
    }).filter(Boolean);
    if (!tsts.length) { setLocNote("Fahrtverlauf ohne verortbare Haltestellen – erst laden, dann 🚲? nutzen."); return; }
    const p = livePos();
    let best = null;
    for (const s of tsts) {
      const dm = dist(p, s);
      if (!best || dm < best.dm) best = { s: s, dm: dm };
    }
    if (!best) best = { s: tsts[0], dm: 0 };
    openBikeDlg("h", { anchor: null, ents: tsts, dest: null,
      title: "🚲? Micromobility Routing: Umstieg aufs Leihfahrrad (Linie " + (currentTrip.route || "?") + " → " + (currentTrip.direction || "") + ")" });
    return;
  }
  const tripref = e.target.closest("[data-tripref]");
  if (tripref) {
    if (refetchGateOk("triprt:" + tripref.dataset.tripref)) selectTrip(currentBus.sn, tripref.dataset.tripref, true);
    else setLocNote("↻ zuletzt vor wenigen Sekunden gedrückt – frühestens in 5 Sekunden wieder.");
    return;
  }
  const tripexp = e.target.closest("[data-tripexp]");
  if (tripexp && currentTrip) {
    currentTrip.expand = !currentTrip.expand;   // ganzer Lauf <-> ab Einstiegshaltestelle
    if (currentTrip.expand) kvgFillPlanned();   // ganze Strecke: geplante Abfahrten überall eintragen
    renderBusPanel();
    return;
  }
  const ref = e.target.closest("[data-ref]");
  if (ref) {
    if (refetchGateOk("ref:" + ref.dataset.ref)) refetchStop(ref.dataset.ref, true);
    else setLocNote("↻ zuletzt vor wenigen Sekunden gedrückt – frühestens in 5 Sekunden wieder.");
  }
});

