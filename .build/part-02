// (Menü "Zustand importieren") oder auf einer anderen Installation importiert.
const STATE_KEYS = ["kvg-favs", "kvg-addrfavs", "kvg-addr", "kvg-pos", "kvg-font", "kvg-alarmcfg", "kvg-view", "kvg-fhstop", "kvg-sortgps", "kvg-alarms", "kvg-alarms-off", "kvg-vehcfg"];
// Offene Reiter in kvg-view sichern: Stationen (Kette Haltestelle -> Buslinie
// -> Fahrtverlauf, plus eigener Reiter-Name und UID für die Reihenfolge),
// alle parallelen Route-Reiter (Name, Start/Ziel, Zeit) und seit v1.5.6 auch
// die MM-Reiter (Micromobility) samt ihren uebernommenen Routen. saveView
// läuft bei jeder Reiter-Änderung (renderTabs), die Reiter erscheinen nach
// Neustart oder Import wieder.
function saveView() {
  try {
    saveActiveTab();   // sichert auch den aktiven Route-Reiter in sein Objekt
    const payload = {   // v1.6.23: erst Objekt bauen, dann speichern (Quota-Fallback unten)
      tabs: tabs.map(t => {
        const trips = (t.trips || []).map(b =>
          ({ sn: b.sn, tripId: b.tripId, tripOpen: !!b.tripOpen }));
        const ab = (t.trips || [])[t.activeTrip];
        return { sn: t.sn, name: t.name || "", uid: t.uid || "",
          bus: ab ? { sn: ab.sn, tripId: ab.tripId, tripOpen: !!ab.tripOpen } : null,
          trips: trips,
          remote: (t.remote ? { shortName: t.remote.shortName, name: t.remote.name,
            lat: t.remote.lat, lon: t.remote.lon, lid: t.remote.lid || "",
            extId: t.remote.extId || "", svc: t.remote.svc || "nahsh",
            rId: t.remote.rId || null } : null) };   // v1.5.0: Fern-Stationen überdauern Neustart/Import
      }),
      // v1.6.23 (Timo): Route-Reiter ueberleben den Neustart MIT ihrem Inhalt -
      // Trefferliste, gewaehlte Verbindung (Signatur + Verlaufszustand), Fehler.
      rtabs: routeTabs.map(rt => ({ name: rt.name || "", uid: rt.uid || "", sel: rt.sel,
        sub: (rt.sub == null ? -1 : rt.sub), searched: !!rt.searched, err: rt.err || null,
        cons: rt.cons || [],
        chosen: (rt.chosen || []).map(ch => ({
          sig: (ch && ch.sig) || "",
          secOpen: (ch && Array.isArray(ch.secOpen)) ? ch.secOpen : [] })) })),
      slim: 0,
      mmtabs: mmTabs.map(mt => ({ uid: mt.uid || "", stId: (mt.stId == null ? null : mt.stId),   // v1.5.6: MM-Reiter samt Routen
        name: mt.name || "", routes: (mt.routes || []).filter(mm => mm && typeof mm === "object"),
        active: (mt.active == null ? -1 : mt.active), more: (mt.more || {}) })),
      mmactive: mmActiveTab, mmactiveOn: mmTabActive ? 1 : 0,
      ractive: routeActiveTab, ractiveOn: routeTabActive ? 1 : 0,
      ord: barOrd,
      active: Math.max(0, activeTab) };
    try {
      localStorage.setItem("kvg-view", JSON.stringify(payload));
    } catch (q) {   // Quota: Route-Reiter ohne Ergebnis-Inhalt (Start/Ziel steht trotzdem wieder da)
      payload.rtabs = payload.rtabs.map(rt => ({ name: rt.name, uid: rt.uid, sel: rt.sel }));
      payload.slim = 1;
      try { localStorage.setItem("kvg-view", JSON.stringify(payload)); } catch (q2) {}
    }
  } catch (e) {}
}
function kvgExportState() {
  saveView();   // kvg-view (offene Reiter, Reihenfolge, Route-Reiter) frisch in den Export
  const o = {};
  for (const k of STATE_KEYS) {
    const v = localStorage.getItem(k);
    if (v != null) o[k] = v;
  }
  return btoa(unescape(encodeURIComponent(JSON.stringify(o))));
}
// Von der Android-App aufgerufen: Sprung aus einer Wecker-Benachrichtigung
// direkt in den Reiter des Weckers (aus MainActivity, Intent-Extra "tab").
// v1.6.23 (Timo): Reiter-Inhalt soll das Beenden der App ueberleben - deshalb
// wird der Zustand auch beim Verstecken der Seite und beim pagehide gesichert
// (Android killt den Prozess oft ohne weiteren JS-Tick mehr).
window.addEventListener("pagehide", () => { try { saveActiveTab(); saveView(); } catch (e) {} });
document.addEventListener("visibilitychange", () => {
  if (document.visibilityState === "hidden") { try { saveActiveTab(); saveView(); } catch (e) {} }
});
window.kvgGotoTab = function (sn) {
  try {
    if (!sn) return "err";
    const i = tabs.findIndex(t => t.sn === sn);
    if (i >= 0) { activateTab(i, false); alarmList.hidden = true; return "ok"; }
    return "nofound";
  } catch (e) { return "err"; }
};

window.kvgImportState = function (code) {
  try {
    const o = JSON.parse(decodeURIComponent(escape(atob(String(code).trim()))));
    let n = 0;
    for (const k of STATE_KEYS) if (k in o) { try { localStorage.setItem(k, o[k]); } catch (e) {} n++; }
    if (!n) throw new Error("leer");
    setLocNote("Zustand übernommen (" + n + " Einträge) – lade neu …");
    setTimeout(() => location.reload(), RELOAD_DELAY_MS);
    return "ok";
  } catch (e) {
    setLocNote("Zustand-Code ungültig.");
    return "err";
  }
};
// ⇅ Export/Import als aufklappbare Fuß-Sektion (unter „Über diese App“): beim
// Öffnen wird der Export-Code frisch erzeugt; Kopieren/Übernehmen laufen direkt
// in der Sektion – kein eigener Dialog/Overlay mehr, der Zustands-Knopf im
// Kopf entfällt.
(function initStateSec() {
  const sec = document.getElementById("stateSec");
  if (!sec) return;
  sec.addEventListener("toggle", () => {
    if (sec.open) {
      const ta = document.getElementById("stateExp");
      if (ta) ta.value = kvgExportState();
    }
  });
  document.getElementById("stateCopy").addEventListener("click", () => {
    const ta = document.getElementById("stateExp");
    try {
      if (ta && ta.select) ta.select();
      if (document.execCommand) document.execCommand("copy");
      setLocNote("Zustands-Code kopiert.");
    } catch (err) { setLocNote("Code markiert – bitte selbst kopieren."); }
  });
  document.getElementById("stateGo").addEventListener("click", () => {
    const ta = document.getElementById("stateImp");
    if (ta && ta.value) kvgImportState(ta.value);
  });
})();

// ---------- 🐞 Support / Bugreport: Zustand als Text in einer E-Mail ----------
// Der Support-Knopf im Fuß (zwischen „⇅ Export/Import“ und „Impressum“) öffnet
// einen Bestätigungs-Dialog: Problembeschreibung eintragen, ausdrücklich
// bestätigen, dass App-Daten mitgesendet werden, und per Checkbox auswählen,
// welche Inhalte als Text in die E-Mail wandern (Suchfelder, offene Route-,
// Stations- und MM-Reiter samt Unter-Reitern mit Fahrplänen und Zeiten,
// Favoriten; je Reiter-Art sind alle gerade offenen Reiter vorausgewählt). Die E-Mail selbst geht
// als mailto:-Link an das installierte E-Mail-Programm (support@pixcaelium.de,
// Betreff „Bugreport CitySurfer v…“): Sie öffnet sich UNGESENDET – im
// E-Mail-Programm lässt sich vor dem Absenden noch jede Zeile ansehen,
// kürzen oder löschen.
function supportDelayTxt(d) {
  return d == null ? "" : " (" + (d > 0 ? "+" + d + "m" : d < 0 ? d + "m" : "0m") + ")";
}
// Abfahrtsliste einer Station als Klartext-Zeilen (früher, Live, geplant):
// dasselbe Sichtbarkeits-Fenster wie in der Anzeige (depWindow), nur flach.
function supportDepsText(v) {
  if (!v) return "";
  const w = depWindow(v, 0);
  const rows = [];
  const one = (d, ts, tag) => {
    if (d == null) return;
    rows.push("    " + followClock((ts || v.fetchTs || 0) + (d.actualRelativeTime || 0) * 1000) +
      "  Linie " + (d.line || "?") + " nach " + (d.direction || "?") +
      (tag ? "  [" + tag + "]" : ""));
  };
  (v.earlier || []).forEach(d => one(d, v.earlierTs, "früher geladen"));
  (v.deps || []).forEach(d => one(d, v.fetchTs,
    d.planned || d.status === "PLANNED" ? "geplant" : "Echtzeit"));
  w.plannedVisible.forEach(d => one(d, v.plannedTs, "geplant"));
  return rows.join("\n");
}
// Ein Route-Reiter als Text: Suche, Verbindungsvorschläge und die geöffneten
// Verbindungs-Unter-Reiter je Abschnitt inklusive aufgekauften Verläufen.
function supportRouteTabText(idx) {
  const rt = routeTabs[idx];
  if (!rt) return "";
  const sel = rt.sel || {};
  let h = "Route-Reiter " + (idx + 1) + ": „" + defTabName("r", rt) + "“" +
    (sel.time ? " · Suche ab " + sel.time.replace("T", " ") : "");
  const cons = rt.cons || [];
  h += "\n  Verbindungsvorschläge: " + (cons.length ? String(cons.length) :
    "keine (noch nicht gesucht oder nichts gefunden)");
  cons.forEach(c => {
    h += "\n    " + c.dep + "–" + c.arr + " (" + c.dur + " min, " + (c.chg || 0) + "× umsteigen)";
  });
  if (rt.err) h += "\n  Suchfehler: " + rt.err;
  const chosen = rt.chosen || [];
  h += "\n  Unter-Reiter (geöffnete Verbindungen): " + chosen.length;
  chosen.forEach((rc, i) => {
    const c = rc.con || {};
    h += "\n    [" + (i + 1) + "] " + c.dep + "–" + c.arr + " (" + c.dur + " min, " +
      (c.chg || 0) + "× umsteigen)";
    (c.secs || []).forEach((sec, si) => {
      if (sec.kind === "jny") {
        h += "\n      Linie " + (sec.line || "?") + " nach " + (sec.dir || "?") +
          ": ab " + (sec.from || "?") + " " + (sec.dep || "?") + supportDelayTxt(sec.depDelay) +
          " an " + (sec.to || "?") + " " + (sec.arr || "?") + supportDelayTxt(sec.arrDelay);
        if (rc.secOpen && rc.secOpen[si] && (sec.stops || []).length)
          h += "\n        Verlauf (Station gep./aktuell): " +
            sec.stops.map(st => st.name + " " + (st.dS || st.aS || "–") + "/" +
              (st.dR || st.aR || "–")).join("; ");
      } else {
        h += "\n      " + (sec.kind === "walk" ? "Fußweg" : sec.kind) + " " +
          (sec.from || "?") + " → " + (sec.to || "?") + ": " +
          (sec.mins != null ? sec.mins : "?") + " min" +
          (sec.distM != null ? " (" + sec.distM + " m)" : "") +
          (sec.sfx ? " · " + sec.sfx : "");
      }
    });
  });
  return h;
}
// Ein MM-Reiter als Text (v1.4.15): Abholstation und je übernommener Leihrad-
// Route Start, Abholrad, Rückgabe, Ziel und geplante Ankunft als Zeilen.
function supportMMTabText(idx) {
  const mt = mmTabs[idx];
  if (!mt) return "";
  let h = "MM-Reiter " + (idx + 1) + ": „" + ((mt.name != null && mt.name) ? mt.name : "Leihstation") + "“ (Abholstation)";
  const d = donkeyCache && donkeyCache.d;
  if (mt.stId != null && d && (d.s || []).length) {
    const stn = (d.s || []).find(x => x && x.id === mt.stId);
    if (stn && stn.name) h += " · " + stn.name;
  }
  const routes = mt.routes || [];
  h += "\n  Übernommene MM-Routen: " + routes.length;
  routes.forEach((mm, i) => {
    h += "\n    [" + (i + 1) + "] Start " + ((mm.from && mm.from.name) || "?") +
      " → Ziel " + ((mm.dest && mm.dest.name) || "?") +
      ", geplante Ankunft " + mmClockOfMs(mm.planArrMs) + " Uhr" +
      (mm.tot != null ? ", Gesamtzeit " + mm.tot + " min" : "");
    h += "\n      Abholrad #" + bikeShortId(mm.bike && mm.bike.id) +
      ((mm.bike && mm.bike.t) ? " (" + (mm.bike.t === "ebike" ? "E-Bike" : "Standardrad") + ")" : "") +
      ((mm.bike && mm.bike.fu != null) ? ", Akku " + mm.bike.fu + " %" : "");
    h += "\n      Fußweg " + (mm.w1 != null ? mm.w1 : "?") +
      " min · Radfahrt " + (mm.rb != null ? mm.rb : "?") +
      " min · Rückgabe " + ((mm.drop && mm.drop.name) || "?") +
      " · Fußweg " + (mm.w2 != null ? mm.w2 : "?") + " min";
  });
  return h;
}
// Ein Stations-Reiter als Text: Abfahrtsliste plus die geöffneten Fahrt-
// Verläufe (Unter-Reiter) mit allen Halten und Ist-/Planzeiten.
function supportStopTabText(idx) {
  const t = tabs[idx];
  if (!t) return "";
  let h = "Stations-Reiter " + (idx + 1) + ": „" + defTabName("s", t) + "“";
  const depTxt = supportDepsText(stopViews.get(t.sn));
  h += "\n  Abfahrtsliste: " + (depTxt ? "\n" + depTxt : "(keine Daten geladen)");
  const trips = t.trips || [];
  h += "\n  Unter-Reiter (geöffnete Fahrten): " + trips.length;
  trips.forEach((ab, i) => {
    const trip = ab.trip;
    h += "\n    [" + (i + 1) + "] Fahrt " + (ab.tripId || "?") +
      (trip && trip.route ? " – Linie " + trip.route + " nach " + (trip.direction || "?") : "") +
      (trip && (trip.stops || []).length ?
        " (Verlauf geladen" + (ab.tripOpen ? "" : ", zugeklappt") + ")" :
        " (Fahrtverlauf nicht geladen)");
    if (trip && (trip.stops || []).length) {
      h += "\n      Halte (Station gep./aktuell): " + trip.stops.map(s => {
        const key = s.key || (s.shortName + "|" + (trip.tripId || ab.tripId || ""));
        const dl = (trip.delay || {})[key] || null;
        return s.name + " " + ((dl && dl.plannedTime) || s.plannedTime || "–") + "/" +
          (s.time || (dl && dl.actualTime) || "–");
      }).join("; ");
    }
  });
  return h;
}
function supportAddrFavText() {
