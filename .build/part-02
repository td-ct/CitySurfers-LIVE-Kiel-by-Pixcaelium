// ---------- Native Brücke (Android-Mini-App) ----------
// window.KvgNative wird nur von der App eingespritzt; im Browser bleibt es
// undefiniert und alle Aufrufe sind wirkungslos (Seite läuft unverändert weiter).
function nativeCall(fn, ...args) {
  try { if (typeof window !== "undefined" && window.KvgNative) window.KvgNative[fn](...args); }
  catch (e) {}
}
function nativeVibrate(pat) { nativeCall("vibrate", JSON.stringify(pat)); }
// Weckzeit (Epoch-ms) = geplante/aktuelle Abfahrt minus Vorlauf, inkl. Tagesumbruch
function nativeAlarmEpoch(aKey, leadMin) {
  const trip = tripById(aKey.slice(0, aKey.indexOf("|")));
  let h = NaN, m = NaN;
  if (!trip) {   // Route-Wecker: Zeit direkt aus der gewaehlten Route
    const a = alarms.get(aKey);
    const depMin = a ? routeAlarmDepMin(a) : null;
    if (depMin == null) return null;
    h = Math.floor(depMin / 60); m = depMin % 60;
  } else {
    const sn = aKey.slice(aKey.indexOf("|") + 1);
    const s = (trip.stops || []).find(x => x.shortName === sn);
    if (!s) return null;
    const key = s.key || (sn + "|" + trip.tripId);
    const dl = trip.delay[key] || {};
    const t = dl.plannedTime || dl.actualTime || s.time || s.plannedTime || "";
    const parts = t.split(":").map(Number);
    h = parts[0]; m = parts[1];
  }
  if (!isFinite(h) || !isFinite(m)) return null;
  const now = new Date();
  let depMs = new Date(now.getFullYear(), now.getMonth(), now.getDate(), h, m).getTime();
  if (depMs < Date.now() - 60000) depMs += 86400000;   // nachts: gehört zum nächsten Tag
  // Weckzeit kann knapp in der Vergangenheit liegen (Abfahrt schon nah):
  // AlarmManager löst dann sofort aus, was genau richtig ist.
  return depMs - leadMin * 60000;
}

// Abfahrtszeit (Minuten des Tages) der Wecker-Station aus dem aktuellen Fahrtverlauf
// Route-Wecker (Glocke in der gewaehlten Route): Abfahrtszeit der Station
// direkt aus der Route suchen, Echtzeit vor Plan – dazu muessen Fahrtverlauf
// und tripById nichts wissen; gesucht wird in allen offenen Verbindungen nach
// dem Abschnitt (jid) und dem Stations-Namen.
function routeAlarmDepMin(a) {
  if (!a || !a.jid || a.rtName == null) return null;
  const norm = s => String(s || "").toLowerCase().replace(/[^a-z0-9äöüß]/g, "");
  const want = norm(String(a.rtName).replace(/\s*\(DB\)\s*$/, ""));
  for (const rc of routeChosen) {
    const con = rc && rc.con;
    if (!con) continue;
    for (const sec of con.secs || []) {
      if (!sec || sec.jid !== a.jid) continue;
      const sts = sec.stops || [];   // die Segment-Liste bleibt immer die Basis (Erweiterung nur Anzeige)
      for (const st of sts) {
        if (!st || norm(String(st.name).replace(/\s*\(DB\)\s*$/, "")) !== want) continue;
        const parts = (st.dR || st.dS || "").split(":").map(Number);
        if (parts.length < 2 || !isFinite(parts[0]) || !isFinite(parts[1])) return null;
        return parts[0] * 60 + parts[1];
      }
    }
  }
  return null;
}
function alarmDepMin(a) {
  const trip = tripById(a.tripId);
  if (!trip) return routeAlarmDepMin(a);   // Route-Wecker: kein Fahrverlauf noetig
  const s = (trip.stops || []).find(x => x.shortName === a.sn);
  if (!s) return null;
  const key = s.key || (a.sn + "|" + a.tripId);
  const dl = currentTrip.delay[key] || {};
  const t = (dl.plannedTime || dl.actualTime || s.time || s.plannedTime || "");
  const [h, m] = t.split(":").map(Number);
  return (isFinite(h) && isFinite(m)) ? h * 60 + m : null;
}
// Zeit der Station für den Wecker aktualisieren (KVG: Tafel der Station; DB: Fahrt neu)
async function pollAlarmStop(a) {
  if (!currentTrip || currentTrip.tripId !== a.tripId) return;
  const s = (currentTrip.stops || []).find(x => x.shortName === a.sn);
  if (!s) return;
  const key = s.key || (a.sn + "|" + a.tripId);
  if (isDB(currentTrip.sn)) { selectTrip(currentTrip.sn, a.tripId, true); return; }
  try {
    const res = await apiFetch("kvg", DEPART_URL, {
      method: "POST",
      headers: { "Content-Type": "application/x-www-form-urlencoded" },
      body: "stop=" + encodeURIComponent(a.sn)
    });
    if (!res.ok) return;
    const data = await res.json();
    const d = [...(data.actual || []), ...(data.oldActual || [])].find(x => x.tripId === a.tripId);
    if (!d || !d.plannedTime) return;
    const old = currentTrip.delay[key] || {};
    const actualTime = d.actualTime || old.actualTime || d.plannedTime;
    const [ph, pm] = d.plannedTime.split(":").map(Number);
    const [ah, am] = actualTime.split(":").map(Number);
    currentTrip.delay[key] = {
      plannedTime: d.plannedTime, actualTime,
      delayMin: (isFinite(ph) && isFinite(pm) && isFinite(ah) && isFinite(am))
        ? (ah * 60 + am) - (ph * 60 + pm) : null,
      ts: Date.now()
    };
  } catch (e) {}
}
function alarmTick() {
  syncNativeRinging();
  renderAlarmInd();
  if (alarmsOff) return;   // global aus: nichts auslösen (Wecker bleiben gestellt)
  if (!alarms.size) return;
  // Distanz-Wecker: NUR echte Live-Ortung (GPS an). Ohne GPS wuerde die
  // gespeicherte/letzte Position (eine eingefrorene Konstante!) falsch
  // messen: Der Abstand stimmt nie, der Wecker bleibt dauerhaft stumm.
  const pos = (gpsState === "on" && myPos) ? myPos : null;
  const nowD = new Date();
  const nowMin = nowD.getHours() * 60 + nowD.getMinutes();
  for (const [aKey, a] of [...alarms]) {
    if (a.paused) continue;   // deaktiviert: nicht prüfen, nicht läuten
    const stop = stops.find(x => x.shortName === a.sn) || dbStopOf(a.sn) ||   // KVG-Liste oder DB-Bahnhof
      (a.lat != null ? { lat: a.lat, lon: a.lon } : null);   // Route-Station: Koordinaten direkt aus der Route
    if (a.dist && pos && stop && dist(pos, stop) <= a.dist) { fireAlarm(aKey, a); continue; }
    if (a.leadMin != null) {
      if (Date.now() - (a.lastPoll || 0) > a.leadMin * 30000) {   // alle leadMin/2 Minuten
        a.lastPoll = Date.now();
        pollAlarmStop(a);
      }
      const depMin = alarmDepMin(a);
      if (depMin != null) {
        let d = depMin - nowMin;
        if (d < -720) d += 1440;
        if (d <= a.leadMin) { fireAlarm(aKey, a); continue; }
      }
    }
  }
}

// Wecker-Dialog: erst eine Station des Fahrtverlaufs wählen, dann Distanz ODER
// Zeit vor Abfahrt sowie Vibration/Weckton einstellen. "Distanz" und "Zeit" sind
// nur Überschriften, nicht wählbar; gestellt wird erst mit Station und
// mindestens einer der beiden Bedingungen. Aufruf über die Glocke am "Fahrtverlauf"-Kopf.
function openAlarmDialog(tripId, preSn) {
  if (!currentTrip || currentTrip.tripId !== tripId) return;   // nur mit geladenem Fahrtverlauf
  const tstops = (currentTrip && currentTrip.stops || []);
  // Vorbelegung-Priorität: läutend > ausgelöst > gestellt; sonst GPS-nahe bzw.
  // nächste Abfahrts-Station der Fahrt
  let sn = preSn || null;
  if (!sn) {
    const hit = tstops.find(x => ringing.has(tripId + "|" + x.shortName)) ||
      tstops.find(x => firedAlarms.has(tripId + "|" + x.shortName)) ||
      tstops.find(x => alarms.has(tripId + "|" + x.shortName));
    if (hit) sn = hit.shortName;
  }
  // Marker für die Stationsauswahl: 📍 GPS steht gerade im Radius dieser Station,
  // ▶ nächste Abfahrtsstation der Fahrt (erste Station mit Zeit ab jetzt)
  const mPos = livePos();
  const mR = isDB(currentTrip.sn) ? STATION_RADIUS_TRAIN_M : STATION_RADIUS_BUS_M;
  let gpsSn = null, nextSn = null;
  if (mPos) {
    for (const x of tstops) {
      const st = stops.find(s => s.shortName === x.shortName);
      if (st && dist(mPos, st) < mR) { gpsSn = x.shortName; break; }
    }
  }
  {
    const n0 = new Date(), nowMin0 = n0.getHours() * 60 + n0.getMinutes();
    for (const x of tstops) {
      const t = x.actualTime || x.time || x.plannedTime || "";
      const [h, m] = t.split(":").map(Number);
      if (isFinite(h) && isFinite(m) && h * 60 + m >= nowMin0 - 1) { nextSn = x.shortName; break; }
    }
  }
  if (!sn) sn = gpsSn || nextSn;
  let aKey = null, a = { tripId, sn: "", name: "" }, old = {};
  let selDist = null, selLead = null;
  const cfg = alarmCfg();
  // In der App vibriert die native Brücke auch ohne navigator.vibrate (WebView)
  const hasVib = !!(navigator.vibrate || window.KvgNative);
  const wrap = document.createElement("div");
  wrap.className = "dlgwrap";
  const chip = (label, val, group) =>
    '<button class="achip" data-g="' + group + '" data-v="' + val + '">' + label + "</button>";
  wrap.innerHTML =
    '<div class="dlg">' +
    '<div class="dtitle">Wecker: Linie ' + escapeHtml(currentTrip ? currentTrip.route : "") +
      " → " + escapeHtml(currentTrip ? currentTrip.direction : "") + "</div>" +
    '<div class="dlabel">Station dieses Fahrtverlaufs</div>' +
    '<select class="astop"><option value="">– Station wählen –</option>' +
      tstops.map(x => {
        const t = x.actualTime || x.time || x.plannedTime || "";
        const mk = x.shortName === gpsSn ? "📍 " : x.shortName === nextSn ? "▶ " : "";
        return '<option value="' + escapeHtml(x.shortName) + '"' + (sn === x.shortName ? " selected" : "") + '>' +
          mk + escapeHtml((t ? t + "  " : "") + x.name) + "</option>";
      }).join("") + "</select>" +
    '<div class="dlabel">Distanz</div>' +
    '<div class="achips">' +
      chip("250 m", 250, "d") + chip("500 m", 500, "d") + chip("1 km", 1000, "d") + chip("2 km", 2000, "d") +
      chip("5 km", 5000, "d") + chip("10 km", 10000, "d") + "</div>" +
    '<div class="doder">ODER</div>' +
    '<div class="dlabel">Zeit vor gepl. / akt. Abfahrt</div>' +
    '<div class="achips">' +
      chip("2 min", 2, "t") + chip("5 min", 5, "t") + chip("10 min", 10, "t") + chip("20 min", 20, "t") + "</div>" +
    '<div class="dstages">' +
      '<label class="dstage"><input type="checkbox" class="avib"' + ((old.vib !== false) ? " checked" : "") + (hasVib ? "" : " disabled") +
        "> Vibration" + (hasVib ? "" : " (Gerät unterstützt es nicht)") + "</label>" +
      '<label class="dstage"><input type="checkbox" class="atone"' + ((old.tone !== false) ? " checked" : "") + "> Weckton</label>" +
      '<label class="dstage">Ton <select class="asnd">' +
        ALARM_SOUNDS.map(x => '<option value="' + x[0] + '"' + (x[0] === cfg.snd ? " selected" : "") + ">" + x[1] + "</option>").join("") +
        "</select></label>" +
      '<label class="dstage">Lautstärke <input type="range" class="avol" min="0.1" max="1" step="0.05" value="' + cfg.vol + '" title="Weckton-Lautstärke" /></label>' +
      '<button class="atest" title="Weckton und Vibration sofort ausprobieren">▶ Test</button>' +
    "</div>" +
    '<div class="dbtns">' +
      '<button class="adel" hidden title="Gestellten Wecker entfernen">🗑 Wecker löschen</button>' +
      '<button class="acancel">Abbrechen</button>' +
    '<button class="aok" disabled>Wecker stellen</button></div>' +
    // Im Browser (ohne native Brücke): Hinweis, dass Vibration/Weckton im
    // Hintergrund nicht funktionieren, plus Download-Link zur APK im selben
    // Verzeichnis wie diese Seite (relativ, funktioniert überall, wo beide
    // Dateien zusammen liegen)
    (window.KvgNative ? "" :
      '<div class="apkdl">⚠ Im Browser klingelt oder vibriert der Wecker nicht, ' +
      'während die Seite im Hintergrund ist oder das Display aus ist. ' +
      'Android-App installieren: <a href="cslk.apk" download="cslk.apk">cslk.apk</a> ' +
      '(Download im selben Verzeichnis wie diese Seite).</div>') +
    "</div>";
  document.body.appendChild(wrap);
  const okBtn = wrap.querySelector(".aok");
  const delBtn = wrap.querySelector(".adel");
  const titleEl = wrap.querySelector(".dtitle");
  const stopSel = wrap.querySelector(".astop");
  // Station gewählt: Titel, ggf. gestellten Wecker dieser Station vorbelegen
  function pickStation(v) {
    aKey = v ? tripId + "|" + v : null;
    const stop = tstops.find(x => x.shortName === v);
    a = { tripId, sn: v, name: stop ? stop.name : v };
    old = (aKey && alarms.get(aKey)) || {};
    selDist = old.dist || null;
    selLead = old.leadMin || null;
    if (titleEl) titleEl.textContent = aKey ? "Wecker: " + a.name : "Wecker: Station wählen";
    if (delBtn) delBtn.hidden = !(old.dist || old.leadMin);
    sync();
  }
  const sync = () => {
    wrap.querySelectorAll(".achip").forEach(c => {
      const on = c.dataset.g === "d" ? Number(c.dataset.v) === selDist
                                     : Number(c.dataset.v) === selLead;
      c.classList.toggle("on", on);
    });
    okBtn.disabled = !(selDist || selLead) || !aKey;   // erst mit Station und mindestens einer Bedingung stellbar
  };
  if (stopSel) stopSel.addEventListener("change", () => pickStation(stopSel.value));
  if (sn) pickStation(sn); else sync();
  wrap.addEventListener("click", e => {
    if (e.target.closest(".atest")) {   // Test: aktueller Ton + Lautstärke + Vibration
      const c = { snd: wrap.querySelector(".asnd").value,
                  vol: Number(wrap.querySelector(".avol").value) };
      saveAlarmCfg(c);
      if (wrap.querySelector(".atone").checked) alarmBeep(c.vol, c.snd);
      if (wrap.querySelector(".avib").checked && hasVib) vibratePattern([200, 100, 200]);
      return;
    }
    const c = e.target.closest(".achip");
    if (c) {
      const v = Number(c.dataset.v);
      if (c.dataset.g === "d") selDist = selDist === v ? null : v;
      else selLead = selLead === v ? null : v;
      sync();
      return;
    }
    if (e.target.closest(".adel") && aKey) {   // gestellten Wecker löschen
      alarms.delete(aKey);
      saveAlarms();
      stopRinging(aKey, true);
      wrap.remove();
      renderAlarmInd();
      renderTabs();
      setLocNote("🔕 Wecker gelöscht: " + a.name);
      if (currentBus) renderBusPanel();
      return;
    }
    if (e.target.closest(".acancel")) { wrap.remove(); return; }
    if (e.target.closest(".aok") && aKey && (selDist || selLead)) {
      const snd = wrap.querySelector(".asnd").value;
      const vol = Number(wrap.querySelector(".avol").value);
      saveAlarmCfg({ snd: snd, vol: vol });   // Klang/Lautstärke künftig merken
      const useVib = hasVib && wrap.querySelector(".avib").checked;
      const useTone = wrap.querySelector(".atone").checked;
      firedAlarms.delete(aKey);       // ggf. alten Auslöse-Zustand zurücksetzen
      alarms.set(aKey, { tripId: a.tripId, sn: a.sn, name: a.name,
        paused: false,
        tabSn: currentBus ? currentBus.sn : (currentStop ? currentStop.shortName : null),
        dist: selDist, leadMin: selLead,
        vib: useVib, tone: useTone, snd: snd, vol: vol, lastPoll: 0 });
      saveAlarms();
      // Zeit-Wecker an die App übergeben: AlarmManager klingelt auch bei
      // ausgeschaltetem Display / im Hintergrund (Distanz-Wecker nur offen)
      if (selLead && !alarmsOff) {   // global aus: keinen nativen Wecker planen
        const ms = nativeAlarmEpoch(aKey, selLead);
        if (ms != null) nativeCall("setAlarm", aKey, String(ms), a.name,
          JSON.stringify({ lead: selLead, vib: useVib, tone: useTone, snd: snd, vol: vol }));
      }
      wrap.remove();
      renderAlarmInd();
      renderTabs();
      setLocNote("🔔 Wecker gestellt: " + a.name +
        (selDist ? " · " + (selDist >= 1000 ? selDist / 1000 + " km" : selDist + " m") : "") +
        (selDist && selLead ? " oder " : "") +
        (selLead ? selLead + " min vor Abfahrt" : "") +
        (selDist && gpsState !== "on" ? " · ⚠ Distanz misst nur mit aktiver GPS-Ortung (◎ oben einschalten), sonst bleibt der Wecker stumm" : "") +
        (selDist && window.KvgNative ? " · klingelt in der App dank Geofence auch bei ausgeschaltetem Display" : ""));
      if (currentBus) renderBusPanel();
    }
  });
}

// ---------- Glocke in der gewählten Route: Wecker für die GESAMT-Route ----------
// Stations-Liste der gewählten Route: alle Haltestellen aller Fahrzeug-Abschnitte
// in Fahrtrichtung gemeinsam (Zubringer haben keine Haltestellen). Jede Station
// wird auf eine KVG-/DB-Station abgebildet (exakter Name, sonst Koordinate
// <= 250 m); fremde Stationen bekommen ein Pseudo-sn UND die Koordinaten aus
// der Route mit, damit Distanz-Wecker und Geofence auch dort arbeiten.
function routeAlarmStations(rc) {
  const out = [];
  const con = rc && rc.con;
  const norm = s => String(s || "").toLowerCase().replace(/[^a-z0-9äöüß]/g, "");
  (con && con.secs || []).forEach(sec => {
    if (!sec || sec.kind !== "jny") return;
    const sts = sec.stops || [];   // die Segment-Liste bleibt immer die Basis (Erweiterung nur Anzeige)
    sts.forEach(st => {
      if (!st || st.name == null) return;
      const stN = norm(String(st.name).replace(/\s*\(DB\)\s*$/, ""));
      const byName = stops.find(s => norm(String(s.name || "").replace(/\s*\(DB\)\s*$/, "")) === stN);
      let sn = byName ? byName.shortName : null;
      if (!sn && st.lat != null && st.lon != null) {
        let best = null;
        for (const s of stops) {
          if (s.lat == null || s.lon == null) continue;
          const d = dist(st, s);
          if (d < 250 && (!best || d < best.d)) best = { s: s, d: d };
        }
        sn = best ? best.s.shortName : null;
      }
      if (!sn) sn = "N:" + stN;
      if (out.some(x => x.jid === sec.jid && x.sn === sn)) return;   // Durchgang im selben Lauf nur einmal
      out.push({ jid: sec.jid, tripId: "rt!" + sec.jid, sn: sn, name: String(st.name),
        lat: st.lat, lon: st.lon, rail: !!sec.rail,
        time: (st.dR || st.dS || st.aR || st.aS || "") });
    });
  });
  out.forEach(x => { x.aKey = x.tripId + "|" + x.sn; });
  return out;
}
