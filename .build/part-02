// (justify-content: center). Gezaehlt wird, wie viele Knöpfe bei der Mindestbreite
// 64 px in eine Zeile passen; die gemeinsame Zeilenbreite ist dann die Breite JE KNOPFS.
function updateBigBtnsLayout() {
  const bb = document.getElementById("bigbtns");
