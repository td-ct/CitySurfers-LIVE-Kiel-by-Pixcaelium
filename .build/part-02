    seenJid.add(j.jid);
    seenDep.set(dkey, deps.length);
    deps.push(entry);
    const plat = st.dPlatF || st.dPlatR;
    if (plat) platforms[j.jid] = plat;
  }
  deps.sort((a, b) => a.actualRelativeTime - b.actualRelativeTime);
  return { deps, platforms };
}

