function dbHHMM(t) { if (!t) return ""; const h = t.length > 6 ? t.slice(-6) : t;
  return h.slice(0, 2) + ":" + h.slice(2, 4); }
function hhmmShift(t, mins) {   // "HH:MM" um +/- Minuten verschieben (rechnerischer Mitternacht-Umbruch)
  const m = /^(\d{1,2}):(\d{2})$/.exec(String(t || ""));
  if (!m) return t;
  const v = ((Number(m[1]) * 60 + Number(m[2]) + (mins || 0)) % 1440 + 1440) % 1440;
  return String(Math.floor(v / 60)).padStart(2, "0") + ":" + String(v % 60).padStart(2, "0");
}
function rtDiffMin(a, b) {   // Soll-/Ist-HAFAS-Zeit -> +/- Minuten (auch negativ), null ohne Echtzeit
