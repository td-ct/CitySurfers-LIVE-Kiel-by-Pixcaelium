function setAlarmsOff(off) {   // Wecker global: Nebenwirkungen wie frueher einzeln
  alarmsOff = off;
  try { localStorage.setItem("kvg-alarms-off", alarmsOff ? "1" : "0"); } catch (e) {}
  if (alarmsOff) {
    for (const k of [...ringing.keys()]) stopRinging(k, true);   // laufende Läut-Ketten beenden
    for (const k of [...alarms.keys()]) nativeCall("cancelAlarm", k);   // native Wecker/Zäune raus
  } else {
    syncGeofences();   // Geofence-Zäune wieder registrieren
    for (const [k, a] of alarms) {
      if (a.leadMin != null) {   // native Zeit-Wecker wieder planen
        const ms = nativeAlarmEpoch(k, a.leadMin);
        if (ms != null) nativeCall("setAlarm", k, String(ms), a.name,
          JSON.stringify({ lead: a.leadMin, vib: a.vib !== false, tone: a.tone !== false,
            snd: a.snd || "alarm", vol: a.vol == null ? 1 : a.vol }));
      }
    }
  }
}
