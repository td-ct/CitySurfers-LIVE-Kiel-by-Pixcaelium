  if (!st) st = apiStats.kinds[kind] = { n: 0, b: 0, a: 0, e: 0 };
  st.a++;   // v1.5.3: jeder Versuch zaehlt, egal wie er ausgeht
  let res;
  try {
    res = await fetch(url, opts);
  } catch (errSt) {   // Netzwerk-/DNS-/Abbruch-Fehler: fehlgeschlagener Versuch
    st.e++;
    apiStatsChanged();
    throw errSt;
  }
  if (!res.ok) {   // HTTP-Fehlerstatus: fehlgeschlagener Versuch, Antwort bleibt fuer den Aufrufer lesbar
    st.e++;
    apiStatsChanged();
    return res;
  }
  try {
    const c = res.clone();
    const txt = await c.text();
    st.n++;
    st.b += apiEnc.encode(txt).length;
    apiStatsChanged();
  } catch (e) {}
  return res;
}
