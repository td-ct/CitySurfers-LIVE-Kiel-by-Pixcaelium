  // jnyFltrL (Produkt-Bitmaske 31 = Schienenverkehr): Ohne Filter füllen Busse
  // das 100er-Limit – am Hbf blieben so nur ~8 Züge in 1,5 h übrig. Mit Filter
  // liefert EINE Abfrage rund 10 h Züge (Anzeige: 6 h, mit „später“ seitenweise weiter).
  const res = await dbFetch([{ meth: "StationBoard",
    req: { type: "DEP", stbLoc: { lid: d.lid }, date, time,
      jnyFltrL: [{ type: "PROD", mode: "INC", value: "31" }], maxJny: 100 } }]);
  const out = res.svcResL && res.svcResL[0] && res.svcResL[0].res;
  if (!out || !out.jnyL) return null;
  const prodL = (out.common && out.common.prodL) || [];
  const deps = [], platforms = {};
  const seenJid = new Set();
  const seenDep = new Map(); // "Ziel|Sollzeit" -> Index in deps
  for (const j of out.jnyL) {
    const prod = prodL[j.prodX] || {};
    if ((prod.cls || 0) >= 32) continue;   // nur Schienenverkehr (Zug/Schienenersatz)
    const st = j.stbStop || {};
    const t = st.dTimeR || st.dTimeS;
    if (!t) continue;
    const rawName = String(prod.name || "").trim();
    // Datenpseudonym "de:NAHSH" entfernen, auch mitten im Namen (z.B. "SEVde:NA" -> "SEV")
    const deIdx = rawName.indexOf("de:");
    const cleanName = deIdx > 0 ? rawName.slice(0, deIdx).trim() : (deIdx === 0 ? "" : rawName);
    const isPseudo = !cleanName;
    const line = cleanName
      || String((prod.prodCtx && prod.prodCtx.catOutS) || prod.addId || "DB").trim();
    // Doppelungen vermeiden:
    // a) gleiche Fahrt-ID (jid) nur einmal (SEV-Schleifen: mehrfache Durchgänge pro Tageslauf)
    // b) gleiche Fahrt kommt teils als ZWEI Produkte mit verschiedenen jids
    //    (z.B. "RB73" und SEV-Ersatz "de:NAHSH") mit identischer Zeit+Ziel ->
    //    nur den Eintrag mit dem konkreten Liniennamen behalten.
    const dkey = (j.dirTxt || "") + "|" + (st.dTimeS || "");
    const prev = seenDep.get(dkey);
    if (seenJid.has(j.jid)) continue;
    const entry = {
      tripId: j.jid,
      line: line || "DB",
      direction: j.dirTxt || "",
      isPseudo,
      plannedTime: dbHHMM(st.dTimeS),
      actualTime: dbHHMM(st.dTimeR || st.dTimeS),
      actualRelativeTime: dbRelMin(t) * 60,   // Sekunden ab jetzt (wie KVG-API)
      status: st.dTimeR ? "PREDICTED" : "PLANNED",
      alerts: []
