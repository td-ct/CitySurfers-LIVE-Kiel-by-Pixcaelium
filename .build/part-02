function vehMoiyReset() { const n = new Date(); vehMinOfYear = new Date(n.getFullYear(), 0, 1).getTime(); }
vehMoiyReset();
function vehMoiy(ms) { return (ms - vehMinOfYear) / 60000; }
// HH:MM-Minuten des Tages ins Minuten-Spektrum heben; mehr als 12 h daneben
// heißt Nachbar-Tag (Mitternachts-Fahrten gehören zur laufenden Fahrt)
function vehMoiyOfMin(minOfDay, nowMoiy) {
  let m = Math.floor(nowMoiy / 1440) * 1440 + minOfDay;
  if (m - nowMoiy > 720) m -= 1440;
  if (nowMoiy - m > 720) m += 1440;
  return m;
}

// Richtungsvektor a→b in lokalen Metern, normiert (für die Richtungs-Prüfung)
function vehDirVec(a, b) {
  const ks = Math.cos((a.lat || 0) * Math.PI / 180) * 111320;
  const dx = (b.lon - a.lon) * ks, dy = (b.lat - a.lat) * 111320;
  const L = Math.hypot(dx, dy);
  if (L < 1) return null;
  return { x: dx / L, y: dy / L };
}

// Eigene Richtung + Geschwindigkeit aus der Spur (verlässlich ab 60 m Bewegung
// innerhalb der letzten 4 Minuten), Geschwindigkeit in Metern pro Minute
function vehUserMotion(trail, nowMs) {
  const cut = nowMs - 4 * 60 * 1000;
  const pts = (trail || []).filter(p => p.ts >= cut);
  if (pts.length < 2) return { dir: null, spd: 0, confident: false };
  const a = pts[0], b = pts[pts.length - 1];
  const moved = dist(a, b);
  const spd = moved / Math.max(0.1, (b.ts - a.ts) / 60000);
  if (moved < 60) return { dir: null, spd, confident: false };
  return { dir: vehDirVec(a, b), spd, confident: true };
}

// Datenqualität einer Fahr-Linie: 2 = komplett Live, 1 = teilweise Live
// (von Live-Punkten extrapoliert oder erst auf einen Live-Punkt zu), 0 = Fahrplan
function vehLiveCls(tstops) {
  let liveN = 0, n = 0;
  for (const s of tstops) { n++; if (s.live) liveN++; }
  if (!n || liveN === 0) return 0;
  return liveN === n ? 2 : 1;
}

// Projektion eines Punkts auf den Raum-Zeit-Abschnitt a→b: Längsanteil (0..1)
// und querer Abstand in Metern (Luftlinie zwischen den Haltestellen)
function vehSegProject(a, b, p) {
  const dLat = b.lat - a.lat, dLon = b.lon - a.lon;
  const len2 = dLat * dLat + dLon * dLon;
  if (!len2) return { f: 0, dPerp: dist(p, a) };
  let f = ((p.lat - a.lat) * dLat + (p.lon - a.lon) * dLon) / len2;
  f = Math.max(0, Math.min(1, f));
  return { f, dPerp: dist(p, { lat: a.lat + f * dLat, lon: a.lon + f * dLon }) };
}

// Kern-Vergleich (rein, Raum-Zeit): tstops [{lat, lon, moiy, live, name?, sn?}]
// aufsteigend, Trail aufsteigend nach Zeit. Jeder Spur-Punkt wird auf den
// ABSCHNITT der Fahr-Linie projiziert, der ihn in Raum UND Zeit am nächsten
// nimmt: Abweichung = sqrt(querMetern² + (Abschnittstempo × MinutenAbstand)²).
// Position, Geschwindigkeit und Richtung stecken damit in EINEM Abstand;
// Richtung und Tempo werden zusätzlich HART geprüft (Gegenrichtung raus,
// Stadtbusse über 50 km/h raus). Rückgabe:
// { score 0..99, segK, next, eta, openSn, cls } | null
function vehScore3D(tstops, trail, nowMs, opts) {
  opts = opts || {};
  const pos = opts.pos;
  if (!pos || !tstops || tstops.length < 2) return null;
  const acc = opts.acc == null ? 30 : opts.acc;
  const corridor = (opts.isDB ? VEH_CORRIDOR_DB_M : VEH_CORRIDOR_M) + Math.min(acc, 150);
  const win = opts.winMin || 6;                    // erlaubte Minuten-Abweichung je Punkt
  const segs = [];
  for (let i = 0; i + 1 < tstops.length; i++) {
    const a = tstops[i], b = tstops[i + 1];
    if (!isFinite(a.lat) || !isFinite(b.lat) || a.moiy == null || b.moiy == null) continue;
    const D = b.moiy - a.moiy;
    if (D <= 0) continue;                         // rückwärts laufende Kette: unbrauchbar
    segs.push({ i, a, b, D, S: dist(a, b) / D }); // S: Tempo des Abschnitts in m/min
  }
  if (!segs.length) return null;
  const traj = vehUserMotion(trail, nowMs);
  // Tempo HART: über 50 km/h eigener Geschwindigkeit fährt kein Stadtbus der
  // Bus-Ebene (nur Bahn-Ebene: Züge und Überland-/SEV-Busse bleiben drin)
  if (traj.spd * 0.06 > 50 && !opts.isDB) return null;
  const cut = nowMs - VEH_TRAIL_MS;
  const pts = (trail || []).filter(p => p.ts >= cut && p.ts <= nowMs + 60000);
  const usePts = pts.length ? pts : [{ lat: pos.lat, lon: pos.lon, ts: nowMs }];
  let devSum = 0, cover = 0, best = null;
  for (const p of usePts) {
    const m = vehMoiy(p.ts);
    let bp = null;
    for (const g of segs) {
      const pj = vehSegProject(g.a, g.b, p);
      const dtMin = m - (g.a.moiy + pj.f * g.D);   // Minuten zur Fahr-Linie dort
      if (Math.abs(dtMin) > win) continue;
      const dev = Math.sqrt(pj.dPerp * pj.dPerp + (g.S * dtMin) * (g.S * dtMin));
      if (!bp || dev < bp.dev) bp = { g, dev, dtMin, pj };
    }
    if (!bp) continue;                              // kein Abschnitt im Zeitfenster
    if (bp.dev <= corridor) cover++;
    devSum += Math.min(bp.dev, corridor * 3);
    best = bp;                                      // letzter Punkt = aktuelle Lage
  }
  if (!best) return null;
  // Richtung HART: steht die eigene Fahrtrichtung fest (≥ 60 m bewegt), muss der
  // passende Abschnitt in dieselbe oder eine ähnliche Richtung laufen (≤ 60°-Winkel)
  if (traj.confident && traj.dir) {
    const sv = vehDirVec(best.g.a, best.g.b);
    if (sv && traj.dir.x * sv.x + traj.dir.y * sv.y < 0.5) return null;
  }
  const devAvg = devSum / usePts.length;
  const closeness = Math.max(0, 1 - devAvg / (corridor * 3));
  const score = Math.round(100 * Math.min(0.99, 0.6 * (cover / usePts.length) + 0.4 * closeness));
  if (score < 15) return null;
  let openSn = null;   // erste ANTIPPBARE Station ab der nächsten (KVG/DB-Bestand)
  for (let i = best.g.i + 1; i < tstops.length && openSn == null; i++) {
    const s = tstops[i];
    if (s.sn && opts.openable && opts.openable(s.sn)) openSn = s.sn;
  }
  const next = tstops[best.g.i + 1] || null;
  const eta = next && next.moiy != null
    ? Math.max(0, Math.round(next.moiy - vehMoiy(nowMs))) : null;
  return { score, segK: best.g.i, next, eta, openSn,
    dtMin: best.dtMin, frac: best.pj.f, spdK: Math.round(best.g.S * 0.06) };
}

// Haltestellen-Kette einer KVG-Live-Fahrt (tripPassages: old + actual)
async function vehKvgStops(tripId) {
  const res = await apiFetch("kvg", TRIP_URL, {
    method: "POST",
    headers: { "Content-Type": "application/x-www-form-urlencoded" },
    body: "tripId=" + encodeURIComponent(tripId)
  });
  if (!res.ok) return null;
  const data = await res.json();
  const raw = (data.old || []).concat(data.actual || []);
  if (!raw.length) return null;
  const out = raw.map(p => {
    const sn = p.stop && p.stop.shortName;
    const st = sn != null ? (stops.find(x => x.shortName === sn) || dbStopOf(sn)) : null;
    return { sn, name: p.stop && p.stop.name,
      lat: st ? st.lat : NaN, lon: st ? st.lon : NaN,
      depMin: vehHhmmMin(p.actualTime), live: true };   // Ist-Zeit (Live-Board)
  }).filter(s => s.depMin != null);
  if (out.length < 2) return null;
  return { stops: out, route: data.routeName || "", dir: data.directionText || "" };
}

// Haltestellen-Kette einer DB-Zugfahrt (JourneyDetails, echte Koordinaten);
// kvgPlanned: geplante KVG-Fahrt über NAH.SH (extId -> KVG-Station abbilden)
async function vehDbStops(tripId, kvgPlanned) {
  const res = await dbFetch([{ meth: "JourneyDetails", req: { jid: tripId } }]);
  const out = res.svcResL && res.svcResL[0] && res.svcResL[0].res;
  const j = out && out.journey;
  if (!j || !j.stopL) return null;
  const locL = (out.common && out.common.locL) || [];
  const kvgExt = kvgPlanned ? {} : null;
  if (kvgPlanned) for (const ksn in nahshLocCache) {
    const m = nahshLocCache[ksn] && nahshLocCache[ksn].lid
      ? String(nahshLocCache[ksn].lid).match(/@L=(\d+)/) : null;
    if (m && !kvgExt[m[1]]) kvgExt[m[1]] = ksn;
  }
  const out2 = j.stopL.map(p => {
    const loc = locL[p.locX] || {};
    const crd = loc.crd || {};
    const plannedS = p.dTimeS ? dbHHMM(p.dTimeS) : (p.aTimeS ? dbHHMM(p.aTimeS) : null);
    const actualS = p.dTimeR ? dbHHMM(p.dTimeR) : (p.aTimeR ? dbHHMM(p.aTimeR) : plannedS);
    const extId = loc.extId != null ? String(loc.extId) : "";
    const sn = kvgPlanned ? (kvgExt[extId] || null) : (extId ? "DB:" + extId : null);
    return { sn, name: loc.name,
      lat: crd.y ? crd.y / 1e6 : NaN, lon: crd.x ? crd.x / 1e6 : NaN,
      depMin: vehHhmmMin(actualS), live: !!p.dTimeR };
  }).filter(s => s.depMin != null && isFinite(s.lat));
  if (out2.length < 2) return null;
  return { stops: out2, route: "", dir: j.dirTxt || "" };
}

// Haltestellen-Kette mit Cache (auch negative Ergebnisse, TTL gegen Hämmern);
// geplante KVG-Fahrten (Fahrplan über NAH.SH, jid) laufen über den DB-Pfad mit
// KVG-Stations-Abbildung, KVG-Livefahrten über tripPassages
async function vehTripStops(tripId, sn, dep) {
  const c = vehStopsCache.get(tripId);
  if (c && Date.now() - c.ts < VEH_STOPS_TTL) return c.bad ? null : c;
  let out = null;
  try {
    out = isDB(sn) ? await vehDbStops(tripId, false)
      : ((dep && dep.planned) ? await vehDbStops(tripId, true) : await vehKvgStops(tripId));
  } catch (e) { out = null; }
  const rec = out ? { ts: Date.now(), stops: out.stops, route: out.route, dir: out.dir }
                  : { ts: Date.now(), bad: true };
  vehStopsCache.set(tripId, rec);
  return out ? rec : null;
}

// Bus-Ebene: Stationen in Reichweite (KVG, keine DB-Bahnhöfe), um die aktuelle
// Position und um den zurückgelegten Weg, sortiert nach Entfernung, maximal so
// weit wie der Bus-Umkreis im Dialog (Standard 250 m)
function vehNearbyStops(pos) {
  const seen = new Set(), out = [];
  const add = arr => { for (const s of arr) {
    if (!s || isDB(s.shortName) || seen.has(s.shortName) || out.length >= VEH_MAX_STOPS) continue;
    seen.add(s.shortName); out.push({ sn: s.shortName });
  }};
  add(stops.map(x => x).sort((a, b) => dist(pos, a) - dist(pos, b))
      .filter(s => dist(pos, s) <= vehCfg.m));
  const cut = Date.now() - VEH_TRAIL_PT_MS;
  for (const p of vehTrail) {
    if (out.length >= VEH_MAX_STOPS) break;
    if (p.ts < cut) continue;
    add(stops.map(x => x).sort((a, b) => dist(p, a) - dist(p, b))
        .filter(s => dist(p, s) <= vehCfg.m));
  }
  return out;
}

// Bahn-Ebene: DB-Bahnhöfe im großen Radius (Standard 10 km), nach Entfernung
function vehNearbyRail(pos) {
  return DB_STOPS.map(d => ({ sn: d.sn, m: dist(pos, d) }))
    .filter(d => d.m <= vehCfg.km * 1000)
    .sort((a, b) => a.m - b.m)
    .slice(0, VEH_MAX_RAIL_STOPS)
    .map(d => ({ sn: d.sn }));
}

// Fahrplan-Brett: KVG-Station ohne Live-Tafel (Nacht, Linie ohne Live-Daten) –
// geplante Fahrten über NAH.SH; füllt nebenbei den sn-Karten-Cache (nahshLocFor)
async function vehPlannedDeps(sn) {
  const stop = stops.find(x => x.shortName === sn);
  if (!stop) return null;
  let lid = null;
  try { lid = await nahshLocFor(stop); } catch (e) { lid = null; }
  if (!lid) return null;
  try {
    const now = Date.now();
    const list = [];
    for (const e of await nahshBoardEntries(lid, new Date(), "32")) {
      const rel = (e.absMs - now) / 1000;
      if (rel < -120 || rel > 30 * 60) continue;   // nur nahe Fahrten zeichnen
      list.push({ tripId: e.tripId, line: e.line, direction: e.direction,
        plannedTime: e.plannedTime, actualTime: e.actualTime,
        actualRelativeTime: rel, status: e.hasRT ? "PREDICTED" : "PLANNED",
        alerts: [], planned: true });
    }
    return list;
  } catch (e) { return null; }
}

// Ein Durchlauf: Ebenen (Bus + Bahn) -> Tafeln -> Kandidaten -> Raum-Zeit-Vergleich
async function vehScan(manual) {
  if (vehScanning) { if (manual) vehCfgDirty = true; return; }
  if (!manual && Date.now() - vehLastScan < VEH_SCAN_MS) return;
  if (gpsState !== "on" || !myPos) { vehResults = []; renderVehDlg(); renderVehBadge(); return; }
  vehScanning = true;
  vehLastScan = Date.now();
  const scanId = ++vehScanId;
  sztRejected = [];
  vehMoiyReset();   // Neujahr ueberschritten? Zeitachse der Karte neu festlegen
  renderVehDlg();
  try {
    // zwei Ebenen: Stadtbusse im kleinen Radius, Bahn-Halte im grossen Radius
    const layerStops = [], seenSn = new Set();
    for (const n of vehNearbyStops(myPos).concat(vehNearbyRail(myPos))) {
      if (!seenSn.has(n.sn)) { seenSn.add(n.sn); layerStops.push(n); }
    }
    // 1) frische Tafeln beider Ebenen (Cache umgehen, Alter je Tafel mitrechnen);
    //    leere Live-Tafel an einer KVG-Station: Fahrplan-Brett statt gar nichts
    const boards = [];
    await Promise.all(layerStops.map(async (n) => {
      try {
        const t0 = Date.now();
        depCache.delete(n.sn);
        let deps = await getDepartures(n.sn);
        if ((!deps || !deps.length) && !isDB(n.sn)) deps = await vehPlannedDeps(n.sn);
        if (deps && deps.length) boards.push({ sn: n.sn, deps, ageSec: (Date.now() - t0) / 1000 });
      } catch (e) {}
    }));
    if (scanId !== vehScanId) return;
    sztReachDigest(boards, myPos, vehUserMotion(vehTrail, Date.now()), Date.now());
    // 2) Kandidaten: Fahrten, die an einer Station der Ebenen im eingestellten
    //    Zeitfenster (±X Minuten, Standard ±2) abfahren oder eben abgefahren sind
    const cands = [], seenTrip = new Set();
    const vehWin = vehCfg.min * 60;
    for (const b of boards) {
      for (const d of b.deps) {
        if (!d.tripId || seenTrip.has(d.tripId)) continue;
        const rel = d.actualRelativeTime - b.ageSec;
        if (rel < -vehWin || rel > vehWin) continue;
        seenTrip.add(d.tripId);
        cands.push({ sn: b.sn, rel, dep: d });
      }
    }
    cands.sort((a, b) => Math.abs(a.rel) - Math.abs(b.rel));   // "laeuft gerade" zuerst
    // 3) Fahr-Linien der besten Kandidaten holen und im Raum-Zeit vergleichen
    const scored = [];
    await Promise.all(cands.slice(0, VEH_MAX_TRIPS).map(async (c) => {
      const t = await vehTripStops(c.dep.tripId, c.sn, c.dep);
      if (!t || scanId !== vehScanId) return;
      const cls = vehLiveCls(t.stops);   // 2 = Live, 1 = teilweise, 0 = Fahrplan
      const nowMoiy = vehMoiy(Date.now());
      const t3 = t.stops.map(s => ({ sn: s.sn, name: s.name, lat: s.lat, lon: s.lon,
        moiy: vehMoiyOfMin(s.depMin, nowMoiy), depMin: s.depMin, live: !!s.live }));
      if (t3.length < 2) return;
      // Toleranz je Datenqualitaet: Fahrplan-Linien duerfen weiter abweichen
      const winMin = vehCfg.min * (cls === 0 ? 2.5 : cls === 1 ? 1.5 : 1);
      const dbLayer = isDB(c.sn);
      const sc = vehScore3D(t3, vehTrail, Date.now(),
        { pos: myPos, acc: myPos.accuracy, isDB: dbLayer, winMin,
          openable: sn => !!stops.find(s => s.shortName === sn) });
      if (sc) scored.push({ tripId: c.dep.tripId, line: c.dep.line, sn: c.sn, isDB: dbLayer,
        direction: t.dir || c.dep.direction || "", route: t.route || "",
        score: sc.score, next: sc.next, eta: sc.eta, openSn: sc.openSn, cls,
        dtMin: sc.dtMin, segI: sc.segK, spdK: sc.spdK, t3 });
      else if (sztRejected.length < 8) {
        sztRejected.push({ line: c.dep.line, dir: t.dir || c.dep.direction || "",
          reason: sztRejectReason(t3, vehTrail, Date.now(), { pos: myPos, isDB: dbLayer, winMin }) });
      }
    }));
    if (scanId !== vehScanId) return;
    // 4) gleiche Linie + Richtung: nur der beste Kandidat (Folgefahrt etc.)
    const best = new Map();
    for (const r of scored) {
      const key = (r.line || "") + "|" + (r.direction || "");
      if (!best.has(key) || best.get(key).score < r.score) best.set(key, r);
    }
    vehResults = [...best.values()].sort((a, b) => b.score - a.score).slice(0, 5);
    vehBadgeIdx = 0;   // Rotation beginnt wieder beim besten Treffer
    sztDigest(vehResults[0] || null);
    sztWalkDigest();
  } catch (e) {
    if (scanId === vehScanId) vehResults = [];
  } finally {
    vehScanning = false;
    if (!sztMotion || Date.now() - sztMotion.ts > 20 * 1000) sztWalkDigest();
    renderVehDlg();
    renderVehBadge();
    if (vehCfgDirty) {   // Regler wurde waehrend des Laufs gedrueckt: jetzt neu suchen
      vehCfgDirty = false;
      setTimeout(() => vehScan(true), 50);
    }
  }
}

function renderVehDlg() {
  if (!vehDlg || vehDlg.hidden) return;
  if (gpsState !== "on" || !myPos) {
    vehDlgState.textContent = "Die Erkennung braucht die laufende GPS-Ortung (◎ oben bzw. im Ruhe-Dialog) – bitte einschalten, die Suche startet dann von selbst.";
    vehDlgList.innerHTML = "";
    return;
  }
  vehDlgState.textContent = vehScanning
    ? "Erkennung läuft … (Abfahrten beider Ebenen werden gegen die GPS-Spur im Raum-Zeit verglichen)"
    : "Standort ±" + Math.round(myPos.accuracy || 0) + " m · Fenster ±" + vehCfg.min + " min · 🚌 " + vehCfg.m + " m · 🚆 " + vehCfg.km + " km · "
      + (vehLastScan ? "letzter Blick: " + new Date(vehLastScan).toLocaleTimeString("de-DE") + " Uhr" : "")
      + (vehScanning ? "" : " · ↻ sucht sofort neu");
  if (!vehResults.length && !vehScanning) {
    vehDlgList.innerHTML = '<small class="rowinfo dim">Kein Fahrzeug erkannt. Gegenrichtung und (bei zügigem Tempo) Stadtbusse sind hart ausgefiltert; möglicherweise wartest du noch, das GPS ist zu ungenau, oder im Fenster ±' + vehCfg.min + " min fährt gerade nichts.</small>" + sztDlgFooter();
    return;
  }
  const vehCls = { 2: "🟢", 1: "🟡", 0: "⚪" };
  const vehClsTxt = { 2: "Live-Daten der Fahrt", 1: "teilweise Live (Fahrt zwischen Live- und Fahrplan-Abschnitten)", 0: "reine Fahrplan-Daten (keine Live verfügbar)" };
  let html = "";
  vehResults.forEach((r, i) => {
    const open = r.openSn && stops.some(s => s.shortName === r.openSn);
    const cl = vehCls[r.cls] || "⚪";   // 🟢 Live · 🟡 teilweise Live · ⚪ Fahrplan
    html += '<div class="vehwrap"><div class="vehrow' + (open ? "" : " dimrow") + '" data-veh="' + i + '"' +
      (open ? ' title="Antippen: nächste Station als Reiter öffnen, Fahrtverlauf direkt darunter"'
            : ' title="Keine in der App öffnbare Station auf dem weiteren Lauf"') + '>' +
      '<span class="dl">' + escapeHtml(r.line || r.route || "?") + '</span>' +
      '<span class="vdir">→ ' + escapeHtml(r.direction || "") + '</span>' +
      '<span class="vpct">' + r.score + " %</span>" +
      '<span class="vcls" title="' + (vehClsTxt[r.cls] || vehClsTxt[0]) + '">' + cl + '</span></div>' +
      '<div class="subinfo">' +
      (r.next ? "nächste Station: " + escapeHtml(r.next.name || "") +
        (r.eta != null ? " · in ~" + r.eta + " min" : "") : "") +
      (open ? ' · <span class="nxopen">antippen: öffnen</span>' : "") +
      "</div></div>";
  });
  vehDlgList.innerHTML = html + sztDlgFooter();
}

// Kandidat wählen: nächste Station als Reiter + direkt darunter der Verlauf
function vehPick(r) {
  vehDlg.hidden = true;
  if (!r.openSn) return;
  const stopEl = stops.find(s => s.shortName === r.openSn);
  if (!stopEl) return;
  selectBus(r.openSn, r.tripId);        // Stationsreiter + Unter-Reiter der Fahrt
  selectTrip(r.openSn, r.tripId);       // Verlauf laden (Block direkt offen)
  setLocNote("Fahrzeug erkannt: Linie " + (r.line || r.route || "?") + " → " + (r.direction || "") +
    " – " + stopEl.name + " und Fahrtverlauf geöffnet.");
}

vehDlg.addEventListener("keydown", e => { if (e.key === "Escape") vehDlg.hidden = true; });

// Knopf-Schild: blaues Linienschild zeigt „???“ bzw. live die Liniennummer des
// wahrscheinlichsten Fahrzeugs und blättert im Sekundentakt durch die Top 5
const bbVehBadge = document.getElementById("bbVehBadge");
let vehBadgeIdx = 0;
function renderVehBadge() {
  if (!bbVehBadge) return;
  const rs = vehResults.slice(0, 5);
  const t = rs.length
    ? String(rs[vehBadgeIdx % rs.length].line || rs[vehBadgeIdx % rs.length].route || "?")
    : "???";
  if (bbVehBadge.textContent !== t) bbVehBadge.textContent = t;
}
setInterval(() => {
  if (vehResults.length > 1) vehBadgeIdx = (vehBadgeIdx + 1) % Math.min(5, vehResults.length);
  renderVehBadge();
}, 1000);   // Top-5-Nummern sequentiell im Abstand von 1 s

// ---------- Raum-Zeit-Daten (SZT): dritte Datenquelle neben Gep. und Aktuell ----------
// KONVENTION (App, Hilfe, README, Wissensbasis): Werte aus der EIGENEN Raum-Zeit-
// Auswertung (GPS-Spur gegen die Fahr-Linie der erkannten Fahrt) sind IMMER
// KURSIV und nutzen dieselben Farben wie die Live-Daten. Weichen sie von der
// Live-Angabe ab (Timo-Kommando v1.6.11: bereits ab 30 Sekunden statt bisher
// 3 Minuten) oder fehlt Live ganz, laufen sie mit der Live-Angabe im Wechsel
// (2-Sekunden-Wechsel des Stapels, beide lesbar) bzw. ersetzen sie; auf
// Minuten-Anzeigen (Uhrzeit, Chips) ist die erste sichtbare Stufe eine
// abweichende Minute, in Sekunden-Countdowns greift die 30-s-Kante exakt.
// Die drei Quellen: Gep. = Fahrplan, Aktuell = Live-Tafel, kursiv = Raum-Zeit.
// Ausnahme bleibt die Starthaltestelle jedes OePNV-Abschnitts (v1.6.7): Dort
// kommt die Abfahrts-Vorhersage niemals aus dem eigenen GPS.
const SZT_DELTA_MIN = 1;          // v1.6.11: erste sichtbare Minuten-Stufe der 30-s-Uebernahme-Kante
const SZT_TAKEOVER_S = 30;        // v1.6.11: Abweichung in Sekunden, ab der der Raum-Zeit-Wert uebernimmt (Countdowns)
const SZT_TTL_MS = 45 * 1000;    // Auswertung gilt 45 s (Suchrhythmus der Erkennung: 15 s)
const SZT_HIST = 8;              // Messungen im Verspaetungs-Verlauf
let sztState = null;             // { ts, tripId, line, dir, delay, bySn, byName, etaEnd, endName }
let sztDelayHist = [];           // { ts, d }: Verspaetungs-Verlauf der erkannten Fahrt
let sztRejected = [];            // verworfene Kandidaten (Debug-Ansicht im Dialog)
let sztReach = [];               // Lauf-Reichweite: erreichbare Abfahrten der Umgebung
let sztMotion = null;            // { ts, kmh }: eigenes Tempo aus der Spur
let sztWalk = null;              // wie sztMotion, nur wenn es klar ein Lauf-Tempo ist

function sztFresh() { return sztState && Date.now() - sztState.ts <= SZT_TTL_MS ? sztState : null; }
function sztNowMin() { const n = new Date(); return n.getHours() * 60 + n.getMinutes(); }
function sztClockOf(min) {
  if (min == null || !isFinite(min)) return "";
  const m = ((Math.round(min) % 1440) + 1440) % 1440;
  return String(Math.floor(m / 60)).padStart(2, "0") + ":" + String(m % 60).padStart(2, "0");
}
function sztIsSig(a, b) { return a == null || b == null || Math.abs(a - b) >= SZT_DELTA_MIN; }
// Verspaetungs-Verlauf (Idee 1): Tendenz aus den letzten Messungen der Fahrt
function sztTrendText(hist, nowMs, deltaMin) {
  const t = (deltaMin > 0 ? "+" : "") + deltaMin + " min";
  const pts = (hist || []).filter(h => nowMs - h.ts <= 6 * 60 * 1000);
  if (pts.length < 2) return t;
  const d = pts[pts.length - 1].d - pts[0].d;
  return t + (d >= 2 ? ", Tendenz steigend" : d <= -2 ? ", Tendenz fallend" : ", Tendenz stabil");
}
// Wechsel-Blend: Live-Wert und kursiver Raum-Zeit-Wert in einem Stapel (CSS)
function sztBlend(liveTxt, sztTxt) {
  return '<span class="sztwrap"><span class="sztl">' + escapeHtml(String(liveTxt)) + "</span>" +
    '<span class="sztt szt">' + escapeHtml(String(sztTxt)) + "</span></span>";
}
function sztChip(delay, italic) {
  const c = delay > 0 ? "up" : delay < 0 ? "down" : "ok";
  const t = delay > 0 ? "+" + delay + "m" : delay < 0 ? delay + "m" : "0m";
  return '<span class="tdelay ' + c + (italic ? " szt" : "") + '">' + t + "</span>";
}
function sztChipBlend(liveD, sztD) {
  return '<span class="sztwrap"><span class="sztl">' + sztChip(liveD, false) + "</span>" +
    '<span class="sztt">' + sztChip(sztD, true) + "</span></span>";
}
// ETA einer Verlaufs-Zeile aus der Raum-Zeit-Auswertung (nur kommende Stationen)
function sztRowEta(sn, planned, name) {
  const s = sztFresh();
  if (!s) return null;
  const pmin = hhmmToMin(planned);
  if (pmin == null) return null;
  let eta = null;
  if (sn && s.bySn[sn] != null) eta = s.bySn[sn];
  else if (name && s.byName[name] != null) eta = s.byName[name];
  if (eta == null || eta < sztNowMin() - 1) return null;
  return { eta, d: eta - pmin };
}
// Auswertung des besten Treffers: Verspaetung (dtMin am letzten Spur-Punkt)
// + ETAs an allen kommenden Stationen (konstante Verspaetung auf der Kette)
function sztDigest(r) {
  if (!r || !r.t3 || r.dtMin == null) return;
  const nowMs = Date.now();
  const delay = Math.max(-30, Math.min(60, Math.round(r.dtMin)));
  if (!sztState || sztState.tripId !== r.tripId) sztDelayHist = [];
  sztDelayHist.push({ ts: nowMs, d: delay });
  while (sztDelayHist.length > SZT_HIST) sztDelayHist.shift();
  const bySn = {}, byName = {};
  let etaEnd = null, endName = "";
  for (let i = (r.segI || 0) + 1; i < r.t3.length; i++) {
    const st = r.t3[i];
    if (st.depMin == null) continue;
    const eta = st.depMin + delay;
    if (st.sn && bySn[st.sn] == null) bySn[st.sn] = eta;
    if (st.name && byName[st.name] == null) byName[st.name] = eta;
    etaEnd = eta; endName = st.name || endName;
  }
  sztState = { ts: nowMs, tripId: r.tripId, line: r.line, dir: r.direction,
    delay, segI: r.segI, spdK: r.spdK, bySn, byName, etaEnd, endName };
}
// Debug (Idee 5): warum eine Fahr-Linie verworfen wurde - vereinfachte
// Nachrechnung in der Filter-Reihenfolge von vehScore3D
function sztRejectReason(t3, trail, nowMs, opts) {
  opts = opts || {};
  const traj = vehUserMotion(trail, nowMs);
  if (traj.spd * 0.06 > 50 && !opts.isDB) return "Tempo: kein Stadtbus bei deinem Tempo";
  const win = opts.winMin || 6;
  const m = vehMoiy(nowMs);
  let segs = 0, inWin = false, dirOk = false;
  for (let i = 0; i + 1 < (t3 || []).length; i++) {
    const a = t3[i], b = t3[i + 1];
    if (a.moiy == null || b.moiy == null || b.moiy - a.moiy <= 0) continue;
    segs++;
    const pj = vehSegProject(a, b, opts.pos || a);
    const dtMin = m - (a.moiy + pj.f * (b.moiy - a.moiy));
    if (Math.abs(dtMin) > win) continue;
    inWin = true;
    const sv = vehDirVec(a, b);
    if (traj.confident && traj.dir && sv && traj.dir.x * sv.x + traj.dir.y * sv.y < 0.5) continue;
    dirOk = true;
  }
  if (!segs) return "keine nutzbare Linie";
  if (!inWin) return "Zeitfenster";
  if (traj.confident && !dirOk) return "Gegenrichtung";
  return "Abstand/Score zu klein";
}
// Stationssuche nach Raum-Zeit-Reichweite (Idee 7): welche Abfahrten der
// Stationen um dich sind mit DEM EIGENEN Tempo noch erreichbar? (in Lauf-
// Richtung bevorzugt, fruehe zuerst; je Station die frueheste)
function sztReachDigest(boards, pos, traj, nowMs) {
  const out = [];
  const spd = traj && traj.confident && traj.spd > 35 ? traj.spd : WALK_SPEED_KMH * 1000 / 60;
  const baseMin = sztNowMin();
  for (const b of boards || []) {
    const st = stops.find(x => x.shortName === b.sn) || dbStopOf(b.sn);
    if (!st) continue;
    const m = dist(pos, st);
    const walkMin = Math.ceil(m / spd);
    let dirOk = false;
    if (traj && traj.confident && traj.dir) {
      const dv = vehDirVec(pos, st);
      dirOk = !!dv && traj.dir.x * dv.x + traj.dir.y * dv.y > 0.4;
    }
    for (const d of b.deps || []) {
      const rel = (d.actualRelativeTime || 0) - (b.ageSec || 0);
      if (rel < 0 || rel > 30 * 60 || rel < walkMin * 60) continue;
      out.push({ sn: b.sn, m, walkMin, dirOk, line: d.line || "?",
        clock: sztClockOf(baseMin + Math.round(rel / 60)) });
    }
  }
  out.sort((a, b) => (b.dirOk - a.dirOk) || (a.clock < b.clock ? -1 : a.clock > b.clock ? 1 : 0));
  const seen = new Set();
  sztReach = [];
  for (const o of out) {
    if (seen.has(o.sn)) continue;
    seen.add(o.sn);
    sztReach.push(o);
    if (sztReach.length >= 4) break;
  }
}
function sztWalkDigest() {
  const traj = vehUserMotion(vehTrail, Date.now());
  sztMotion = traj && traj.confident && traj.spd > 25
    ? { ts: Date.now(), kmh: Math.round(traj.spd * 0.06) } : null;
  sztWalk = sztMotion && sztMotion.kmh >= 3 && sztMotion.kmh <= 15 ? sztMotion : null;
}
// Bahn-Disambiguierung (Idee 6): eigenes Tempo gegen die Abschnitts-Tempi
function sztRailHTML() {
  const rail = vehResults.filter(r => r.isDB && r.spdK != null).slice(0, 3);
  if (!sztMotion || rail.length < 2) return "";
  const own = sztMotion.kmh;
  rail.sort((a, b) => Math.abs(own - a.spdK) - Math.abs(own - b.spdK));
  const txt = rail.map((r, i) => escapeHtml(r.line) + " " + r.spdK + " km/h (" +
    Math.abs(own - r.spdK) + " Differenz)" + (i === 0 ? " - passt besser" : "")).join(" - ");
  return '<div class="followhint"><div class="szt" title="Raum-Zeit: eigenes Tempo gegen das Abschnitts-Tempo der Bahn-Kandidaten">🚆 Tempo-Profil (eigenes Tempo ~' + own + " km/h): " + txt + "</div></div>";
}
// Fußweg im Raum-Zeit (Idee 4): Ankunft mit dem eigenen Tempo statt Standard
function sztWalkHTML(meters) {
  if (!sztWalk || Date.now() - sztWalk.ts > 3 * 60 * 1000 || meters == null) return "";
  const ownMin = meters / (sztWalk.kmh * 1000 / 60);
  const defMin = meters / (WALK_SPEED_KMH * 1000 / 60);
  if (Math.abs(ownMin - defMin) < 2) return "";
  return ' <span class="szt" title="Raum-Zeit: Ankunft mit deinem eigenen Tempo statt Standard-Tempo (5 km/h)">↝ ~' +
    sztClockOf(sztNowMin() + Math.max(0, Math.round(ownMin))) + "</span>";
}
// Kopfzeile im Fahrtverlauf der erkannten Fahrt: Verspaetungs-Verlauf + Ziel (Idee 1+2)
function sztTripHeadHTML(trip) {
  const s = sztFresh();
