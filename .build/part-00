  /* Gewählte Route: pinke Fortschritts-Balken je Abschnitt, Kreise an allen
     Start-/Umsteige-/End-Punkten, ein Punkt wandert über die Gesamtroute
     (läuft HINTER den Kreisen). Basis dunkelpink, Fortschritt leuchtpink. */
  .rtrail { position: relative; }
  .rtrail .routesec { position: relative; padding-left: 30px; }
  .rtrail .rtleg { position: absolute; left: 10px; top: 10px; bottom: -11px; width: 3px;
    border-radius: 2px; background: #3b1631; }
  /* Ausgeklappter Fahrverlauf: pinke Linie endet am Abschnitt, der schraege
     Uebergang fuehrt zur blauen Verlaufs-Linie (rtlast weiter unten gewinnt). */
  .rtrail .rtopen .rtleg { bottom: 0; }
  .rtrail .rtlast .rtleg { bottom: 10px; }
  /* v1.6.6 Lueckenlose Kette: Die Leiste jedes Folge-Abschnitts stoesst an das
     Leisten-ENDE ihres Vorgaengers (10 px ueber dessen Rand), versteckt unter
     dem dortigen Quer-Strich: nach einem Bus-/Bahn-Abschnitt (Rand 2 px bzw.
     6 px zur Bus-/Bahn-Folge) und vor einem Bus-/Bahn-Abschnitt an die Spitze
     des Zubringer-Ueberhangs. Der Strahl verlaeuft damit abschnittsueber-
     greifend physisch als EINE Linie, ohne dass zwischen den Leisten nur die
     dahinterliegende duenne Gesamt-Linie (rtspine) die Verbindung haelt; die
     weichen Farbuebergaenge der rtspine bleiben dahinter unberuehrt */
  .rtrail .routesec.rtjny + .routesec:not(.rtjny) .rtleg { top: -12px; }
  .rtrail .routesec.rtjny + .routesec.rtjny .rtleg { top: -16px; }
  .rtrail .routesec:not(.rtjny) + .routesec.rtjny .rtleg { top: -6px; }
  .rtrail .rfill { position: absolute; left: 0; top: 0; width: 3px; height: 0;
    border-radius: 2px; background: #ec4899; transition: height 1s linear; }
  .rtrail .rtc { position: absolute; left: 6.5px; width: 10px; height: 10px; border-radius: 50%;
    background: #0b1222; border: 2px solid #ec4899; box-sizing: border-box; z-index: 3; }
  .rtrail .rtc.rttop { top: 5px; }
  .rtrail .rtc.rtbot { bottom: 5px; }
  /* Übergangs-Strich (v1.3.12; v1.6.6 mittig): Fuß-/Fahrrad-/Roller-Übergänge
     bekommen keinen Kreis am Hauptstrang, sondern nur einen kleinen Anschluss-
     Strich horizontal MITTIG auf dem Strahl, exakt so lang wie die Ring-
     Durchmesser, auf der Hoehe der Ringmitten (der Punkt laeuft dort durch) */
  .rtrail .rtlnk { position: absolute; left: 6.5px; top: 9px; width: 10px; height: 3px;
    border-radius: 2px; background: #ec4899; z-index: 3; }
  /* v1.5.6: Bus-/Bahn-Abschnitte im Strang: Die Abfahrts-Station traegt einen
     kurzen BLAUEN Querstrich, seit v1.6.6 horizontal mittig auf dem Strahl und
     exakt so lang wie die Stations-Kreise (dort sass frueher der lila Knopf),
     die Anastation seit v1.6.5 ebenfalls einen BLAUEN (vorher hellrot); die
     Abschnitts-Leiste laeuft dazwischen in
     Dunkelblau, und der GPS-Fortschritt fuellt sie stationssynchron in
     Hellblau auf: In aufgeklappten Verlaeufen erreicht der Strahl jeden
     Stationskreis genau dann, wenn die Fahrt den Halt geometrisch passiert,
     und aktiviert ihn dabei (.rtpass, Kreis hellblau gefuellt). Der rosa
     Ziel-Ring (rtbot) bleibt Kreis; auf- und einklappen tut die Linien-Zeile
     selbst (blaues Linien-Schild + Richtungstext antippen). */
  .rtrail .rtline { position: relative; }
  .rtrail .routesec.rtjny .rtleg { background: #1e3a5f; bottom: 10px; }
  .rtrail .routesec.rtjny .rfill { background: #7dd3fc; }
  .rtrail .rtdep { position: absolute; left: 6.5px; top: 9px; width: 10px; height: 3px;
    border-radius: 2px; background: #38bdf8; z-index: 3; }
  .rtrail .rtal { position: absolute; left: 6.5px; bottom: 9px; width: 10px; height: 3px;
    border-radius: 2px; background: #38bdf8; z-index: 3; }
  .trip .trow.rtpass::after { background: #7dd3fc; border-color: #7dd3fc;
    box-shadow: 0 0 0 3px rgba(125, 211, 252, .35); }
  /* Eingebetteter Verlauf: Der Trip-Block liegt INNERHALB des Abschnitts (zwischen
     Linien-Zeile und Anastation); der negative Rand haelt die blauen Stations-Kreise
     exakt ueber dem pinken Strang (gleiche X-Koordinaten wie zuvor) */
  .rtrail .routesec .trip { margin-left: -30px; }
  .rtrail .rtdot { position: absolute; left: 6.5px; top: 0; width: 10px; height: 10px;
    border-radius: 50%; background: #f472b6; display: none; z-index: 2;
