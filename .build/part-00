  if (!f || !c) return;
  f.nahsh = { name: c.name, lid: c.lid, type: c.type || "A",
    lat: c.lat != null ? c.lat : null, lon: c.lon != null ? c.lon : null };
  saveAddrFavs(); renderAddrFavs();
  const d = favNahshDist(f);
  favNahshSt.note = "NAH.SH-Eintrag übernommen." +
    (d != null && d > 100 ? " ⚠ Abstand zur OSM-Adresse: " + formatDist(d) + "." : "");
