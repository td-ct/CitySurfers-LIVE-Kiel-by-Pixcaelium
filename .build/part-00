// ---------- Koordinaten, Locator & Karten-Links erkennen (viele Formate) ----------
// Akzeptiert: Dezimalgrad (54.32, 10.13 / 54,3232 10,135 / N54.32 E10.13),
// Grad/Minuten/Sekunden (54°19'18"N 10°08'06"E), Maidenhead-/QTH-Locator (JO49sk),
// Plus Codes (OLC, auch kurz mit Kiel-Bezug), geo:-URIs sowie Links von Google Maps,
// Apple Karten, Bing, OpenStreetMap, HERE und Yandex.
function mkPos(lat, lon, label) {
  lat = Number(lat); lon = Number(lon);
  if (!isFinite(lat) || !isFinite(lon) || Math.abs(lat) > 90 || Math.abs(lon) > 180) return null;
  return { lat, lon, label: label + " " + lat.toFixed(5) + ", " + lon.toFixed(5) };
}
function dmsVal(d, m, s) {
  return Number(d) + (Number(m) || 0) / 60 + (Number(s) || 0) / 3600;
}
function decodeMaidenhead(mh) {
  const s = mh.toUpperCase();
  if (!/^[A-R]{2}\d{2}(?:[A-X]{2}(?:\d{2})?)?$/.test(s)) return null;
  const A = c => c.charCodeAt(0) - 65;
  let lon = A(s[0]) * 20 - 180, lat = A(s[1]) * 10 - 90;
  lon += Number(s[2]) * 2; lat += Number(s[3]);
  if (s.length >= 6) { lon += (s.charCodeAt(4) - 65) * 5 / 60; lat += (s.charCodeAt(5) - 65) * 2.5 / 60; }
  if (s.length === 8) { lon += Number(s[6]) * 5 / 1440; lat += Number(s[7]) * 2.5 / 1440; }
  // Mittelpunkt des Rasters
  if (s.length === 4) { lon += 1; lat += 0.5; }
  else if (s.length === 6) { lon += 5 / 120; lat += 2.5 / 120; }
  else { lon += 5 / 2880; lat += 2.5 / 2880; }
  return { lat, lon, label: "Locator " + s };
}
function decodeOLC(code) {
  const base = "23456789CFGHJMPQRVWX";
  let c = code.toUpperCase().replace(/\s/g, "");
  const plus = c.indexOf("+");
  if (plus < 0) return null;
  c = c.replace(/\+/g, "");
  if (c.length < 2 || c.length % 2 || c.length > 10) return null;
  // kurzer Code (z. B. "84V2+XQ"): Bezug Kiel (9F6G …) voranstellen
  if (plus < 8) c = "9F6G".slice(0, 8 - plus) + c;
  const res = [20, 1, 0.05, 0.0025, 0.000125];
  let lat = -90, lon = -180;
  const pairs = c.length / 2;
  for (let i = 0; i < pairs; i++) {
    const dl = base.indexOf(c[2 * i]), dg = base.indexOf(c[2 * i + 1]);
    if (dl < 0 || dg < 0) return null;
    lat += dl * res[i]; lon += dg * res[i];
  }
  return { lat: lat + res[pairs - 1] / 2, lon: lon + res[pairs - 1] / 2,
           label: "Plus Code " + code.trim() };
}
function parseCoordPair(t) {
  // Grad/Minuten/Sekunden, gemischt mit Dezimalminuten/-sekunden
  const dms = t.match(/^\s*([NSns])?\s*(\d{1,3})(?:[°d:\s]+(\d{1,2}(?:[.,]\d+)?))?(?:['m′\s:]+(\d{1,2}(?:[.,]\d+)?))?["s″]?\s*([NSns])?\s*[,;\/]?\s*([EWew])?\s*(\d{1,3})(?:[°d:\s]+(\d{1,2}(?:[.,]\d+)?))?(?:['m′\s:]+(\d{1,2}(?:[.,]\d+)?))?["s″]?\s*([EWew])?\s*$/);
  if (dms) {
    let lat = dmsVal(dms[2], dms[3], dms[4]);
    let lon = dmsVal(dms[7], dms[8], dms[9]);
    if ((dms[1] || dms[5] || "").toUpperCase() === "S") lat = -lat;
    if ((dms[6] || dms[10] || "").toUpperCase() === "W") lon = -lon;
    if (Math.abs(lat) > 90 && Math.abs(lon) <= 90) { const x = lat; lat = lon; lon = x; }
    return mkPos(lat, lon, "Koordinaten");
  }
  // Dezimalgrad-Paar mit Komma/Semikolon/Leerzeichen oder Himmelsrichtung
  const dec = t.match(/^\s*([NSns])?\s*(-?\d{1,3}[.,]\d+)\s*°?\s*([NSns])?\s*[,;\/\s]\s*([EWew])?\s*(-?\d{1,3}[.,]\d+)\s*°?\s*([EWew])?\s*$/);
  if (dec) {
    let lat = Number(dec[2].replace(",", "."));
    let lon = Number(dec[5].replace(",", "."));
    if ((dec[1] || dec[3] || "").toUpperCase() === "S") lat = -lat;
    if ((dec[4] || dec[6] || "").toUpperCase() === "W") lon = -lon;
    if (Math.abs(lat) > 90 && Math.abs(lon) <= 90) { const x = lat; lat = lon; lon = x; }
    return mkPos(lat, lon, "Koordinaten");
  }
  return null;
}
function parseMapsUrl(t) {
  if (!/https?:\/\/|\bwww\./i.test(t)) return null;
  t = t.replace(/%2C/gi, ",");   // URL-kodiertes Komma (z. B. Yandex ll=)
  const n = "(-?\\d{1,3}\\.\\d+)";
  const yandex = /yandex\./i.test(t);
  const pats = [
    [new RegExp("[?&]q=" + n + "\\s*,\\s*" + n), false],         // Google ?q=lat,lng
    [new RegExp("[?&]ll=" + n + "\\s*,\\s*" + n), yandex],       // Apple ll=lat,lng / Yandex ll=lon,lat
    [new RegExp("[?&]cp=" + n + "\\s*~\\s*" + n), false],        // Bing cp=lat~lng
    [new RegExp("[?&]mlat=" + n + "[^0-9-]+mlon=" + n), false],  // OSM mlat/mlon
    [/#map=\d+\/(-?\d{1,3}\.\d+)\/(-?\d{1,3}\.\d+)/, false],     // OSM #map=z/lat/lon
    [new RegExp("[?&]map=" + n + "\\s*,\\s*" + n), false],       // HERE map=lat,lng
    [/!3d(-?\d{1,3}\.\d+)!4d(-?\d{1,3}\.\d+)/, false],           // Google !3dlat!4dlng
    [/@(-?\d{1,3}\.\d+),\s*(-?\d{1,3}\.\d+)/, false],            // Google/Apple @lat,lng
    [new RegExp(n + "\\s*,\\s*" + n), false],                    // generisch: erstes Zahlenpaar
  ];
  for (const [re, swapped] of pats) {
    const m = t.match(re);
    if (!m) continue;
    const a = Number(m[1]), b = Number(m[2]);
    let lat = swapped ? b : a, lon = swapped ? a : b;
    if (Math.abs(lat) > 90 && Math.abs(lon) <= 90) { const x = lat; lat = lon; lon = x; }
    return mkPos(lat, lon, "Karten-Link");
  }
  return null;
}
function parseLocText(raw) {
  const t = (raw || "").trim();
  if (t.length < 3 || t.length > 2000) return null;
  // geo:-URI
  const geo = t.match(/^geo:(-?\d{1,3}(?:[.,]\d+)?),(-?\d{1,3}(?:[.,]\d+)?)/i);
  if (geo) {
    const p = mkPos(geo[1].replace(",", "."), geo[2].replace(",", "."), "geo:");
    if (p) return p;
  }
  // Maidenhead-/QTH-Locator (JO49, JO49sk, JO49sk55)
  const mh = t.match(/^\s*([A-Ra-r]{2}\d{2}(?:[A-Xa-x]{2}(?:\d{2})?)?)\s*$/);
  if (mh) { const d = decodeMaidenhead(mh[1]); if (d) return mkPos(d.lat, d.lon, d.label); }
  // Plus Code / OLC ("9FCGJ3V2+XQ" oder kurz "J3V2+XQ", Bezug Kiel)
  const olc = t.match(/\b([23456789CFGHJMPQRVWXcfghjmpqrvwx]{2,8}\+[23456789CFGHJMPQRVWXcfghjmpqrvwx]{0,6})\b/);
  if (olc) { const d = decodeOLC(olc[1]); if (d) return mkPos(d.lat, d.lon, d.label); }
  // Karten-Links (Google, Apple, Bing, OSM, HERE, Yandex)
  const url = parseMapsUrl(t);
  if (url) return url;
  // Koordinatenpaar (Dezimal oder Grad/Min/Sek)
  return parseCoordPair(t);
}

// OSM-Normalform für Adressen (der „Atlas" ist Nominatim/OSM): „Straße Hausnummer,
// PLZ Ort" bzw. bei POIs „Name, Straße Hausnummer, PLZ Ort". Diese Normalform wird
// als Label gespeichert, angezeigt, als Suchtext an NAH.SH-LocMatch übergeben und
// als Name (O=) in die NAH.SH-Koordinaten-lid eingebettet. Ohne addressdetails
// (leeres address-Objekt) greift der alte Fallback: erste 3 display_name-Teile.
function nomLabel(x) {
  const a = (x && x.address) || {};
  const road = a.road || a.pedestrian || a.footway || a.residential || "";
  const hnr = a.house_number || (x && x.housenumber) || "";
  let nm = String((x && x.name) || "").trim();
  if (/^\d+[a-zA-Z]?$/.test(nm)) nm = "";   // „name" ist nur die Hausnummer, kein POI-Name
  const cityRaw = a.city || a.town || a.village || a.municipality || "";
  const city = (nm && cityRaw.toLowerCase() === nm.toLowerCase()) ? "" : cityRaw;
  const pc = a.postcode || "";
  let core = "";
  if (nm && road && hnr) core = nm + ", " + road + " " + hnr;
  else if (road && hnr) core = road + " " + hnr;
  else if (nm) core = nm;
  else if (road) core = road;
  if (!core)   // keine addressdetails: alter Fallback
    return String((x && x.display_name) || "").split(",").map(t => t.trim())
      .filter(Boolean).slice(0, 3).join(", ");
  const tail = [pc, city].filter(Boolean).join(" ");
  return tail ? core + ", " + tail : core;
}
// ---------- Einheitliche Adresssuche: Nominatim/OSM + NAH.SH parallel ----------
// Beide Kataloge werden je Suchanfrage gleichzeitig befragt und die Treffer
// zusammengeführt. Derselbe Ort in beiden Katalogen (gleiche Hausnummer und
// ≤ 2 km Distanz, bzw. Straßenniveau ohne Hausnummer und ≤ 300 m) wird EIN
// Treffer mit beiden Quellen (📍🚌); weichen die Koordinaten voneinander ab
// (> 100 m), zeigt der Treffer den Abstand an, bleibt aber wählbar (Diskrepanz
// akzeptieren). Adressen, die nur in EINEM der beiden Kataloge existieren, sind
// eigene, ebenfalls wählbare Treffer (📍 nur OSM / 🚌 nur NAH.SH). Dieselbe
// Suche läuft in der Adresssuche, im Routen-Dialog (Adress-Picker) und im
// Favoriten-Bearbeiten.
let unifSeq = 0;
function addrStreetOf(s, last) {   // Straßennamen-Segment: OSM vorn, NAH.SH hinten
  const parts = String(s || "").split(",").map(p => p.trim()).filter(Boolean);
  if (!parts.length) return "";
  return parts[last ? parts.length - 1 : 0].toLowerCase().replace(/\s+/g, " ");
}
function addrPairTest(osm, nsh) {   // derselbe Ort in beiden Katalogen?
  const d = dist(osm, nsh);
  const hO = hnrOfName(osm.label), hN = hnrOfName(nsh.name);
  if (hO && hN) return hO === hN && d <= 2000;   // gleiche Hausnummer, gleiche Stadt
  if (!hO && !hN)   // Straßenniveau: gleicher Straßenname und nah beieinander
    return d <= 300 && addrStreetOf(osm.label, false) === addrStreetOf(nsh.name, true);
  return false;   // verschiedene Granularität (z. B. Straße vs. Hausnummer): getrennt führen
}
function addrSrcBadge(r) {   // Quellen-Kennzeichnung eines Suchtreffers
  if (r.src === "both") return (r.dPair != null && r.dPair > 100)
    ? "📍🚌 ⚠ " + formatDist(r.dPair) + " Abstand" : "📍🚌 beide Kataloge";
  return r.src === "nahsh" ? "🚌 nur NAH.SH" : "📍 nur OSM";
}
async function unifiedAddrSearch(q) {
  const seq = ++unifSeq;
  let osmL = [];
  try {   // Katalog 1: OSM/Nominatim (Normalform-Label), Photon als Not-Fallback
    const res = await apiFetch("nom", NOMINATIM + "?q=" + encodeURIComponent(q) +
      "&format=jsonv2&addressdetails=1&limit=5&accept-language=de&countrycodes=de");
    if (res.ok) {
      const list = await res.json();
      osmL = (Array.isArray(list) ? list : []).map(r => ({
        label: nomLabel(r), lat: Number(r.lat), lon: Number(r.lon),
        type: r.type || r.category || "" }));
    }
  } catch (e) {}
  if (seq !== unifSeq) return null;
  if (!osmL.length) {
    try {
      const res = await apiFetch("nom", PHOTON + "?q=" + encodeURIComponent(q) +
        "&limit=5&lang=de&lat=54.32&lon=10.13");
      if (res.ok) {
        const data = await res.json();
        const seen = new Set();
        osmL = (data.features || []).map(f => {
          const pr = f.properties || {};
          const label = [pr.street || pr.name, pr.housenumber].filter(Boolean).join(" ") +
            (pr.postcode ? ", " + pr.postcode : "") + (pr.city ? " " + pr.city : "");
          return { label, lat: f.geometry.coordinates[1], lon: f.geometry.coordinates[0],
            type: pr.osm_value || "" };
        }).filter(r => {
          const key = r.label + "|" + String(r.lat).slice(0, 5);
          if (seen.has(key)) return false;
          seen.add(key); return true;
        }).slice(0, 5);
      }
    } catch (e) {}
  }
  if (seq !== unifSeq) return null;
  let nshL = [], nahshErr = false;
  try {   // Katalog 2: NAH.SH-LocMatch, Adressen (A) und POIs (P)
    const res = await routeHafas("LocMatch", { input: { field: "S", loc: { name: q, type: "ALL" } } });
    const seen = new Set();
    for (const x of ((res.match && res.match.locL) || [])) {
      if (!x.lid || !x.name || (x.type !== "A" && x.type !== "P")) continue;
      if (seen.has(x.lid)) continue;
      seen.add(x.lid);
      const crd = x.crd || {};
      nshL.push({ name: x.name, lid: x.lid, type: x.type,
        lat: crd.y != null ? crd.y / 1e6 : null, lon: crd.x != null ? crd.x / 1e6 : null });
    }
  } catch (e) { nahshErr = true; }
  if (seq !== unifSeq) return null;
  const out = [], used = new Set();
  for (const o of osmL) {   // OSM-Treffer, mit passendem NAH.SH-Treffer gemergt
    let bi = -1, bd = 1e12;
    nshL.forEach((n, i) => {
      if (used.has(i) || n.lat == null) return;
      if (addrPairTest(o, n)) { const d = dist(o, n); if (d < bd) { bd = d; bi = i; } }
    });
    if (bi >= 0) {
      used.add(bi);
      const n = nshL[bi];
      out.push({ label: o.label, lat: o.lat, lon: o.lon, osmLat: o.lat, osmLon: o.lon,
        type: o.type, src: "both", dPair: bd,
        nahsh: { name: n.name, lid: n.lid, type: n.type, lat: n.lat, lon: n.lon } });
    } else {
      out.push({ label: o.label, lat: o.lat, lon: o.lon, osmLat: o.lat, osmLon: o.lon,
        type: o.type, src: "osm", dPair: null, nahsh: null });
    }
  }
  let extra = 0;
  const ref = osmL.length ? osmL[0] : null;   // Bezugs­punkt: erster OSM-Treffer
  nshL.forEach((n, i) => {   // nur in NAH.SH vorhandene Adressen (max. 3 zusätzliche)
    if (used.has(i) || n.lat == null || extra >= 3) return;
    if (ref && dist(ref, n) > 50000) return;   // NAH.SH-Rauschen aus anderen Städten ausblenden
    out.push({ label: n.name, lat: n.lat, lon: n.lon, osmLat: null, osmLon: null,
      type: n.type === "P" ? "poi" : "", src: "nahsh", dPair: null,
      nahsh: { name: n.name, lid: n.lid, type: n.type, lat: n.lat, lon: n.lon } });
    extra++;
  });
  return { list: out, nahshErr: nahshErr };
}
// Ersten Treffer der einheitlichen Suche als Auflösung übernehmen (z. B. „Übernehmen“
// im Favoriten-Dialog, ohne vorher einen Treffer angetippt zu haben)
async function unifiedResolveOne(q) {
  const u = await unifiedAddrSearch(q);
  if (!u || !u.list.length) return null;
  const e = u.list[0];
  return { label: e.label, lat: Number(e.lat), lon: Number(e.lon),
    osmLat: e.osmLat != null ? Number(e.osmLat) : null,
    osmLon: e.osmLon != null ? Number(e.osmLon) : null,
    nahsh: e.nahsh || null, src: e.src, dPair: e.dPair != null ? e.dPair : null };
}
let addrSeq = 0;   // Race-Guard: nur die zuletzt angefragte Eingabe darf rendern
async function searchAddress(q) {
  const seq = ++addrSeq;
  addrResults = [];
  // einheitliche Suche: Nominatim/OSM + NAH.SH parallel, gemergte Treffer
  const u = await unifiedAddrSearch(q);
  if (!u || seq !== addrSeq) return;   // inzwischen wurde schon wieder gesucht
  addrResults = u.list.map(r => ({ ...r, lat: String(r.lat), lon: String(r.lon) }));
  // Favoriten (Alias und Adresse) mit durchsuchen: Treffer oben, vor den allgemeinen
  // Orten. Mehrwort-Suche: jedes Wort muss in Alias ODER Adresse vorkommen.
  const qls = q.toLowerCase().split(/\s+/).filter(Boolean);
  let favHits = addrFavs.filter(f => qls.every(w =>
    (f.name || "").toLowerCase().includes(w) || (f.label || "").toLowerCase().includes(w)));
  const favOrigin = sortGpsOrigin("addrFav");
  if (favOrigin) favHits = favHits.slice()
    .sort((a, b) => dist(favOrigin, a) - dist(favOrigin, b));
  if (!addrResults.length && !favHits.length) {
    addrSug.innerHTML = '<div><span>keine passende Adresse gefunden</span></div>';
    addrSug.hidden = false;
    return;
  }
  let html = favHits.map(f => {
    const i = addrFavs.indexOf(f);
    return '<div data-favsel="' + i + '" class="favhit" title="Adressfavorit als Standort übernehmen">' +
      '<span>⭐ ' + escapeHtml(f.name) + '</span>' +
      '<span class="atype">' + escapeHtml(f.label || "") + '</span></div>';
  }).join("");
  if (favHits.length && addrResults.length) html += '<hr class="sugsep" />';
  html += addrResults.map((r, i) => {
    const isFav = addrFavs.some(f =>
      f.label === r.label && f.lat === Number(r.lat) && f.lon === Number(r.lon));
    return '<div data-addr="' + i + '"><span>' + escapeHtml(r.label) + "</span>" +
      routeIconHTML({ lat: Number(r.lat), lon: Number(r.lon) }, "Diese Adresse an eine externe Karten-App übergeben (z. B. Google Maps)") +
      '<button class="star' + (isFav ? "" : " off") + '" data-afav="' + i +
      '" title="Adresse als Favorit speichern bzw. entfernen">★</button>' +
      '<span class="atype">' + escapeHtml(addrSrcBadge(r)) +
      (r.type ? " · " + escapeHtml(r.type) : "") + '</span></div>';
  }).join("");
  if (u.nahshErr) html += '<div><span class="atype">NAH.SH-Abgleich gerade nicht erreichbar – nur OSM-Treffer.</span></div>';
  addrSug.innerHTML = html;
  addrSug.hidden = false;
}

addrSug.addEventListener("click", e => {
  if (e.target.closest(".ricon")) return;   // Route-Icon: oeffnet nur den Routing-Link
  const st = e.target.closest("[data-afav]");
  if (st) {
    const r = addrResults[Number(st.dataset.afav)];
    if (!r) return;
    const fav = { name: r.label, lat: Number(r.lat), lon: Number(r.lon), label: r.label,
      osmLat: r.osmLat != null ? r.osmLat : (r.src === "nahsh" ? null : Number(r.lat)),
      osmLon: r.osmLon != null ? r.osmLon : (r.src === "nahsh" ? null : Number(r.lon)),
      osmNone: r.src === "nahsh",
      nahsh: r.nahsh || null };
    const idx = addrFavs.findIndex(f => f.label === fav.label && f.lat === fav.lat && f.lon === fav.lon);
    if (idx >= 0) addrFavs.splice(idx, 1);
    else addrFavs.push(fav);
    saveAddrFavs();
