// Sichtbares Sicherheitsnetz: Ungefangene JS-Fehler (z. B. in Klick-Handlern oder
// asynchronen Fortsetzungen) landen sonst unsichtbar im Konsolen-Log und äußern
// sich nur als „geöffnet, aber kein Inhalt“. Einmal pro Fehlersignatur anzeigen.
const _errShown = {};
window.addEventListener("error", e => {
  try {
    const sig = String(e && e.message || e);
    if (_errShown[sig]) return;
    _errShown[sig] = 1;
    setLocNote("⚠️ Interner Fehler: " + sig.slice(0, 140) + " – ↻/Neu laden hilft meist. (Meldung einmalig, Details im Protokoll)");
  } catch (x) {}
});
