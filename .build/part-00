// Senden-Ziel (Android-Share/Teilen): Text im Adressfeld eintragen und prüfen
// Von der Android-App aufgerufen (Teilen-Ziel der App, ACTION_SEND): Der geteilte
// Text (Adresse, Koordinaten, Locator oder Karten-Link) wird als ZIEL in den
// Routen-Dialog übernommen – der Dialog öffnet direkt, danach bedient man die
// App wie gewohnt (Start wählen bzw. GPS nehmen und Route suchen).
window.kvgImportLocation = function (text) {
  try {
    const q = String(text || "").trim().slice(0, 500);
    if (!q) return "empty";
    // Koordinaten/Locator/geo:-URI/Karten-Link: lokal erkannt, direkt übernehmen
    const loc = parseLocText(q);
    if (loc) {
      shareRouteDest({ label: loc.label, name: loc.label, lat: loc.lat, lon: loc.lon });
      return "ok";
    }
    shareSearchAddr(q);   // als Adresse suchen (asynchron), erstes/fallback-Ergebnis wird Ziel
    return "pending";
  } catch (e) { return "error"; }
};
// Geteilten Text als Adresse auflösen und als Route-Ziel übernehmen:
// erst Nominatim (Photon-Fallback wie bei der Adresssuche), dann NAH.SH-LocMatch
// (deckt auch Haltestellen/POIs ab). Ohne Treffer: Hinweis, Dialog bleibt zu.
async function shareSearchAddr(q) {
  setLocNote("Prüfe geteilte Adresse …");
  let hit = null;
  try {
    const res = await apiFetch("nom",
      NOMINATIM + "?q=" + encodeURIComponent(q) + "&format=jsonv2&addressdetails=1&limit=5&accept-language=de&countrycodes=de");
    if (res.ok) {
      const r = await res.json();
      const x = (Array.isArray(r) ? r : [])[0];
      if (x && x.lat != null) {
        const label = nomLabel(x);
        hit = { label: label, name: label, lat: Number(x.lat), lon: Number(x.lon) };
      }
    }
  } catch (e) {}
  if (!hit) {
    try {
      const res = await routeHafas("LocMatch", { input: { field: "S", loc: { name: q, type: "ALL" } } });
      const locL = (res.match && res.match.locL) || [];
      const b = locL.find(x => x.lid);
      if (b) hit = { label: b.name, name: b.name, lid: b.lid, locType: b.type || "A",
        lat: b.crd ? b.crd.y / 1e6 : null, lon: b.crd ? b.crd.x / 1e6 : null };
    } catch (e) {}
  }
  if (!hit) {
    setLocNote("Geteilten Text nicht als Adresse erkannt: „" + q.slice(0, 60) + "“.");
    return;
  }
  shareRouteDest(hit);
}
