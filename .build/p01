        (en.a.paused ? "Wecker wieder aktivieren" : "Wecker deaktivieren (läutet nicht mehr)") + '">' +
        (en.a.paused ? "▶" : "⏸") + "</button>";
    btns += '<button class="afbtn" data-adele="' + escapeHtml(en.aKey) + '" title="Wecker entfernen">✗</button>';
    return '<div class="alrow" data-akey="' + escapeHtml(en.aKey) + '" title="Zum Reiter wechseln">' +
