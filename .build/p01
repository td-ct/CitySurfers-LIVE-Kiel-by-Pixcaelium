    if (fT == null) return;
    el.style.height = (Math.max(0, Math.min(1, fT)) * 100) + "%";
  });
  if (!dot) return;
  if (pos) {
    // Punkt rein geometrisch ueber die GESAMTE Route (routeDotBest): Der
    // Fortschritts-Zustand pr (Balkenfuellung, Committen) bleibt davon
    // unberuehrt; der Punkt selbst braucht keine Zeit-Plausibilitaet.
    // Aufruf mit laufendem Abschnitt (Kleberei am Umstieg) und
    // Erweiterungs-Stationen fuer aufgeklappte Laeufe: Die Punkt-Laufbahn rechnet dann ueber
    // den ganzen Lauf, passend zu den sichtbaren Zeilen.
    const best = routeDotBest(rc.con.secs, pos, pr.cur != null ? pr.cur : null,
      si => {
        const s2 = rc.con.secs[si];
        return (rc.secOpen && rc.secOpen[si] && s2 && s2.extStops && s2.extStops.length) ? s2.extStops : null;
      });
    if (best) {
      if (best.d > TRIP_DOT_MAX_M) routeDotFar = true;    // unrealistisch weit weg
