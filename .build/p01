    Math.round((c.depAbsMs - c.depAbsMsP) / 60000) : null;   // Echtzeit-Verspaetung der Verbindung selbst
  let watch = null;
  try { const w = sztSecWatch(fj, fj.stops, false, null, null); if (w && w.delay != null) watch = w.delay; } catch (e) {}
