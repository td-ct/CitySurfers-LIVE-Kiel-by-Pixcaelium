// ---------- Immer nur EINE der beiden Listen (Adressen / Haltestellen) offen ----------
// Adressvorschläge, Adressfavoriten, Haltestellenliste und Haltestellenfavoriten
// schließen sich gegenseitig: Öffnet man eine Liste, klappt automatisch jede
// andere ein. Der hidden-Zugriff läuft dafür über einen Setter auf dem Element –
// alle bestehenden Stellen im Code (Öffnen, Schließen, Toggle) bleiben unverändert.
function exclList(el, others) {
  let v = el.hidden;
  Object.defineProperty(el, "hidden", {
    get() { return v; },
    set(x) {
      v = !!x;
      if (!v) for (const o of others) { if (o && !o.hidden) o.hidden = true; }
      if (v) el.setAttribute("hidden", ""); else el.removeAttribute("hidden");
    },
    configurable: true
  });
}
