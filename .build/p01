  }
  return { cur: (st.si != null && st.si < secs.length) ? st.si : null, frac: st.frac, fills: fills };
}

// ---------- Dot-Engines: setzen nur Stile, bauen kein Panel neu ----------
// ---------- Leuchtpunkt-Platzierung (rein geometrisch) ----------
// Ueber ALLE sichtbaren Stationspaare wird das Segment mit dem kleinsten
// Luftlinien-Abstand zur GPS-Position gesucht; zurueck kommen Segment-Index,
// Anteil darauf und der Abstand - unabhaengig davon, ob die Uhrzeit zu
// Fahrplan-, Echtzeit- oder Raum-Zeit-Werten passt. Genau dann rueckt der
// Punkt naemlich nach: Passt keine Zeit (das Abhaken bleibt in dem Fall
// aus), zeigte er frueher stur am Anfangs-Abschnitt haengend; jetzt steht
// er dort, wo du wirklich bist.
function dotSegBest(pos, segs) {   // segs [{i0, i1|null, a, b|null}] -> {i0, i1, f, d, pos, amb}|null
  const cand = [];
