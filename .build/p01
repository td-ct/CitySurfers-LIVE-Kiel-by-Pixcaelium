  if (mPos) {
    for (const x of tstops) {
      const st = stops.find(s => s.shortName === x.shortName);
      if (st && dist(mPos, st) < mR) { gpsSn = x.shortName; break; }
    }
  }
  {
    const n0 = new Date(), nowMin0 = n0.getHours() * 60 + n0.getMinutes();
    for (const x of tstops) {
      const t = x.actualTime || x.time || x.plannedTime || "";
      const [h, m] = t.split(":").map(Number);
      if (isFinite(h) && isFinite(m) && h * 60 + m >= nowMin0 - 1) { nextSn = x.shortName; break; }
    }
  }
