function renderStopFavs() {
  if (stopFavCount) stopFavCount.textContent = favs.length;
  if (stopFavPanel.hidden) return;
  const origin = sortGpsOrigin("stopFav");   // hinterlegter GPS-Standort oder aktuelle Position
  let inner = '<div class="afshead">' +
    '<button class="chip afbtn" id="stopFavGps" title="GPS-Standort für diese Liste übernehmen und Haltestellenfavoriten nach Abstand sortieren">📍 GPS</button>' +
    (sortGps.stopFav
      ? '<button class="afbtn" id="stopFavGpsClr" title="Gespeicherten GPS-Standort löschen – sortiert wieder nach aktueller Position">✕ GPS</button>'
      : '') +
    '<span class="dim">' + (sortGps.stopFav
      ? 'Sortierung: gespeicherter GPS-Standort (±' + sortGps.stopFav.acc + ' m)'
      : 'Sortierung: aktuelle Position') + '</span></div>';
  if (!favs.length) {
    inner += '<div class="afsrow"><span class="afsname dim">Noch keine Haltestellenfavoriten. ' +
      "★ an einer Haltestelle antippen, um sie hier zu sichern.</span></div>";
  }
  const sns = favs.slice();
  if (origin) sns.sort((a, b) => {   // nächstgelegene Haltestelle zuerst
    const sa = stops.find(x => x.shortName === a), sb = stops.find(x => x.shortName === b);
    return (sa ? dist(origin, sa) : 1e12) - (sb ? dist(origin, sb) : 1e12);
  });
  sns.forEach(sn => {
    const s = stops.find(x => x.shortName === sn);
    const nn = nahshNameForStop(sn);
    inner += '<div class="afsrow" data-sfi="' + escapeHtml(sn) + '" title="Haltestelle öffnen">' +
      '<span class="afsname">🚏 ' + escapeHtml(s ? s.name : sn) +
        (s && origin ? ' <small class="dim">' + formatDist(dist(origin, s)) + '</small>' : '') +
        (nn ? '<br><small class="dim">NAH.SH: ' + escapeHtml(nn) + "</small>" : "") + "</span>" +
      (s ? routeIconHTML(s, "Diese Haltestelle an eine externe Karten-App übergeben (z. B. Google Maps)") : "") +
      '<button class="afbtn" data-fh="stop:' + escapeHtml(sn) + '" title="Finde nach Hause: Hinweise einstellen' +
        (fhStopCfg[sn] && fhStopCfg[sn].on ? ' (aktiv)' : '') + '">' +
        (fhStopCfg[sn] && fhStopCfg[sn].on ? "🏠" : "⌂") + "</button>" +
      '<button class="afbtn" data-sfdel="' + escapeHtml(sn) + '" title="Aus Favoriten entfernen">✗</button></div>';
  });
  stopFavPanel.innerHTML = inner;
  // NAH.SH-Namen der Favoriten einmalig im Hintergrund nachziehen (LocMatch mit
  // ≤ 150-m-Abgleich, danach 30 Tage im Cache) – die Zeile erscheint dann sofort
  const miss = favs.filter(sn => !isDB(sn) && !nahshLocCache[sn]);
  if (miss.length && Date.now() - (renderStopFavs._abg || 0) > 30000) {
    renderStopFavs._abg = Date.now();
    miss.forEach(sn => {
      const stop = stops.find(s => s.shortName === sn);
      if (stop) nahshLocFor(stop).then(() => { if (!stopFavPanel.hidden) renderStopFavs(); }).catch(() => {});
    });
  }
}
