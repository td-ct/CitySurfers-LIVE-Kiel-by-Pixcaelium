// v1.4.16: Alle Knöpfe der Leiste haben exakt die Breite der Knöpfe der obersten
// Zeile (--bbw in der .bigbtn-Regel); eine nicht ganz gefüllte Zeile sitzt mittig
// (justify-content: center). Gezaehlt wird, wie viele Knöpfe bei der Mindestbreite
// 64 px in eine Zeile passen; die gemeinsame Zeilenbreite ist dann die Breite JE KNOPFS.
function updateBigBtnsLayout() {
  const bb = document.getElementById("bigbtns");
  if (!bb || !bb.children.length) return;
  const W = bb.clientWidth;
  if (W <= 40) return;   // Layout noch nicht sichtbar oder unsinnig schmal
  const kids = bb.children.length;
  const perRow = Math.max(1, Math.min(kids, Math.floor((W + BB_GAP_PX) / (BB_MIN_PX + BB_GAP_PX))));
  bb.style.setProperty("--bbw", ((W - (perRow - 1) * BB_GAP_PX) / perRow).toFixed(2) + "px");
}
