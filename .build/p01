    // Fuellung folgt STATIONSSYNCHRON der Projektion (vollstaendig gefahrene
    // Abschnitte voll, kommende leer, der laufende exakt bis zur Position),
    // aufgeklappte Verlaeufe eingeschlossen, Rueckwaertsbewegung erwuenscht.
    // Die Zubringer-Wege behalten ihre pinke Fuellung aus routeProgress.
    if (y != null && geomOk) {   // v1.6.17: nur mit sicherer Geometrie; sonst bleibt der Zeit-Fortschritt (oder der Strahl ehrlich leer)
      const wt2 = wrapEl.getBoundingClientRect().top;
      wrapEl.querySelectorAll(".rfill[data-rsi]").forEach(el => {
        const si2 = Number(el.dataset.rsi);
        if (!rc.con.secs[si2] || rc.con.secs[si2].kind !== "jny") return;
        const leg2 = el.parentElement;
        if (!leg2) return;
        const legR2 = leg2.getBoundingClientRect();
        const top2 = legR2.top - wt2;
        let f2;
        if (si2 < best.si) f2 = 1;
        else if (si2 === best.si) f2 = (y - top2) / Math.max(1, legR2.height);
        else f2 = 0;
        const fT = geomOk ? null : rtTimeFrac(si2);   // v1.6.17: Zeit nur noch im unsicheren Fall, sonst reine GPS-Geometrie
        if (fT != null && fT > f2) f2 = fT;
        el.style.height = (Math.max(0, Math.min(1, f2)) * 100) + "%";
      });
    }
    // Leuchtpunkt und Stationskreise: nur wenn eine Position vorliegt UND die
    // Abstands-Hysterese ihn zulaesst - der Strahl laeuft trotzdem weiter.
    if (y != null && !routeDotFar) {
      // Farbübergang des Punkts: auf der pinken Route-Linie leuchtet er pink,
      // innerhalb eines ausgeklappten blauen Verlaufs färbt er sich blau
      // (die CSS-Transition blendet den Wechsel weich über)
      let inTrip = false;
      wrapEl.querySelectorAll(".trip").forEach(t => {
        const r = t.getBoundingClientRect();
        if (y >= r.top - wrapTop - 6 && y <= r.bottom - wrapTop + 6) inTrip = true;
      });
      // v1.5.6: Auf Bus-/Bahn-Abschnitten laeuft der Punkt auf dem neuen
      // blauen Strahl, deshalb leuchtet er dort immer hellblau (auch wenn der
      // Verlauf gerade eingeklappt und kein .trip-Block im Spiel ist)
      dot.classList.toggle("rtblue", inTrip ||
        !!(rc.con.secs[best.si] && rc.con.secs[best.si].kind === "jny"));
      dot.style.display = "";
      dot.style.top = (y - 5) + "px";
      rtPassCircles(wrapEl, y, best.si, geomOk ? null : tp);   // v1.6.17 Stationskreise + Verlaufs-Strahl: sichere Geometrie entscheidet allein
    } else { dot.style.display = "none"; rtPassCircles(wrapEl, null, null, tp); }
  } else { routeDotFar = false; dot.style.display = "none"; rtPassCircles(wrapEl, null, null, tp); }
}

