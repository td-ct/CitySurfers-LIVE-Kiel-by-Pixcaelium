    } else {
      d = dist(s.a, pos);
    }
    // pos = kontinuierliche Stations-Position im Index-Raum (i0 + Anteil Richtung i1)
    cand.push({ i0: s.i0, i1: s.i1, f: f, d: d, pos: (s.i1 != null && s.b) ? s.i0 + f : s.i0 });
