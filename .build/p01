// Zeigt alle gestellten Wecker mit Bedingung, Läut-Zeit und Restzeit; ein Klick
// auf einen Eintrag wechselt in den Reiter des Weckers. Ohne Wecker unsichtbar.
const alarmInd = document.getElementById("alarmInd");
