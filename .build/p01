function alarmRingEpoch(a) {
  if (a.leadMin == null) return null;
  const trip = tripById(a.tripId);
  let h = NaN, m = NaN;
  if (!trip) {   // Route-Wecker: Zeit direkt aus der gewaehlten Route
    const depMin = routeAlarmDepMin(a);
    if (depMin == null) return null;
    h = Math.floor(depMin / 60); m = depMin % 60;
  } else {
    const s = (trip.stops || []).find(x => x.shortName === a.sn);
    if (!s) return null;
    const key = s.key || (a.sn + "|" + trip.tripId);
    const dl = (trip.delay || {})[key] || {};
    const t = dl.plannedTime || dl.actualTime || s.time || s.plannedTime || "";
    const parts = t.split(":").map(Number);
    h = parts[0]; m = parts[1];
  }
  if (!isFinite(h) || !isFinite(m)) return null;
  const now = new Date();
  let depMs = new Date(now.getFullYear(), now.getMonth(), now.getDate(), h, m).getTime();
  if (depMs < Date.now() - 60000) depMs += 86400000;   // nachts: nächster Tag
  return depMs - a.leadMin * 60000;
}
// v1.6.35: Eigene Android-Nachricht der Eichhoernchen-Alarme (neben ⏰ gesamt
// und 🏠 fh-scan): eine Karte je Status, mit jedem Pruef-Update aktualisiert
// (still, Popup gibt es nur beim Ausloesen selbst). Ohne Alarme null -> Karte weg.
function packNativeEntry() {
  if (!packAlarms.length) return null;
  const now = Date.now();
  const lines = packAlarms.map(a => {
    const occ = packNextOcc(a);
    let s = a.line + " -> " + (a.dir || "?") + " · " +
      ((a.on || []).map((b, i) => b ? PACK_DAYS[i] : null).filter(Boolean).join(", ") || "kein Tag") +
      (occ ? " · nächste " + PACK_DAYS[occ.wd] + " " + occ.t + " Uhr" : "");
    if (a.lastMsg && a.lastMsgTs && now - a.lastMsgTs < 36 * 3600000) s += " · " + a.lastMsg;
    return s;
  });
  const ringN = packAlarms.filter(a => ringing.has(a.id)).length;
  return {
    key: "eichhoernchen",
    title: "🐿️ " + packAlarms.length + (packAlarms.length === 1 ? " Eichhörnchen-Alarm" : " Eichhörnchen-Alarme") +
      (ringN ? " · läutet!" : ""),
    text: lines.join("\n"),
    tab: ""
  };
}
function renderAlarmInd() {
  // Einträge einmal berechnen: für die Weckerliste und für die Android-
  // Benachrichtigungen (eine je Wecker, mit Sprung zum passenden Reiter)
  const entries = [];
  for (const [aKey, a] of alarms) {
    const isRing = ringing.has(aKey);
    let cond = a.leadMin != null
      ? a.leadMin + " min vor Abfahrt"
      : (a.dist >= 1000 ? a.dist / 1000 + " km" : a.dist + " m") + " Entfernung";
    if (isRing) cond = "läutet jetzt";
    else if (a.paused) cond += " (aus)";
    else if (a.dist && gpsState !== "on") cond += " · ⚠ ohne aktives GPS (◎ oben) misst kein Abstand mit";
    const ep = alarmRingEpoch(a);
    let when = "";
    if (ep != null && !isRing && !a.paused) {
      const d = new Date(ep);
      const mins = Math.round((ep - Date.now()) / 60000);
      const hh = String(d.getHours()).padStart(2, "0"), mm = String(d.getMinutes()).padStart(2, "0");
      when = " · klingelt " + hh + ":" + mm + " (in " + (mins > 0 ? mins + " min" : "jetzt") + ")";
    }
    entries.push({ aKey: aKey, a: a, cond: cond, when: when, ring: isRing });
  }
  // Läutende Wecker (ausgelöst, evtl. nativ im Hintergrund) zusätzlich anzeigen:
  // dort beendet 🔕 das Läuten, ohne den Reiter wechseln zu müssen
  for (const [aKey, r] of ringing) {
    if (alarms.has(aKey)) continue;
    entries.push({ aKey: aKey, a: { name: r.name || "Wecker", tabSn: "" },
      cond: "läutet jetzt", when: "", ring: true });
  }
  // In der App: EINE Sammel-Benachrichtigung je Wecker-Typ (⏰ gesamt, 🐿️ je
  // Status), laufend aktualisiert (auch leer: dann verschwindet sie). Tap oeffnet
  // den Reiter des naechsten Weckers. v1.6.35: Die Eichhoernchen-Alarme bekommen
  // ihre EIGENE Android-Nachricht (neben ⏰ wecker-gesamt und 🏠 fh-scan), die
  // mit jedem Pruef-Update aktualisiert wird; syncAlarms erwartet ALLE aktiven
  // Nachrichten in EINEM Array (fehlende keys werden geloescht).
  if (window.KvgNative) {
    const arr = [];
    if (entries.length) {
      const sorted = entries.slice().sort((a, b) => {
        const ea = a.ring ? 0 : (alarmRingEpoch(a.a) != null ? alarmRingEpoch(a.a) : Infinity);
        const eb = b.ring ? 0 : (alarmRingEpoch(b.a) != null ? alarmRingEpoch(b.a) : Infinity);
        return ea - eb;
      });
      // Action-Buttons der Benachrichtigung (max. 3): je Wecker lauten stoppen,
      // Distanz-Wecker deaktivieren/aktivieren, sonst loeschen
      const acts = [];
      for (const en of sorted.slice(0, 3)) {
        const a = en.a;
        if (en.ring || ringing.has(en.aKey)) acts.push({ akey: en.aKey, mode: "stop", label: "Stopp: " + (a.name || "Wecker") });
        else if (a.leadMin == null) acts.push(a.paused
          ? { akey: en.aKey, mode: "resume", label: "An: " + (a.name || "Wecker") }
          : { akey: en.aKey, mode: "pause", label: "Aus: " + (a.name || "Wecker") });
        else acts.push({ akey: en.aKey, mode: "delete", label: "Löschen: " + (a.name || "Wecker") });
      }
      arr.push({
        key: "wecker-gesamt",
        title: "⏰ " + entries.length + (entries.length === 1 ? " Wecker" : " Wecker") +
          (sorted[0].a.name ? " · nächster: " + sorted[0].a.name : ""),
        text: entries.map(en => en.a.name + " – " + en.cond + en.when).join("\n"),
        tab: sorted[0].a.tabSn || "",
        actions: acts
      });
