  const sameName = (x, t) => norm(x.name) === norm(t.name);
  const sameTime = (x, t) => {
    const pairs = [[x.dS, t.dS], [x.aS, t.dS], [x.dS, t.aS], [x.aS, t.aS]];
    return pairs.some(pr => pr[0] != null && pr[1] != null && pr[0] === pr[1]);
