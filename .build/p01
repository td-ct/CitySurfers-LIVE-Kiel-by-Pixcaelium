    let f = 0, d = null;
    if (s.b) {
      const t = segFrac(s.a, s.b, pos);
      if (t == null) continue;
      const proj = { lat: s.a.lat + (s.b.lat - s.a.lat) * t, lon: s.a.lon + (s.b.lon - s.a.lon) * t };
