    if (f != null) st.frac = Math.max(st.frac, Math.min(0.995, f));
    if (st.frac >= 0.995 || (to && dist(pos, to) <= 36)) {   // Abschnitt abgeschlossen
      st.done = Math.max(st.done, si);
      st.si = si + 1 < secs.length ? si + 1 : null;
      st.frac = 0;
    }
  }
  // kein laufender Abschnitt: Einstieg suchen (nah am Start oder im Verlauf)
  if (st.si == null || st.si >= secs.length) {
    for (let si = st.done + 1; si < secs.length; si++) {
      const pts = ptsOf(si);
      if (!pts) continue;
      const near = dist(pos, pts[0]) <= 120;
      const pr = polyFrac(pts, pos);
      const corr = secs[si].kind === "jny" ? (pr && pr.d <= 150) : (pr && pr.d <= 120);
