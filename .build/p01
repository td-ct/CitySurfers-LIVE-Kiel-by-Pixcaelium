// Route-Wecker (Glocke in der gewaehlten Route): Abfahrtszeit der Station
// direkt aus der Route suchen, Echtzeit vor Plan – dazu muessen Fahrtverlauf
// und tripById nichts wissen; gesucht wird in allen offenen Verbindungen nach
// dem Abschnitt (jid) und dem Stations-Namen.
function routeAlarmDepMin(a) {
  if (!a || !a.jid || a.rtName == null) return null;
  const norm = s => String(s || "").toLowerCase().replace(/[^a-z0-9äöüß]/g, "");
  const want = norm(String(a.rtName).replace(/\s*\(DB\)\s*$/, ""));
  for (const rc of routeChosen) {
    const con = rc && rc.con;
    if (!con) continue;
    for (const sec of con.secs || []) {
      if (!sec || sec.jid !== a.jid) continue;
      const sts = sec.stops || [];   // die Segment-Liste bleibt immer die Basis (Erweiterung nur Anzeige)
      for (const st of sts) {
        if (!st || norm(String(st.name).replace(/\s*\(DB\)\s*$/, "")) !== want) continue;
        const parts = (st.dR || st.dS || "").split(":").map(Number);
        if (parts.length < 2 || !isFinite(parts[0]) || !isFinite(parts[1])) return null;
        return parts[0] * 60 + parts[1];
      }
    }
  }
  return null;
}
function alarmDepMin(a) {
  const trip = tripById(a.tripId);
  if (!trip) return routeAlarmDepMin(a);   // Route-Wecker: kein Fahrverlauf noetig
  const s = (trip.stops || []).find(x => x.shortName === a.sn);
  if (!s) return null;
  const key = s.key || (a.sn + "|" + a.tripId);
  const dl = currentTrip.delay[key] || {};
  const t = (dl.plannedTime || dl.actualTime || s.time || s.plannedTime || "");
  const [h, m] = t.split(":").map(Number);
  return (isFinite(h) && isFinite(m)) ? h * 60 + m : null;
}
// Zeit der Station für den Wecker aktualisieren (KVG: Tafel der Station; DB: Fahrt neu)
async function pollAlarmStop(a) {
  if (!currentTrip || currentTrip.tripId !== a.tripId) return;
  const s = (currentTrip.stops || []).find(x => x.shortName === a.sn);
  if (!s) return;
  const key = s.key || (a.sn + "|" + a.tripId);
  if (isDB(currentTrip.sn)) { selectTrip(currentTrip.sn, a.tripId, true); return; }
  try {
    const res = await apiFetch("kvg", DEPART_URL, {
      method: "POST",
      headers: { "Content-Type": "application/x-www-form-urlencoded" },
      body: "stop=" + encodeURIComponent(a.sn)
    });
    if (!res.ok) return;
    const data = await res.json();
    const d = [...(data.actual || []), ...(data.oldActual || [])].find(x => x.tripId === a.tripId);
    if (!d || !d.plannedTime) return;
    const old = currentTrip.delay[key] || {};
    const actualTime = d.actualTime || old.actualTime || d.plannedTime;
    const [ph, pm] = d.plannedTime.split(":").map(Number);
    const [ah, am] = actualTime.split(":").map(Number);
    currentTrip.delay[key] = {
      plannedTime: d.plannedTime, actualTime,
      delayMin: (isFinite(ph) && isFinite(pm) && isFinite(ah) && isFinite(am))
        ? (ah * 60 + am) - (ph * 60 + pm) : null,
      ts: Date.now()
    };
  } catch (e) {}
}
function alarmTick() {
  syncNativeRinging();
  renderAlarmInd();
  if (alarmsOff) return;   // global aus: nichts auslösen (Wecker bleiben gestellt)
  if (!alarms.size) return;
  // Distanz-Wecker: NUR echte Live-Ortung (GPS an). Ohne GPS wuerde die
  // gespeicherte/letzte Position (eine eingefrorene Konstante!) falsch
  // messen: Der Abstand stimmt nie, der Wecker bleibt dauerhaft stumm.
  const pos = (gpsState === "on" && myPos) ? myPos : null;
  const nowD = new Date();
  const nowMin = nowD.getHours() * 60 + nowD.getMinutes();
  for (const [aKey, a] of [...alarms]) {
    if (a.paused) continue;   // deaktiviert: nicht prüfen, nicht läuten
    const stop = stops.find(x => x.shortName === a.sn) || dbStopOf(a.sn) ||   // KVG-Liste oder DB-Bahnhof
      (a.lat != null ? { lat: a.lat, lon: a.lon } : null);   // Route-Station: Koordinaten direkt aus der Route
    if (a.dist && pos && stop && dist(pos, stop) <= a.dist) { fireAlarm(aKey, a); continue; }
    if (a.leadMin != null) {
      if (Date.now() - (a.lastPoll || 0) > a.leadMin * 30000) {   // alle leadMin/2 Minuten
        a.lastPoll = Date.now();
        pollAlarmStop(a);
      }
      const depMin = alarmDepMin(a);
      if (depMin != null) {
        let d = depMin - nowMin;
        if (d < -720) d += 1440;
        if (d <= a.leadMin) { fireAlarm(aKey, a); continue; }
      }
    }
  }
}

