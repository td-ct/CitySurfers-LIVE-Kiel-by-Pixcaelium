      currentTrip.delay[key] = {
        plannedTime: planned, actualTime: actual,
        delayMin: (isFinite(ph) && isFinite(pm) && isFinite(ah) && isFinite(am))
          ? (ah * 60 + am) - (ph * 60 + pm) : null,
        ts: Date.now()
      };
      // geplante KVG-Fahrt: extId auf KVG-Station abbilden (klickbar, GPS, Wecker),
      // unbekannte Stationen (außerhalb des KVG-Bereichs / LID nicht im Cache)
      // bekommen die NAH.SH-Kennung – reine Anzeige, kein Klick.
      let snOut;
      if (kvgExt && kvgExt[String(loc.extId || "")]) snOut = kvgExt[String(loc.extId || "")];
      else snOut = loc.extId ? (kvgPlanned ? "NAH:" + loc.extId : "DB:" + loc.extId)
                             : (kvgPlanned ? "NAH:x" + idx : "DB:x" + idx);
      const kvgStop = kvgExt && kvgExt[String(loc.extId || "")]
        ? stops.find(x => x.shortName === kvgExt[String(loc.extId || "")]) : null;
      return {
        shortName: snOut,
        name: (kvgStop && kvgStop.name) || loc.name || "?", time: actual, isArr,
        // eigene Koordinaten je Station (v1.3.12): Damit der blaue Leuchtpunkt
        // und die 50-m-Fortschritt-Logik auch in NAH.SH-Laeufen (Zuege und
        // geplante KVG-Fahrten) kontinuierlich laufen koennen, und zwar ueber
        // JEDE Station, nicht nur ueber die bekannten DB-Bahnhoefe.
        lat: (loc.crd && loc.crd.y != null) ? loc.crd.y / 1e6 : null,
        lon: (loc.crd && loc.crd.x != null) ? loc.crd.x / 1e6 : null,
        status: (p.dTimeR || p.aTimeR) ? "PREDICTED" : "PLANNED",
        seq: idx, key
      };
    });
    currentTrip.loading = false;
  } catch (e) {
    currentTrip.loading = false;
    currentTrip.error = true;
  }
}

// ---------- Abfahrtsdaten ----------
const depCache = new Map(); // sn -> deps (bis globaler Reset)
async function getDepartures(sn) {
  if (depCache.has(sn)) return depCache.get(sn);
  if (isRS(sn)) {   // v1.5.0: Fern-Station: regionaler Live-Dienst, sonst nah.sh-Fallback
    const deps = await rsGetDepartures(sn);
    if (deps) { depCache.set(sn, deps); return deps; }
    return null;
  }
  if (isDB(sn)) {
    try {
      const r = await dbDepartures(sn);
      if (!r) return null;
      depCache.set(sn, r.deps);
      dbPlatformCache.set(sn, r.platforms);
      return r.deps;
    } catch (e) { return null; }
  }
  try {
    const res = await apiFetch("kvg", DEPART_URL, {
      method: "POST",
      headers: { "Content-Type": "application/x-www-form-urlencoded" },
      body: "stop=" + encodeURIComponent(sn)
    });
    if (!res.ok) throw new Error("HTTP " + res.status);
    const data = await res.json();
    const deps = (data.actual || []).map(d => ({
      tripId: d.tripId, line: d.patternText, direction: d.direction,
      plannedTime: d.plannedTime, actualTime: d.actualTime,
      actualRelativeTime: d.actualRelativeTime, status: d.status,
      alerts: d.generalAlerts || []
    }));
    depCache.set(sn, deps);
    return deps;
  } catch (e) {
    return null;
  }
}

// ---------- Sichtbarkeits-Steuerung ----------
const stopViews = new Map(); // sn -> {stop, meters, fetchTs, deps, platforms, fetched, reloading}
function viewOf(sn) {
  if (!stopViews.has(sn)) {
    const stop = stops.find(s => s.shortName === sn) ||
      (isRS(sn) ? remoteStops.get(sn) : null);   // v1.5.0: Fern-Stationen im selben View-System
    if (!stop) return null;
    stopViews.set(sn, { stop, meters: null, fetchTs: 0, deps: null, platforms: null, fetched: false, reloading: false, error: false });
  }
  return stopViews.get(sn);
}
async function enrichRow(stop, force) {
  const v = viewOf(stop.shortName);
  if (!v) return;
  if (!v.meters || force) {
    const m = await walkMeters(stop);
    if (m != null && (!v.meters || Math.abs(v.meters - m) / Math.max(v.meters, 1) > 0.15)) v.meters = m;
    else if (m != null && !v.meters) v.meters = m;
  }
  if (!v.fetched) {
    v.reloading = true;
    try {
      const [deps, platforms] = await Promise.all([getDepartures(stop.shortName), loadPlatforms(stop.shortName)]);
      v.deps = deps; v.platforms = platforms;
      v.fetched = !!deps; v.fetchTs = Date.now();
      v.error = !deps;   // fehlgeschlagene Erst-Abfrage: Fehlerzustand statt „lädt ewig“
    } catch (e) {
      v.error = true;   // nie mit hängendem reloading zurückbleiben
    } finally {
      v.reloading = false;
    }
    // Vorab-Laden abgeschlossen: Auch das Stations-Panel nachziehen. Ohne das
    // blieb der frisch geöffnete Reiter bei „Daten werden geladen …“ hängen,
    // wenn die Zeile angeklickt wurde, während ihr Vorab-Lauf noch lief
    // (refetchStop springt dann am reloading-Guard an und rendert nie selbst).
    renderPanels();
  }
}

function renderViews() {
  if (sugBox.hidden) return;
  for (const el of sugBox.querySelectorAll("div[data-sn]")) renderView(el.dataset.sn, el);
}

// Nur diese Station: neue Abfrage (Auto-Cooldown 15 s)
async function refetchStop(sn, manual) {
  const v = viewOf(sn);
  if (!v) return;
  const now = Date.now();
  // Auto-Aktualisierung mit Cooldown, damit Soll/Ist laufend frisch bleiben
  if (!manual && now - (v.lastAuto || 0) < 40000) return;
  if (v.reloading) return;
  v.lastAuto = now;
  v.reloading = true;
  renderViews();
  depCache.delete(sn);
  let deps = null, platforms = null, err = false;
  try {
    [deps, platforms] = await Promise.all([getDepartures(sn), loadPlatforms(sn)]);
  } catch (e) { err = true; }
  if (deps) {
    v.deps = deps; v.platforms = platforms;
    v.fetched = true; v.fetchTs = Date.now(); v.error = false;
  } else {
    // Fehlgeschlagene Abfrage (Netzwerk/API-Fehler, null statt Abfahrten):
    // Zustand sauber aufräumen und als Fehler markieren – NIE im „lädt …“-
    // Zustand hängen bleiben. Sonst bliebe der Reiter für immer leer und
    // selbst ↻ könnte ihn nicht mehr füllen (Bug „leerer Stationsreiter“).
    err = true;
    v.fetchTs = Date.now();
    if (!v.deps || !v.deps.length) { v.fetched = false; v.deps = null; v.platforms = null; }
    // mit Altdaten: letzte Abfahrten bleiben sichtbar, Hinweis im Panel
  }
  v.error = err;
  v.reloading = false;
  renderViews();
  renderPanels();
}

// ---------- „später“/„früher“: Abfahrtsliste seitenweise blättern ----------
// „später“ (unten): je Klick sechs weitere Einträge. KVG-Busse: Das Live-Fenster
// ist kurz (~25 min); geplante Abfahrten kommen aus dem NAH.SH-Fahrplan
// (LocMatch + StationBoard, Zuordnung max. 150 m von der KVG-Haltestelle).
// DB: Die Fahrplan-Einträge kommen bereits mit der Live-Abfrage (rund 10 h) –
// „später“ schaltet je Klick sechs Einträge jenseits des 6-h-Fensters frei.
// „früher“ (oben): je Klick sechs bereits abgefahrene Verbindungen über die
// NAH.SH-Abfahrtstafel mit zurückliegender Anfragezeit (nur Planzeit).
async function laterDeps(sn) {
  const v = viewOf(sn);
  if (!v) return;
  v.moreOpen = true;
  v.fwdShown = (v.fwdShown || 0) + 6;
  refetchStop(sn, true);                 // 1) Live-Abfahrten aktualisieren (rendert selbst)
  if (!isDB(sn) && (!v.plannedTried || Date.now() - (v.plannedTs || 0) > 600000)) {
    try { await fetchPlannedDeps(sn); } catch (e) {}   // 2) Fahrplan auffüllen (max. 10 min alt)
  }
  renderPanels();
  renderViews();
}
async function earlierDeps(sn) {
  const v = viewOf(sn);
  if (!v) return;
  try { await fetchEarlierDeps(sn); } catch (e) {}
  renderPanels();
  renderViews();
}
const nahshLocCache = JSON.parse(localStorage.getItem("kvg-nahshloc") || "{}"); // sn -> {lid, ok, ts}
function saveNahshLocCache() {
  try { localStorage.setItem("kvg-nahshloc", JSON.stringify(nahshLocCache)); } catch (e) {}
}
// NAH.SH-Haltestelle zu einer KVG-Haltestelle: LocMatch („Kiel <Name>“); der Treffer
// muss höchstens 150 m von der KVG-Position entfernt sein (Namensgleichheit genügt nicht).
async function nahshLocFor(stop) {
  const c = nahshLocCache[stop.shortName];
  if (c && c.lid && Date.now() - (c.ts || 0) < 30 * 86400e3) return c.lid;
  if (c && c.ok === false && Date.now() - (c.ts || 0) < 7 * 86400e3) return null;
  let ok = false, lid = null;
  try {
    const res = await dbFetch([{ meth: "LocMatch",
      req: { input: { loc: { type: "S", name: "Kiel " + stop.name }, field: "S" } } }]);
    const locs = (res.svcResL && res.svcResL[0] && res.svcResL[0].res &&
      res.svcResL[0].res.match && res.svcResL[0].res.match.locL) || [];
    let best = null, bestD = 1e9;
    for (const l of locs) {
      const crd = l.crd || {};
      if (!crd.x || !crd.y) continue;
      const d = dist({ lat: crd.y / 1e6, lon: crd.x / 1e6 }, stop);
      if (d < bestD) { bestD = d; best = l; }
    }
    if (best && bestD <= 150 && best.lid) { ok = true; lid = best.lid; }
  } catch (e) {}
  nahshLocCache[stop.shortName] = { lid, ok, ts: Date.now() };
  saveNahshLocCache();
  return ok ? lid : null;
}
// HAFAS-Zeit („HHMMSS“, ggf. mit Tagesoffset-Präfix) am Datum „YYYYMMDD“ in
// lokale Millisekunden umrechnen (setDate statt Addition: DST-sicher).
function hafasAbsMs(date, t) {
  if (!t) return null;
  const s = String(t);
  const s6 = (s.length > 6 ? s.slice(-6) : s).padStart(6, "0");
  const day = s.length > 6 ? (parseInt(s.slice(0, s.length - 6), 10) || 0) : 0;
  const y = parseInt(date.slice(0, 4), 10), mo = parseInt(date.slice(4, 6), 10), d = parseInt(date.slice(6, 8), 10);
  if (!y || !mo || !d) return null;
  const h = parseInt(s6.slice(0, 2), 10) || 0;   // Stunden > 23 = Überlauf in den Folgetag
  const dt = new Date(y, mo - 1, d, h % 24, parseInt(s6.slice(2, 4), 10) || 0, parseInt(s6.slice(4, 6), 10) || 0);
  dt.setDate(dt.getDate() + day + Math.floor(h / 24));
  return dt.getTime();
}
// Betriebstag aus der NAH.SH-jid (endet auf TTMMJJJJ, z. B. „1|19685|1|100|16112026“):
// Abfahrten nach Mitternacht tragen KEINEN Tagesoffset-Präfix, wenn ihr Betriebstag
// vom Anfragedatum abweicht – ihre Zeit ist relativ zum BETRIEBSTAG aus der jid zu
// lesen. Mit dem Anfragedatum gerechnet erscheinen Busse von morgen früh als
// „heute früh“ (8–16 h in der Vergangenheit) und sprengen das „früher“-Paging.
function hafasJidDate(jid, fallback) {
  const m = String(jid || "").match(/(\d{2})(\d{2})(\d{4})$/);
  return m ? (m[3] + m[2] + m[1]) : fallback;
}
// NAH.SH-Abfahrtstafel ab einem beliebigen Zeitpunkt (auch zurückliegend):
// rohe Einträge mit absoluter Abfahrtszeit in ms. mask: 31 = Schiene, 32 = Bus.
// Wirft bei API-Fehlern (z. B. HAMM-Rate-Limit), damit Aufrufer „fehlgeschlagen“
// von „wirklich keine Abfahrten“ unterscheiden können.
async function nahshBoardEntries(lid, T, mask) {
  const p = x => String(x).padStart(2, "0");
  const date = T.getFullYear() + p(T.getMonth() + 1) + p(T.getDate());
  const time = p(T.getHours()) + p(T.getMinutes()) + p(T.getSeconds());
  const res = await dbFetch([{ meth: "StationBoard",
    req: { type: "DEP", stbLoc: { lid }, date, time,
      jnyFltrL: [{ type: "PROD", mode: "INC", value: mask }], maxJny: 120 } }]);
  const s0 = res.svcResL && res.svcResL[0];
  if ((!s0 || (s0.err && s0.err !== "OK")) && res.err)
    throw new Error("NAH.SH-Fehler " + (res.err || (s0 && s0.err)));
  const out = s0 && s0.res;
  if ((!out || !out.jnyL) && s0 && s0.err && s0.err !== "OK")
    throw new Error("NAH.SH-Fehler " + s0.err);
  if (!out || !out.jnyL) return [];
  const prodL = (out.common && out.common.prodL) || [];
  const list = [];
  for (const j of out.jnyL) {
    const prod = prodL[j.prodX] || {};
    const st = j.stbStop || {};
    const tS = st.dTimeS || st.dTimeR;
    if (!tS) continue;
    const absMs = hafasAbsMs(hafasJidDate(j.jid, date), tS);
    if (absMs == null) continue;
    const nm = String(prod.name || "").replace(/^Bus\s+/i, "").trim();
    // Bus-/Bahnsteig aus dem Board mitnehmen (HAFAS-Felder dPlatF/dPlatR bzw.
    // dPltfS als Objekt mit txt): Geplante und "frueher"-Zeilen tragen eine
    // HAFAS-tripId, die nie in die KVG-Steig-Map passt - ihr Steig kommt
    // direkt aus dem Board-Eintrag mit.
    const pfOf = pf => pf == null ? null : (pf.txt != null ? pf.txt : pf);
    const plat = pfOf(st.dPlatF) || pfOf(st.dPlatR) || pfOf(st.dPltfS) || pfOf(st.dPlatfS) || null;
    list.push({ tripId: j.jid, line: nm || "Bus", direction: j.dirTxt || "",
      plannedTime: dbHHMM(tS), actualTime: dbHHMM(st.dTimeR || tS),
      hasRT: !!st.dTimeR, absMs, plat: plat });
  }
  return list;
}
// Geplante KVG-Busabfahrten (Fahrplan) über NAH.SH, Horizont 6 h.
async function fetchPlannedDeps(sn) {
  const v = viewOf(sn);
  const stop = stops.find(s => s.shortName === sn);
  if (!v || !stop) return;
  const lid = await nahshLocFor(stop);
  const list = [];
  // Steig-Anzeige fuer geplante Zeilen: NAH.SH liefert den Steig direkt im
  // Board mit (Feld dPltfS, live am Hauptbahnhof geprueft). Gezeigt wird er
  // unter derselben Regel wie bei Live-Zeilen: nur an Stationen, deren
  // KVG-Steigliste mindestens 3 Steige hat (einfache A/B-Halte bleiben ohne).
  await getSteige();
  const showSteig = !!(steige && steige[sn] && steige[sn].length >= 3);
  let ok = false;
  if (lid) {
    try {
      const now = Date.now();
      for (const e of await nahshBoardEntries(lid, new Date(), "32")) {
        const rel = (e.absMs - now) / 1000;
        if (rel < -120 || rel > 6 * 3600 + 300) continue;   // nur die nächsten 6 h
        list.push({
          tripId: e.tripId, line: e.line, direction: e.direction,
          plannedTime: e.plannedTime, actualTime: e.actualTime,
          actualRelativeTime: rel, status: e.hasRT ? "PREDICTED" : "PLANNED",
          alerts: [], planned: true, plat: showSteig ? (e.plat || null) : null
        });
      }
      ok = true;
    } catch (e) {}
  } else {
    ok = true;   // Haltestelle im NAH.SH-Fahrplan unbekannt: das ist ein Ergebnis (plannedLidOk=false)
  }
  if (!ok) return;   // NAH.SH nicht erreichbar: Zustand unverändert, „später“ bleibt drückbar
  list.sort((a, b) => a.actualRelativeTime - b.actualRelativeTime);
  v.planned = list;
  v.plannedTs = Date.now();
  v.plannedTried = true;
  v.plannedLidOk = !!lid;
}
// „früher“: bis zu sechs bereits abgefahrene Verbindungen vor dem Listenanfang
// nachladen. Die Abfragezeit wandert adaptiv nach hinten (3 min, dann
// verdoppelnd bis 192 min), bis sechs noch nicht geladene Einträge vor der
// frühesten sichtbaren Abfahrt dastehen oder der Rahmen erschöpft ist.
async function fetchEarlierDeps(sn) {
  const v = viewOf(sn);
  const stop = stops.find(s => s.shortName === sn);
  if (!v || !stop) return;
  const isdb = isDB(sn);
  const lid = isdb ? ((dbStopOf(sn) || {}).lid || null) : await nahshLocFor(stop);
  if (!lid) { v.earlierTried = true; return; }
  // Steig der abgefahrenen Fahrt mitliefern (dPlatF/dPltfS aus dem Board):
  // Zuege zeigen ihn immer (wie die DB-Live-Tafel), Busse nur, wo die
  // KVG-Steigliste die Anzeige-Schwelle erfuellt - dieselbe Regel wie live.
  if (!isdb) await getSteige();
  const showSteig = isdb || !!(steige && steige[sn] && steige[sn].length >= 3);
  // früheste zurzeit sichtbare Abfahrt (absolut)
  let earliest;
  if (v.earlier && v.earlier.length) earliest = v.earlier[0].absMs;
  else if (v.deps && v.deps.length) earliest = v.fetchTs + (v.deps[0].actualRelativeTime || 0) * 1000;
  else earliest = Date.now();
  const have = {};
  for (const d of (v.earlier || [])) have[d.jidKey] = 1;
  let found = [], gotAny = false;
  for (let dMin = 3; dMin <= 192 && found.length < 6; dMin *= 2) {
    try {
      const cand = [];
      for (const e of await nahshBoardEntries(lid, new Date(earliest - dMin * 60000), isdb ? "31" : "32")) {
        if (e.absMs >= earliest || e.absMs < earliest - 12 * 3600e3) continue;
        const k = e.tripId + "@" + e.absMs;
        if (have[k]) continue;   // bereits geladen
        cand.push({ e, k });
      }
      cand.sort((a, b) => b.e.absMs - a.e.absMs);   // neueste zuerst
      found = cand;
      gotAny = true;
    } catch (err) { break; }
  }
  if (!gotAny) {   // NAH.SH (z. B. Rate-Limit) nicht erreichbar: Button bleibt, erneut drücken
    setLocNote("NAH.SH gerade nicht erreichbar – „früher“ bitte gleich noch einmal drücken.");
    return;       // earlierTried/exhausted NICHT setzen
  }
  const add = found.slice(0, 6);
  if (add.length) {
    add.reverse();   // zeitlich aufsteigend (älteste zuerst)
    const now = Date.now();
    v.earlier = v.earlier || [];
    for (const c of add) {
      v.earlier.push({
        tripId: c.e.tripId, line: c.e.line, direction: c.e.direction,
        plannedTime: c.e.plannedTime, actualTime: c.e.actualTime,
        status: c.e.hasRT ? "PREDICTED" : "PLANNED",
        actualRelativeTime: (c.e.absMs - now) / 1000,
        alerts: [], earlier: true, planned: !isdb, absMs: c.e.absMs, jidKey: c.k,
        plat: showSteig ? (c.e.plat || null) : null
      });
    }
    v.earlier.sort((a, b) => a.absMs - b.absMs);
    v.earlierTs = now;
  } else if (v.earlier && v.earlier.length) {
    v.earlierExhausted = true;   // nichts mehr zu holen: „früher“ ausblenden
  }
  v.earlierTried = true;
}

// Abfahrten wirklich weg (länger als 2 Minuten abgefahren)? Nicht verwechseln mit
// „für den Fußweg nicht mehr erreichbar“: Eine weit entfernte Station hat laufend
// Abfahrten, die man zu Fuß nicht mehr schafft – die sind NICHT weg, nur unerreichbar.
function depsReallyGone(v) {
  const ageSec = (Date.now() - v.fetchTs) / 1000;
  return !(v.deps || []).some(d => (d.actualRelativeTime || 0) - ageSec > -180);
}

// ---------- Buszeilen rendern ----------
// Zeitfenster der Liste (gemeinsame Basis für Zeilen und Blätter-Links):
// frühere Einträge (per „früher“ geladen), Live-Fenster, geplante Einträge
// (KVG: NAH.SH-Fahrplan) bzw. Züge jenseits des 6-h-Fensters (DB, „später“).
function depWindow(v, horizonSec) {
  const w = { ageSec: (Date.now() - v.fetchTs) / 1000,
    agePl: v.plannedTs ? (Date.now() - v.plannedTs) / 1000 : 0,
    ageEr: v.earlierTs ? (Date.now() - v.earlierTs) / 1000 : 0,
    fwd: v.moreOpen ? (v.fwdShown || 0) : 0,
    lastLiveRel: -Infinity, plannedVisible: [], plannedMore: false,
    dbBeyond: 0, dbMore: false };
  for (const d of v.deps) {
    const r = (d.actualRelativeTime || 0) - w.ageSec;
    if (r > w.lastLiveRel) w.lastLiveRel = r;
    if (horizonSec && r > horizonSec) w.dbBeyond++;
  }
  w.dbMore = w.dbBeyond > w.fwd;
  // geplante KVG-Fahrten: diejenigen überspringen, die die Live-Auskunft bereits führt
  for (const d of (v.planned || [])) {
    const rel = (d.actualRelativeTime || 0) - w.agePl;
    if (rel <= w.lastLiveRel + 60) continue;
    if (w.plannedVisible.length < w.fwd) w.plannedVisible.push(d); else w.plannedMore = true;
  }
  return w;
}
// „früher“-Link über der Liste (zentriert): je Klick sechs abgefahrene Verbindungen
function earlierHTML(v) {
  if (!v || !v.fetched) return "";
  if (isRS(v.stop.shortName)) return "";   // v1.5.0: Fern-Stationen ohne „früher“-Paging (KVG-spezifisch)
  if (v.earlierExhausted || (v.earlierTried && (!v.earlier || !v.earlier.length))) return "";
  return '<div class="morewrap"><button class="morelink" data-earlier="' +
    escapeHtml(v.stop.shortName) + '" title="Die sechs vorherigen (abgefahrenen) Abfahrten nachladen">früher</button></div>';
}
// „später“-Link unter der Liste (zentriert): je Klick sechs weitere Einträge
function laterHTML(v) {
  if (!v || !v.fetched) return "";
  if (isRS(v.stop.shortName)) return "";   // v1.5.0: Fern-Stationen ohne „später“-Paging (Live-Fenster reicht)
  const isdb = isDB(v.stop.shortName);
  const w = depWindow(v, isdb ? 21600 : null);
  const link = '<div class="morewrap"><button class="morelink" data-later="' +
    escapeHtml(v.stop.shortName) + '" title="Live-Abfahrten aktualisieren und sechs weitere Abfahrten nachladen">später</button></div>';
  if (isdb) return w.dbMore ? link : "";
  if (!v.plannedTried) return link;
  if (w.plannedMore) return link;
  if (w.plannedVisible.length) return "";   // alles angezeigt
  return '<div class="morewrap"><small class="rowinfo dim">' +
    (v.plannedLidOk ? "Keine geplanten Abfahrten in den nächsten Stunden."
      : "Keine geplanten Abfahrten gefunden (Haltestelle im NAH.SH-Fahrplan unbekannt).") + "</small></div>";
}
// Sekunden-Countdown für unmittelbar bevorstehende KVG-Echtzeit-Abfahrten.
// KVG-Live liefert actualRelativeTime als echten Sekunden-Countdown (live
// getestet: zählt synchron zur Uhr, nach Abfahrt negativ weiter). Anzeige als
// M:SS – NUR für Echtzeit-Einträge (PREDICTED/STOPPING) der KVG-API: Bei
// geplanten oder HAFAS-Zeiten (NAH.SH/DB) sind die Sekunden immer :00, ein
// Countdown wäre dort Fake-Präzision.
const CD_MAX_S = 180;    // Countdown maximal 3 Minuten vor der Abfahrt zeigen
const CD_REFRESH_MS = 20000;   // läuft ein Countdown: Daten alle 20 s nachziehen statt alle 45 s
function cdFmt(ms) {
  if (!isFinite(ms) || ms <= 0) return "jetzt";
  return Math.floor(ms / 60000) + ":" + String(Math.floor(ms % 60000 / 1000)).padStart(2, "0");
}
function cdSpan(absMs) {   // tickender Countdown-Span (Ziel_ms absolut), 1-s-Ticker pflegt den Text
  return '<span class="cd" data-cd="' + Math.round(absMs) + '">' + cdFmt(absMs - Date.now()) + "</span>";
}
// 1-Sekunden-Ticker: nur die Countdown-Spans aktualisieren, kein Neurendern
setInterval(() => {
  if (document.hidden) return;
  const now = Date.now();
  for (const el of document.querySelectorAll("[data-cd]"))
    el.textContent = cdFmt(Number(el.dataset.cd) - now);
}, 1000);
// ---------- Verlaufs-Sekunden-Countdown (Standard seit v1.3.10) ----------
// Ziel-Millisekunden zu einer "HH:MM"-Zeit: heute, Tages-Wrap-sicher um
// "jetzt" herum (Nachtfahrten mit Minuten jenseits Mitternacht inklusive).
function hhmmAbsMs(hhmm) {
  const m = hhmmToMin(hhmm);
  if (m == null) return null;
  return Date.now() + sztWrapDiff(m, sztNowMin()) * 60000;
}
// Timer-HTML hinter den Delay-Chip der Verlaufs-Zeilen: "+Xm" bleibt stehen,
// dahinter tickt "in M:SS" (der 1-s-Ticker oben pflegt alle [data-cd]).
// Zwei Wurzeln: primMs = Live-/Fahrplan-Ziel (in "Aktuell" stehende Ist-Zeit,
// sonst Planzeit; das GPS-ETA an der eigenen Haltestelle ist als einziges
// Ziel auf die Sekunde genau, alle anderen zaehlen auf die volle Minute) ->
// normale Schrift. sztMs = Raum-Zeit-Ziel -> kursiv; gibt es beide, laeuft
// der kursive in Klammern dahinter: "in 0:34 (0:56)". Beide nur im
// CD_MAX_S-Fenster; der kursive nur, wenn er abweicht (v1.6.11: ab 30 Sekunden,
// (sonst zeigte er nur dasselbe Zifferblatt nochmal). "" ohne Timer.
function tripCdHTML(nowMs, primMs, sztMs) {
  const maxMs = CD_MAX_S * 1000;
  const ok = ms => ms != null && ms > nowMs + 900 && ms - nowMs <= maxMs;
  const pOk = ok(primMs);
  const sOk = ok(sztMs) && (!pOk ||
    Math.abs(sztMs - primMs) >= SZT_TAKEOVER_S * 1000);   // v1.6.11: kursiver Klammer-Countdown ab 30 s Abweichung (vorher: abweichende Minute)
  if (!pOk && !sOk) return "";
  const span = (ms, cls) => '<span class="cd' + (cls ? " " + cls : "") + '" data-cd="' +
    Math.round(ms) + '">' + cdFmt(ms - nowMs) + "</span>";
  if (pOk && sOk)
    return ' <span class="tcd" title="Sekunden-Countdown auf die Live-/Fahrplanzeit, kursiv in Klammern die Raum-Zeit-Voraussage">in ' +
      span(primMs) + ' <span class="szt">(' + span(sztMs, "szt") + ')</span></span>';
  if (pOk)
    return ' <span class="tcd" title="Sekunden-Countdown auf die Live-/Fahrplanzeit">in ' + span(primMs) + "</span>";
  return ' <span class="tcd szt" title="Sekunden-Countdown auf die Raum-Zeit-Voraussage">in ' + span(sztMs, "szt") + "</span>";
}

function busLinesHTML(v, horizonSec, withFollow) {
  if (!v || !v.deps) return [];
  const w = depWindow(v, horizonSec);
  const walkSec = v.meters ? v.meters / (WALK_SPEED_KMH * 1000 / 3600) : 0;
  const out = [];
  // zeitlich aufsteigend: frühere Einträge vor dem Live-Fenster, danach Live,
  // dann die per „später“ freigeschalteten geplanten Einträge
  const seq = (v.earlier || []).concat(v.deps, w.plannedVisible);
  let rank = 0;   // DB: schon sichtbare Einträge jenseits des 6-h-Fensters
  for (const d of seq) {
    const rel = d.earlier ? ((d.actualRelativeTime || 0) - w.ageEr)
              : d.planned ? ((d.actualRelativeTime || 0) - w.agePl)
              : (d.actualRelativeTime - w.ageSec);
    // DB-Paging: jenseits des 6-h-Fensters nur die per „später“ geladenen (je 6)
    if (horizonSec && !d.earlier && !d.planned && rel > horizonSec) {
      if (rank >= w.fwd) continue;
      rank++;
    }
    const losMin = Math.round((rel - walkSec) / 60);
    // Abfahrtszeit entscheidet (kein Erreichbarkeits-Filter mehr): ALLE noch
    // nicht abgefahrenen Verbindungen stehen in der Liste; Abgefahrene bleiben
    // bis 3 Minuten grau durchgestrichen stehen und verschwinden dann.
    if (!d.earlier && rel < -180) continue;
    // Live-Zeilen: Steig aus der KVG-Steig-Tafel (v.platforms). Geplante und
    // "frueher"-Zeilen tragen ihren Steig direkt vom NAH.SH-Board (d.plat),
    // nach derselben Anzeige-Schwelle wie in der Live-Anzeige.
    const plat = (v.platforms && v.platforms[d.tripId]) || d.plat || null;
    const isPlan = d.earlier ? d.status === "PLANNED" : (d.planned || d.status === "PLANNED");
    const cls = (rel >= 0 ? (rel > 180 ? "bl" : "bl soon") : "bl gone") + (isPlan ? " planned" : "");
    const ptag = isPlan ? '<span class="ptag">geplant</span>' : "";
    const gsrc = d.gSrc === "delfi";   // v1.5.3: DELFI-Chip (blau) oder gtfs.de-Chip (tuerkis)
    const gtag = d.gDelay != null ? '<span class="ptag ' + (gsrc ? "delfitag" : "gtag") + '" title="Verspätungs-Overlay: ' +
      (gsrc ? "DELFI-Pool-Realtime (Mobilithek, clientzertifikatsverschlüsselt), Solldaten nah.sh, serverseitig aufbereitet über delfiproxy.php"
            : "gtfs.de-Realtime (Datenbasis DELFI, CC BY 4.0), serverseitig aufbereitet über gtfsproxy.php") + '">' + (gsrc ? "DELFI " : "gtfs.de ") +
      (d.gDelay >= 0 ? "+" : "-") + Math.round(Math.abs(d.gDelay) / 60) + " min</span>" : "";
    const now = new Date();
    const t = new Date(now.getTime() + rel * 1000);
    const clock = String(t.getHours()).padStart(2, "0") + ":" + String(t.getMinutes()).padStart(2, "0");
    const text = d.direction;
    const clickable = true;   // geplante KVG-Zeilen sind jetzt ebenfalls klickbar: Fahrtverlauf über NAH.SH-JourneyDetails (selectTrip-Planned-Zweig)
    const bLink = escapeHtml(v.stop.shortName) + "~" + escapeHtml(d.tripId);
    // Folgefahrten derselben Linie (nur Stationsreiter-Übersicht): withFollow
    // hängt unter jede Zeile die Fahrplan-Zeile „auch geplant: …“ plus ggf.
    // Betriebsschluss-Warnung; die Suchtreffer-Zeile (renderView) ruft ohne.
    const right = d.earlier
      ? clock + " · vor " + Math.max(0, Math.round(-rel / 60)) + " min"
      : (!d.planned && (d.status === "PREDICTED" || d.status === "STOPPING") &&
         !isDB(v.stop.shortName) && rel > 0 && rel <= CD_MAX_S)
        ? clock + " · fährt in " + cdSpan(v.fetchTs + d.actualRelativeTime * 1000) + " min"
        : rel < 0
          ? clock + " · abgefahren"
          : losMin >= 0
            ? clock + " · los in " + losMin + " min"
            : clock + " · ab in " + Math.round(rel / 60) + " min";
    out.push({
      html: '<div class="blwrap"><div class="' + cls + '"' + (clickable ? ' data-bus="' + bLink + '"' : "") + ">" +
        '<span class="dl blink' + (clickable ? '" data-buslink="' + bLink : "") + '">' + escapeHtml(d.line) + '</span>' +
        (plat ? '<span class="plat">[' + escapeHtml(plat) + ']</span>' : '') +
        '<span class="mqwrap"><span class="mqi blink' + (clickable ? '" data-buslink="' + bLink : "") + '">' + escapeHtml(text) + "</span></span>" +
        (withFollow ? '<button class="pkgchip" data-pkgsn="' + escapeHtml(v.stop.shortName) +
          '" data-pkgline="' + escapeHtml(d.line) + '" data-pkgdir="' + escapeHtml(d.direction) +
          '" data-pkgtime="' + escapeHtml(clock) +
          '" title="Regelmäßige Verbindung: 🐿️-Alarm für diese Linie in dieser Richtung an dieser Station">🐿️</button>' : "") +
        '<span class="btime">' + right + ptag + gtag + "</span></div>" +
        (withFollow ? rowFollowHTML(v.stop.shortName, d) : "") + "</div>",
      losMin
    });
  }
  return out;
}

// ---------- Folgefahrten derselben Linie (3-Stunden-Fahrplanfenster) ----------
// „auch geplant: HH:MM Uhr“: die nächsten Fahrten derselben Linie an derselben
// Haltestelle, Primärquelle ist der Fahrplan (NAH.SH-Board, geplante Zeiten,
// liefert Live-Zeiten mit, wo es sie gibt). Bei dichtem Takt Kurzform
// („auch geplant: 14:12 Uhr, alle 10 min.“). Dazu eine Heuristik für den
// möglichen Betriebsschluss: letzte Fahrt im 2,5-h-Fenster mit danach
// stiller Linie, oder Lücke über 1 Stunde zwischen zwei Fahrten in den
// Nachtstunden (korridor ca. 20 bis 5 Uhr; außen kleiner Orte früher
// abends / Stadtlinien später nachts). Gezeigt wird es unter jeder Zeile der
// Abfahrtsliste im Stationsreiter, im Fahrtverlauf über der „Gep./Aktuell“-
// Kopfzeile und im aufgeklappten Verlauf jedes Bus-/Bahn-Abschnitts der
// GEWÄHLTEN Route (jeweils an derselben Stelle: über der Kopfzeile).
const FOLLOW_WIN_MS = 3 * 60 * 60 * 1000;     // Blick in die nächsten 3 Stunden
const FOLLOW_CACHE_MS = 3 * 60 * 1000;         // Fahrplan ist ruhig: 3 Minuten Cache
const FOLLOW_ERR_RETRY_MS = 60 * 1000;        // v1.6.33: nach einem Fetch-Fehler nur einmal pro Minute erneut (kein Endlos-Retry-Loop)
const followCache = new Map();                 // key -> { ts, list, inflight, err }
const followLocCache = new Map();              // Stationsname -> { ts, lid }   (NAH.SH-Lid)
function followNormLine(l) {
  return String(l || "").toLowerCase().replace(/^bus\s+/i, "").replace(/\s+/g, "").trim();
}
function followClock(absMs) {
  const t = new Date(absMs);
  return String(t.getHours()).padStart(2, "0") + ":" + String(t.getMinutes()).padStart(2, "0");
}
// HH:MM auf „heute“ heben; liegt die daraus gebaute Zeit mehr als 6 h in der
// Vergangenheit, gehört sie zum Folgetag (Fahrt über Mitternacht).
function followAnchorMs(hhmm, nowMs) {
  const m = String(hhmm || "").match(/^(\d{1,2}):(\d{2})$/);
  if (!m) return null;
  const d = new Date(nowMs);
  d.setHours(Number(m[1]), Number(m[2]), 0, 0);
  let t = d.getTime();
  if (t < nowMs - 6 * 3600 * 1000) t += 24 * 3600 * 1000;
  return t;
}
// Nacht-Korridor für die Betriebsschluss-Heuristik
function followIsNight(absMs) {
  const h = new Date(absMs).getHours();
  return h >= 20 || h < 5;
}
// Zeile 1 (rein): zukünftige Fahrten der Linie (aufsteigend) -> Text.
// Wenige: alle Uhrzeiten. Viele: erste Uhrzeit + Takt („alle N Minuten“),
// unruhiger Takt: Median („im Schnitt alle N Minuten“).
function followLineHTML(entries) {
  if (!entries || !entries.length) return "";
  if (entries.length <= 4) {
    const clocks = entries.map(e => followClock(e.absMs));
    const last = clocks.pop();
    return "auch geplant: " + (clocks.length ? clocks.join(", ") + " und " : "") + last + " Uhr";
  }
  const gaps = [];
  for (let i = 1; i < Math.min(entries.length, 9); i++)
    gaps.push(Math.round((entries[i].absMs - entries[i - 1].absMs) / 60000));
  gaps.sort((a, b) => a - b);
  const med = gaps[Math.floor(gaps.length / 2)];
  const uniform = gaps[gaps.length - 1] - gaps[0] <= 1;
  return "auch geplant: " + followClock(entries[0].absMs) + " Uhr, " +
    (uniform ? "alle " : "im Schnitt alle ") + med + " min.";
}
// Zeile 2 (rein): Betriebsschluss-Heuristik über die Fahrten der Linie im
// Fenster (seq, aufsteigend, inkl. aktueller Fahrt).
// (a) Lücke über 60 min zwischen zwei Fahrten, wenn eine davon nachts liegt
// (b) letzte Fahrt im 2,5-h-Fenster, danach schweigt die Linie mindestens
//     40 min bis zum Fensterende, und sie liegt nachts -> „letzte Fahrt heute“
function followSchlussHTML(seq, nowMs) {
  if (!seq || !seq.length) return "";
  for (let i = 0; i + 1 < seq.length; i++) {
    const a = seq[i].absMs, b = seq[i + 1].absMs;
    if (b - a > 60 * 60000 && (followIsNight(a) || followIsNight(b)))
      return "⚠ möglicher Betriebsschluss: nach " + followClock(a) +
        " Uhr vermutlich erst wieder " + followClock(b) + " Uhr";
  }
  const last = seq[seq.length - 1].absMs;
  const winEnd = nowMs + FOLLOW_WIN_MS;
  if (followIsNight(last) && last <= nowMs + 150 * 60000 && winEnd - last >= 40 * 60000)
    return "⚠ möglicher Betriebsschluss: letzte Fahrt heute vermutlich " + followClock(last) + " Uhr";
  return "";
}
// NAH.SH-Lid einer (auch auswärtigen) Haltestelle über LocMatch; mit
// Koordinate wird der beste Treffer binnen 300 m gewählt, sonst der erste.
async function followLoc(name, lat, lon) {
  const key = String(name || "").trim();
  if (!key) return null;
  const c = followLocCache.get(key);
  if (c && Date.now() - c.ts < 30 * 86400e3) return c.lid;
  let lid = null;
  try {
    const res = await dbFetch([{ meth: "LocMatch",
      req: { input: { loc: { type: "S", name: key }, field: "S" } } }]);
    const locs = (res.svcResL && res.svcResL[0] && res.svcResL[0].res &&
      res.svcResL[0].res.match && res.svcResL[0].res.match.locL) || [];
    let best = null;
    if (lat != null && lon != null && isFinite(lat) && isFinite(lon)) {
      let bestD = 1e9;
      for (const l of locs) {
        const crd = l.crd || {};
        if (!crd.x || !crd.y || !l.lid) continue;
        const d = dist({ lat: crd.y / 1e6, lon: crd.x / 1e6 }, { lat, lon });
        if (d < bestD) { bestD = d; best = l; }
      }
      if (bestD > 300) best = null;   // Treffer zu weit weg: lieber gar keinen
    } else {
      best = locs.find(l => l.lid && l.crd && l.crd.x) || null;
    }
    lid = (best && best.lid) || null;
  } catch (e) { lid = null; }
  followLocCache.set(key, { ts: Date.now(), lid });
  return lid;
}
// Fahrplan-Board einer Haltestelle, gefiltert auf die Linie (Richtung als
// Bevorzugung: passt keine Richtung, bleiben alle Richtungseinträge).
async function followBoardList(lid, mask, line, dirHint) {
  const entries = await nahshBoardEntries(lid, new Date(), mask);
  const ln = followNormLine(line);
  const seen = new Set(), out = [];
  for (const e of entries || []) {
    if (followNormLine(e.line) !== ln || seen.has(e.tripId)) continue;
    seen.add(e.tripId);
    out.push(e);
  }
  if (dirHint && out.length > 1) {
    const same = out.filter(e => String(e.direction || "").trim() === String(dirHint).trim());
    if (same.length && same.length < out.length) return same.sort((a, b) => a.absMs - b.absMs);
  }
  return out.sort((a, b) => a.absMs - b.absMs);
}
// Folge-Hinweise (rein) aus dem Cache: liefert { follow, schluss }-Texte und
// stößt ggf. einen frischen Fahrplan-Fetch an (einmal je Lauf, inflight-Flag;
// Ergebnis erscheint beim nächsten Render-Tick).
function followHintHTML(key, fetchFn, anchorMs, exclTripId, dirHint, nowMs) {
  nowMs = nowMs || Date.now();
  let c = followCache.get(key) || null;
  const fresh = !!c && !c.inflight && !c.err && Date.now() - c.ts <= FOLLOW_CACHE_MS;
  // v1.6.33: Nach einem Fehler KEINEN sofortigen Neuversuch im selben Render-Tick -
  // der Neuversuch lief über .finally -> renderPanels -> hier wieder Neuversuch als
  // Endlosschleife (App-Freeze bei Fern-Stationen, deren Folgefahrten-Abruf fehlschlug).
  const errHold = !!c && !c.inflight && !!c.err && Date.now() - c.ts < FOLLOW_ERR_RETRY_MS;
  if (!fresh && !errHold && (!c || !c.inflight)) {
    const prev = c || { ts: 0, list: [] };
    prev.inflight = true;
    followCache.set(key, prev);
    fetchFn(dirHint).then(list => {
      followCache.set(key, { inflight: false, ts: Date.now(), list: list || [] });
    }).catch(() => {
      followCache.set(key, { inflight: false, ts: Date.now(), list: (c && c.list) || [], err: true });
    }).finally(() => { try { renderPanels(); } catch (e) {} });
    c = prev;
  }
  const list = (c && c.list) || [];
  if (!list.length) return { follow: "", schluss: "" };
  const future = list.filter(e => e.absMs >= nowMs - 2 * 60000 && e.absMs <= nowMs + FOLLOW_WIN_MS);
  if (!future.length) return { follow: "", schluss: "" };
  // aktuelle Fahrt ausschließen (Trip-ID oder ±90 s um die eigene Abfahrt)
  const others = future.filter(e => e.tripId !== exclTripId &&
    !(anchorMs != null && Math.abs(e.absMs - anchorMs) <= 90 * 1000) && e.absMs >= nowMs);
  // Sequenz für die Betriebsschluss-Heuristik: ALLE Fahrten im Fenster (inkl.
  // aktueller), sie steckt sonst nirgends sauber drin
  let seq = future.slice();
  if (anchorMs != null && !future.some(e => Math.abs(e.absMs - anchorMs) <= 90 * 1000) &&
      anchorMs >= nowMs - 3 * 3600 * 1000 && anchorMs <= nowMs + FOLLOW_WIN_MS)
    seq = [{ absMs: anchorMs }].concat(seq).sort((a, b) => a.absMs - b.absMs);
  return { follow: followLineHTML(others), schluss: followSchlussHTML(seq, nowMs) };
}
// Haltestelle einer KVG-/DB-Station (App-Bestand) -> Fahrplan-Folgeliste
async function fetchTripFollow(sn, line, dirHint) {
  let lid = null, mask = "32";
  if (isDB(sn)) {
    const d = dbStopOf(sn);
    lid = d && d.lid || null;
    mask = "31";
  } else if (isRS(sn)) {   // v1.6.33: Fern-Station – Lid aus dem Reiter-System, alle Produkte wie ihre Abfahrtstafel
    const m = remoteStops.get(sn);
    lid = m && m.lid || null;
    mask = "511";
  } else {
    const st = stops.find(s => s.shortName === sn);
    lid = st ? await nahshLocFor(st) : null;
  }
  if (!lid) throw new Error("Haltestelle im NAH.SH-Fahrplan unbekannt");
  return followBoardList(lid, mask, line, dirHint);
}
// Haltestelle eines Route-Abschnitts (beliebige NAH.SH-Haltestelle, auch
// auswärts) -> Fahrplan-Folgeliste; Lid über LocMatch mit Koordinaten-Abgleich
async function fetchSecFollow(sec, dirHint) {
  const s0 = (sec.stops && sec.stops[0]) || {};
  const mask = sec.rail ? "31" : "32";
  const lid = await followLoc(sec.from, s0.lat, s0.lon);
  if (!lid) throw new Error("Haltestelle im NAH.SH-Fahrplan unbekannt");
  return followBoardList(lid, mask, sec.line, dirHint);
}
// Hinweis-HTML für den Fahrtverlauf im Stationsreiter (einmal je angezeigter
// Fahrt, direkt ÜBER der „Gep./Aktuell“-Kopfzeile): 1-2 Zeilen
function tripFollowHTML(trip, tstops) {
  if (!trip || !trip.tripId || !trip.sn || !trip.route) return "";
  const nowMs = Date.now();
  const fi = trip.fromIdx != null ? trip.fromIdx : 0;
  const anchor = followAnchorMs(((tstops || [])[fi] || {}).plannedTime, nowMs);
  const t = followHintHTML("sn:" + trip.route + "|" + trip.sn,
    dh => fetchTripFollow(trip.sn, trip.route, dh), anchor, trip.tripId, trip.direction, nowMs);
  if (!t.follow && !t.schluss) return "";
  return '<div class="followhint">' +
    (t.follow ? "<div>" + t.follow + "</div>" : "") +
    (t.schluss ? "<div>" + t.schluss + "</div>" : "") + "</div>";
}
// Hinweis-HTML für einen Bus-/Bahn-Abschnitt der gewählten Route: 1-2 Zeilen,
// steht im aufgeklappten Verlauf direkt ÜBER der „Gep./Aktuell“-Kopfzeile
function secFollowHTML(sec) {
  if (!sec || sec.kind !== "jny" || !sec.line) return "";
  const nowMs = Date.now();
  const anchor = followAnchorMs(sec.depP || sec.dep, nowMs);
  const t = followHintHTML("sec:" + sec.line + "|" + sec.from + "|" + (sec.rail ? "31" : "32"),
    dh => fetchSecFollow(sec, dh), anchor, sec.jid, sec.dir, nowMs);
  if (!t.follow && !t.schluss) return "";
  return '<div class="followhint">' +
    (t.follow ? "<div>" + t.follow + "</div>" : "") +
    (t.schluss ? "<div>" + t.schluss + "</div>" : "") + "</div>";
}

// Hinweis-HTML für eine Zeile der Abfahrtsliste im Stationsreiter (unter jeder
// Bus-/Bahn-Zeile): dieselben 1-2 Zeilen, Anker = Planzeit der Zeile.
// Suchtreffer-Zeilen (renderView) bleiben ohne diese Hinweise.
function rowFollowHTML(sn, d) {
  if (!d || !d.line || d.earlier) return "";
  const nowMs = Date.now();
  const anchor = followAnchorMs(d.plannedTime || d.time || "", nowMs);
  const t = followHintHTML("row:" + d.line + "|" + sn + "|" + (d.direction || ""),
    dh => fetchTripFollow(sn, d.line, dh), anchor, null, d.direction, nowMs);
  if (!t.follow && !t.schluss) return "";
  return '<div class="followhint">' +
    (t.follow ? "<div>" + t.follow + "</div>" : "") +
    (t.schluss ? "<div>" + t.schluss + "</div>" : "") + "</div>";
}

// Sichtbare Zeile im Suchergebnis aktualisieren
function renderView(sn, el) {
  const v = stopViews.get(sn);
  if (!v) return;
  const meta = el.querySelector(".srowmeta");   // v1.4.18: Klasse der zweiten Trefferzeile
  if (v.meters && meta) {
    const walkMin = Math.ceil(v.meters / (WALK_SPEED_KMH * 1000 / 60));
    const pre = isEst(sn) ? "~" : "";
    const newText = pre + formatDist(v.meters) + " · " + pre + walkMin + " min";
    const sztText = escapeHtml(newText) + sztWalkHTML(v.meters);
    if (meta.innerHTML !== sztText) meta.innerHTML = sztText;
  }
  const info = el.querySelector(".rowinfo");
  if (info) {
    if (v.reloading) {
      info.className = "rowinfo dim";
      info.textContent = "wird aktualisiert …";
    } else if (!v.fetched) {
      info.className = "rowinfo dim";
      info.textContent = "Daten werden geladen …";
    } else if ((v.deps && v.deps.length) || (v.earlier && v.earlier.length)) {
      const lines = busLinesHTML(v, isDB(sn) ? 21600 : null);
      // alle Abfahrten länger als 2 Minuten weg: Station neu laden (max. alle 30 s)
      if (!lines.length) {
        info.className = "rowinfo dim";
        if (depsReallyGone(v)) {
          info.textContent = "alle geladenen Abfahrten sind abgefahren – lade neu …";
          if (Date.now() - v.fetchTs > 30000) refetchStop(sn, false);
        } else {
          info.innerHTML = "alle geladenen Abfahrten sind abgefahren";
        }
        return;
      }
      // „früher“/„später“ gibt es nur im Stationsreiter (nach Wahl einer Station),
      // nicht in dieser Stationsübersicht.
      const newHTML = lines.map(l => l.html).join("");
      // Daten altern: neu abfragen, damit Soll/Ist aktuell bleiben; läuft ein
      // Sekunden-Countdown (Zeile „fährt in M:SS“), verkürzt auf 20 s
      const cdLive = lines.some(l => (l.html || "").indexOf("data-cd") >= 0);
      if (Date.now() - v.fetchTs > (cdLive ? CD_REFRESH_MS : 45000)) refetchStop(sn, false);
      if (info.dataset.last !== newHTML) {
        info.dataset.last = newHTML;
        info.className = "rowinfo";
        info.innerHTML = newHTML;
        marqueeify(info);
      }
    } else if (v.fetched) {
      info.className = "rowinfo dim";
      info.textContent = "keine Abfahrten in den nächsten Minuten";
    }
  }
}

