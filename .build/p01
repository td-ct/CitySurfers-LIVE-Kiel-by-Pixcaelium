// ---------- v1.6.11/v1.6.12: Automatische Echtzeit-Aktualisierung des Fahrtverlaufs
// im Stationsreiter: Er aktualisiert seine Echtzeitdaten selbstständig – beim
// Öffnen sofort (erster fälliger Tick nach dem Ansprechen), danach alle
// 15 Sekunden, solange die eigene Ansicht sichtbar ist, sonst (Ansicht zu oder
// verdeckt) alle 60 Sekunden. Eingefrorene Ansichten (❄) aktualisieren bewusst
// NICHT; asynchrone Überlappung ist ausgeschlossen (Flag), die 5-Sekunden-
// Sperre der manuellen ↻-Knöpfe bleibt unangetastet.
// v1.6.12 (Timo): Die ERGEBNISSE des Route-Reiters aktualisieren sich NIE von
// selbst – auch nicht bei laufender GPS-Quelle: Eine neue Verbindungssuche
// läuft ausschließlich auf Anforderung (▶-Knopf, Ändern eines Steuer-Elements
// oben im Reiter oder ↻). Der Stationsreiter oben läuft unverändert weiter.
const RT_AUTO_VIS_MS = 15000, RT_AUTO_BG_MS = 60000;
const rtAutoState = { trip: { next: 0 }, tripRun: false };
function rtAutoDue(st, vis) {
  const now = Date.now();
  if (st.next > now) return false;
  st.next = now + (vis ? RT_AUTO_VIS_MS : RT_AUTO_BG_MS);
  return true;
}
setInterval(() => {
  const now = Date.now();
  // --- Stationsreiter: Fahrtverlauf der offenen Fahrt ---
  if (!rtAutoState.tripRun) {
    const tripVis = !!(busPanel && !busPanel.hidden && currentBus && currentBus.tripOpen !== false &&
      currentTrip && currentTrip.sn && currentTrip.tripId && currentTrip.tripId === currentBus.tripId);
    const tripLive = tripVis || !!(currentTrip && currentTrip.sn && currentTrip.tripId &&
      currentBus && currentBus.tripOpen !== false);   // verdeckt: Daten frisch halten (❄ bleibt draußen)
    if (tripLive && rtAutoDue(rtAutoState.trip, tripVis)) {
      rtAutoState.tripRun = true;
      const sn = currentTrip.sn, tripId = currentTrip.tripId;
      Promise.resolve(isDB(sn) ? selectTrip(sn, tripId, true) : refetchTripRealtime(sn, tripId))
        .catch(() => {})
        .finally(() => { rtAutoState.tripRun = false; });
    }
  }
}, 1000);

// ---------- Globaler Aktualisieren-Knopf ----------
// ---------- Lauftext für überlaufende Zeilen ----------
function marqueeify(container) {
  const els = container.querySelectorAll(".mqi");
  for (const el of els) {
    if (el.dataset.mq) continue;
    requestAnimationFrame(() => {
      const parent = el.parentElement;   // .mqwrap: nur die Richtung läuft,
      if (!parent) return;                // Linie/Steig und Zeit bleiben fest
      const maxW = parent.clientWidth - parseFloat(getComputedStyle(parent).paddingLeft || 0);
      const w = el.scrollWidth;
      if (w <= maxW || w === 0) return;   // passt: kein Lauftext
      el.dataset.mq = "1";
      const overflow = w - maxW + 8;
      const visibleChars = Math.max(Math.round(maxW / (w / (el.textContent.length || 1))), 4);
      const hold = Math.max(visibleChars * 0.05, 1.2);        // Verweildauer links/rechts
      const run = overflow / 40;                               // Laufzeit bei 40 px/s
      const total = hold + run + hold;
      el.animate([
        { transform: "translateX(0)", offset: 0 },
        { transform: "translateX(0)", offset: hold / total },
        { transform: "translateX(-" + overflow + "px)", offset: (hold + run) / total },
        { transform: "translateX(-" + overflow + "px)", offset: 1 }
      ], { duration: total * 1000, iterations: Infinity });
    });
  }
}

// ---------- Schriftgrößen-Regler ----------
// zoom skaliert die gesamte App einheitlich (auch px-Größen). Die Kopfzeile
// (und damit der Slider selbst) wird gegenzoomt: Der Regler behält während
// des Ziehens seine Größe und Position bei und zuckt nicht unter dem Finger.
