// v1.6.27 (Timo, 26.11.2026): Verspaetung der ERSTEN Fahrt wirkt auf den Aufbruch.
// Die Verbindung kennt die Verspaetung aus zwei Quellen: Echtzeit der TripSearch
// (dep/depP-Differenz, in depAbsMs gegen depAbsMsP) und die Raum-Zeit-Beobachtung
// der Fahrt (sztSecWatch, dieselbe Digest-Quelle wie die +/-Chips im Verlauf).
// Effektiv zaehlt das MAXIMUM beider. Eine Verspaetung schiebt den Aufbruch
// (erster Zubringer-Fussweg, Countdown im Kopf und Unter-Reiter) nach hinten;
// der planmaessige Aufbruch bleibt als "sonst"-Fallback im Hinweis-Chip stehen,
// weil die Fahrt die Verspaetung bis zur Einstiegs-Haltestelle ja noch aufholen kann.
function routeStartEff(c) {
  if (!c || !c.secs) return null;
