    const pe = packNativeEntry();   // v1.6.35: eigene 🐿️-Nachricht
    if (pe) arr.push(pe);
    nativeCall("syncAlarms", JSON.stringify(arr));   // leer: alle Nachrichten verschwinden
  }
  syncGeofences();   // native Geofences für Distanz-Wecker (Hintergrund) aktualisieren
  // ⏰ in der Statusleiste: immer sichtbar, ausgegraut ohne Wecker, mit Zahl
  // (inkl. läutender, bereits ausgelöster) in der normalen Farbe ab 1 Wecker
  alarmInd.classList.toggle("empty", !entries.length);
  alarmInd.textContent = "⏰" + (entries.length ? " " + entries.length : "");
  if (alarmList.hidden) return;
  if (!entries.length) {
    alarmList.innerHTML = '<div class="alrow"><span class="afsname dim">Keine Wecker gestellt.</span></div>';
    return;
  }
  alarmList.innerHTML = entries.map(en => {
