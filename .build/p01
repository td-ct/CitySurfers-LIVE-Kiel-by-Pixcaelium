      // gleiche Hoehe, der Anschluss-Strich sitzt dort, wo vorher der Ring saß)
      const start = secEl.offsetTop + 10;                       // Ring-Mitte oben (Start-/Umsteige-Punkt)
      const nextEl = wrapEl.querySelector('.routesec[data-rsi="' + (best.si + 1) + '"]');
      const end = nextEl ? (nextEl.offsetTop + 10)             // naechster Umsteige-Ring
