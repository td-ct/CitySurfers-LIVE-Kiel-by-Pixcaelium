    '<div class="dlabel">Station dieses Fahrtverlaufs</div>' +
    '<select class="astop"><option value="">– Station wählen –</option>' +
      tstops.map(x => {
        const t = x.actualTime || x.time || x.plannedTime || "";
        const mk = x.shortName === gpsSn ? "📍 " : x.shortName === nextSn ? "▶ " : "";
        return '<option value="' + escapeHtml(x.shortName) + '"' + (sn === x.shortName ? " selected" : "") + '>' +
