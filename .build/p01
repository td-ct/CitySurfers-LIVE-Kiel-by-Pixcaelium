    }
    // v1.6.17: Ist die Geometrie SICHER (GPS nah dran UND keine Mehrdeutigkeit),
    // ist sie die einzige Quelle des Strahls - die Spitze zeigt die exakte
    // Projektions-Position, vor und zurueck, auch rueber um Sekunden. Zeit
    // (rrTimePos) entscheidet nur noch ohne GPS, bei weitem Abseits-Stand oder
    // im mehrdeutigen Fall (gleiche Linie/Spur zurueck). Frueher war der
    // Zeit-Fortschritt ein MINIMUM ueberall: Die Spitze lief der Uhr vor und
    // stand nicht mehr dort, wo man wirklich war.
    const geomOk = !!(best && !best.amb && best.d <= TRIP_DOT_MAX_M);
    // v1.6.7: Strahl-POSITION und PUNKT-Sichtbarkeit sind entkoppelt: Die
    // Projektionshoehe y laeuft IMMER mit dem GPS mit - vorwaerts wie
    // rueckwaerts, auch wenn der Leuchtpunkt wegen der Abstands-Hysterese
    // gerade ausgeblendet ist oder ein Abschnitt keine Halte-Koordinaten hat
    // (dann traegt der from/to-Fallback des Punktes die Projektion). Der
    // hellblaue GPS-Strahl unten zeigt damit staendig die echte Position in
    // der Route und friert nie wieder ein; nur der Punkt selbst und die
    // Stationskreise bleiben an die Hysterese gekoppelt.
    const secEl = best != null ?
      wrapEl.querySelector('.routesec[data-rsi="' + best.si + '"]') : null;
    const wrapTop = wrapEl.getBoundingClientRect().top;
    const y = (() => {
      if (!secEl) return null;
      // Aufgeklappter Verlauf eines Bus-/Bahn-Abschnitts: Die Position laeuft
      // STATIONSSYNCHRON zwischen den Stationszeilen, sie nimmt jeden Kreis
