  const shift = Math.max(0, dly - (known || 0));   // ueber die Verbindung-Echtzeit hinaus (z. B. nur beobachtet)
  return { dly: dly, planMs: planMs, effMs: c.depAbsMs + shift * 60000, shiftMin: shift };
