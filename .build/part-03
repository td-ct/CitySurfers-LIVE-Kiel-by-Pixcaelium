  const nb = (v, mn, mx) => (mx > mn ? (mx - v) / (mx - mn) : 1);   // 1 = bester Wert im Ergebnis-Set
  if (routeRain)
    return 25 * nb(routeArrMin(c), st.arrMin, st.arrMax) +
