function routeDivStartsOf(cons) {   // v1.6.18: Anzahl verschiedener erster Fahrten (Start-Vielfalt einer Liste)
  const s = new Set();
  for (const c of (cons || [])) { const k = routeFirstJnyKey(c); if (k) s.add(k); }
  return s.size;
}
function routeDiversify(cons) {   // v1.6.18: Auswahl der 10 angebotenen Verbindungen mit Varietaet
  // Timo 24.11.2026 spaet: „drei Verbindungen, alle mit demselben Bus, nur zum
  // Ende verschieden" ist kein gutes Ergebnis. Uebersteigt die Suchausbeute die
  // Zielzahl, werden die 10 Angebotenen so gewaehlt, dass (1) je Sortierart
  // (Ankunft, Fahrzeit, Umstiege, ⭐ Beste) die jeweils zwei besten dastehen und
  // (2) die Einstiege variieren: Eimer je erster Fahrt, reihum gefuellt, bis
  // drei (ROUTE_DIV_STARTS) verschiedene Starts und ROUTE_CONS_GOAL Karten
  // zusammen sind. Direktweg-Karten bleiben unberuehrt oben.
  const direct = cons.filter(c => c && c.direct);
  const rest = cons.filter(c => !c || !c.direct);
  if (rest.length <= ROUTE_CONS_GOAL) return cons;   // kurze Liste: nichts zu verteilen
  const stH = routeHeurStats(rest);
  const picked = new Set(), list = [];
  const add = c => { if (c && !picked.has(c)) { picked.add(c); list.push(c); } };
  const crits = [
    rest.slice().sort((a, b) => (routeArrMin(a) - routeArrMin(b))),   // Ankunft
    rest.slice().sort((a, b) => ((a.dur || 0) - (b.dur || 0)) || (routeArrMin(a) - routeArrMin(b))),   // Fahrzeit
    rest.slice().sort((a, b) => ((a.chg || 0) - (b.chg || 0)) || ((a.dur || 0) - (b.dur || 0))),   // Umstiege
    rest.slice().sort((a, b) => (routeScore(b, stH) - routeScore(a, stH)))   // ⭐ Beste
  ];
  // v1.6.20: Die gewaehlte Sortierart bekommt ein zusaetzliches Kontingent
  // (drei statt zwei): Der Listen-Wunsch zaehlt damit schon beim Suchen, ohne
  // eine zusaetzliche Abfrage (die Knopfleiste sortiert die Liste selbst).
  const critKeys = ["arr", "dur", "chg", "heur"];
  for (let ci = 0; ci < crits.length; ci++) {
    const n = (routeSort === critKeys[ci]) ? ROUTE_SORT_MIN_N + 1 : ROUTE_SORT_MIN_N;
    for (let i = 0; i < n && i < crits[ci].length; i++) add(crits[ci][i]);
