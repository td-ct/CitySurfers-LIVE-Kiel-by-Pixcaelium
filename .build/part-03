}
function routeArrMin(c) {   // v1.4.8: Ankunft als Tagesminute, Mitternachts-Wrap ueber die Abfahrtszeit
  const a = /^(\d{1,2}):(\d{2})$/.exec(String(c.arr || ""));
  if (!a) return 0;
  let am = Number(a[1]) * 60 + Number(a[2]);
  const d = /^(\d{1,2}):(\d{2})$/.exec(String(c.dep || ""));

  if (d) { const dm = Number(d[1]) * 60 + Number(d[2]); if (am + 720 < dm) am += 1440; }   // Fahrt ueber Mitternacht
  return am;
}
function routeWalkMOf(c) {   // v1.6.1: Summe der Fuss-/Rad-/Roller-Wege in Metern (distM; Notfall aus Minuten geschaetzt, 80 m/min)
  let m = 0;
  for (const s of (c.secs || []))
    if (s.kind === "walk" || s.kind === "bike")
      m += (s.distM != null && s.distM > 0) ? s.distM : Math.max(0, s.mins || 0) * 80;
