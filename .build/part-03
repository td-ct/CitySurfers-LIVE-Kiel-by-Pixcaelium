  const buckets = [];   // Eimer je erster Fahrt, Reihenfolge = aktuelle Sortierung
  for (const c of rest) {
    const k = routeFirstJnyKey(c) || routeSig(c);
    let b = buckets.find(x => x.key === k);
    if (!b) { b = { key: k, items: [] }; buckets.push(b); }
    b.items.push(c);
