const routeVarShown = {};   // v1.6.1: aufgeklappte Varianten-Gruppen (Schluessel = Kern-Kette oder routeSig)
function routeGroups(cons) {   // v1.6.1: fast gleiche Verbindungen zusammenfassen: gleiche Fahrzeug-Kette, sonst gleiche erste Linie mit Ankunft +- 1 min
  const st = routeHeurStats(cons), score = c => routeScore(c, st);
  const groups = [];
