  for (let r = 0; list.length < ROUTE_CONS_GOAL && r < ROUTE_CONS_GOAL; r++)
    for (const b of buckets)
      if (list.length < ROUTE_CONS_GOAL && b.items[r]) add(b.items[r]);   // reihum: verschiedene Starts zuerst
  for (const c of rest) {   // Rest auffuellen, bis 10 zusammen sind
    if (list.length >= ROUTE_CONS_GOAL) break;
