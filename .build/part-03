// Gesicherte Reiter wiederherstellen: pro Reiter die Kette aus Haltestelle
// und ggf. gewählter Buslinie inkl. Fahrtverlauf öffnen (z. B. nach Import).
// Seit v1.5.6 komplett: Stations-, Route- UND MM-Reiter (Micromobility) samt
// letztem aktiven Reiter, alles aus kvg-view.
try {
  const sv = JSON.parse(localStorage.getItem("kvg-view") || "null");
  const openOne = (sn, bus, tripsArr) => {
    const list = (Array.isArray(tripsArr) && tripsArr.length) ? tripsArr : (bus ? [bus] : []);
    if (!list.length) { selectStop(sn); return; }
    for (const tb of list) if (tb && tb.tripId) selectBus(sn, tb.tripId);
    if (bus && bus.tripId) {
      selectBus(sn, bus.tripId);
      if (bus.tripOpen) {
        // Abfahrten der Station abwarten (DB braucht die geplante Zeit der
        // Fahrt, um den Verlauf eindeutig zuzuordnen), dann Verlauf laden.
        let tries = 0;
        const t = setInterval(() => {
          tries++;
          if (((viewOf(sn) || {}).deps) || tries > 40) {   // max. ~12 s
            clearInterval(t);
            if (currentBus && currentBus.sn === sn && currentBus.tripId === bus.tripId)
              selectTrip(sn, bus.tripId, true);
          }
        }, 300);
      }
    } else selectStop(sn);
  };
  if (sv && Array.isArray(sv.tabs) && sv.tabs.length) {
    sv.tabs.forEach(t => {
      if (t.sn && isRS(t.sn)) {   // v1.5.0: Fern-Stations-Reiter (ohne Fahrten-Unter-Reiter)
        if (t.remote || remoteStops.get(t.sn)) rsRestoreTab(t);
      } else if (t.sn && stops.find(s => s.shortName === t.sn)) {
        openOne(t.sn, t.bus, t.trips);
        const tb = tabs.find(x => x.sn === t.sn);
        if (tb) { if (t.name) tb.name = t.name; if (t.uid) tb.uid = t.uid; }   // Name + UID (Reihenfolge) übernehmen
      }
    });
  } else if (sv && sv.sn && stops.find(s => s.shortName === sv.sn)) {
    openOne(sv.sn, sv.bus);   // altes Format (einzelner Reiter, v1.0.10)
  }
  if (sv && Array.isArray(sv.rtabs)) {
    // parallele Route-Reiter: seit v1.6.23 MIT Inhalt (Treffer, gewaehlte
    // Verbindung, offene Verlaeufe, Fehler). Signatur -> Treffer-Objekt,
    // secOpen stellt die auf-/zugeklappten Verlaeufe wieder her. Altes Format:
    // Start/Ziel steht wieder, Suche laeuft beim Antippen (altes Verhalten).
    for (const rt of (sv.rtabs || [])) {
      if (!rt || !rt.sel || !rt.sel.start || !rt.sel.dest) continue;
      const cons = (Array.isArray(rt.cons) ? rt.cons : []).filter(c => c && Array.isArray(c.secs));
      const chosen = [];
      for (const chS of (Array.isArray(rt.chosen) ? rt.chosen : [])) {
        if (!chS || !chS.sig) continue;
        const con = cons.find(c => { try { return routeSig(c) === chS.sig; } catch (e) { return false; } });
        if (con) chosen.push({ sig: chS.sig, con: con,
          secOpen: (Array.isArray(chS.secOpen) && chS.secOpen.length === con.secs.length) ? chS.secOpen : con.secs.map(() => false),
          at: [], prog: [] });
      }
      routeTabs.push({ uid: rt.uid || newTabUid(), name: rt.name || "", sel: rt.sel,
        cons: cons, chosen: chosen,
        sub: (rt.sub != null && chosen[rt.sub]) ? rt.sub : -1,
        err: rt.err || null, loading: false,
        searched: !!(rt.searched && cons.length), searching: null,
        topOpen: true, subOpen: true, fold: false, frozen: false, cachedTop: "", cachedSub: "" });
    }
    if (Array.isArray(sv.ord) && sv.ord.length) barOrd = sv.ord.slice();   // gemeinsame Reihenfolge
  }
  if (sv && Array.isArray(sv.mmtabs)) {   // v1.5.6: MM-Reiter samt uebernommenen Routen wiederherstellen
    for (const mt of sv.mmtabs) {
      if (!mt || typeof mt !== "object") continue;
      const routes = (Array.isArray(mt.routes) ? mt.routes : [])
        .filter(mm => mm && typeof mm === "object" && mm.tot != null)
        .map(mm => {   // Uhrzeiten auf jetzt umbasen: Der Fortschritt der MM-Route ist GPS-gefuehrt, die Restzeit zaehlt ab der Wiederherstellung
          const r = Object.assign({}, mm), now = Date.now();
          r.t0ms = now; r.planArrMs = now + Math.max(0, Number(r.tot) || 0) * 60000;
          return r;
        });
      if (mt.stId == null && !routes.length) continue;   // nur mit Station oder mit Route ein Reiter
      mmTabs.push({ uid: mt.uid || newTabUid(), stId: (mt.stId == null ? null : mt.stId),
        name: (typeof mt.name === "string" && mt.name) ? mt.name : "Leihstation",
        routes: routes,
        active: routes.length ? Math.max(0, Math.min(routes.length - 1, Number(mt.active) || 0)) : -1,
        more: (mt.more && typeof mt.more === "object") ? mt.more : {} });
    }
  }
  if (sv && sv.mmactiveOn && mmTabs.length && sv.mmactive >= 0 && mmTabs[sv.mmactive]) {
    activateMMTab(sv.mmactive);   // v1.5.6: zuletzt aktiver MM-Reiter erscheint wieder (incl. Unter-Reiter und Strahl)
  } else if (routeTabs.length && sv && sv.ractiveOn && sv.ractive >= 0 && routeTabs[sv.ractive]) {
    activateRouteTab(sv.ractive);   // zuletzt aktiver Route-Reiter: erscheint und sucht einmalig selbst
  } else if (tabs.length) {
    activateTab(Math.min(sv && (sv.active || 0) || 0, tabs.length - 1), false);
  }
  renderTabs();
} catch (e) {}

