// ---------- Raum-Zeit-Daten (SZT): dritte Datenquelle neben Gep. und Aktuell ----------
// KONVENTION (App, Hilfe, README, Wissensbasis): Werte aus der EIGENEN Raum-Zeit-
// Auswertung (GPS-Spur gegen die Fahr-Linie der erkannten Fahrt) sind IMMER
// KURSIV und nutzen dieselben Farben wie die Live-Daten. Weichen sie von der
// Live-Angabe ab (Timo-Kommando v1.6.11: bereits ab 30 Sekunden statt bisher
// 3 Minuten) oder fehlt Live ganz, laufen sie mit der Live-Angabe im Wechsel
// (2-Sekunden-Wechsel des Stapels, beide lesbar) bzw. ersetzen sie; auf
// Minuten-Anzeigen (Uhrzeit, Chips) ist die erste sichtbare Stufe eine
// abweichende Minute, in Sekunden-Countdowns greift die 30-s-Kante exakt.
// Die drei Quellen: Gep. = Fahrplan, Aktuell = Live-Tafel, kursiv = Raum-Zeit.
// Ausnahme bleibt die Starthaltestelle jedes OePNV-Abschnitts (v1.6.7): Dort
// kommt die Abfahrts-Vorhersage niemals aus dem eigenen GPS.
const SZT_DELTA_MIN = 1;          // v1.6.11: erste sichtbare Minuten-Stufe der 30-s-Uebernahme-Kante
const SZT_TAKEOVER_S = 30;        // v1.6.11: Abweichung in Sekunden, ab der der Raum-Zeit-Wert uebernimmt (Countdowns)
const SZT_TTL_MS = 45 * 1000;    // Auswertung gilt 45 s (Suchrhythmus der Erkennung: 15 s)
const SZT_HIST = 8;              // Messungen im Verspaetungs-Verlauf
let sztState = null;             // { ts, tripId, line, dir, delay, bySn, byName, etaEnd, endName }
let sztDelayHist = [];           // { ts, d }: Verspaetungs-Verlauf der erkannten Fahrt
let sztRejected = [];            // verworfene Kandidaten (Debug-Ansicht im Dialog)
let sztReach = [];               // Lauf-Reichweite: erreichbare Abfahrten der Umgebung
let sztMotion = null;            // { ts, kmh }: eigenes Tempo aus der Spur
let sztWalk = null;              // wie sztMotion, nur wenn es klar ein Lauf-Tempo ist

function sztFresh() { return sztState && Date.now() - sztState.ts <= SZT_TTL_MS ? sztState : null; }
function sztNowMin() { const n = new Date(); return n.getHours() * 60 + n.getMinutes(); }
function sztClockOf(min) {
  if (min == null || !isFinite(min)) return "";
  const m = ((Math.round(min) % 1440) + 1440) % 1440;
  return String(Math.floor(m / 60)).padStart(2, "0") + ":" + String(m % 60).padStart(2, "0");
}
function sztIsSig(a, b) { return a == null || b == null || Math.abs(a - b) >= SZT_DELTA_MIN; }
// Verspaetungs-Verlauf (Idee 1): Tendenz aus den letzten Messungen der Fahrt
function sztTrendText(hist, nowMs, deltaMin) {
  const t = (deltaMin > 0 ? "+" : "") + deltaMin + " min";
  const pts = (hist || []).filter(h => nowMs - h.ts <= 6 * 60 * 1000);
  if (pts.length < 2) return t;
  const d = pts[pts.length - 1].d - pts[0].d;
  return t + (d >= 2 ? ", Tendenz steigend" : d <= -2 ? ", Tendenz fallend" : ", Tendenz stabil");
}
// Wechsel-Blend: Live-Wert und kursiver Raum-Zeit-Wert in einem Stapel (CSS)
function sztBlend(liveTxt, sztTxt) {
  return '<span class="sztwrap"><span class="sztl">' + escapeHtml(String(liveTxt)) + "</span>" +
    '<span class="sztt szt">' + escapeHtml(String(sztTxt)) + "</span></span>";
}
function sztChip(delay, italic) {
  const c = delay > 0 ? "up" : delay < 0 ? "down" : "ok";
  const t = delay > 0 ? "+" + delay + "m" : delay < 0 ? delay + "m" : "0m";
  return '<span class="tdelay ' + c + (italic ? " szt" : "") + '">' + t + "</span>";
}
function sztChipBlend(liveD, sztD) {
  return '<span class="sztwrap"><span class="sztl">' + sztChip(liveD, false) + "</span>" +
    '<span class="sztt">' + sztChip(sztD, true) + "</span></span>";
}
// ETA einer Verlaufs-Zeile aus der Raum-Zeit-Auswertung (nur kommende Stationen)
function sztRowEta(sn, planned, name) {
  const s = sztFresh();
  if (!s) return null;
  const pmin = hhmmToMin(planned);
  if (pmin == null) return null;
  let eta = null;
  if (sn && s.bySn[sn] != null) eta = s.bySn[sn];
  else if (name && s.byName[name] != null) eta = s.byName[name];
  if (eta == null || eta < sztNowMin() - 1) return null;
  return { eta, d: eta - pmin };
}
// Auswertung des besten Treffers: Verspaetung (dtMin am letzten Spur-Punkt)
// + ETAs an allen kommenden Stationen (konstante Verspaetung auf der Kette)
function sztDigest(r) {
  if (!r || !r.t3 || r.dtMin == null) return;
  const nowMs = Date.now();
  const delay = Math.max(-30, Math.min(60, Math.round(r.dtMin)));
  if (!sztState || sztState.tripId !== r.tripId) sztDelayHist = [];
  sztDelayHist.push({ ts: nowMs, d: delay });
  while (sztDelayHist.length > SZT_HIST) sztDelayHist.shift();
  const bySn = {}, byName = {};
  let etaEnd = null, endName = "";
  for (let i = (r.segI || 0) + 1; i < r.t3.length; i++) {
    const st = r.t3[i];
    if (st.depMin == null) continue;
    const eta = st.depMin + delay;
    if (st.sn && bySn[st.sn] == null) bySn[st.sn] = eta;
    if (st.name && byName[st.name] == null) byName[st.name] = eta;
    etaEnd = eta; endName = st.name || endName;
  }
  sztState = { ts: nowMs, tripId: r.tripId, line: r.line, dir: r.direction,
    delay, segI: r.segI, spdK: r.spdK, bySn, byName, etaEnd, endName };
}
// Debug (Idee 5): warum eine Fahr-Linie verworfen wurde - vereinfachte
// Nachrechnung in der Filter-Reihenfolge von vehScore3D
function sztRejectReason(t3, trail, nowMs, opts) {
  opts = opts || {};
  const traj = vehUserMotion(trail, nowMs);
  if (traj.spd * 0.06 > 50 && !opts.isDB) return "Tempo: kein Stadtbus bei deinem Tempo";
  const win = opts.winMin || 6;
  const m = vehMoiy(nowMs);
  let segs = 0, inWin = false, dirOk = false;
  for (let i = 0; i + 1 < (t3 || []).length; i++) {
    const a = t3[i], b = t3[i + 1];
    if (a.moiy == null || b.moiy == null || b.moiy - a.moiy <= 0) continue;
    segs++;
    const pj = vehSegProject(a, b, opts.pos || a);
    const dtMin = m - (a.moiy + pj.f * (b.moiy - a.moiy));
    if (Math.abs(dtMin) > win) continue;
    inWin = true;
    const sv = vehDirVec(a, b);
    if (traj.confident && traj.dir && sv && traj.dir.x * sv.x + traj.dir.y * sv.y < 0.5) continue;
    dirOk = true;
  }
  if (!segs) return "keine nutzbare Linie";
  if (!inWin) return "Zeitfenster";
  if (traj.confident && !dirOk) return "Gegenrichtung";
  return "Abstand/Score zu klein";
}
// Stationssuche nach Raum-Zeit-Reichweite (Idee 7): welche Abfahrten der
// Stationen um dich sind mit DEM EIGENEN Tempo noch erreichbar? (in Lauf-
// Richtung bevorzugt, fruehe zuerst; je Station die frueheste)
function sztReachDigest(boards, pos, traj, nowMs) {
  const out = [];
  const spd = traj && traj.confident && traj.spd > 35 ? traj.spd : WALK_SPEED_KMH * 1000 / 60;
  const baseMin = sztNowMin();
  for (const b of boards || []) {
    const st = stops.find(x => x.shortName === b.sn) || dbStopOf(b.sn);
    if (!st) continue;
    const m = dist(pos, st);
    const walkMin = Math.ceil(m / spd);
    let dirOk = false;
    if (traj && traj.confident && traj.dir) {
      const dv = vehDirVec(pos, st);
      dirOk = !!dv && traj.dir.x * dv.x + traj.dir.y * dv.y > 0.4;
    }
    for (const d of b.deps || []) {
      const rel = (d.actualRelativeTime || 0) - (b.ageSec || 0);
      if (rel < 0 || rel > 30 * 60 || rel < walkMin * 60) continue;
      out.push({ sn: b.sn, m, walkMin, dirOk, line: d.line || "?",
        clock: sztClockOf(baseMin + Math.round(rel / 60)) });
    }
  }
  out.sort((a, b) => (b.dirOk - a.dirOk) || (a.clock < b.clock ? -1 : a.clock > b.clock ? 1 : 0));
  const seen = new Set();
  sztReach = [];
  for (const o of out) {
    if (seen.has(o.sn)) continue;
    seen.add(o.sn);
    sztReach.push(o);
    if (sztReach.length >= 4) break;
  }
}
function sztWalkDigest() {
  const traj = vehUserMotion(vehTrail, Date.now());
  sztMotion = traj && traj.confident && traj.spd > 25
    ? { ts: Date.now(), kmh: Math.round(traj.spd * 0.06) } : null;
  sztWalk = sztMotion && sztMotion.kmh >= 3 && sztMotion.kmh <= 15 ? sztMotion : null;
}
// Bahn-Disambiguierung (Idee 6): eigenes Tempo gegen die Abschnitts-Tempi
function sztRailHTML() {
  const rail = vehResults.filter(r => r.isDB && r.spdK != null).slice(0, 3);
  if (!sztMotion || rail.length < 2) return "";
  const own = sztMotion.kmh;
  rail.sort((a, b) => Math.abs(own - a.spdK) - Math.abs(own - b.spdK));
  const txt = rail.map((r, i) => escapeHtml(r.line) + " " + r.spdK + " km/h (" +
    Math.abs(own - r.spdK) + " Differenz)" + (i === 0 ? " - passt besser" : "")).join(" - ");
  return '<div class="followhint"><div class="szt" title="Raum-Zeit: eigenes Tempo gegen das Abschnitts-Tempo der Bahn-Kandidaten">🚆 Tempo-Profil (eigenes Tempo ~' + own + " km/h): " + txt + "</div></div>";
}
// Fußweg im Raum-Zeit (Idee 4): Ankunft mit dem eigenen Tempo statt Standard
function sztWalkHTML(meters) {
  if (!sztWalk || Date.now() - sztWalk.ts > 3 * 60 * 1000 || meters == null) return "";
  const ownMin = meters / (sztWalk.kmh * 1000 / 60);
  const defMin = meters / (WALK_SPEED_KMH * 1000 / 60);
  if (Math.abs(ownMin - defMin) < 2) return "";
  return ' <span class="szt" title="Raum-Zeit: Ankunft mit deinem eigenen Tempo statt Standard-Tempo (5 km/h)">↝ ~' +
    sztClockOf(sztNowMin() + Math.max(0, Math.round(ownMin))) + "</span>";
}
// Kopfzeile im Fahrtverlauf der erkannten Fahrt: Verspaetungs-Verlauf + Ziel (Idee 1+2)
function sztTripHeadHTML(trip) {
  const s = sztFresh();
  if (!s || !trip || trip.tripId !== s.tripId) return "";
  return '<div class="followhint sztline"><div class="szt" title="eigene Raum-Zeit-Auswertung: GPS-Spur gegen die Fahr-Linie">🗺 Raum-Zeit: Verspaetung ' +
    escapeHtml(sztTrendText(sztDelayHist, Date.now(), s.delay)) +
    (s.etaEnd != null ? " - Ziel " + escapeHtml(s.endName || "") + " ~" + sztClockOf(s.etaEnd) + " Uhr" : "") +
    "</div></div>";
}
// Anschluss-Sicherung (Idee 3) in der gewaehlten Route: Raum-Zeit-Ankunft am
// Umstieg gegen die Abfahrt des Folge-Abschnitts
function sztConnHTML(c) {
  const s = sztFresh();
  if (!s || !c || !c.secs) return "";
  let hit = -1;
  for (let i = 0; i < c.secs.length; i++) {
    const sec = c.secs[i];
    if (sec.kind !== "jny") continue;
    const dep = hhmmToMin(sec.depP || sec.dep);
    const jidHit = !!(sec.jid && sec.jid === s.tripId);
    const lineHit = followNormLine(sec.line) === followNormLine(s.line) &&
      dep != null && Math.abs(dep + (s.delay || 0) - sztNowMin()) <= 25;
    if (jidHit || lineHit) { hit = i; break; }
  }
  if (hit < 0) return "";
  const destName = c.secs[hit].to;
  const arrEta = destName && s.byName[destName] != null ? s.byName[destName] : null;
  let nxtDep = null;
  for (let i = hit + 1; i < c.secs.length; i++) {
    if (c.secs[i].kind === "jny") { nxtDep = hhmmToMin(c.secs[i].depP || c.secs[i].dep); break; }
  }
  if (arrEta == null || nxtDep == null) return "";
  const buf = nxtDep - arrEta;
  if (buf >= 9) return "";
  const cls = buf < 0 ? " sztkrit" : buf <= 3 ? " sztwarn" : " sztok";
  const txt = buf < 0
    ? "⚠ Anschluss verpasst: Raum-Zeit-Ankunft ~" + sztClockOf(arrEta) + " Uhr in " + escapeHtml(destName || "") + ", Abfahrt " + sztClockOf(nxtDep) + " Uhr"
    : "⚠ Anschluss knapp: Raum-Zeit-Ankunft ~" + sztClockOf(arrEta) + " Uhr in " + escapeHtml(destName || "") + ", Abfahrt " + sztClockOf(nxtDep) + " Uhr (" + buf + " min Puffer)";
  // v1.6.28 (Timo): Knopf "Alternativen wählen" - oeffnet den gewohnten Routen-Dialog
  // mit zwei zusaetzlichen Start-Optionen (mit dem aktuellen Bus / am geplanten
  // Ausstieg der aktuellen Linie) und dem bisherigen Ziel voreingetragen.
  let exLat = null, exLon = null;
  const stps = (c.secs[hit].stops || []);
  for (let j2 = stps.length - 1; j2 >= 0; j2--) {
    const st2 = stps[j2];
    if (st2 && st2.name === destName && st2.lat != null && st2.lon != null) { exLat = st2.lat; exLon = st2.lon; break; }
  }
  const altBtn = ' <button class="achip" data-rtalt="1" data-rtalt-line="' + escapeHtml(String(s.line || "")) +
    '" data-rtalt-exit="' + escapeHtml(String(destName || "")) +
    '" data-rtalt-lat="' + (exLat != null ? exLat : "") + '" data-rtalt-lon="' + (exLon != null ? exLon : "") +
    '" title="Alternative Verbindungen suchen: Start im aktuellen Bus mitfahren oder am geplanten Ausstieg einsteigen, Ziel bleibt unverändert">⤴ Alternativen wählen</button>';
  return '<div class="followhint sztline' + cls + '"><div class="szt">' + txt + altBtn + "</div></div>";
}
// ---------- Raum-Zeit-Fahrtbeobachtung: jeder ANGESEHENE Fahrtverlauf ----------
// (Fahrtverlauf im Stationsreiter UND jeder Fahr-Abschnitt der gewaehlten Route)
// fuettert ab dem Moment, in dem fahrplanmaessig die ersten Stationen durchfahren
// werden, seine beobachteten Ist-/Plan-Zeiten in die Raum-Zeit-Karte: Die Fahr-
// Linie wird um die zuletzt beobachtete Verspaetung entlang der Zeitachse
// verschoben und auf alle kommenden Stationen fortgeschrieben, die
// voraussichtliche Verspaetung steht damit sofort, bevor die Live-Auskunft dort
// Ist-Zeiten liefern wuerde (ohne Beobachtung gilt: voraussichtlich puenktlich).
// Anzeige: kursiver Raum-Zeit-Hinweis, blinkend im Wechsel mit der normalen
// (nicht kursiven) Voraussage. Farben je nach Urteil: gruen = voraussichtlich
// puenktlich, gelb = leichte Verspaetung, rot = starke Verspaetung (ab
// SZT_WATCH_LATE_MIN Minuten), blau = voraussichtlich zu frueh.
const SZT_WATCH_LATE_MIN = 5;      // ab hier gilt die Verspaetung als "stark" (rot)
let sztWatch = new Map();          // key -> { ts, delay, hist: [{ ts, d }] }: Fuetterung je angesehener Fahrt
function sztWrapDiff(aMin, bMin) { // Tages-Wrap-sichere Minuten-Differenz (Ist gegen Plan)
  if (aMin == null || bMin == null) return null;
  let d = aMin - bMin;
  if (d > 720) d -= 1440; else if (d < -720) d += 1440;
  return d;
}
// kursiver Vorhersage-Chip in der Watch-Farbskala (gruen/gelb/rot/blau)
function sztWatchChipHTML(d) {
  const cls = d > 0 ? (d >= SZT_WATCH_LATE_MIN ? "sztw-late" : "sztw-warn") : d < 0 ? "sztw-early" : "sztw-ok";
  const t = d > 0 ? "+" + d + "m" : d < 0 ? d + "m" : "0m";
  return '<span class="tdelay szt ' + cls + '" title="Raum-Zeit-Voraussage aus dem beobachteten Fahrtverlauf">' + t + "</span>";
}
// Kern: beobachtete Verspaetung einer (ggf. ganzen) Fahrt plus Fortschreibung
// auf alle kommenden Stationen (konstante Verspaetung auf der Kette, wie
// sztDigest). norm: [{ p: Plan-Minute, a: Ist-Minute oder null, name }] in
// Lauf-Reihenfolge. Rueckgabe null, solange die Fahrt fahrplanmaessig noch
// nicht unterwegs ist; als Beobachtung zaehlen nur Stationen, die planmaessig
// bereits zurueckgelegt sind (vorausliegende Live-Schaetzungen bleiben draußen).
function sztWatchDigest(key, norm) {
  if (!key || !norm || !norm.length) return null;
  const nowMin = sztNowMin();
  let begin = null;
  for (const e of norm) if (e.p != null) { begin = e.p; break; }   // erste Station der Fahrt
  if (begin == null || sztWrapDiff(nowMin, begin) < 0) return null;   // noch nicht fahrplanmaessig unterwegs
  let obsD = null, obsP = null;
  for (let i = 0; i < norm.length; i++) {
    const e = norm[i];
    if (e.a == null || e.p == null) continue;
    if (sztWrapDiff(e.p, nowMin) > 0) continue;   // Station liegt planmaessig noch vor uns: keine Beobachtung
    const d = sztWrapDiff(e.a, e.p);
    if (d == null) continue;
    obsD = Math.max(-30, Math.min(60, Math.round(d)));
    obsP = e.p;
  }
  const delay = obsD == null ? 0 : obsD;          // ohne Ist-Beobachtung: Lauf wie geplant (gruen)
  let etaEnd = null, endName = "";
  for (let i = norm.length - 1; i >= 0; i--) {
    if (norm[i].p != null) { etaEnd = norm[i].p + delay; endName = norm[i].name || ""; break; }
  }
  const nowMs = Date.now();
  const we = sztWatch.get(key) || { ts: 0, delay: 0, hist: [] };
  we.ts = nowMs; we.delay = delay;
  we.hist.push({ ts: nowMs, d: delay });
  while (we.hist.length > SZT_HIST) we.hist.shift();
  sztWatch.set(key, we);
  if (sztWatch.size > 24) {                      // Karte begrenzen: aelteste Eintraege entsorgen
    const ks = [...sztWatch.keys()].sort((a, b) => sztWatch.get(a).ts - sztWatch.get(b).ts);
    for (let i = 0; i < ks.length - 24; i++) sztWatch.delete(ks[i]);
  }
  return { key, delay, obsD, obsP, etaEnd, endName, hist: we.hist };
}
// Adapter Fahrtverlauf (Stationsreiter): Ist aus der Live-Zeile (s.time) oder
// der gespeicherten GPS-/Tafel-Messung in trip.delay; beobachtet die GESAMTE
// Fahrt (tstops), damit die Karte ab der ersten fahrplanmaessigen Station frisst
function sztTripWatch(trip, tstops) {
  if (!trip || !trip.tripId || !tstops || !tstops.length) return null;
  const norm = tstops.map(s => {
    const dl = trip.delay[s.key || (s.shortName + "|" + trip.tripId)];
    const a = s.time ? hhmmToMin(s.time) : (dl && dl.actualTime ? hhmmToMin(dl.actualTime) : null);
    return { p: hhmmToMin(s.plannedTime), a, name: s.name };
  });
  return sztWatchDigest("t|" + trip.tripId, norm);
}
// Adapter Route-Abschnitt: Ist aus dR/aR; bei aufgeklapptem ganzer Lauf (ext)
// beobachtet die Karte den kompletten Lauf, sonst diesen Abschnitt. gpsLiveMin:
// eigene GPS-Uhr bzw. ETA am eigenen Halt (nur ohne ext, Index gilt in sts).
function sztSecWatch(sec, sts, extOn, gpsLiveMin, atIdx) {
  const src = extOn && sec.extStops && sec.extStops.length ? sec.extStops : (sts || []);
  if (!src.length) return null;
  const norm = src.map((st, i) => ({
    p: hhmmToMin(st.dS || st.aS),
    a: st.dR ? hhmmToMin(st.dR) : (st.aR ? hhmmToMin(st.aR) :
      (!extOn && gpsLiveMin != null && atIdx === i ? gpsLiveMin : null)),
    name: st.name
  }));
  return sztWatchDigest("s|" + (sec.jid || (sec.line + "|" + sec.from + "|" + (sec.dep || ""))), norm);
}
// Kompakte Raum-Zeit-Ankunft unter der Ausstiegs-/Zielstation (v1.3.12): Der
// ehemalige Kopf-Hinweis ueber der Liste (wechselnde Fahrplan- und Raum-Zeit-
