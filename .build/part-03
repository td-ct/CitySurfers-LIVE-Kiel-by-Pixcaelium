let vehLastScan = 0;
let vehScanId = 0;            // stehende alte Durchläufe verwerfen
const vehStopsCache = new Map();   // tripId -> { ts, stops, route, dir } | { ts, bad: true }
const VEH_CFG_KEY = "kvg-vehcfg";
const VEH_CFG_MINS = [1, 2, 3, 4, 5];        // Zeitfenster ± Minuten (Standard 2)
const VEH_CFG_MS = [100, 250, 500, 1000];    // Bus-Stations-Umkreis in Metern (Standard 250)
const VEH_CFG_KMS = [5, 10, 25, 100, 250];   // Bahn-Stations-Umkreis in Kilometern (Standard 10)
let vehCfg = { min: 2, m: 250, km: 10 };
let vehCfgDirty = false;   // Regler wurde während eines Laufs geändert: danach neu suchen
try { const c = JSON.parse(localStorage.getItem(VEH_CFG_KEY) || "null");
  if (c && VEH_CFG_MINS.indexOf(c.min) >= 0 && VEH_CFG_MS.indexOf(c.m) >= 0) {
