  const full = bigAssign.length - 1 >= BIGBTN_MAX;
  const last = bigAssign.length - 1 <= 1;   // v1.4.15: nur ein Favoriten-Knopf übrig: Löschen gesperrt
  let inner = '<div class="afshead"><span><b>Knopf ' + i + '</b>: was soll passieren?</span></div>';
