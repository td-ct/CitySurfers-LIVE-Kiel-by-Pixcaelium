    ". Kursiv = Raum-Zeitwert aus dem beobachteten Verlauf." +
    (exitName ? " Station: " + escapeHtml(exitName) : "");
  return '<div class="sztexit szt ' + cls + '" title="' + tit + '">≈ ' +
