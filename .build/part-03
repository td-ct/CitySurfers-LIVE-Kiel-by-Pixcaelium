  const cls = d > 0 ? "up" : d < 0 ? "down" : "ok";
  const txt = d > 0 ? "+" + d + "m" : d < 0 ? d + "m" : "0m";
  return ' <span class="tdelay ' + cls + '">' + txt + "</span>";
}
// v1.6.4: Countdown-Chip der Routen-Suche und des Routen-Verlaufs ("los in X
// min" bis zum Aufbruch inklusive Fuß-/Rad-/Roller-Zubringer, "da in X min" bis
// zur Ankunft): gruen im Normalfall, gelb in den letzten 3 Minuten - ab dort
// tickt die Zahl als M:SS ueber den 1-Sekunden-Countdown-Ticker mit (genau wie
// es die Fahrplan- oder Echtzeit-Zielzeit eben hergibt) -, rot nach Verstreichen
// der Zeit. absMs = Zielzeit absolut in Millisekunden, preTxt/postTxt umschließen
// die Zahl, missTxt ersetzt den Text ab dem Verstreichen (Standard "vor X min.").
function routeCdChipHTML(absMs, preTxt, postTxt, missTxt) {
  if (absMs == null || !isFinite(absMs)) return "";
  const dMs = absMs - Date.now();
  const pre = preTxt == null ? "in " : preTxt;
  const post = postTxt == null ? " min" : postTxt;
  if (dMs > 0) {
    if (dMs <= CD_MAX_S * 1000)   // Fenster echter Sekunden-Countdown (Ziel aus Live-/Planzeit)
      return '<span class="rtxm soon" title="Sekunden-Countdown auf die Fahrplan- oder Echtzeit-Zielzeit">' + pre +
        '<span class="cd" data-cd="' + Math.round(absMs) + '">' + cdFmt(dMs) + "</span>" + post + "</span>";
    return '<span class="rtxm ok">' + pre + Math.round(dMs / 60000) + post + "</span>";
  }
  if (dMs > -45000) return '<span class="rtxm soon">' + (missTxt || "jetzt") + "</span>";
  return '<span class="rtxm missed">' + (missTxt || ("vor " + Math.round(-dMs / 60000) + " min.")) + "</span>";
}
// (v1.6.5: Der Raum-Zeit-Chip je Bus-/Bahn-Zeile entsteht jetzt direkt in
// rtTimeCols aus der selben sztSecWatch-Beobachtung; die ehemals separate
// Chip-Funktion ist entfallen.)
// ---------- Pinker Fortschritt ueber die gewaehlte Route (Gesamt-Punkt) ----------
// Fortschritt in einem Zubringer-Abschnitt (Fussweg/Rad): "nach echtem Weg" –
// ab dem Einstieg am Startpunkt werden die tatsaechlich zurueckgelegten
// GPS-Meter summiert und auf die echte Weglaenge (gis.dist) bezogen: ein
// Drittel Fussweg = ein Drittel Punkt. Spruenge (GPS-Teleport) zaehlen nicht.
function routeWalkFrac(rc, si, pos) {
  const sec = rc.con.secs[si];
  if (!sec || !pos || sec.fromLat == null || sec.toLat == null) return null;
  const tab = rc.wacc = rc.wacc || {};
  const acc = tab[si] = tab[si] || { last: null, m: 0, on: false };
  const from = { lat: sec.fromLat, lon: sec.fromLon };
  const to = { lat: sec.toLat, lon: sec.toLon };
  if (!acc.on) {   // Einstieg: nahe am Startpunkt beginnt die Zaehlung
    if (dist(pos, from) <= Math.max(60, pos.accuracy || 0)) { acc.on = true; acc.last = pos; acc.m = 0; }
    else return null;
  } else if (acc.last) {
    const step = dist(acc.last, pos);
    if (step >= 1.5 && step < 60) acc.m += step;   // Spruenge (>= 60 m) = GPS-Teleport: nicht zaehlen
    acc.last = pos;
  }
  if (sec.distM != null && sec.distM > 0) {
    if (dist(pos, to) <= Math.max(30, pos.accuracy || 0)) acc.m = sec.distM;   // Ziel erreicht: voll
    return Math.max(0, Math.min(1, acc.m / sec.distM));
  }
  return segFrac(from, to, pos);   // ohne Weglaenge: Geraden-Anteil
}
// Fortschritt ueber die GEWAEHLTE Route: sequenzieller Zustand in rc.rps
// (monoton, nie rueckwaerts). Abschnitt = jny (Projektion auf den Stop-Zug,
// Korridor 350 m) oder Zubringer (routeWalkFrac). Rueckgabe:
// { cur: Abschnitt-Index|null, frac: Anteil darin, fills: [0..1 je Abschnitt] }
function routeProgress(rc, pos, nowMs) {
  const secs = rc && rc.con && rc.con.secs;
  if (!secs || !secs.length) return { cur: null, frac: 0, fills: [] };
  const st = rc.rps = rc.rps || { si: null, frac: 0, done: -1 };
  const fills = secs.map(() => 0);
  if (!pos) { st.si = null; st.frac = 0; return { cur: null, frac: 0, fills: fills }; }
  const ptsOf = function (si) {
    if (si < 0 || si >= secs.length) return null;
    const s = secs[si];
    if (s.kind === "jny") {
      const pts = (s.stops || []).filter(q => q && q.lat != null && q.lon != null)
        .map(q => ({ lat: q.lat, lon: q.lon }));
      return pts.length >= 2 ? pts : null;
    }
    if (s.fromLat == null || s.toLat == null) return null;
    return [{ lat: s.fromLat, lon: s.fromLon }, { lat: s.toLat, lon: s.toLon }];
  };
  // laufenden Abschnitt fortschreiben (monoton: Rueckschritte frieren ein)
  if (st.si != null && st.si < secs.length) {
    const si = st.si, pts = ptsOf(si);
    const to = pts ? pts[pts.length - 1] : null;
    let f = null;
    if (secs[si].kind === "jny") {
      const pr = pts && polyFrac(pts, pos);
      if (pr && pr.d <= 350) f = pr.frac;
    } else {
      f = routeWalkFrac(rc, si, pos);
    }
    if (f != null) st.frac = Math.max(st.frac, Math.min(0.995, f));
    if (st.frac >= 0.995 || (to && dist(pos, to) <= 36)) {   // Abschnitt abgeschlossen
      st.done = Math.max(st.done, si);
      st.si = si + 1 < secs.length ? si + 1 : null;
      st.frac = 0;
    }
  }
  // kein laufender Abschnitt: Einstieg suchen (nah am Start oder im Verlauf)
  if (st.si == null || st.si >= secs.length) {
    for (let si = st.done + 1; si < secs.length; si++) {
      const pts = ptsOf(si);
      if (!pts) continue;
      const near = dist(pos, pts[0]) <= 120;
      const pr = polyFrac(pts, pos);
      const corr = secs[si].kind === "jny" ? (pr && pr.d <= 150) : (pr && pr.d <= 120);
      if (near || corr) {
        st.si = si;
        st.frac = near ? 0 : Math.min(0.5, pr ? pr.frac : 0);
        if (secs[si].kind !== "jny") {   // Zubringer mitten im Verlauf: Zaehler passend starten
          const tab = rc.wacc = rc.wacc || {};
          const acc = tab[si] = tab[si] || { last: null, m: 0, on: false };
          if (!acc.on) { acc.on = true; acc.last = pos;
            acc.m = (secs[si].distM || 0) * st.frac; }
        }
        break;
      }
    }
  }
  // Fills erst nach dem Zustands-Update: abgeschlossene Abschnitte voll, der
  // laufende zum GPS-Anteil, kommende leer (pinke Balken je Abschnitt)
  for (let i = 0; i <= st.done && i < fills.length; i++) fills[i] = 1;
  if (st.si != null && st.si < secs.length) {
    fills[st.si] = Math.max(0, Math.min(1, st.frac));
  }
  return { cur: (st.si != null && st.si < secs.length) ? st.si : null, frac: st.frac, fills: fills };
}

// ---------- Dot-Engines: setzen nur Stile, bauen kein Panel neu ----------
// ---------- Leuchtpunkt-Platzierung (rein geometrisch) ----------
// Ueber ALLE sichtbaren Stationspaare wird das Segment mit dem kleinsten
// Luftlinien-Abstand zur GPS-Position gesucht; zurueck kommen Segment-Index,
// Anteil darauf und der Abstand - unabhaengig davon, ob die Uhrzeit zu
// Fahrplan-, Echtzeit- oder Raum-Zeit-Werten passt. Genau dann rueckt der
// Punkt naemlich nach: Passt keine Zeit (das Abhaken bleibt in dem Fall
// aus), zeigte er frueher stur am Anfangs-Abschnitt haengend; jetzt steht
// er dort, wo du wirklich bist.
function dotSegBest(pos, segs) {   // segs [{i0, i1|null, a, b|null}] -> {i0, i1, f, d, pos, amb}|null
  const cand = [];
  for (const s of segs) {
    let f = 0, d = null;
    if (s.b) {
      const t = segFrac(s.a, s.b, pos);
      if (t == null) continue;
      const proj = { lat: s.a.lat + (s.b.lat - s.a.lat) * t, lon: s.a.lon + (s.b.lon - s.a.lon) * t };
      f = t; d = dist(proj, pos);
    } else {
      d = dist(s.a, pos);
    }
    // pos = kontinuierliche Stations-Position im Index-Raum (i0 + Anteil Richtung i1)
    cand.push({ i0: s.i0, i1: s.i1, f: f, d: d, pos: (s.i1 != null && s.b) ? s.i0 + f : s.i0 });
  }
  if (!cand.length) return null;
  cand.sort((x, y) => x.d - y.d);
  const best = cand[0];
  // v1.6.17 Mehrdeutigkeit: Eine Verlaufsspur, die auf sich selbst zurueckfaehrt
  // (gleiche oder parallele Strecke nochmal), hat ZWEI fast gleich nahe Projektions-
  // Kandidaten weit auseinander. Genau dann (amb) entscheidet die Raum-Zeit, nicht
  // die Geometrie; sonst bleibt die reine GPS-Projektion Master, vor und zurueck.
  let second = null;
  for (let i = 1; i < cand.length; i++)
    if (Math.abs(cand[i].pos - best.pos) > TRIP_AMB_GAP) { second = cand[i]; break; }
  best.amb = !!(second && second.d <= best.d + TRIP_AMB_D);
  return best;
}
// Dasselbe fuer die gewaehlte Route: naechstliegender Abschnitt UEBER ALLE
// Abschnitte (jny: Polyline der Halte, Zubringer: Start-Ziel-Gerade), ohne
// Zeit- und ohne Fortschritts-Zustand. Zwei Erweiterungen v1.3.12:
// (1) extOf(si) liefert bei aufgeklapptem ganzer Lauf die Erweiterungs-Stationen;
// die Laufbahn des Punkts rechnet dann ueber den KOMPLETTEN Lauf, passend zu den
// angezeigten Zeilen. (2) prefSi = der laut routeProgress LAUFENDE Abschnitt:
// Dessen Kandidat behaelt den Punkt, solange er hoechstens TRIP_DOT_PREF_M
// hinter dem geometrisch besten liegt. Genau das verhindert die Kreis-Spruenge
// am Umstieg (Bahnhof-Bushaltestelle-Uebergang: der Punkt laeuft den Weg durch,
// statt vom Ausstiegs-Kreis zum Einstiegs-Kreis zu teleportieren), und es haelt
// den Punkt bei rauschigem GPS stabiler im Fahrzeug.
function routeDotBest(secs, pos, prefSi, extOf) {
  let best = null, pref = null, cands = [], cum = 0;   // cum = Stations-Zaehler vor dem aktuellen Abschnitt (Verlaufs-Raum)
  for (let si = 0; si < secs.length; si++) {
    const s = secs[si];
    let f = null, d = null, seg = null;
    if (s.kind === "jny") {
      const ext = extOf ? extOf(si) : null;
      const raw = (ext && ext.length ? ext : s.stops) || [];
      const pr = rowSyncFrac(raw, pos);   // Original-Indizes: 1:1 auf die Zeilen abbildbar
      if (pr) { f = pr.frac; d = pr.d; seg = { k: pr.k, sub: pr.sub }; }
    }
    if (f == null && s.fromLat != null && s.fromLon != null && s.toLat != null && s.toLon != null) {
      if (s.kind === "jny") {
        const pr = polyFrac([{ lat: s.fromLat, lon: s.fromLon }, { lat: s.toLat, lon: s.toLon }], pos);
        if (pr) { f = pr.frac; d = pr.d; }
      } else {
        // Zubringer (Fussweg, Fahrrad, Roller, mitfahrend): Reststrecke relativ
        // uebersetzen: Der Punkt sitzt auf dem Strahl dort, wo du zwischen Weg-
        // Start und Weg-Ziel gerade stehst, vorwaerts wie rueckwaerts. Weglaenge
        // = echte Strecke (distM), das Abseits-Mass fuer die Abschnitts-Wahl
        // haelt sich an die Ellipse um den Weg (Luftlinien-Dreiecksluecke / 2).
        const fa = { lat: s.fromLat, lon: s.fromLon };
        const ta = { lat: s.toLat, lon: s.toLon };
        const legLen = (s.distM != null && s.distM > 0) ? s.distM : dist(fa, ta);
        if (legLen > 0) {
          const rem = dist(pos, ta);
          const before = dist(pos, fa);
          if (before + rem <= legLen * ROUTE_DOT_WALK_DET + ROUTE_DOT_WALK_ADD_M) {
            if (before > legLen) f = 1;   // hinter dem Weg-Ziel: Punkt bleibt am Ende stehen
            else f = Math.max(0, Math.min(1, 1 - rem / legLen));
            d = Math.max(0, (before + rem - legLen) / 2);
          }
        }
      }
    }
    if (f == null) continue;
    const cand = { si: si, frac: f, d: d, seg: seg };
    // Verlaufs-Position im kumulativen Stations-Raum: abslouter Station-Zaehler
    // ueber alle Abschnitte + Position im eigenen (k+sub bei jny, sonst frac)
    cand.room = cum + (seg ? (seg.k + seg.sub) : f);
    cum += (s.stops && s.stops.length) ? s.stops.length : 1;
    cands.push(cand);
    if (best == null || d < best.d) best = cand;
    if (prefSi != null && si === prefSi) pref = cand;
  }
  if (pref && best && pref.si !== best.si && pref.d <= best.d + TRIP_DOT_PREF_M) best = pref;
  // v1.6.17 Mehrdeutigkeit: Ein Kandidat im kumulativen Stations-Raum klar
  // versetzt (gleiche Linie/Spur faehrt zurueck, Rundkurs), der fast genauso
  // nah dran ist, macht die reine GPS-Geometrie unsicher -> amb: Dann
  // entscheidet die Raum-Zeit (rrTimePos), sonst bleibt die Geometrie Master.
  // Der nah am Umstieg liegende Nachbar-Abschnitt zaehlt dabei NICHT als
  // Mehrdeutigkeit (Abstand im Stations-Raum klein).
  let second2 = null;
  for (const c of cands)
    if (Math.abs(c.room - best.room) > TRIP_AMB_GAP && (second2 == null || c.d < second2.d)) second2 = c;
  best.amb = !!(second2 && second2.d <= best.d + TRIP_AMB_D);
  return best;
}
// Blauer Punkt im Fahrtverlauf: laeuft kontinuierlich auf der Linie zwischen
// den Stations-Kreisen, HINTER ihnen hindurch bis in ihre Mitte. Die Platzie-
// rung kommt rein geometrisch aus dotSegBest (siehe oben), der Cut-off blendet
// den Punkt als unrealistisch weit weg aus, die Hysterese haelt ihn gegen
// Flackern an der Grenze unsichtbar, bis der Abstand wieder wirklich klein ist.
// ---------- v1.6.11: Raum-Zeit-Strahl (zeitproportionaler Fortschritt) ----------
// Projizierte Passage-Zeit (ms) je Station eines Fahrtverlaufs: Rangfolge der
// Quellen = eigene GPS-ETA (mark, sicherste Quelle, sekundengenau) > Live-Ist
// (Tafel/trip.delay) > Plan + Raum-Zeit-Delay (Fahrzeug-Erkennung mit Vorrang,
// sonst die Fahrt-Beobachtung aus sztWatch) > Plan allein. Null = keine Zeit.
// v1.6.17: Diese Zeiten tragen den Strahl NUR noch in unsicheren Faellen (kein
// GPS, weit abseits, mehrdeutige Spur); mit sicherem GPS entscheidet die
// geometrische Projektion allein (Spitze = echte Position, vor und zurueck).
function tripBeamTimes(trip, tstops) {
  if (!trip || !tstops || !tstops.length) return null;
  const veh = sztFresh();
  const vehOn = veh && veh.tripId === trip.tripId ? veh : null;
  let wDelay = null;
  const we = sztWatch.get("t|" + trip.tripId);
  if (we && Date.now() - we.ts <= 10 * 60 * 1000) wDelay = we.delay;
  const dUse = vehOn != null ? vehOn.delay : wDelay;
  const mark = trip.mark;
  const out = [];
  for (let i = 0; i < tstops.length; i++) {
    const s = tstops[i];
    const key = s.key || (s.shortName + "|" + trip.tripId);
    const dl = trip.delay && trip.delay[key];
    const planned = (dl && dl.plannedTime) || s.plannedTime || "";
    let t = null;
    if (s.time || (dl && dl.actualTime)) t = hhmmAbsMs(s.time || dl.actualTime);
    else {
      const p = planned ? hhmmAbsMs(planned) : null;
      if (p != null && dUse != null) t = p + dUse * 60000;
      else t = p;
    }
    if (mark && mark.idx === i && mark.etaTs) t = mark.etaTs;   // eigene GPS-ETA an der eigenen Station übersteuert still (v1.6.11)
    out.push(t);
  }
  return out;
}
// Strahl-Position im Index-Raum der Stationen aus den projizierten Zeiten:
// PASST ist jede Station mit Zeit <= jetzt (der Strahl läuft mindestens bis zum
// letzten passiertem Kreis), dazwischen zeitenproportional (Fortschritt
// zwischen den beiden Stationen). Rückgabe k+f (0-basiert, Index-Raum) oder
// null, solange noch keine StationTimeString-Ordnung greift (vor Fahrtbeginn).
function beamIdxOfTimes(times, nowMs) {
  if (!times || !times.length) return null;
  let any = false;
  for (const t of times) if (t != null) { any = true; break; }
  if (!any) return null;
  let k = -1;
  for (let i = 0; i < times.length; i++)
    if (times[i] != null && times[i] <= nowMs) k = i;
  if (k < 0) return null;   // vor der ersten projetierbaren Station: noch kein Strahl
  if (k >= times.length - 1) return k;   // Ziel (bzw. letzte Zeile) passiert: voll
  const tn = times[k + 1];
  if (tn == null) return k;
  const span = tn - times[k];
  if (span <= 0) return k;
  return k + Math.max(0, Math.min(1, (nowMs - times[k]) / span));
}
// Strahl im Stations-Fahrtverlauf nachführen (500-ms-Ticker): Füllung zwischen
// der Mitte des ersten und der Mitte des letzten sichtbaren Kreises, die SPITZE
// (v1.6.17) an der exakten GPS-Projektion zwischen den zwei naechsten Stationen;
// ohne GPS, bei weitem Abseits-Stand oder mehrdeutiger Spur laeuft die Spitze
// zeitproportional (Raum-Zeit-Prognose), wie gehabt.
function updateTripBeam() {
  const wrapEl = (busPanel && !busPanel.hidden) ? busPanel.querySelector(".trip") : null;
  const beam = wrapEl && wrapEl.querySelector(".tripbeam");
  if (!beam) return;
  const tstops = currentTrip && currentTrip.stops;
  const use = !!(wrapEl && tstops && tstops.length && currentBus && currentBus.tripOpen !== false);
  if (!use) { beam.style.display = "none"; wrapEl.querySelectorAll(".trow.tpass").forEach(el => el.classList.remove("tpass")); return; }
  const rows = {};
  wrapEl.querySelectorAll(".trow[data-tri]").forEach(el => { rows[Number(el.dataset.tri)] = el; });
  const vis = Object.keys(rows).map(Number).sort((x, y) => x - y);
  if (vis.length < 2) { beam.style.display = "none"; return; }
  const times = tripBeamTimes(currentTrip, tstops);
  const idx = times ? beamIdxOfTimes(vis.map(i => times[i]), Date.now()) : null;
  const wr = wrapEl.getBoundingClientRect();
  const cyc = i => { const r = rows[i].getBoundingClientRect(); return r.top + r.height / 2 - wr.top; };
  const y0 = cyc(vis[0]), y1 = cyc(vis[vis.length - 1]);
  // v1.6.17 Strahl-SPITZE = exakte GPS-Projektion: Der Strahl endet haargenau
  // dort, wo sich die aktuelle Position zwischen den ZWEI naechsten Stationen
  // geometrisch hinprojiziert (Abstands-Verhaeltnis, vor und zurueck mitlaufend,
  // nicht mehr nur als Minimum zur Raum-Zeit-Prognose). Die Zeit entscheidet
  // AUSSCHLIESSLICH in unsicheren Faellen: kein GPS, GPS weit abseits oder eine
  // mehrdeutige Spur (Verlauf faehrt auf sich selbst zurueck, gleiche Linie
  // wieder entgegen) - nur dann laeuft die Spitze zeitproportional (Raum-Zeit).
  let geo = null;
  if (gpsState === "on" && myPos) geo = dotSegBest(myPos, tripGeomSegs(wrapEl, tstops).segs);
  const geoSolid = !!(geo && !geo.amb && geo.d <= TRIP_DOT_MAX_M);
  let y = null, yT = null;
  // v1.6.26 (Timo): Der Prognose-Strahl schreitet MIT DER UHR fort (Raum-Zeit-Prognose
  // der Fahrt), unabhaengig von der eigenen Position. Die eigene GPS-Projektion kann ihn
  // nur nach vorn schieben (wenn man selbst an Bord ist), niemals bremsen: Strahl-Spitze
  // = Maximum aus GPS-Geometrie und Zeit-Fortschritt, wie im Gesamtfahrtverlauf.
  if (idx != null) {
    const far = Math.min(vis.length - 1, idx);   // Position im sichtbaren Index-Raum
    const kk = Math.floor(far);
    yT = cyc(vis[kk]);
    if (kk + 1 < vis.length && far - kk > 0) yT += (far - kk) * (cyc(vis[kk + 1]) - yT);
  }
  if (geoSolid) {
    const gr0 = rows[geo.i0].getBoundingClientRect();
    const gy0 = gr0.top + gr0.height / 2 - wr.top;
    y = gy0;
    if (geo.i1 != null && rows[geo.i1]) {
      const gr1 = rows[geo.i1].getBoundingClientRect();
      y = gy0 + geo.f * (gr1.top + gr1.height / 2 - wr.top - gy0);
    }
  } else if (geo && yT == null) {
    // keine projizierbare Zeit, aber GPS: Strahl folgt der Geometrie trotzdem
    const gr0 = rows[geo.i0].getBoundingClientRect();
    y = gr0.top + gr0.height / 2 - wr.top;
    if (geo.i1 != null && rows[geo.i1]) {
      const gr1 = rows[geo.i1].getBoundingClientRect();
      y += geo.f * (gr1.top + gr1.height / 2 - wr.top - (gr0.top + gr0.height / 2 - wr.top));
    }
  }
  if (yT != null) y = (y == null) ? yT : Math.max(y, yT);
  if (y == null) { beam.style.display = "none"; wrapEl.querySelectorAll(".trow.tpass").forEach(el => el.classList.remove("tpass")); return; }
  y = Math.max(y0, Math.min(y1, y));
  // v1.6.23 (Timo): Port aus dem Gesamtfahrtverlauf - der Strahl aktiviert die
  // Stationskreise STATIONSSYNCHRON, jeder Kreis genau im Moment des geometri-
  // schen Passierens, vor und zurueck mitlaufend. EINE Farbe wie der Strahl.
  vis.forEach(i => {
    const r2 = rows[i].getBoundingClientRect();
    rows[i].classList.toggle("tpass", (r2.top + r2.height / 2 - wr.top) <= y + 0.5);
  });
  beam.style.display = "";
  beam.style.top = y0 + "px";
  beam.style.height = Math.max(0, Math.round(y - y0)) + "px";
}
// v1.6.17: Stations-Segmente des sichtbaren Verlaufs (Zeilen-Koordinaten und
// their stations) gemeinsam fuer Leuchtpunkt und Strahl: Eine Quelle, damit die
// Spitze des Strahls und der Punkt immer dieselbe Position ausweisen.
function tripGeomSegs(wrapEl, tstops) {
  const rows = {};
  wrapEl.querySelectorAll(".trow[data-tri]").forEach(el => { rows[Number(el.dataset.tri)] = el; });
  const vis = Object.keys(rows).map(Number).sort((x, y) => x - y);
  if (!vis.length) return { rows: rows, vis: vis, segs: [] };
  const stopOf = i => (tstops[i] && tstops[i].lat != null) ? tstops[i] :
    (stops.find(x => x.shortName === tstops[i].shortName) || dbStopOf(tstops[i].shortName));
  const segs = [];
  for (let k = 0; k < vis.length; k++) {
    const a = stopOf(vis[k]);
    const nb = k + 1 < vis.length ? vis[k + 1] : null;
    const b = nb != null ? stopOf(nb) : null;
    if (a && b) segs.push({ i0: vis[k], i1: nb, a: a, b: b });
    else if (a && nb == null) segs.push({ i0: vis[k], i1: null, a: a, b: null });   // letzte sichtbare Zeile als Punkt-Anker
  }
  return { rows: rows, vis: vis, segs: segs };
}