// ist weggefallen. Stattdessen steht genau EINE kurze kursive Zeile direkt
// unter der Station, an der du aussteigst bzw. unter der Zielstation: Ziel-
// Uhrzeit plus Minuten-Abweichung, Farbe in der Watch-Skala, Details im
// title-Tooltip. Erscheint nur, wenn die beobachtete Fahrt um MEHR als
// SZT_WATCH_EXIT_MIN Minuten vom Fahrplan abweicht (bei puenktlicher oder
// knapper Voraussage bleibt die Zeile bewusst weg).
const SZT_WATCH_EXIT_MIN = 2;
function sztExitHTML(w, exitP, exitName) {
  if (!w || w.delay == null || exitP == null) return "";
  const d = w.delay;
