// 🔔/🔕 Ruhe-Knopf: Wecker und „Finde nach Hause“ gemeinsam (Zyklus s. oben)
function setAlarmsOff(off) {   // Wecker global: Nebenwirkungen wie frueher einzeln
  alarmsOff = off;
  try { localStorage.setItem("kvg-alarms-off", alarmsOff ? "1" : "0"); } catch (e) {}
  if (alarmsOff) {
    for (const k of [...ringing.keys()]) stopRinging(k, true);   // laufende Läut-Ketten beenden
    for (const k of [...alarms.keys()]) nativeCall("cancelAlarm", k);   // native Wecker/Zäune raus
  } else {
    syncGeofences();   // Geofence-Zäune wieder registrieren
    for (const [k, a] of alarms) {
      if (a.leadMin != null) {   // native Zeit-Wecker wieder planen
        const ms = nativeAlarmEpoch(k, a.leadMin);
        if (ms != null) nativeCall("setAlarm", k, String(ms), a.name,
          JSON.stringify({ lead: a.leadMin, vib: a.vib !== false, tone: a.tone !== false,
            snd: a.snd || "alarm", vol: a.vol == null ? 1 : a.vol }));
      }
    }
  }
}
function setFhOff(off) {   // Nach-Hause-Suche global
  fhOff = off;
  try { localStorage.setItem("kvg-fh-off", fhOff ? "1" : "0"); } catch (e) {}
  if (fhOff) nativeCall("cancelNotify", "fh-scan");
}
let muteLastTs = 0;
bbMute.addEventListener("click", () => {
  const state = (alarmsOff ? 1 : 0) | (fhOff ? 2 : 0);   // 0=an/an 1=Wecker aus 2=Hinweise aus 3=beides aus
  const next = muteNextState(state, Date.now() - muteLastTs);
  muteLastTs = Date.now();
  if (!!(next & 1) !== alarmsOff) setAlarmsOff(!!(next & 1));
  if (!!(next & 2) !== fhOff) setFhOff(!!(next & 2));
  renderBigToggles();
  renderAlarmInd();
  setLocNote(next === 3
    ? "🔕 Wecker und „Finde nach Hause“ stumm. Schnell nochmal antippen: nur Wecker bzw. nur Hinweise."
    : next === 1
      ? "🔕 Nur die Wecker sind stumm (gestellt bleiben sie) – „Finde nach Hause“ läuft weiter."
      : next === 2
        ? "🔕 Nur „Finde nach Hause“ ist stumm – die Wecker laufen weiter."
        : "🔔 Wecker und „Finde nach Hause“ wieder an.");
});

// Belegbare Favoriten-Knöpfe (v1.4.14): Langer Druck fragt erst, was gemeint
// ist: diesen Knopf (neu) belegen oder einen weiteren Favoriten-Knopf in der
// Leiste erzeugen. Einfacher Klick = Aktion bzw. Belegung, wenn der Knopf frei
// ist. Knöpfe über die Obergrenze BIGBTN_MAX hinaus werden dynamisch erzeugt
// und über kvg-bigbtns (Arraylänge) mit-restauriert.
let bbPressTimer = null, bbLongFired = false;
function rigBigBtn(b, i) {
  b.addEventListener("pointerdown", () => {
    bbLongFired = false;
    clearTimeout(bbPressTimer);
    bbPressTimer = setTimeout(() => { bbLongFired = true; openBigLongDlg(i + 1); }, 550);
  });
  ["pointerup", "pointerleave", "pointercancel"].forEach(ev =>
    b.addEventListener(ev, () => clearTimeout(bbPressTimer)));
  b.addEventListener("click", () => {
    if (bbLongFired) { bbLongFired = false; return; }   // Aktion nach Langdrücken unterdrücken
    const a = bigAssign[i + 1];
    if (!a) { openBigAssignDlg(i + 1); return; }
    if (a.kind === "addr") {
      const f = addrFavs.find(x => x.name === a.name);
      if (!f) { openBigAssignDlg(i + 1); return; }
      // Adressfavorit als Startadresse einsetzen, immer mit den gespeicherten Koordinaten
      addrPos = { lat: f.lat, lon: f.lon, label: f.name };
      try { localStorage.setItem("kvg-addr", JSON.stringify(addrPos)); } catch (e) {}
      addrSug.hidden = true;
      addrSearch.value = f.name;   // Adresse im Feld zeigen (✕ setzt zurück)
      addrSearch._loc = null;
      renderAddrChip();
      locBtn.classList.add("disabled");
      positionReset();
      clearStopSearchOnAddrLogin();   // wie Adress-Login: Suchtext weg, Feld-GPS der Stationssuche aus
      setLocNote("Adressfavorit aktiv: " + f.name + " · Listen danach sortiert. ✕ im Adressfeld kehrt zum GPS zurück.");
      renderPanels();
      openStopListAfterFav();   // Haltestellenliste sofort neu sortiert aufklappen
    } else {
      const s = stops.find(x => x.shortName === a.sn);
      if (!s) { openBigAssignDlg(i + 1); return; }
      selectStop(a.sn);   // neuen Stationsreiter anlegen und öffnen
      setLocNote("Haltestellenfavorit geöffnet: " + s.name);
      openStopListAfterFav();   // Haltestellenliste gleich mit aufklappen
    }
  });
}
function addBigBtn() {   // weiteren Favoriten-Knopf dynamisch in die Leiste setzen
  if (bigAssign.length - 1 >= BIGBTN_MAX) {
    setLocNote("Bereits alle " + BIGBTN_MAX + " Favoriten-Knöpfe der Leiste vergeben.");
    return false;
  }
  bigAssign.push(null);
  saveBigAssign();
  const nb = document.createElement("button");
  nb.className = "bigbtn " + BIGBTN_COLS[bbBtns.length % BIGBTN_COLS.length];   // v1.4.16: Farb-Rotation
  nb.title = "Langer Druck: Favorit hier neu belegen, weiteren Favoriten-Knopf erzeugen oder diesen Knopf löschen";
  nb.innerHTML = '<span class="bbsym">☆</span><small>frei</small>';
  document.getElementById("bigbtns").appendChild(nb);
  bbBtns.push(nb);
  rigBigBtn(nb, bbBtns.length - 1);
  renderBigBtns();
  updateBigBtnsLayout();
  setLocNote("Weiterer Favoriten-Knopf ist in der Leiste entstanden: Langer Druck belegt ihn.");
  return true;
}
function ensureBigBtns() {   // v1.4.16: alle Favoritenknöpfe dynamisch erzeugen (Start-Setup: einer)
  while (bbBtns.length < Math.min(BIGBTN_MAX, Math.max(1, bigAssign.length - 1))) {
    const nb = document.createElement("button");
    nb.className = "bigbtn " + BIGBTN_COLS[bbBtns.length % BIGBTN_COLS.length];   // v1.4.16: Farb-Rotation
    nb.title = "Langer Druck: Favorit hier neu belegen, weiteren Favoriten-Knopf erzeugen oder diesen Knopf löschen";
    nb.innerHTML = '<span class="bbsym">☆</span><small>frei</small>';
    document.getElementById("bigbtns").appendChild(nb);
    bbBtns.push(nb);
    rigBigBtn(nb, bbBtns.length - 1);
  }
  renderBigBtns();
  updateBigBtnsLayout();
}
function deleteBigBtn(i) {   // v1.4.16: Favoriten-Knopf aus der Leiste entfernen (niemals der letzte)
  if (bigAssign.length - 1 <= 1) {   // nur dieser eine Knopf übrig: in der Leiste bleibt immer einer existent
    setLocNote("Der letzte Favoriten-Knopf bleibt in der Leiste stehen.");
    return false;
  }
  bigAssign.splice(i, 1);   // Belegung (oder freier Platz) dieses Knopfs entfernen
  saveBigAssign();
  bbBtns.forEach(b => { if (b) b.remove(); });   // v1.4.16: ALLE Favoritenknöpfe sind dynamisch, komplette Leiste frisch aufbauen
  bbBtns.length = 0;
  ensureBigBtns();   // Knöpfe passend zur neuen Knopfzahl frisch erzeugen und verdrahten
  setLocNote("Favoriten-Knopf " + i + " ist aus der Leiste entfernt: Belegungen rutschen nach, mindestens einer bleibt.");
  return true;
}
// v1.4.14: Langdruck-Auswahl des Favoriten-Knopfs (Belegen oder weiteren Knopf erzeugen)
