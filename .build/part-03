function routeStopMatch(nm) {
  const norm = q => String(q || "").toLowerCase().replace(/\(db\)/g, "").replace(/[^a-zäöüß0-9]/g, "");
  const n = norm(nm);
  if (!n || n.length < 5) return null;
  for (const st of stops) {
    const m = norm(st.name);
    if (!m || m.length < 5) continue;
    if (m === n || (n.length >= m.length && n.endsWith(m)) || (m.length >= n.length && m.endsWith(n))) return st.shortName;
  }
  return null;
}
