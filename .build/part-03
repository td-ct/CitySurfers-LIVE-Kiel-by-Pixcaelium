function routeApplySort(cons) {   // v1.6.1: Liste nach der gewaehlten Sortierart sortieren (heur = Qualitaets-Score)
  // v1.6.12: Direkt-weg-Verbindungen (direct, ohne ÖPNV) bleiben IMMER ganz oben
  // (Timo: „weit oben!“) und nehmen nicht an der Sortierung der ÖPNV-Karten teil.
  const direct = cons.filter(c => c && c.direct);
  const rest = cons.filter(c => !c || !c.direct);
  const tmp = rest.slice();
  if (routeSort === "heur") {
    const st = routeHeurStats(tmp);
    tmp.sort((a, b) => (routeScore(b, st) - routeScore(a, st)) ||
      (routeArrMin(a) - routeArrMin(b)) ||
      ((a.depAbsMsP || a.depAbsMs || 0) - (b.depAbsMsP || b.depAbsMs || 0)));   // Punktgleichstand: fruehere Ankunft, dann Abfahrt
  } else {
    const cmp = routeSort === "dur"
      ? (a, b) => (a.dur - b.dur) || (routeArrMin(a) - routeArrMin(b))
