// ---------- 🚍 Fahrzeug-Erkennung: „Ich sitze gerade im Bus/Zug“ ----------
// Kern (vehScore3D/vehSegProject/vehUserMotion/vehLiveCls/muteNextState) ist
// DOM-frei und per Grab getestet. Modell: jede Fahrt ist eine Linie im Raum-
// Zeit-Kontext (Breite, Laenge, Minute seit Neujahr), die eigene GPS-Spur wird
// in denselben Massstab gezeichnet und die Fahrt mit dem kleinsten Abstand
// gewinnt; Richtung und Tempo sind harte Vorkfilter, nicht Gewichtungs-Beiwerte.
const vehDlg = document.getElementById("vehDlg");
const vehDlgList = document.getElementById("vehDlgList");
const vehDlgState = document.getElementById("vehDlgState");
