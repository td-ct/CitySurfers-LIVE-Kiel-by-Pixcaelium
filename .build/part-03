// Ruhe-Knopf (früher zwei Knöpfe ⏰ + 🏠): beides an -> beides aus -> nur
// Wecker aus -> nur „Finde nach Hause“ aus -> beides an. Schnelle Kette
// (< MUTE_CYCLE_GAP_MS seit dem letzten Druck) läuft im Zyklus weiter; nach
// einer Weile stellt EIN Druck alles wieder an (Rücksetzen).
const MUTE_CYCLE_GAP_MS = 3000;
function muteNextState(state, msSinceLastPress) {
  if (state === 0) return 3;   // alles an: ein Druck stummt alles
  return msSinceLastPress < MUTE_CYCLE_GAP_MS
    ? (state === 3 ? 1 : state === 1 ? 2 : 0)   // schnelle Kette: Zyklus weiter
    : 0;                                        // nach einer Weile: alles wieder an
}
function renderBigToggles() {
  const anyMuted = alarmsOff || fhOff;
  const bothMuted = alarmsOff && fhOff;
  bbMute.classList.toggle("off", anyMuted);
  bbMute.classList.toggle("strike", bothMuted);
  bbMute.querySelector(".bbsym").textContent = anyMuted ? "🔕" : "🔔";
  bbMute.querySelector("small").textContent =
    bothMuted ? "beides aus" : alarmsOff ? "Wecker aus" : fhOff ? "Hinweise aus" : "beides an";
  bbMute.title = bothMuted
    ? "Wecker und „Finde nach Hause“ sind stumm – Antippen schaltet beides wieder ein. Schnell mehrfach antippen: nur Wecker bzw. nur Hinweise."
    : alarmsOff
      ? "Nur die Wecker sind stumm (gestellt bleiben sie) – Antippen schaltet alles wieder an; schnell weiter antippen: beides aus, Hinweise aus."
      : fhOff
        ? "Nur „Finde nach Hause“ ist stumm – Antippen schaltet alles wieder an; schnell weiter antippen: beides aus, Wecker aus."
        : "Wecker und „Finde nach Hause“ sind an. Antippen: beides stumm. Schnell weiter antippen: nur Wecker aus, nur Hinweise aus, wieder an.";
}

