async function rtStopOpenTap(name, lat, lon) {
  const q0 = String(name || "").trim();
  if (!q0) return;
  const kvg = routeStopMatch(q0);
  if (kvg) { openTab(kvg); return; }
  for (const rs of remoteStops.values())
    if (rs && rs.name && rsFold(rs.name) === rsFold(q0)) { openRemoteTab(rs); return; }
  const la = (lat != null && lat !== "") ? Number(lat) : null;
  const lo = (lon != null && lon !== "") ? Number(lon) : null;
  setLocNote("Suche Station „" + q0 + "“ fuers eigene Reiter-Opening …");
  try { await rsSearch(q0); } catch (e) {}
  const c = rsSearchCache.get(q0.toLowerCase());
  let best = null, bestScore = -1;
  for (const h of ((c && c.hits) || [])) {
    if (!h || !h.name) continue;
    let sc = rsFold(h.name) === rsFold(q0) ? 2 : 1;
    if (la != null && h.lat != null && dist({ lat: la, lon: lo }, h) > 500) sc = 0;   // Zeilen-Koordinate widerspricht
    if (sc > bestScore) { bestScore = sc; best = h; }
  }
  if (best && bestScore >= 1) { openRemoteTab(rsNormalizeHit(best)); return; }
  setLocNote("Station „" + q0 + "“ laesst sich nicht eindeutig als eigenen Reiter oeffnen.");
}
