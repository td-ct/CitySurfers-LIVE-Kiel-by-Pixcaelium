// NAH.SH-Haltestelle zu einer KVG-Haltestelle: LocMatch („Kiel <Name>“); der Treffer
// muss höchstens 150 m von der KVG-Position entfernt sein (Namensgleichheit genügt nicht).
async function nahshLocFor(stop) {
  const c = nahshLocCache[stop.shortName];
  if (c && c.lid && Date.now() - (c.ts || 0) < 30 * 86400e3) return c.lid;
  if (c && c.ok === false && Date.now() - (c.ts || 0) < 7 * 86400e3) return null;
