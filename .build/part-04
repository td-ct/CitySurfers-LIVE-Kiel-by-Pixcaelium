// ---------- v1.4.12: Micromobility Routing (MM): Route uebernehmen, grüner Reiter ----------
// Die fertige 4-Punkte-Route aus dem MM-Dialog (Start, Abholrad, Rueckgabe,
// Ziel) wird als eigener Unter-Reiter neben die gewaehlten OEPNV-Verbindungen
// gelegt und laeuft im Look eines normalen Fahrtverlaufs: geplante Ankunft
// ganz links, daneben die aktuelle Voraussage (Raum-Zeit: eigene GPS-Bewegung
// gegen die geplanten Bein-Zeiten; kursiv wie alle Raum-Zeit-Werte), farbige
// Verspaetung, und Strahl, Ringe und GPS-Punkt durchgehend in Gruen (Klasse
// .mmrail am selben .rtrail-Gefuege, Basis-Farbe MMSpineCol statt Pink).
const MMSpineCol = "#14532d";
function mmClockOfMs(ms) {
  const d = new Date(ms);
  return String(d.getHours()).padStart(2, "0") + ":" + String(d.getMinutes()).padStart(2, "0");
}
// Frische GPS-Position einmalig abfragen (uMap-fuenfter-Punkt nach der
// Gesamtroute): Die Berechtigungsfrage stellt DIESE Seite (Browser-Standort,
// abgefragt direkt im Klick), uMap selbst braucht keine eigene Freigabe, die
// Koordinaten stecken im data=-Parameter der Karten-URL. Ohne Erlaubnis oder
// Fix gilt die letzte bekannte Position (bzw. gar keine).
function mmFreshPos(sec) {
  return new Promise(res => {
    const fb = () => res((gpsState === "on" && myPos) ? myPos : null);
    if (!(("geolocation" in navigator) && isSecure())) { fb(); return; }
    try {
      navigator.geolocation.getCurrentPosition(g =>
        res({ lat: g.coords.latitude, lon: g.coords.longitude, accuracy: g.coords.accuracy }), fb,
        { enableHighAccuracy: true, timeout: (sec || 8) * 1000, maximumAge: 20000 });
    } catch (e) { fb(); }
  });
}
