    if (!bkst.dropOpen && cur) {   // v1.6.9: nach der Wahl zusammengeklappt: nur die gewählte Station, Tipp (Suchfeld/Knopf) klappt alle wieder auf
      dropListEl.innerHTML = '<button class="bkhi on" data-did="' + escapeHtml(String(cur.s.id)) +
