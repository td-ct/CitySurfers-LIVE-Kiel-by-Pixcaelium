  async function osrmBikeM(a, b) {
    try {
      const url = BIKE_ROUTER + a.lon + "," + a.lat + ";" + b.lon + "," + b.lat + "?overview=false";
      const res = await apiFetch("osrm", url);
      if (res.ok) {
        const data = await res.json();
        if (data.routes && data.routes[0]) return { m: data.routes[0].distance, est: false };
      }
    } catch (e) {}
    return { m: dist(a, b) * 1.3, est: true };   // Rueckfall: Luftlinie x 1,3
  }
