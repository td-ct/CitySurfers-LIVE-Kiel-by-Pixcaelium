// 500-ms-Takt des aktiven MM-Reiters: Aktuell-Uhrzeit, Verspaetung und der
// gruene Fortschritts-Strahl (Fuellung + GPS-Punkt) ohne Neu-Rendern auffrischen
function mmTick() {
  if (!(mmTabActive && mmActiveTab >= 0 && mmTabs[mmActiveTab])) return;
  const mt = mmTabs[mmActiveTab];
  const mm = (mt.routes && mt.active != null) ? mt.routes[mt.active] : null;
  if (!mm) return;
  const rail = mmPanel.querySelector(".rtrail.mmrail");
  if (rail) { paintRouteSpine(rail, MMSpineCol); mmUpdateProgress(mm, rail); }
  const wrapEl = document.getElementById("mmaktwrap");
  if (!wrapEl) return;
  const pred = mmPredArr(mm);
  const actC = pred ? mmClockOfMs(pred.arrMs) : mmClockOfMs(mm.planArrMs);
  if (wrapEl.textContent !== actC) {
    wrapEl.textContent = actC;
    wrapEl.className = pred ? "szt" : "dim";
    const de = document.getElementById("mmdelayspan");
    if (de) de.outerHTML = mmDelaySpanHTML(pred ? Math.round((pred.arrMs - mm.planArrMs) / 60000) : null, !!pred);
  }
  // v1.6.9: Die Zeilen des MM-Fahrtverlaufs (Gep./Aktuell, Abweichung,
  // Sekunden-Countdown) im selben Takt auffrischen, ohne neu zu rendern:
  // Aktuell-Uhr kursiv nachführen, Chips und Countdown-Ziele neu setzen (der
  // 1-s-Ticker pflegt die M:SS-Anzeige zwischen den Ticks).
  const rows = mmPanel.querySelectorAll("[data-mmsrow]");
  if (!rows.length) return;
  const pp = mmPredPoints(mm), nowMs = Date.now();
  const pOf = k => (pp ? (k === 1 ? pp.bike : k === 2 ? pp.ride : k === 3 ? pp.drop : k === 4 ? pp.dest : null) : null);
  rows.forEach(row => {
    const k = Number(row.dataset.mmsrow), planMs = Number(row.dataset.mmplan);
    if (!(planMs > 0)) return;
    let predMs = pOf(k);
    if (predMs != null && predMs <= nowMs - 60000) predMs = null;   // vergangene Punkte gelten als ohne Voraussage
    const ak = row.querySelector("[data-mmakt]");
    if (ak) {
      const t = predMs != null ? "≈" + mmClockOfMs(predMs) : mmClockOfMs(planMs);
      if (ak.textContent !== t) { ak.textContent = t; ak.className = "takt " + (predMs != null ? "szt" : "dim"); }
    }
    const wx = row.querySelector("[data-mmx]");
    if (wx) {
      const inner = mmRowXtraHTML(planMs, predMs);
      if (wx.innerHTML !== inner) wx.innerHTML = inner;
    }
  });
}

