    st.note = st.cands.some(c => c.kind === "loc")
      ? "(NAH.SH passt nicht genau – Standard sind die OSM-Koordinaten, anderen Eintrag antippen)"
      : "(Koordinaten, nah.sh-kompatibel)";
  }
