// v1.6.9: Voraussage der Ankunft an JEDEM Punkt der MM-Route aus der eigenen
// GPS-Bewegung (Raum-Zeit; ohne Fahrplan bestimmt das GPS die aktuellen Zahlen
// allein): bike = Abholrad, ride = Beginn der Radfahrt nach Ausleihen,
// drop = Rückgabe-Station, dest = Ziel. Vergangene Punkte sind null, die
// Ziel-Voraussage ist identisch mit mmPredArr (dieselbe Leih-/Rückgabe-Puffer-
// Rechnung: volle Zeit vor dem Rad-Bein, halbe während der Fahrt, keine danach).
function mmPredPoints(mm) {
  if (!(gpsState === "on" && myPos)) return null;
  const pr = mmProject(mm, myPos);
  if (!pr) return null;
  const L = [mm.w1 || 0, mm.rb || 0, mm.w2 || 0], H = mm.handle || 0, now = Date.now();
  const rem = s => s < pr.seg ? 0 : s === pr.seg ? (1 - pr.frac) * L[s] : L[s];
  if (pr.seg === 0) {
    const bike = now + rem(0) * 60000, ride = bike + H * 60000,
      drop = ride + rem(1) * 60000;
    return { bike: bike, ride: ride, drop: drop, dest: drop + rem(2) * 60000 };
  }
  if (pr.seg === 1)
    return { bike: null, ride: null, drop: now + rem(1) * 60000,
      dest: now + (rem(1) + rem(2)) * 60000 + H * 60000 * 0.5 };
  return { bike: null, ride: null, drop: null, dest: now + rem(2) * 60000 };
