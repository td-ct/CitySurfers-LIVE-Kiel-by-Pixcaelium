      if (bi < 0) bi = st.cands.findIndex(c => c.kind === "coord");
      if (bi >= 0) routeAbgPick(which, bi, true);
    } else {
      // Adresse/POI: nur EINDEUTIGE Treffer automatisch (≤ 100 m und passende
      // Hausnummer); sonst Abgleich-Fenster zeigen, Wahl bleibt dem Nutzer.
