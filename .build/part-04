  routeAbg[which] = st;
  rtdUpdate();
  try {
    if (sel.sn) {   // Station: eigene, koordinatenverifizierte lid
      const d = isDB(sel.sn) ? dbStopOf(sel.sn) : null;
      let lid = (d && d.lid) || null;
      if (!lid) {
        const stop = stops.find(s => s.shortName === sel.sn);
        lid = stop ? await nahshLocFor(stop).catch(() => null) : null;
      }
      if (lid) {
        routeAbgApply(which, lidName(lid) || sel.name, lid, "S");
        st.note = "(verifizierte Haltestelle)";
      } else {
