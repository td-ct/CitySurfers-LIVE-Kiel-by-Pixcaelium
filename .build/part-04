  if (sel.lat == null) throw new Error("Ort ohne Koordinaten: " + sel.name);
  sel.lid = coordLid(sel.name, sel.lat, sel.lon);   // OSM-Koordinaten als NAH.SH-Adresse
  sel.locType = "A";
