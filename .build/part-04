  async function renderDrop() {
    const myseq = ++dropSeq2;
    st.drops = null;
    resEl.innerHTML = "";   // Ziel geaendert: altes Ergebnis weg
    mmInvalidate();
    dropInfoEl.textContent = "–";
    if (!st.dest || st.dest.lat == null) {
      dropListEl.innerHTML = '<div class="bkempty">(erst Ziel wählen)</div>';
      dropInfoEl.textContent = "Nach der Zielwahl: die " + BK_DROP_N + " nächsten Rückgabe-Stationen, nach Entfernung sortiert.";
      return;
    }
    const d = await donkeyData(!donkeyCache.d);
    if (myseq !== dropSeq2) return;
    if (!d) { dropListEl.innerHTML = '<div class="bkempty">⚠ Leihfahrrad-Daten nicht erreichbar.</div>'; return; }
