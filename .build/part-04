// Projektion der eigenen Position auf die 3 Beine der MM-Route: Rueckgabe
// { seg, frac, dms, cums, w } mit w = zurueckgelegte Meter, oder null, wenn
// die Position weiter als 120 m abseits aller Beine liegt. Bei mehreren
// Treffern gewinnt der weiteste Fortschritt (Fahrtrichtung). 
function mmProject(mm, pos) {
  if (!mm || !pos || pos.lat == null) return null;
  const P = [mm.from, mm.bike, mm.drop, mm.dest];
  for (const p of P) if (!(p && p.lat != null && p.lon != null)) return null;
  const dms = [dist(P[0], P[1]), dist(P[1], P[2]), dist(P[2], P[3])];
  const cums = [0, dms[0], dms[0] + dms[1], dms[0] + dms[1] + dms[2]];
  let best = null;
  for (let s = 0; s < 3; s++) {
    const a = P[s], b = P[s + 1];
    const dx = b.lon - a.lon, dy = b.lat - a.lat;
    const len2 = Math.max(dx * dx + dy * dy, 1e-12);
    const t = Math.max(0, Math.min(1, ((pos.lon - a.lon) * dx + (pos.lat - a.lat) * dy) / len2));
    const off = dist(pos, { lat: a.lat + t * dy, lon: a.lon + t * dx });
    if (off <= 120 && (!best || cums[s] + t * dms[s] > best.w)) best = { seg: s, frac: t, dms: dms, cums: cums, w: cums[s] + t * dms[s] };
  }
  return best;
}
// Aktuelle Ankunfts-Voraussage (Raum-Zeit: eigene Bewegung gegen die geplanten
// Bein-Zeiten; Ausleihe/Rueckgabe anteilig vor/nach dem Rad-Bein). Ohne Live-
// Ortung oder abseits der Route: null, dann gilt die geplante Zeit.
function mmPredArr(mm) {
  if (!(gpsState === "on" && myPos)) return null;
  const pr = mmProject(mm, myPos);
  if (!pr) return null;
  const legMin = [mm.w1 || 0, mm.rb || 0, mm.w2 || 0];
  let rest = 0;
  for (let s = pr.seg; s < 3; s++) rest += (1 - (s === pr.seg ? pr.frac : 0)) * legMin[s];
  rest += (mm.handle || 0) * (pr.seg === 0 ? 1 : pr.seg === 1 ? 0.5 : 0);
  return { arrMs: Date.now() + rest * 60000, proj: pr };
}
function mmDelaySpanHTML(dmin, hasPred) {
  if (!hasPred || dmin == null)
    return ' <span class="tdelay" id="mmdelayspan" title="ohne Live-Ortung (oder abseits der Route) gilt die geplante Ankunft"></span>';
  // v1.6.9: dieselbe Farbskala wie die Raum-Zeit-Werte der Verläufe:
  // gelb = knapp, rot ab 5 min, blau = zu früh, grün = pünktlich
  const cls = dmin > 0 ? (dmin >= SZT_WATCH_LATE_MIN ? "sztw-late" : "sztw-warn") : dmin < 0 ? "sztw-early" : "sztw-ok";
  const txt = dmin > 0 ? "+" + dmin + "m" : dmin < 0 ? dmin + "m" : "0m";
  return ' <span class="tdelay ' + cls + '" id="mmdelayspan" title="Verspätung gegen die geplante Ankunft, aus der Raum-Zeit-Voraussage der eigenen GPS-Bewegung (gelb = knapp, rot ab 5 min, blau = zu früh, grün = pünktlich)">' + txt + "</span>";
