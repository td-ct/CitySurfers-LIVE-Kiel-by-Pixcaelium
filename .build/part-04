      coordLid(sel.name, sel.lat, sel.lon), "A", sel.lat, sel.lon);
    const ci = st.cands.findIndex(c => c.kind === "coord");
    if (ci < 0) {
      st.cands.push({ name: "Koordinaten " + sel.lat.toFixed(5) + ", " + sel.lon.toFixed(5),
