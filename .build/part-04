  if (sel.sn) {
    const stop = stops.find(s => s.shortName === sel.sn);
    if (stop) {
      const d = isDB(sel.sn) ? dbStopOf(sel.sn) : null;
      const lid = (d && d.lid) ? d.lid : await nahshLocFor(stop).catch(() => null);
      if (lid) { sel.lid = lid; sel.locType = "S"; return sel; }
    }
