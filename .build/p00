const RS_PREFIX = "RS:";          // Kennzeichen einer Fern-Station im Reiter-System
const RS_MIN_CHARS = 3;           // ab so vielen Buchstaben wird LocMatch gefragt
const RS_MAX_HITS = 6;            // höchstens so viele Fern-Stationen je Suche
const RS_CACHE_TTL = 600000;      // LocMatch-Treffer 10 Minuten im Cache (Rate-Schutz)
const RS_SVC_LABEL = { nahsh: "nah.sh", vbb: "VBB", vvs: "VVS", mvv: "MVV", dvb: "DVB" };
function svcForCoords(lat, lon) {   // Facelift: regionaler Live-Dienst je Grob-BBox, sonst nah.sh
  if (lat >= 51.2 && lat <= 53.7 && lon >= 11.1 && lon <= 14.9) return "vbb";   // Berlin/Brandenburg
  if (lat >= 47.9 && lat <= 49.5 && lon >= 8.6  && lon <= 10.4) return "vvs";   // Stuttgart-Region
  if (lat >= 47.75 && lat <= 48.6 && lon >= 10.95 && lon <= 12.15) return "mvv";   // München und Umland (Freising bis Ebersberg, ohne Augsburg)
  if (lat >= 50.8 && lat <= 51.3 && lon >= 13.0 && lon <= 14.3) return "dvb";   // Raum Dresden
  return "nahsh";
}
const isRS = sn => String(sn || "").indexOf(RS_PREFIX) === 0;
const remoteStops = new Map();    // "RS:<extId>" -> Fern-Station {shortName,name,lat,lon,lid,extId,svc,rId}
const rsSearchCache = new Map();  // Suchtext (klein) -> { hits: [Fern-Station], ts }
let rsSearchTimer = null, rsSearchSeq = 0;
