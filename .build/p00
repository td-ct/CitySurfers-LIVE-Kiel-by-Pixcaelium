}
function rsRowHTML(s, pos) {   // v1.5.0: zweizeilige Fern-Stations-Zeile mit Kurzzeichen rechts
  const meta = [];
  if (pos) {
    const air = dist(pos, s) * 1.3;
    meta.push("~" + formatDist(air) + " · ~" + Math.ceil(air / (WALK_SPEED_KMH * 1000 / 60)) + " min (Luftlinie)");
  }
  meta.push("Fern-Station");
  return '<div data-rs="' + escapeHtml(s.shortName) + '" title="Fern-Station öffnen: Live-Abfahrten über ' +
    escapeHtml(RS_SVC_LABEL[s.svc] || "nah.sh") + ' (regionale Quelle zuerst, sonst nah.sh-Fallback)">' +
    '<div class="srow"><span class="sname">🚏 ' + escapeHtml(s.name) + "</span>" +
    '<span class="srowact">' +
    routeIconHTML(s, "Fern-Station an eine externe Karten-App übergeben") +
    '<span class="regsvc d' + (s.svc || "nahsh") + '" title="Live-Dienst: ' + escapeHtml(RS_SVC_LABEL[s.svc] || "nah.sh") + '">' +
    escapeHtml(RS_SVC_LABEL[s.svc] || "nah.sh") + "</span></span></div>" +
    '<div class="srowmeta">' + escapeHtml(meta.join(" · ")) + "</div>" +
    "</div>";
}
async function rsSearch(q) {   // NAH.SH-LocMatch deutschlandweit (nur Stationen), gecached
  q = String(q || "").trim();
  if (q.length < RS_MIN_CHARS || listMode === "flat") return;
  const key = q.toLowerCase();
  const c = rsSearchCache.get(key);
  if (c) { if (!sugBox.hidden) updateSuggestions(); return; }   // Cache (auch leer) genügt
  const seq = ++rsSearchSeq;
  try {
    const res = await routeHafas("LocMatch", { input: { field: "S", loc: { name: q, type: "S" } } });
    if (seq !== rsSearchSeq) return;
    const hits = [], seen = new Set();
    const qF = rsFold(q);
    for (const x of ((res.match && res.match.locL) || [])) {
      if (!x || x.type !== "S" || !x.lid || seen.has(x.lid)) continue;
      seen.add(x.lid);
      const extM = String(x.lid).match(/@L=(\d+)/);
      const crd = x.crd || {};
      if (!extM || !/^\d+$/.test(extM[1]) || crd.y == null || crd.x == null) continue;
      const nm = String(x.name || "").replace(/…/g, "").trim();
      if (!nm) continue;
      if (qF && rsFold(nm).indexOf(qF) < 0) continue;   // nur Treffer, die zur Eingabe passen
      const lat = crd.y / 1e6, lon = crd.x / 1e6;
      if (RS_KNOWN_EXT.has(extM[1])) continue;   // Kiels DB-Stationen stecken schon fest in der Liste
      let dup = false;   // Doppelung zu Kieler Haltestellen in unmittelbarer Nähe vermeiden
      for (const st of stops) {
        if (isRS(st.shortName) || st.lat == null || st.lon == null) continue;
        if (dist(st, { lat: lat, lon: lon }) < 400 &&
            rsFold(st.name).slice(0, 5) === rsFold(nm).slice(0, 5)) { dup = true; break; }
      }
      if (dup) continue;
      hits.push(rsNormalizeHit({ shortName: RS_PREFIX + extM[1], name: nm, lat: lat, lon: lon,
        lid: String(x.lid), extId: extM[1] }));
      if (hits.length >= RS_MAX_HITS) break;
    }
    if (rsSearchCache.size > 40) {   // Cache begrenzen
      const k0 = rsSearchCache.keys().next().value;
      if (k0 != null) rsSearchCache.delete(k0);
    }
    rsSearchCache.set(key, { hits: hits, ts: Date.now() });
    if (seq === rsSearchSeq && !sugBox.hidden &&
        String(search.value || "").trim().toLowerCase() === key) updateSuggestions();
  } catch (e) {   // LocMatch nicht erreichbar: still bleiben (Kiel-Treffer funktionieren weiter)
    if (seq === rsSearchSeq) rsSearchCache.set(key, { hits: [], ts: Date.now() });
