  renderRows();
  renderList();
  loadSched(false);
}

// ---------- Geofence-Wecker: Distanz-Wecker klingeln in der App auch im Hintergrund ----------
// Die Seite bleibt das Konzept: Sie kennt die Wecker-Logik und konfiguriert die
// Zäune; die App überwacht sie beim System (Geofencing API) und läutet beim
// Eintritt in den Radius nach exakt demselben Muster wie der Zeit-Wecker
// (3 s Ton/Vibration, 5 s Pause, ... bis zum ⏰-Antippen). Im Browser bleiben
// alle Aufrufe wirkungslos, die Seite läuft unverändert weiter.
let geoSyncHash = "";
function syncGeofences() {
  if (!window.KvgNative || typeof window.KvgNative.syncGeofences !== "function") return;
  let list = [];
  for (const [aKey, a] of alarms) {
    if (!a.dist) continue;   // nur Distanz-Wecker; Zeit-Wecker klingelt nativ per AlarmManager
    if (a.paused) continue;  // deaktivierte Distanz-Wecker: kein Zaun
    const stop = stops.find(x => x.shortName === a.sn) || dbStopOf(a.sn) ||   // DB-Bahnhof: Geofence statt gar kein Zaun
      (a.lat != null ? { lat: a.lat, lon: a.lon } : null);   // Route-Station: Koord. direkt aus der Route
    if (!stop || stop.lat == null) continue;
    list.push({ key: aKey, lat: stop.lat, lon: stop.lon, radius: a.dist,
      name: a.name || a.sn, vib: a.vib !== false, tone: a.tone !== false,
      snd: a.snd || "alarm", vol: a.vol == null ? 1 : a.vol });
  }
  if (alarmsOff) list = [];   // global aus: keine nativen Geofence-Zäune registrieren
  // nur bei Änderung an die App durchreichen (renderAlarmInd läuft alle 15 s)
  const h = list.map(x => x.key + ":" + x.radius + ":" +
    Math.round(x.lat * 1e5) + "," + Math.round(x.lon * 1e5)).sort().join("|") +
    "|" + [...alarms].filter(([, a]) => a.paused).map(([k]) => k).sort().join(",");
  if (h === geoSyncHash) return;
  geoSyncHash = h;
  nativeCall("syncGeofences", JSON.stringify(list));
}

// Von der App gemeldete Geofence-Ereignisse (z. B. ausgelöst, während die Seite
// im Hintergrund war): Wecker als ausgelöst markieren, native Läut-Kette
// übernehmen (nicht abbrechen, sie klingelt bereits).
// Aus der App: Benachrichtigungs-Buttons (AlarmActionReceiver) rufen diese
// Funktion mit dem Wecker-Key und der Aktion auf ("stop"|"pause"|"resume"|"delete").
window.kvgAlarmAction = function (akey, mode) {
  try {
    const a = alarms.get(akey);
    const nm = (a && a.name) || "Wecker";
    if (mode === "stop") {
      stopRinging(akey);            // Distanz-Wecker: deaktiviert statt gelöscht
      firedAlarms.delete(akey);
      setLocNote("🔕 Läuten beendet (aus der Benachrichtigung): " + nm);
    } else if (mode === "delete") {
      alarms.delete(akey);
      saveAlarms();
      stopRinging(akey, true);
      firedAlarms.delete(akey);
      nativeCall("cancelAlarm", akey);
      setLocNote("🔕 Wecker entfernt (aus der Benachrichtigung): " + nm);
    } else if (a) {
      a.paused = mode === "pause";
      saveAlarms();
      setLocNote(mode === "pause" ? "⏸ Wecker deaktiviert: " + nm : "▶ Wecker aktiviert: " + nm);
    }
    renderAlarmInd();
    renderTabs();
    if (currentBus) renderBusPanel();
    return "ok";
  } catch (e) { return "error"; }
};

window.kvgGeofenceEvents = function (json) {
  try {
    const evs = typeof json === "string" ? JSON.parse(json) : (json || []);
    let n = 0;
    for (const ev of evs) {
      const aKey = ev.key || ev;
      // System-Hinweise der App (keine Wecker): Geofence-Registrierung gescheitert.
      // Erwartet v. a. "__geofence_noperm" (Hintergrund-Standort nicht erteilt)
      // und "__geofence_error:<Typ>" (Play-Services-Fehler beim Zaun-Setzen).
      if (typeof aKey === "string" && aKey.indexOf("__geofence") === 0) {
        if (aKey === "__geofence_noperm") {
          setLocNote("⚠ Hintergrund-Standort fehlt: Geofence-Wecker klingeln sonst erst beim Öffnen der App. " +
            "In den Android-Einstellungen: Apps → CitySurfers → Berechtigungen → Standort → „Bei allen Zeiten zulassen“.");
        } else {
          setLocNote("⚠ Geofence-Wecker konnten nicht registriert werden (" +
            (ev && ev.name ? ev.name : "Unbekannter Fehler") +
            ") – Hintergrund-Wecker klingeln nur bei geöffneter App.");
        }
        n++;
        continue;
      }
      const a = alarms.get(aKey);
      if (!a) continue;
      firedAlarms.add(aKey);   // Distanz-Wecker bleiben gestellt (stopRinging deaktiviert)
      syncNativeRinging();    // laufende native Kette ins ⏰-Symbol übernehmen
      startRinging(aKey, a);   // nur falls noch nicht nativ am Läuten
      setLocNote("⏰ Wecker: " + a.name + " – Haltestelle erreicht (Geofence, im Hintergrund ausgelöst). Zum Beenden ⏰ antippen.");
      n++;
    }
    if (n) { renderTabs(); renderAlarmInd(); if (currentBus) renderBusPanel(); }
    return "ok";
  } catch (e) { return "error"; }
};

// Beim Wieder-Aktivieren der App: ausgelöste Geofence-Wecker abholen
function pollGeofenceEvents() {
  try {
    if (window.KvgNative && typeof window.KvgNative.pendingGeofenceEvents === "function") {
      const s = window.KvgNative.pendingGeofenceEvents();
      if (s && s !== "[]") window.kvgGeofenceEvents(s);
    }
  } catch (e) {}
}
document.addEventListener("visibilitychange", () => {
  if (!document.hidden) { pollGeofenceEvents(); updateGpsBtns(); }   // GPS-Knöpfe neu bewerten (gelb, wenn weggewandert)
});

// ---------- Finde nach Hause: direkte Fahrten zu Favoriten-Zielen finden ----------
// Sucht bei laufendem GPS im Takt FH_SCAN_INTERVAL_MS, ob eine Station im
// eingestellten Positions-Umkreis eine Abfahrt hat, für die man spätestens im
// eingestellten Zeitfenster losgehen muss, und deren Fahrtverlauf eine Station im
// Ziel-Umkreis des als 🏠
// markierten Favoriten enthält (ohne Umsteigen). Treffer werden live geprüft und
// dann gemeldet: Dialog im Stil der Abfahrtsanzeigen + Hinweiston/Vibration
// (konfigurierbar wie beim Wecker) + Android-System-Benachrichtigung (Kanal
// "hinweise"). Hinweise lassen sich im Dialog pro Linie oder für das ganze Ziel
// stummschalten (30 min / 1 Std. / 6 Std. / 1 Tag / Nie).
const fhStopCfg = JSON.parse(localStorage.getItem("kvg-fhstop") || "{}"); // sn -> cfg
function saveFhStopCfg() { try { localStorage.setItem("kvg-fhstop", JSON.stringify(fhStopCfg)); } catch (e) {} }
const FH_MUTES = [["30 Minuten", 30], ["1 Std.", 60], ["6 Std.", 360], ["1 Tag", 1440], ["Nie", Infinity]];
const fhTripCache = new Map();   // tripId -> { ts, stops: [{sn, name, time}] }
const fhSeen = new Map();        // "cfgId|route|tripId|sn" -> Ablaufzeit (Meldung nur 1x)
let fhScanning = false;
let fhNotifAsked = false;

// Pro Ziel konfigurierbare Radien/Zeitfenster; alte Einträge ohne Werte bekommen die bisherigen Defaults
function fhDefaults(cfg) {
  if (cfg.posR == null) cfg.posR = 500;
  if (cfg.losWin == null) cfg.losWin = 15;
  if (cfg.tgtR == null) cfg.tgtR = 400;
}
// kleines Auswahllisten-HTML (Optionen mit Einheit), direkt im Erklärtext des Dialogs
function fhSelHtml(cls, opts, val, unit) {
  if (val == null || opts.indexOf(val) < 0) val = opts[1];   // unbekannt/leer -> Standard 500/15
  return '<select class="' + cls + '">' +
    opts.map(o => '<option value="' + o + '"' + (o === val ? " selected" : "") + ">" + o + unit + "</option>").join("") +
    "</select>";
}
function fhTargets() {
  const ts = [];
  addrFavs.forEach((f, i) => {
    if (f.fh && f.fh.on && f.lat != null) { fhDefaults(f.fh);
      ts.push({ id: "a" + i, name: f.label || f.name, lat: f.lat, lon: f.lon, cfg: f.fh }); }
  });
  for (const sn in fhStopCfg) {
    const c = fhStopCfg[sn];
    if (!c || !c.on) continue;
    fhDefaults(c);
    const s = stops.find(x => x.shortName === sn);
    if (s) ts.push({ id: "s" + sn, name: s.name, lat: s.lat, lon: s.lon, cfg: c });
  }
  return ts;
}
function fhMuted(cfg, route) {
  const now = Date.now();
  if (cfg.allMutedUntil != null && (cfg.allMutedUntil === Infinity || cfg.allMutedUntil > now)) return true;
  const m = cfg.muted && cfg.muted[route];
  return m != null && (m === Infinity || m > now);
}
async function fhTripStops(tripId) {
  const c = fhTripCache.get(tripId);
  if (c && Date.now() - c.ts < FH_TRIP_CACHE_MS) return c.stops;
  try {
    const res = await apiFetch("kvg", TRIP_URL, {
      method: "POST",
      headers: { "Content-Type": "application/x-www-form-urlencoded" },
      body: "tripId=" + encodeURIComponent(tripId)
    });
    if (!res.ok) throw new Error("HTTP " + res.status);
    const data = await res.json();
    const arr = (data.actual || []).map(p => ({ sn: p.stop.shortName, name: p.stop.name, time: p.actualTime }));
    fhTripCache.set(tripId, { ts: Date.now(), stops: arr });
    return arr;
  } catch (e) { return null; }
}
// Minuten-Wert "HH:MM" -> Minuten seit Mitternacht; -1 wenn unlesbar
function hhmmMin(t) {
  if (!t) return -1;
  const [h, m] = String(t).split(":").map(Number);
  return (isFinite(h) && isFinite(m)) ? h * 60 + m : -1;
}
async function fhScan() {
  if (fhScanning) return;
  if (fhOff) return;   // global aus: nicht suchen
  const pos = (gpsState === "on" && myPos) ? myPos : null;   // nur echte Live-Ortung

  if (!pos || gpsState !== "on" || (pos.accuracy != null && pos.accuracy > GPS_ACC_COARSE_M)) return;
  const targets = fhTargets();
  if (!targets.length) return;
  fhScanning = true;
  try {
    // größte eingestellte Werte aller Ziele als grobe Vorfilter
    const maxPosR = Math.max.apply(null, targets.map(t => t.cfg.posR || 500));
    const maxLosWin = Math.max.apply(null, targets.map(t => t.cfg.losWin || 15));
    // 1) nächste Stationen um die eigene Position (Positions-Umkreis des weitesten Ziels)
    const near = stops
      .filter(s => !isDB(s.shortName) && dist(pos, s) <= maxPosR)
      .sort((a, b) => dist(pos, a) - dist(pos, b))
      .slice(0, FH_MAX_STATIONS);
    const now = new Date();
    const nowMin = now.getHours() * 60 + now.getMinutes();
    for (const st of near) {
      const deps = await getDepartures(st.shortName) || [];
      // 2) Abfahrten im Zeitfenster (Sollzeit = Offline-Fahrplan); grober Vorfilter
      // über das größte Losgeh-Fenster zuzüglich geschätztem Fußweg (Luftlinie × 1,3)
      const estWalk = dist(pos, st) * 1.3 / (WALK_SPEED_KMH * 1000 / 60);
      for (const d of deps) {
        if (isDB(st.shortName) || String(d.tripId).indexOf("DB:") === 0) continue; // erst nur KVG-Busse
        const pMin = hhmmMin(d.plannedTime);
        if (pMin < 0 || pMin < nowMin - 1 || pMin > nowMin + maxLosWin + Math.ceil(estWalk)) continue;
        const route = d.line + "→" + d.direction;
        const tStops = await fhTripStops(d.tripId);
        if (!tStops) continue;
        // 3) fährt die Fahrt an einem Ziel-Favoriten vorbei?
        for (const tgt of targets) {
          if (fhMuted(tgt.cfg, route)) continue;
          // Zeitfenster: Zeit bis man spätestens losgehen muss (Abfahrt minus geschätzter Fußweg)
          if (pMin - nowMin - estWalk > (tgt.cfg.losWin || 15)) continue;
          // günstigste Station der Fahrt am Ziel: nächste im Ziel-Radius
          let bestS = null, bestD = Infinity;
          for (const ts2 of tStops) {
            const s2 = stops.find(x => x.shortName === ts2.sn);
            if (!s2) continue;
            const d2 = dist(tgt, s2);
            if (d2 <= (tgt.cfg.tgtR || 400) && d2 < bestD) { bestD = d2; bestS = s2; }
          }
          if (!bestS) continue;
          // 4) Live-Prüfung: Abfahrt noch da? Ist-Zeit holen
          depCache.delete(st.shortName);
          const live = await getDepartures(st.shortName) || [];
          const ld = live.find(x => x.tripId === d.tripId);
          if (!ld) continue;   // schon weg oder nicht mehr gelistet
          const aMin = hhmmMin(ld.actualTime || ld.plannedTime);
          if (aMin < 0 || aMin < nowMin) continue;   // abgefahren
          const seenKey = tgt.id + "|" + route + "|" + d.tripId + "|" + st.shortName;
          if (fhSeen.has(seenKey)) continue;
          fhSeen.set(seenKey, (aMin + 5) * 60000 + now.setHours(0, 0, 0, 0)); // bis kurz nach Abfahrt
          fhNotify(tgt, st, ld, aMin, bestS);
        }
      }
    }
  } finally { fhScanning = false; }
}
// Aufräumen: gemeldete Fahrten nach ihrem Ablauf wieder zulassen; zugleich die
// Sammel-Benachrichtigung regelmäßig aktualisieren (auch ohne neuen Fund).
const fhCandidates = new Map();   // candKey -> {line, dir, station, clock, los, until}
function updateFhNotification() {
  // Abgelaufene Hinweise rausfügen – auch im Browser: Das 🏠-Symbol der
  // Statusleiste zählt nur aktive Hinweise
  const now = Date.now();
  for (const [k, c] of fhCandidates) if (c.until < now) fhCandidates.delete(k);
  renderFhInd();
  try { fhMsgUpdate(false); } catch (e) {}   // v1.6.42: 🏠-Nachrichtenfenster im Takt mitführen
  if (!window.KvgNative) return;
  if (fhOff) { nativeCall("cancelNotify", "fh-scan"); return; }   // global aus: Nachricht weg
  // v1.6.44 (Timo-Wunsch 27.11.2026): Der 🏠-Platz im Android-Benachrichtigungs-
  // zentrum führt nur Funde von Zielen mit Haken „In Android benachrichtigen“;
  // ohne Treffer verschwindet die Nachricht, die Suche läuft weiter.
  const arr = [...fhCandidates.values()].filter(c => {
    const t = fhTargets().find(x => x.id === c.tid);
    return !t || t.cfg.msgAnd !== false;
  });
  if (!arr.length) { nativeCall("cancelNotify", "fh-scan"); return; }
  const title = "🏠 Finde nach Hause: " + arr.length +
    (arr.length === 1 ? " mögliche Fahrt" : " mögliche Fahrten");
  const text = arr.map(c => "Linie " + c.line + " → " + c.dir + ", " + c.station +
    " " + c.clock + " Uhr (" + (c.los > 0 ? "in " + c.los + " min losgehen" : "jetzt losgehen") + ")").join("\n");
  nativeCall("notify", "fh-scan", title, text, "hinweise");
}
setInterval(() => {
  const now = Date.now();
  for (const [k, exp] of fhSeen) if (exp < now) fhSeen.delete(k);
  updateFhNotification();
}, FH_SCAN_INTERVAL_MS);
setInterval(fhScan, FH_SCAN_INTERVAL_MS);

// ---------- Fortschritt im aktiven Fahrtverlauf als Android-Benachrichtigung ----------
// Steht das GPS im Radius einer Station eines offenen Fahrtverlaufs, wird EINE
// System-Benachrichtigung auf Kanal "fahrtverlauf" laufend aktualisiert (nicht
// pro Station eine neue): Titel "[Linie] [Endstation]", Text = aktuelle Station
// plus die nächsten 3 Stationen mit Uhrzeit und Minuten bis Abfahrt.
function tripStopClock(t, s) {
  const key = s.key || (s.shortName + "|" + t.tripId);
  const dl = t.delay[key];
  return s.time || (dl && dl.actualTime) || s.plannedTime || (dl && dl.plannedTime) || "";
}
function tripStopLineTxt(t, s) {
  const clock = tripStopClock(t, s);
  let rel = "";
  if (clock) {
    const [h, m] = clock.split(":").map(Number);
    if (isFinite(h) && isFinite(m)) {
      const n = new Date();
      let d = (h * 60 + m) - (n.getHours() * 60 + n.getMinutes());
      if (d < -600) d += 1440;
      rel = d >= 0 ? " in " + d + " min" : d >= -600 ? " vor " + (-d) + " min" : "";
    }
  }
  return (s.name || s.shortName) + (clock ? " " + clock + " Uhr" : "") + (rel ? " (" + rel.trim() + ")" : "");
}
function notifyTripProgress(idx) {
  if (!window.KvgNative || !currentTrip) return;
  const t = currentTrip;
  if (!t.stops || !t.stops.length || idx == null || idx < 0 || idx >= t.stops.length) return;
  const title = "🚌 [" + (t.route || "?") + "] [" + (t.direction || "?") + "]";
  const parts = [];
  for (let k = idx; k < Math.min(idx + 4, t.stops.length); k++) {
    const mark = k === idx ? "▶ " : "→ ";
    parts.push(mark + tripStopLineTxt(t, t.stops[k]));
  }
  nativeCall("notify", "tp" + t.tripId, title,
    "Jetzt: " + parts[0] + (parts.length > 1 ? " · Nächste: " + parts.slice(1).join(", ") : ""),
    "fahrtverlauf");
}
function fhSignal(cfg) {
  if (cfg.tone !== false) alarmBeep(cfg.vol == null ? 1 : cfg.vol, cfg.snd || "notif", 5);
  if (cfg.vib !== false) vibratePattern([3000]);
}
async function fhNotify(tgt, st, dep, aMin, bestS) {
  // Ton + Vibration sofort auslösen, BEVOR die Fußweg-Routings abgefragt werden –
  // sonst verzögert sich das Signal um die Netzlaufzeit (OSRM) oder bleibt aus.
  fhSignal(tgt.cfg);
  const now = new Date();
  // v1.6.42: eigene 🏠-Fenstermeldung + Fenster zeigen (Haken-Regel tritt dahinter zurück)
  tgt.cfg.lastMsg = "🚨 Linie " + dep.line + " → " + dep.direction + " ab " + st.name + " " + depClock + " Uhr Richtung " + tgt.name + ".";
  tgt.cfg.lastMsgTs = Date.now();
  try { fhMsgUpdate(true); } catch (e) {}
  const nowMin = now.getHours() * 60 + now.getMinutes();
  const depClock = String(Math.floor(aMin / 60)).padStart(2, "0") + ":" + String(aMin % 60).padStart(2, "0");
  // Abstände: eigene Position -> Abfahrtsstation und Zielstation -> Ziel.
  // Luftlinie sofort, zusätzlich echtes Wegerouting (OSRM); die Gehzeit zur
  // Station wird von der Wartezeit abgezogen ("los in x Minuten" = losgehen).
  const pos = livePos();
  const air1 = pos ? dist(pos, st) : null;
  const air2 = bestS ? dist(bestS, tgt) : null;
  const r1 = pos ? await footRouteM(pos, st) : null;
  const r2 = bestS ? await footRouteM(bestS, tgt) : null;
  const m1 = r1 ? r1.m : (air1 != null ? air1 * 1.3 : null);   // Fallback: Luftlinie × 1,3
  const m2 = r2 ? r2.m : (air2 != null ? air2 * 1.3 : null);
  const w1 = footMin(m1), w2 = footMin(m2);
  const losMin = (aMin - nowMin) - (w1 || 0);
  const title = "🏠 Mögliche Fahrt nach " + tgt.name;
  const lines = '<div class="bl"><span class="dl blink">' + escapeHtml(dep.line) + "</span>" +
    '<span class="mqwrap"><span class="mqi">' + escapeHtml(dep.direction) + "</span></span></div>" +
    '<div class="rowinfo">' + escapeHtml(st.name) + " <b>" + depClock + "</b> – " +
    (losMin > 0 ? "in " + losMin + " Minuten losgehen" : "jetzt losgehen!") +
    (w1 != null ? " (Fußweg " + w1 + " min" + (r1 ? "" : ", geschätzt") + ")" : "") + "</div>" +
    '<div class="rowinfo">🚶 Zur Abfahrtsstation: ' + formatDist(air1 || 0) + " Luftlinie" +
      (m1 != null ? " · " + formatDist(m1) + " Weg (~" + w1 + " min" + (r1 ? "" : ", geschätzt") + ")" : "") + "</div>" +
    (bestS ? '<div class="rowinfo">🎯 ' + escapeHtml(bestS.name) + " → Ziel: " + formatDist(air2 || 0) + " Luftlinie" +
      (m2 != null ? " · " + formatDist(m2) + " Weg (~" + w2 + " min" + (r2 ? "" : ", geschätzt") + ")" : "") + "</div>" : "");
