    const nm = String(s.name || "").toLowerCase();
    const tier = !ql ? 0 : nm.indexOf(ql) === 0 ? 0 : nm.indexOf(ql) >= 0 ? 1 : -1;
    if (tier < 0) continue;
    // v1.4.18: Zähler je Station für die zweite Trefferzeile: freie E-Bikes mit
    // mindestens 40 % Akkustand und freie Standardräder (alle Werte nur freie Räder)
    let nBikes = 0, nEb40 = 0, nBstd = 0;
