  .szt { font-style: italic; }   /* KONVENTION: kursiv = Wert aus dem Raum-Zeit-Diagramm (eigene Auswertung) */
  .sztwrap { display: inline-grid; vertical-align: bottom; }   /* Live- und Raum-Zeit-Wert im Stapel */
  .sztwrap > span { grid-area: 1 / 1; }
  .sztwrap .sztl { animation: sztAltA 4s steps(1, end) infinite; }
  .sztwrap .sztt { animation: sztAltB 4s steps(1, end) infinite; }
  @keyframes sztAltA { 0% { opacity: 1; } 50% { opacity: 0; } 100% { opacity: 0; } }
  @keyframes sztAltB { 0% { opacity: 0; } 50.01% { opacity: 1; } 100% { opacity: 1; } }
  .sztline.sztwarn div { color: #eab308; }   /* Anschluss-Sicherung: Vouchers-Farben wie Live (gelb) */
  .sztline.sztkrit div { color: #ef4444; }   /* verpasst = rot */
  .sztline.sztok div { color: #22c55e; }     /* Puffer ok = gruen
  .sztw-ok { color: #22c55e; }       /* Raum-Zeit-Fahrtbeobachtung: voraussichtlich puenktlich (gruen) */
  .sztw-warn { color: #eab308; }     /* leichte Verspaetung (gelb) */
  .sztw-late { color: #ef4444; }     /* starke Verspaetung ab 5 min (rot) */
