function focusFirstRow(box) {
  if (!box || box.hidden) return false;
  const first = box.querySelector("div[data-sn], div[data-addr], div[data-favsel], div[data-coord]");
  if (!first) return false;   // kein realer erster Eintrag: Aufrufer darf die Tastatur öffnen
  first.setAttribute("tabindex", "-1");
  [...box.querySelectorAll(".active")].forEach(el => el.classList.remove("active"));
  first.classList.add("active");
  first.focus({ preventScroll: false });
  return true;
}

