              plannedTime: e.t, actualTime: e.depRT || e.t,
              status: e.dly != null ? "PREDICTED" : "PLANNED",
              actualRelativeTime: (ms - now) / 1000,
              absMs: ms, plat: null, alerts: [], dfr: true
            };
