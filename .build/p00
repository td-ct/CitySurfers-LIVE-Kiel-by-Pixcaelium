async function favNahshRun() {
  const f = addrFavs[favDlgIdx];
  if (!f) return;
  if (parseLocText(f.label || "") && favDlgAddr.value.trim() === (f.label || "")) return;   // Koordinaten-Favorit
  const addrText = favDlgAddr.value.trim();
  if (addrText && addrText !== (f.label || "")) {
    // geänderte Adresse zuerst übernehmen (wie „Übernehmen“), damit der Abgleich
    // die neue Normalform und die neuen OSM-Koordinaten verwendet
    favNahshSt = { loading: true, cands: null, err: "", note: "Prüfe Adresse …" };
    favDlgNahshRender();
    let resolved = parseLocText(addrText);
    if (!resolved) resolved = await unifiedResolveOne(addrText);
    if (!resolved) {
      favNahshSt = { loading: false, cands: null, err: "Adresse nicht gefunden – bitte ändern oder „Übernehmen“.", note: "" };
      favDlgNahshRender();
      return;
    }
    f.lat = resolved.lat; f.lon = resolved.lon;
    f.osmLat = resolved.osmLat != null ? resolved.osmLat : (resolved.src === "nahsh" ? null : resolved.lat);
    f.osmLon = resolved.osmLon != null ? resolved.osmLon : (resolved.src === "nahsh" ? null : resolved.lon);
    f.osmNone = resolved.src === "nahsh";
    f.label = resolved.label;
    f.nahsh = resolved.nahsh || null;   // Treffer aus der einheitlichen Suche direkt übernehmen
    saveAddrFavs(); renderAddrFavs();
    favDlgAddr.value = f.label;
  }
  if (parseLocText(f.label || "")) return;   // Koordinaten-Favorit: kein LocMatch
  if (f.osmLat == null) { f.osmLat = f.lat; f.osmLon = f.lon; }
  favNahshSt = { loading: true, cands: null, err: "", note: "" };
  favDlgNahshRender();
  try {
    const st = { cands: null };
    await abgCands(st, { name: f.label, lat: f.lat, lon: f.lon }, null);
    favNahshSt = { loading: false, cands: (st.cands || []).filter(c => c.kind === "loc"), err: "", note: "" };
  } catch (e) {
    favNahshSt = { loading: false, cands: null,
      err: "NAH.SH-Abgleich fehlgeschlagen: " + String((e && e.message) || e), note: "" };
  }
  favDlgNahshRender();
}
