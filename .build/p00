  }, GPS_START_HINT_MS);
}

function gpsStop() {
  if (watchId != null) navigator.geolocation.clearWatch(watchId);
  watchId = null;
  gpsState = "off";
  gpsSilentAdopt = null;   // laufende stille Neu-Ortung abbrechen
  renderGpsBtn();
  renderAcc();
  updateGpsBtns();   // Knöpfe zurück auf grau (GPS aus)
  // keine Meldung mehr: Der Kurz-Hinweis steht im GPS-Dialog neben dem Ein-/Aus-Knopf
}

function onPos(pos) {
  const firstFix = gpsState === "searching";
  const newPos = { lat: pos.coords.latitude, lon: pos.coords.longitude, accuracy: pos.coords.accuracy };
  const moved = !myPos ||
    Math.abs(myPos.lat - newPos.lat) > 0.0002 ||
    Math.abs(myPos.lon - newPos.lon) > 0.0002;
  myPos = newPos;
  vehTrailPush(newPos, Date.now());   // Spur fuer die Fahrzeug-Erkennung
  gpsState = "on";
  gpsErrShown = false;
  renderGpsBtn();
  renderAcc();
  updateGpsBtns();   // Knopffarben nachziehen (grün ≤ 200 m, gelb darüber)
  updateTripDot();   // Punkte bei jedem GPS-Fix kontinuierlich nachfuehren
  updateRouteDots();
  try {
    localStorage.setItem("kvg-pos", JSON.stringify({
      lat: myPos.lat, lon: myPos.lon, accuracy: myPos.accuracy, ts: Date.now()
    }));
  } catch (e) {}
  // Gelber GPS-Knopf gedrückt: frische Ortung ohne Dialog übernehmen, sobald sie gut ist
  if (gpsSilentAdopt) {
    if (myPos.accuracy != null && myPos.accuracy > GPS_ACC_DIRECT_M) return;   // noch zu grob: weiter warten
    const k = gpsSilentAdopt;
    gpsSilentAdopt = null;
    gpsTakeTarget = k;
    gpsAdoptDispatch(myPos);
    return;
  }
  if (addrPos) {
    if (firstFix) setLocNote("Adresse aktiv – GPS läuft im Hintergrund, gilt aber nicht. ✕ im Adressfeld kehrt zum GPS zurück.");
    if (gpsDlgMode === "takeover" && !gpsDlg.hidden && pos.coords.accuracy <= getAccThresh()) { gpsDlg.hidden = true; gpsAdoptDispatch(myPos); }
    return;
  }
  // Ortung wird für die Sortierung der Listen höchstens alle 30 s neu angewendet
  // Fahrtverlauf offen: Panel spätestens alle 3 s neu rendern, damit das
  // Abhaken der Stationen (Radius betreten/verlassen) live mitläuft.
  if (!busPanel.hidden && currentTrip) {
    const nowMs = Date.now();
    if (nowMs - (onPos._lastBusRender || 0) >= 3000) {
      onPos._lastBusRender = nowMs;
      renderBusPanel();
    }
  }
  // Zu grobe Ortung (Radius > GPS_ACC_COARSE_M): nur eine gerade sichtbare
  // Auswahlliste wird ggf. neu sortiert, der Rest wird nicht aktualisiert.
  if (myPos.accuracy != null && myPos.accuracy > GPS_ACC_COARSE_M) {
    if (!sugBox.hidden && !search.value.trim()) { sortStops(); updateSuggestions(); }
    return;
  }
  const sortDue = !lastGpsSortTs || Date.now() - lastGpsSortTs >= GPS_SORT_INTERVAL_MS;
  if (gpsDlgMode === "takeover" && !gpsDlg.hidden && myPos.accuracy <= getAccThresh()) {   // Dialog: ab Schwellenwert automatisch übernehmen
    gpsDlg.hidden = true;
    lastGpsSortTs = Date.now();
    gpsAdoptDispatch(myPos);
    return;
  }
  if (firstFix || (moved && sortDue)) {
    lastGpsSortTs = Date.now();
    positionReset();
    setLocNote("GPS aktiv · Positionen kommen laufend (±" + Math.round(myPos.accuracy) +
      " m) · " + stops.length + " Haltestellen nach Entfernung.");
  }
}
let lastGpsSortTs = 0;

function onGpsErr(err) {
  if (gpsState === "off") return;
  const reasons = {
    1: "Standortfreigabe verweigert – bitte in den Browser-Berechtigungen für diese Seite erlauben und ◎ erneut klicken.",
    2: "Standort aktuell nicht verfügbar (kein GPS-Empfang).",
    3: "Zeitüberschreitung – GPS-Signal wird weiter gesucht …"
  };
  if (err.code === 1) {
    if (watchId != null) navigator.geolocation.clearWatch(watchId);
    watchId = null;
    gpsState = "off";
    renderGpsBtn();
    renderAcc();
  }
  if (!gpsErrShown || err.code === 1) {
    setLocNote((myPos ? "Letzter Standort bleibt aktiv. " : "") +
      (reasons[err.code] || ("GPS-Fehler: " + err.message)));
    gpsErrShown = true;
  }
}

let gpsSuspect = false;
function renderGpsBtn() {
  for (const b of [locBtn, gpsDlgBtn]) {
    if (!b) continue;
    b.classList.toggle("busy", gpsState === "searching");
    b.classList.toggle("active", gpsState === "on");
    if (b === gpsDlgBtn) continue;   // im Dialog nur Zustand, kein Verdachts-Blinken
    b.classList.toggle("suspect", gpsSuspect);
    b.textContent = gpsState === "on" ? "◉" : "◎";
    b.title = gpsState === "on" ? "GPS aktiv (läuft laufend) – klicken zum Deaktivieren"
      : gpsState === "searching" ? "GPS-Suche läuft – klicken zum Abbrechen"
      : "GPS aktivieren";
  }
  if (gpsDlgBtn) {
    gpsDlgBtn.textContent = gpsState === "on" ? "◉ GPS aus" : gpsState === "searching" ? "◎ … abbrechen" : "◎ GPS ein";
    // kein Zustands-Hinweis mehr; nur die Kurzform, wenn GPS aus ist und noch
    // eine letzte Position vorliegt (Liste nutzt sie weiter)
    if (gpsState === "off" && myPos) {
      gpsDlgState.hidden = false;
      gpsDlgState.textContent = "nutzt letzten Standort weiter";
    } else gpsDlgState.hidden = true;
  }
  updateGpsDlg();
}

function renderAcc() {
  if (gpsState === "on" && myPos) {
    const a = myPos.accuracy;
    const seg = a <= 10 ? 5 : a <= 25 ? 4 : a <= 50 ? 3 : a <= 100 ? 2 : 1;
    [...accBar.children].forEach((el, i) => el.classList.toggle("on", i < seg));
    accBar.title = "GPS-Genauigkeit ±" + Math.round(a) + " m";
    accBar.hidden = false;
  } else {
    accBar.hidden = true;
  }
  updateGpsDlg();
}

// ---------- GPS-Dialog an der Haltestellensuche (Knopf „GPS") ----------
// Gute Ortung (<= 100 m): sofort übernehmen, Liste öffnen, ohne Dialog.
// Schlechte Ortung: Dialog wartet auf besseres Signal, schließt automatisch bei <= 20 m.
// Übernehmen/Suche übernimmt die Position frühestens alle 30 s neu in die Listen.
function updateGpsDlg() {
  if (!gpsDlg || gpsDlg.hidden) return;
  if (myPos && gpsState !== "off") {
    const a = Math.round(myPos.accuracy || 0);
    gpsDlgAcc.textContent = "±" + a + " m";
    const seg = a <= 10 ? 5 : a <= 25 ? 4 : a <= 50 ? 3 : a <= 100 ? 2 : 1;
    [...gpsDlgBar.children].forEach((el, i) => el.classList.toggle("on", i < seg));
    gpsDlgBar.hidden = false;
    gpsDlgBar.title = "GPS-Genauigkeit ±" + a + " m";
    const th = getAccThresh();

    gpsDlgMsg.textContent = gpsState === "searching"
      ? "GPS wird eingeschaltet – warte auf Positionsdaten" + (gpsDlgMode === "takeover" && gpsWasOff ? " (Abbrechen schaltet GPS danach wieder aus)." : " …")
      : gpsDlgMode === "status"
        ? (a <= GPS_ACC_AUTOCLOSE_M ? "Sehr gute Ortung (±" + a + " m)."
           : a <= GPS_ACC_DIRECT_M ? "Gute Ortung (±" + a + " m)."
           : "Ortung noch ungenau (±" + a + " m) – Positionen laufen weiter, sobald es besser wird.")
        : a <= th ? "Sehr gute Ortung – wird übernommen …"
        : a <= GPS_ACC_DIRECT_M ? "Gute Ortung – „Übernehmen“ oder auf ein noch besseres Signal (±" + th + " m) warten."
        : "Ortung noch ungenau – warte auf ein besseres Signal (ab ±" + th + " m automatische Übernahme) …";
    // Nach GPS_DLG_WARN_MS immer noch kein brauchbares Signal: Warnung anhängen
    if (gpsDlgMode === "takeover" && gpsDlgSince &&
        Date.now() - gpsDlgSince > GPS_DLG_WARN_MS &&
        (gpsState !== "on" || !myPos || (myPos.accuracy || 999) > getAccThresh()))
      gpsDlgMsg.textContent += " ⚠ Die Ortung bessert sich nicht – ggf. im Freien versuchen oder abbrechen und später erneut.";
  } else {
    gpsDlgAcc.textContent = "–";
    gpsDlgBar.hidden = true;
    gpsDlgMsg.textContent = gpsState === "searching" ? "GPS wird eingeschaltet – warte auf Positionsdaten …"
      : "GPS aus – oben im Dialog einschalten.";
  }
}
// GPS-Knopf-Zustand: "off" = grau (GPS aus), "busy" = blau pulsierend (Suche
// läuft), "ok" = grün (keine Position oder aktuelle Ortung ≤ 200 m von der
// gespeicherten), "stale" = gelb (weiter als 200 m davon entfernt).
// Klick-Semantik (gpsBtnClick): grau = einschalten/übernehmen, gelb = neu orten
// ohne Dialog, grün = GPS ausschalten.
function gpsBtnState(stored) {
  if (gpsState === "searching") return "busy";
  if (gpsState !== "on" || !myPos) return "off";
  if (stored && dist(myPos, stored) > GPS_STALE_M) return "stale";
  return "ok";
}
// Feld-lokaler GPS-Knopf-Zustand (Adressfeld, Haltestellen-Suchfeld, Route-Dialog,
// Start-/Ziel-Auswahl): Drei Zustaende je Feld – grau = nichts uebernommen (Liste
// alphabetisch bzw. nach Aehnlichkeit), gruen = die gespeicherte Position gilt
// (bleibt auch stehen, wenn das GPS aus ist), gelb = Position > 200 m gewandert
// (Druck nimmt die neue sofort). "GPS aus" beendet NUR die Uebernahme dieses
// Feldes, das GPS selbst laeuft weiter.
function gpsLocalBtnState(stored) {
  if (gpsState === "searching") return "busy";
  if (!stored) return "off";
  if (gpsState === "on" && myPos && dist(myPos, stored) > GPS_STALE_M) return "stale";
  return "ok";
}
function gpsBtnCls(st) { return st === "ok" ? " active" : st === "stale" ? " stale" : st === "busy" ? " busy" : ""; }
// Farben der GPS-Knöpfe (Adressfeld, Haltestellenfeld, Reiter-Kopfzeile) neu
// bewerten; renderPanels zieht den Kopfzeilen-Knopf nach (diff-guarded).
let gpsBtnSig = "init";
function updateGpsBtns(force) {
  const sAddr = gpsLocalBtnState(addrPos && addrPos.gps ? addrPos : null);
  const sStop = gpsLocalBtnState(stopGpsPos);
  const sTab = currentStop ? gpsBtnState(tabGps[currentStop.shortName] || depGps || null) : "";
  const sig = sAddr + "|" + sStop + "|" + sTab + "|" + routePickGpsState("start") + "|" + routePickGpsState("dest");
  if (!force && sig === gpsBtnSig) return;
  gpsBtnSig = sig;
  posBtn.className = "gpsbtn" + gpsBtnCls(sAddr);
  document.getElementById("gpsGoBtn").className = "gpsbtn" + gpsBtnCls(sStop);
  // GPS-Knoepfe im Route-Dialog (Start/Ziel) nachziehen, falls er offen ist
  document.querySelectorAll("[data-rtgps]").forEach(b => {
    const g = routeSel[b.dataset.rtgps];
    b.className = "achip rtgps" + gpsBtnCls(gpsLocalBtnState(g && g.gps ? g : null));
  });
  if (routePickRefreshFn) routePickRefreshFn();   // offener Start-/Ziel-Auswahl-Dialog: Chip + Liste nachziehen
  if (bkGpsBtnRefreshFn) bkGpsBtnRefreshFn();   // v1.4.12: offener MM-Routing-Dialog: GPS-Knöpfe nachziehen
  renderPanels();
}
// Eigene GPS-Position des Haltestellen-Suchfelds setzen/löschen (Liste sortiert danach)
function setStopGpsPos(p) {
  stopGpsPos = p;
  try { localStorage.setItem("kvg-stopgps", p ? JSON.stringify(p) : "null"); } catch (e) {}
  document.getElementById("gpsGoBtn").className = "gpsbtn" + gpsBtnCls(gpsLocalBtnState(stopGpsPos));
  sortStops();   // Grundsortierung (GPS-Entfernung oder alphabetisch) nachziehen
  if (!sugBox.hidden && !search.value.trim()) updateSuggestions();
}
function gpsAdoptForStops(p) {
  if (!p) return;
  setStopGpsPos({ lat: p.lat, lon: p.lon, acc: Math.round(p.accuracy || 0), ts: Date.now() });   // eigene Position des Suchfelds setzen
  search.value = "";
  updateStopClear();
  searchIndex = 0;
  updateSuggestions();
  focusFirstRow(sugBox);
  setLocNote("GPS-Position (±" + Math.round(p.accuracy || 0) +
    " m) für die Haltestellensuche übernommen – Liste nach Entfernung sortiert. GPS-Knopf aktualisiert die Position.");
}
function gpsTakeOver() {
  if (!("geolocation" in navigator) || !isSecure()) {
    setLocNote("GPS nicht verfügbar – Adresse, Koordinaten oder Locator eintippen oder als Karten-Link senden.");
    return;
  }
  // GPS an und gute Ortung: kein Dialog, direkt für die Sortierung übernehmen
  if (gpsState === "on" && myPos && (myPos.accuracy == null || myPos.accuracy <= GPS_ACC_DIRECT_M)) {
    gpsAdoptForStops(myPos);
    return;
  }
  // sonst: Dialog (schaltet GPS nötigenfalls ein, wartet auf besseres Signal)
  gpsWasOff = gpsState === "off";
  if (gpsState === "off") gpsStart();
  openGpsDlg("takeover");
}
// Dialog öffnen: "takeover" zeigt Abbrechen/Übernehmen und übernimmt automatisch ab
// GPS_ACC_AUTOCLOSE_M; "status" (Klick aufs GPS-Symbol oben rechts) zeigt nur
// Ein-/Aus-Schalter und Genauigkeit, ohne Übernehmen/Abbrechen.
// ---------- GPS-Übernahme für eine einzelne Liste (Ziel dispatchen) ----------
// gpsTakeTarget legt fest, wohin eine GPS-Übernahme geht: "stops" = klassische
// GPS-Übernahme (Startpunkt + Haltestellenliste), "addrFav"/"stopFav" =
// GPS-Standort nur als Sortier-Ursprung der jeweiligen Favoritenliste hinterlegen.
let gpsTakeTarget = "stops";
let bkGpsAdoptFn = null;     // v1.4.12: offener MM-Routing-Dialog: GPS-Uebernahme fuer Start/Ziel des Dialogs
let bkGpsBtnRefreshFn = null;   // v1.4.12: offener MM-Routing-Dialog: GPS-Knopf-Farben nachziehen
// Gelber GPS-Knopf gedrückt: dieser Kontext wartet auf den nächsten GUTEN Fix und
// übernimmt ihn dann ohne Dialog (gpsSilentAdopt = gpsTakeTarget-Kontext).
let gpsSilentAdopt = null;
function gpsAdoptForList(kind, p) {
  if (!p) return;
  sortGps[kind] = { lat: p.lat, lon: p.lon, acc: Math.round(p.accuracy || 0), t: Date.now() };
  saveSortGps();
  renderAddrFavs();
  renderStopFavs();
  setLocNote("📍 GPS-Standort für die " + (kind === "addrFav" ? "Adressfavoriten" : "Haltestellenfavoriten") +
    " übernommen (±" + Math.round(p.accuracy || 0) + " m) – Liste wird danach sortiert.");
}
// v1.4.12: GPS-Uebernahme fuer das Micromobility Routing (Start-/Ziel-Knopf des
// offenen Bike-Dialogs): bk:start / bk:dest laufen ueber die Registrierung des
// Dialogs; die anderen Ziele (route, addr, stops, Favoriten) bleiben unberuehrt.
function bkGpsFieldAdopt(field, p) {
  if (!bkGpsAdoptFn || !document.getElementById("bikeDlg")) {
    setLocNote("Der Micromobility-Routing-Dialog ist inzwischen geschlossen, die GPS-Position wurde dort nicht mehr übernommen.");
    return;
  }
  bkGpsAdoptFn(field, p);
}
function gpsAdoptDispatch(p) {
  if (gpsTakeTarget.indexOf("bk:") === 0) { bkGpsFieldAdopt(gpsTakeTarget.slice(3), p); return; }
  if (gpsTakeTarget.indexOf("rpick:") === 0) { routePickGpsAdopt(gpsTakeTarget.slice(6), p); return; }
  if (gpsTakeTarget === "addrFav" || gpsTakeTarget === "stopFav") gpsAdoptForList(gpsTakeTarget, p);
  else if (gpsTakeTarget === "addr") adoptGpsPos(p);
  else if (gpsTakeTarget === "addrSave") saveGpsAddrFav(p);
  else if (gpsTakeTarget === "dephead") depGpsAdopt(p);
  else if (gpsTakeTarget === "route") routeGpsAdopt(p);
  else gpsAdoptForStops(p);
}
function gpsTakeOverFor(kind) {
  gpsTakeTarget = kind;
  if (!("geolocation" in navigator) || !isSecure()) {
    setLocNote(kind === "route"
      ? "GPS nicht verfügbar, die Route lässt sich nicht per GPS-Position planen."
      : kind.indexOf("bk:") === 0
      ? "GPS nicht verfügbar, das Micromobility Routing lässt sich nicht per GPS-Position planen."
      : "GPS nicht verfügbar, die Liste lässt sich nicht nach GPS-Standort sortieren.");
    return;
  }
  // gute Ortung: direkt hinterlegen; sonst Dialog (schaltet GPS nötigenfalls ein)
  if (gpsState === "on" && myPos && (myPos.accuracy == null || myPos.accuracy <= GPS_ACC_DIRECT_M)) {
    if (kind.indexOf("rpick:") === 0) routePickGpsAdopt(kind.slice(6), myPos);
    else if (kind === "addr") adoptGpsPos(myPos);
    else if (kind === "dephead") depGpsAdopt(myPos);
    else if (kind === "route") routeGpsAdopt(myPos);
    else if (kind.indexOf("bk:") === 0) bkGpsFieldAdopt(kind.slice(3), myPos);   // v1.4.12: MM-Routing-Dialog
    else gpsAdoptForList(kind, myPos);
    return;
  }
  gpsWasOff = gpsState === "off";
  if (gpsState === "off") gpsStart();
  openGpsDlg("takeover");
}
// ---------- Einheitliche GPS-Knopf-Semantik (alle farbigen GPS-Knöpfe) ----------
// grau = einschalten bzw. Position übernehmen (Dialog nur bei schlechter Ortung),
// gelb = neue Ortung ohne Dialog übernehmen (Knopf wird wieder grün),
// grün = bei feld-lokalen Knöpfen (Adressfeld, Haltestellen-Suchfeld, Route-Dialog,
// Start-/Ziel-Auswahl) NUR die Übernahme dieses Feldes beenden – sonst GPS ganz
// ausschalten; blau pulsierend = Suche läuft, Klick wird ignoriert.
function gpsBtnClick(kind, stored) {
  // feld-lokale Knöpfe bewerten ihren Zustand wie ihre Anzeige: ohne gespeicherte
  // Position grau statt grün, damit "aus" wirklich nur die Übernahme meint.
  const st = (kind === "stops" || kind === "addr" || kind === "route") ? gpsLocalBtnState(stored) : gpsBtnState(stored);
  if (st === "busy") return;
  if (st === "ok") {
    if (kind === "stops") {
      setStopGpsPos(null);
      setLocNote("GPS-Übernahme für die Haltestellensuche beendet – die Liste sortiert wieder alphabetisch. Das GPS selbst bleibt an.");
      return;
    }
    if (kind === "addr") {
      clearAddr(false);
      setLocNote("GPS-Übernahme für das Adressfeld beendet – das GPS selbst bleibt an.");
      return;
    }
    if (kind === "route") {
      const w = gpsTakeWhich;
      routeSel[w] = null;
      routeAbg[w] = null;
      const d = document.getElementById("routeDlg");
      if (d) d.innerHTML = routeDlgHTML();
      updateGpsBtns(true);
      setLocNote("GPS-Position als " + (w === "start" ? "Start" : "Ziel") + " entfernt – im Dialog neu wählen. Das GPS selbst bleibt an.");
      return;
    }
    gpsStop();
    setLocNote("GPS ausgeschaltet – die GPS-Knöpfe sind wieder grau; ein erneuter Druck ortet neu.");
    return;
  }
  if (st === "stale") { gpsSilentRefresh(kind); return; }
  if (kind === "stops") { gpsTakeTarget = "stops"; gpsTakeOver(); return; }   // wie bisher: Übernahme für die Haltestellensuche
  gpsTakeOverFor(kind);
}
// Gelb: frische Ortung ohne Dialog. Liegt schon eine gute Ortung vor, wird sie
// sofort übernommen; sonst läuft das GPS (nötigenfalls angeschaltet) und der
// nächste ausreichend genaue Fix wird automatisch übernommen.
function gpsSilentRefresh(kind) {
  if (gpsState === "on" && myPos && (myPos.accuracy == null || myPos.accuracy <= GPS_ACC_DIRECT_M)) {
    gpsTakeTarget = kind;
    gpsAdoptDispatch(myPos);
    return;
  }
  gpsWasOff = gpsState === "off";
  if (gpsState === "off") gpsStart();
  gpsSilentAdopt = kind;
  setLocNote("Neue Ortung läuft – wird ohne Dialog übernommen, sobald sie genau genug ist.");
}

// ---------- GPS je Stationsreiter (Kopfzeile „Abfahrten: …“) ----------
// Jeder Stationsreiter hält seine EIGENE GPS-Position (kvg-tabgps, sn → Position),
// bis der GPS-Knopf der Kopfzeile sie per Klick aktualisiert. Die alte globale
// depGps-Position gilt weiter als geerbter Ursprung für Reiter ohne eigene.
let depGpsTargetSn = null;   // Reiter, für den die laufende GPS-Übernahme gilt
function depGpsToggle() {   // GPS-Knopf der Kopfzeile: grau = Position DIESES Reiters übernehmen, gelb = neu orten, grün = GPS aus
  depGpsTargetSn = currentStop ? currentStop.shortName : null;
  const own = (depGpsTargetSn && tabGps[depGpsTargetSn]) || depGps || null;
  gpsBtnClick("dephead", own);
}
function depGpsAdopt(p) {   // Übernahme aus GPS-Dialog/-Fix: gilt für den angestoßenen Reiter
  tabGpsAdopt(p, depGpsTargetSn || (currentStop && currentStop.shortName));
}
function tabGpsAdopt(p, sn) {
  if (!p || !sn) return;
  tabGps[sn] = { lat: p.lat, lon: p.lon, acc: Math.round(p.accuracy || 0), ts: Date.now() };
  saveTabGps();
  const v = stopViews.get(sn);   // Fußwege dieses Reiters neu berechnen
  if (v) v.meters = null;
  renderPanels();
  if (currentStop && currentStop.shortName === sn) refetchStop(sn, true);
  renderViews();
  enrichVisible(true);
  updateGpsBtns(true);
  setLocNote("📍 GPS-Position (±" + Math.round(p.accuracy || 0) +
    " m) für diesen Stationsreiter übernommen – Fußwege und erreichbare Verbindungen aktualisiert.");
