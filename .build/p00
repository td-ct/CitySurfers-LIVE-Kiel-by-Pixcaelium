    .replace(/ue/g, "u").replace(/oe/g, "o").replace(/ae/g, "a").replace(/ss/g, "s");
}
function rsNormalizeHit(h) {   // LocMatch-/gespeicherter Treffer -> Station im Register (einmalig)
  let s = remoteStops.get(h.shortName);
  if (!s) {
    s = { shortName: h.shortName, name: h.name || "", lat: h.lat, lon: h.lon,
      lid: h.lid || "", extId: h.extId || "", svc: h.svc || svcForCoords(h.lat, h.lon),
      rId: h.rId || null, rs: true };
    remoteStops.set(h.shortName, s);
  } else {
    if (h.name) s.name = h.name;
    if (h.lat != null) s.lat = h.lat;
    if (h.lon != null) s.lon = h.lon;
    if (h.lid) s.lid = h.lid;
    if (h.svc) s.svc = h.svc;
    if (h.rId) s.rId = h.rId;
