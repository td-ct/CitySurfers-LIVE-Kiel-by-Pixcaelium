    if (sztRv != null && !(gpsKey && key === gpsKey)) {
      const stxt = "≈" + sztClockOf(sztRv.eta);
      const liveMin = actual ? hhmmToMin(actual) : null;
      if (!actual) {
        sztRowAktuell = '<span class="szt">' + stxt + "</span>";
        if (sztRv.d != null) delayHtml = sztChip(sztRv.d);
      } else {
