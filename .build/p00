  if (sugDkOn())    // v1.4.18: Donkey-Zeilen nur bei freigegebenem MM-Filter (alles aus = alles an)
    hits = hits.concat(mmSugStations(q).map(s => ({ s: s, tier: s.tier })));   // v1.4.14: Donkey-Leihstationen (🚲) mit in die Trefferliste
  if (q.length >= RS_MIN_CHARS) {   // v1.5.0: Fern-Stationen aus dem LocMatch-Cache, ganz unten in der Liste
    const rc = rsSearchCache.get(q);
    if (rc && rc.hits.length)
      hits = hits.concat(rc.hits.filter(sugTypeAllowed).map(s => ({ s: s, tier: 2 })));
  }
  if (!q.length && addrPos && pos === addrPos) {   // v1.6.34: aktive Adresse = Listen-Ursprung
    const ah = rsAddrNearHits(addrPos);   // Fern-Stationen um die Adresse, Distanz-Sortierung gilt
    if (ah.length) hits = hits.concat(ah.filter(sugTypeAllowed).map(s => ({ s: s, tier: 0 })));
    rsAddrNear(addrPos);   // ggf. erst suchen (fire-and-forget, Cache schuetzt)
  }
  if (!hits.length) { sugBox.hidden = true; return; }
  if (pos && q.length) {
    // Suchtreffer: Haltestellenfavoriten zuerst (als ⭐ markiert), danach die
    // Relevanz-Stufe (Wortanfang vor enthält vor Tippfehler) und erst innerhalb
    // derselben Stufe nach Entfernung – die passendsten Treffer stehen oben.
    hits = hits.slice().sort((a, b) =>
      (favs.includes(a.s.shortName) ? 0 : 1) - (favs.includes(b.s.shortName) ? 0 : 1) ||
      a.tier - b.tier ||
      dist(pos, a.s) - dist(pos, b.s));
  } else if (pos) {
    hits = hits.slice().sort((a, b) => dist(pos, a.s) - dist(pos, b.s));
  }
  sugHits = hits.map(h => h.s);
  sugRendered = 0;
  sugBox.innerHTML = "";
  sugBox.hidden = false;
  sugBox.scrollTop = 0;
  renderMoreRows(SUGGEST_CHUNK_ROWS);   // die nächsten Treffer zuerst
  if (pos) enrichVisible(false);   // auch während der Suche laden
}

// Tastatursteuerung der Haltestellenliste – gilt für Fokus im Suchfeld
// oder Fokus auf einem Listeneintrag (mobiles Öffnen ohne Tastatur)
function handleSugNav(e) {
  const items = [...sugBox.querySelectorAll("div[data-sn], div[data-fsn], div[data-dk], div[data-rs]")];   // v1.5.0: auch Fern-Stationen
  if (sugBox.hidden || !items.length) return;
  if (e.key === "ArrowDown" || e.key === "ArrowUp") {
    e.preventDefault();
    searchIndex = e.key === "ArrowDown"
      ? Math.min(searchIndex + 1, items.length - 1)
      : Math.max(searchIndex - 1, 0);
    items.forEach((el, i) => el.classList.toggle("active", i === searchIndex));
    items[searchIndex].focus({ preventScroll: false });
    items[searchIndex].scrollIntoView({ block: "nearest" });
  } else if (e.key === "Enter") {
    const el = searchIndex >= 0 ? items[searchIndex] : items[0];
    if (el && el.dataset.ftrip) {   // Flachmodus-Zeile: Station + Buslinie
      const [fSn, fId] = el.dataset.ftrip.split("~");
      selectBus(fSn, fId);
      selectTrip(fSn, fId);
      sugBox.hidden = true;
      return;
    }
    if (el && el.dataset.dk) { openMMTabById(el.dataset.dk); sugBox.hidden = true; return; }   // v1.4.14: Donkey-Leihstation
    if (el && el.dataset.rs) { openRemoteTab(remoteStops.get(el.dataset.rs)); sugBox.hidden = true; return; }   // v1.5.0: Fern-Station
    if (el) selectStop(el.dataset.sn || el.dataset.fsn);
  } else if (e.key === "Escape") {
    sugBox.hidden = true;
  }
}

// ---------- Flachmodus der Haltestellensuche (⏱): Abfahrten in Laufweite ----------
// Alle Haltestellen, die in FLAT_WALK_MAX_MIN Minuten zu Fuß erreichbar sind,
// in einer Abfrage (OSRM-Tabelle) entfernen, deren Abfahrten der nächsten
// FLAT_DEP_MAX_MIN Minuten einsammeln und ALLE Treffer GEMEINSAM nach Fußweg
// zur Station sortieren (innerhalb derselben Station nach Abfahrtszeit) – ganz
// ohne Stationsüberschriften, die Station steht in jeder Zeile. Läuft derselbe
// Bus (tripId) an mehreren erreichbaren Stationen, bleibt nur die Verbindung
// mit dem kürzesten Fußweg stehen.
const FLAT_WALK_MAX_MIN = 15;      // Laufweite in Gehminuten
const FLAT_AIR_FACTOR = 1.3;      // Luftlinie × Faktor als Höchstwert für Kandidaten
const FLAT_MAX_STOPS = 20;        // Kandidaten vor der Fußweg-Abfrage (nächste zuerst)
const FLAT_REFRESH_MS = 45000;    // Abfahrten im Flachmodus so frisch halten
const FLAT_DEP_MAX_MIN = 30;      // nur Abfahrten der nächsten 30 Minuten zeigen
let listMode = "tree";            // "tree" = Hierarchie nach Haltestellen, "flat" = Laufweite
let flatBusy = false, flatTs = 0;
const listModeBtn = document.getElementById("listModeBtn");
listModeBtn.addEventListener("click", () => {
  listMode = listMode === "tree" ? "flat" : "tree";
  listModeBtn.textContent = listMode === "tree" ? "☰" : "⏱";
  listModeBtn.classList.toggle("active", listMode === "flat");
  listModeBtn.title = listMode === "tree"
    ? "Listenansicht wechseln: Hierarchisch (nach Haltestellen) oder Abfahrten in Laufweite (nächste 30 Minuten, gemeinsam nach Fußweg sortiert)"
    : "Listenansicht wechseln: zurück zur Hierarchie nach Haltestellen";
  searchIndex = -1;
  updateSuggestions();
});
async function buildFlatList() {
  if (flatBusy) return;
  flatBusy = true;
  flatTs = Date.now();
  try {
    const pos = listPos();
    sugBox.innerHTML = "";
    if (!pos) {
      sugBox.innerHTML = '<div class="srow"><span class="sname dim">Keine Position aktiv – für Abfahrten in Laufweite GPS antippen oder eine Adresse/Startpunkt einloggen.</span></div>';
      sugBox.hidden = false;
      return;
    }
    // Kandidaten: Luftlinie × 1.3 als Fußweg-Obergrenze, die nächsten 20
    const near = stops.map(s => ({ s: s, air: dist(pos, s) }))
      .filter(c => c.air * FLAT_AIR_FACTOR <= FLAT_WALK_MAX_MIN * WALK_SPEED_KMH * 1000 / 60)
      .sort((a, b) => a.air - b.air)
      .slice(0, FLAT_MAX_STOPS);
    // v1.4.18: Quellen-Filter gilt auch im ⏱-Laufweiten-Modus (der zeigt nur Busse und Bahnen)
    const cands = near.filter(c => sugTypeAllowed(c.s));
    if (!near.length) {
      sugBox.innerHTML = '<div class="srow"><span class="sname dim">Keine Haltestellen in ' + FLAT_WALK_MAX_MIN + ' Minuten Laufweite.</span></div>';
      sugBox.hidden = false;
      return;
    }
    if (!cands.length) {
      sugBox.innerHTML = '<div class="srow"><span class="sname dim">Die aktiven Filter schließen gerade alle Bus- und Bahn-Haltestellen aus; der ⏱-Modus zeigt nur Busse und Bahnen. Oben mindestens einen der Filter 🚆 DB oder 🚌 ÖPNV einschalten.</span></div>';
      sugBox.hidden = false;
      return;
    }
    sugBox.innerHTML = '<div class="srow"><span class="sname dim">Laufweite wird berechnet …</span></div>';
    sugBox.hidden = false;
    // echte Fußwege in einer Tabellen-Abfrage (OSRM)
    const footM = {};
    try {
      const url = FOOT_TABLE + "/" + pos.lon + "," + pos.lat + ";" +
        cands.map(c => c.s.lon + "," + c.s.lat).join(";") +
        "?sources=0&annotations=distance,duration";
      const res = await apiFetch("osrm", url);
      if (res.ok) {
        const data = await res.json();
        const ds = data.distances && data.distances[0];
        if (ds) cands.forEach((c, i) => {
          const m = ds[i + 1];
          if (m != null && m >= 0) footM[c.s.shortName] = m;
        });
      }
    } catch (e) {}
    // erreichbar: Fußweg (OSRM, sonst Schätzung) in Laufweite
    const reach = cands.map(c => ({
        s: c.s,
        footM: footM[c.s.shortName] != null ? footM[c.s.shortName] : c.air * FLAT_AIR_FACTOR
      }))
      .filter(c => c.footM / (WALK_SPEED_KMH * 1000 / 60) <= FLAT_WALK_MAX_MIN);
    if (!reach.length) {
      sugBox.innerHTML = '<div class="srow"><span class="sname dim">Keine Haltestellen in ' + FLAT_WALK_MAX_MIN + ' Minuten Laufweite.</span></div>';
      return;
    }
    // Abfahrtstafeln aller erreichbaren Stationen (Cache je Station umgehen)
    const rows = [];
    await Promise.all(reach.map(async c => {
      depCache.delete(c.s.shortName);
      const [deps, platforms] = await Promise.all([getDepartures(c.s.shortName), loadPlatforms(c.s.shortName)]);
      for (const d of (deps || [])) {
        if (d.actualRelativeTime == null || d.actualRelativeTime > FLAT_DEP_MAX_MIN * 60) continue;   // nur nächste 30 Minuten
        rows.push({
          sn: c.s.shortName, name: c.s.name, footM: c.footM,
          tripId: d.tripId, line: d.line, direction: d.direction,
          rel: d.actualRelativeTime, plat: platforms && platforms[d.tripId],
          status: d.status
        });
      }
    }));
    // Dedup: derselbe Bus (tripId) nur mit dem kürzesten Fußweg
    const best = {};
    for (const r of rows) {
      const prev = best[r.tripId];
      if (!prev || r.footM < prev.footM) best[r.tripId] = r;
    }
    const list = Object.values(best).sort((a, b) => a.footM - b.footM || a.rel - b.rel);   // gemeinsam nach Fußweg zur Station, dann Abfahrtszeit
    const walkSecOf = m => m / (WALK_SPEED_KMH * 1000 / 3600);
    let html = "";
    const now0 = Date.now();
    for (const r of list) {
      const losMin = Math.round((r.rel - (now0 - flatTs) / 1000 - walkSecOf(r.footM)) / 60);
      if (losMin < -2) continue;   // mehr als 2 Minuten abgefahren
      const t = new Date(now0 + r.rel * 1000);
      const clock = String(t.getHours()).padStart(2, "0") + ":" + String(t.getMinutes()).padStart(2, "0");
      const walkMin = Math.ceil(r.footM / (WALK_SPEED_KMH * 1000 / 60));
      html += '<div class="srow flatrow bl' + (losMin < 0 ? " missed" : (losMin <= 3 ? " soon" : "")) +
        '" data-fsn="' + escapeHtml(r.sn) + '" data-ftrip="' +
        escapeHtml(r.sn + "~" + r.tripId) + '" title="Station und Buslinie öffnen">' +
        '<span class="dl blink">' + escapeHtml(r.line) + "</span>" +
        (r.plat ? '<span class="plat">[' + escapeHtml(r.plat) + ']</span>' : "") +
        '<span class="mqwrap"><span class="mqi">' + escapeHtml(r.direction) +
          " (ab " + escapeHtml(r.name) + ")</span></span>" +
        '<span class="fdst">' + escapeHtml(formatDist(r.footM)) + " · " + walkMin + " min</span>" +
        '<span class="btime">' + clock + " · " +
        ((r.status === "PREDICTED" || r.status === "STOPPING") && !isDB(r.sn) &&
          (r.rel - (now0 - flatTs) / 1000) > 0 && (r.rel - (now0 - flatTs) / 1000) <= CD_MAX_S
          ? "fährt in " + cdSpan(flatTs + r.rel * 1000) + " min"
          : "los in " + losMin + " min") + "</span></div>";
    }
    sugBox.innerHTML = html || '<div class="srow"><span class="sname dim">Gerade keine Abfahrten in den nächsten ' + FLAT_DEP_MAX_MIN + ' Minuten.</span></div>';
    sugBox.hidden = false;
    marqueeify(sugBox);   // Lauftext: Fahrtrichtung + Abfahrtsstation gemeinsam lesbar
    flatHasCd = html.indexOf("data-cd") >= 0;   // OKW: mit Countdown dichter nachladen
  } finally {
    flatBusy = false;
  }
}
// Flachmodus: Abfahrten laufend frisch halten (nur solange die Liste offen ist)
