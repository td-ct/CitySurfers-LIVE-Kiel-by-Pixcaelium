    white-space: normal; overflow-wrap: anywhere; word-break: break-word; }   /* v1.6.29 (Timo): umbrechen statt abschneiden */
  /* Wandernder, leuchtender Punkt im Fahrtverlauf: läuft kontinuierlich auf
     der blauen Linie zwischen den Stationen, HINTER den Stations-Kreisen */
  .trip .tripdot { position: absolute; left: 6.5px; top: 0; width: 10px; height: 10px;
