  for (const st of stops) {
    if (isRS(st.shortName) || st.lat == null || st.lon == null) continue;
    const d = dist(addr, st);
    if (d < dmin) dmin = d;
  }
  if (dmin <= RS_ADDR_MIN_KM * 1000) return;   // Kiel-Umfeld: lokale Liste reicht
