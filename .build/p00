    }
    const hereIdx = currentTrip.atIdx != null ? currentTrip.atIdx : done;
    const rowCls = (i <= done && i !== currentTrip.atIdx ? " done" : "") + (i === hereIdx ? " here" : "") +
      (i === theFrom ? " frow" : "") + (i === last ? " lrow" : "");
    const canOpen = stops.some(x => x.shortName === s.shortName);   // KVG-Station: direkter Reiter
    // v1.6.23 (Timo): JEDE im Verlauf angezeigte Station oeffnet per Namens-
    // Tipp einen Reiter: KVG direkt (data-stopopen wie bisher), alle anderen
    // (Fern-Stationen, DB/VBB-Strecken) per Zuordnung ueber data-stoprt.
    const nm = String(s.name || "").trim();
    const openAttr = canOpen
      ? ' data-stopopen="' + escapeHtml(s.shortName) + '"'
      : (nm ? ' data-stoprt="' + escapeHtml(nm) + '"' +
          (s.lat != null ? ' data-stoplat="' + escapeHtml(s.lat) + '"' : "") +
          (s.lon != null ? ' data-stoplon="' + escapeHtml(s.lon) + '"' : "") : "");
    const openTitle = openAttr
      ? ' title="Antippen: Station "' + escapeHtml(s.name) + '" als eigenen Reiter öffnen"' : "";
    html += '<div class="trow' + rowCls + '" data-tri="' + i + '">' +
      '<span class="tgep">' + escapeHtml(planned || "–") + "</span>" +
      '<span class="takt' + (i === currentTrip.atIdx && !(mark && mark.idx === i && mark.etaTs && mark.etaTs > Date.now() + 1500) ? " blinkclock" : "") + '">' + sztRowAktuell + "</span>" +
      delayHtml + sztRowChip + cdHTML +
      '<span class="tname' + (openAttr ? " tnameclick" : "") + '"' + openAttr + openTitle +
        '>' + escapeHtml(s.name) + (s.isArr ? ' <span class="tarr">(an)</span>' : "") + "</span>" +
      "</div>";
  }
  // Kompakte Raum-Zeit-Ankunft UNTER der Zielstation: nur wenn die beobachtete
  // Fahrt um mehr als SZT_WATCH_EXIT_MIN Minuten abweicht; die Fahrzeug-
  // Erkennung hat Vorrang, wenn sie auf genau dieser Fahrt laeuft.
  if (!(sztWVeh && sztWVeh.tripId === currentTrip.tripId)) {
    const lastS = tstops[last];
    const dlL = lastS ? currentTrip.delay[lastS.key || (lastS.shortName + "|" + currentTrip.tripId)] : null;
    const pL = lastS ? hhmmToMin((dlL && dlL.plannedTime) || lastS.plannedTime || "") : null;
    html += sztExitHTML(sztW, pL, lastS ? lastS.name : "");
  }
  html += '<i class="tripdot"></i>';
  html += "</div>";
  return html;
}

// ---------- Kontinuierlicher GPS-Fortschritt: Projektion auf Strecken (rein) ----------
// Laengs-Anteil 0..1 von pos auf der Geraden a->b (geclampt); null ohne Koordinaten.
function segFrac(a, b, pos) {
  if (!a || !b || !pos || a.lat == null || b.lat == null) return null;
  const dl = b.lat - a.lat, dn = (b.lon || 0) - (a.lon || 0);
  const den = dl * dl + dn * dn;
  if (den < 1e-18) return null;
  let t = ((pos.lat - a.lat) * dl + ((pos.lon || 0) - (a.lon || 0)) * dn) / den;
  return t < 0 ? 0 : t > 1 ? 1 : t;
}
// Projektion auf einen Polygonzug (Stationen einer Fahrt): nextliegendes
// Segment, Anteil ueber die Gesamtlaenge. Rueckgabe { frac: 0..1, d: m }.
function polyFrac(pts, pos) {
  const p = (pts || []).filter(q => q && q.lat != null && q.lon != null);
  if (!pos || p.length < 2) return null;
  const dms = [];
  let total = 0;
  for (let i = 1; i < p.length; i++) { const dm = dist(p[i - 1], p[i]); dms.push(dm); total += dm; }
  if (total < 1) return { frac: 0, d: dist(pos, p[0]) };
  let cum = 0, best = null;
  for (let i = 1; i < p.length; i++) {
    const t = segFrac(p[i - 1], p[i], pos);
    if (t != null) {
      const proj = { lat: p[i - 1].lat + (p[i].lat - p[i - 1].lat) * t,
                     lon: p[i - 1].lon + (p[i].lon - p[i - 1].lon) * t };
      const d = dist(proj, pos);
      if (best == null || d < best.d) best = { d: d, frac: (cum + t * dms[i - 1]) / total };
    }
    cum += dms[i - 1];
  }
  return best || { frac: 0, d: dist(pos, p[0]) };
}
// Projektion auf die STATIONSSYNCHRONE Laufbahn der sichtbaren Zeilen (v1.3.12):
// Wie polyFrac ueber die Halte-Polyline, aber mit Original-Indizes der UNGE-
// FILTERTEN Liste (Stationen ohne Koordinaten ueberspringt die Geometrie, die
// Zeilen-Nummerierung bleibt trotzdem stabil). Rueckgabe { frac, d, k, sub }:
// k = Original-Index des Segment-Starts, sub = Anteil innerhalb des Segments.
// Genau damit laeuft der Route-Punkt im aufgeklappten Verlauf zwischen den
// Stationszeilen, jeden Kreis passiert er genau beim zugehoerigen Halt.
function rowSyncFrac(raw, pos) {
  const pts = [];
  for (let i = 0; i < (raw || []).length; i++)
    if (raw[i] && raw[i].lat != null && raw[i].lon != null) pts.push({ r: i, lat: raw[i].lat, lon: raw[i].lon });
  if (!pos || pts.length < 2) return null;
  const dms = [];
  let total = 0;
  for (let i = 1; i < pts.length; i++) { const dm = dist(pts[i - 1], pts[i]); dms.push(dm); total += dm; }
  if (total < 1) return { k: pts[0].r, sub: 0, frac: 0, d: dist(pos, pts[0]) };
  let cum = 0, best = null;
  for (let i = 1; i < pts.length; i++) {
    const t = segFrac(pts[i - 1], pts[i], pos);
    if (t != null) {
      const proj = { lat: pts[i - 1].lat + (pts[i].lat - pts[i - 1].lat) * t,
                     lon: pts[i - 1].lon + (pts[i].lon - pts[i - 1].lon) * t };
      const d = dist(proj, pos);
      if (best == null || d < best.d) best = { d: d, k: pts[i - 1].r, sub: t,
        frac: (cum + t * dms[i - 1]) / total };
    }
    cum += dms[i - 1];
  }
  return best || { k: pts[0].r, sub: 0, frac: 0, d: dist(pos, pts[0]) };
}

// ---------- Wecker je Haltestelle im Fahrtverlauf ----------
// Auslösung: Distanz zur Station (GPS) ODER Minuten vor der geplanten bzw.
// aktualisierten Abfahrtszeit. Zwei Stufen: Vibration (sofern vom Gerät
// unterstützt) und Weckton (im Browser). Bei aktivem Wecker wird die Zeit der
// Station alle (Auswahlzeit)/2 Minuten neu geprüft.
const alarms = new Map();       // "tripId|sn" -> {sn, name, dist, leadMin, vib, tone, lastPoll}
// Globale Taster oben: alle Wecker ein/aus bzw. alle Nach-Hause-Hinweise ein/aus
let alarmsOff = false;
try { alarmsOff = localStorage.getItem("kvg-alarms-off") === "1"; } catch (e) {}
let fhOff = false;
try { fhOff = localStorage.getItem("kvg-fh-off") === "1"; } catch (e) {}
const firedAlarms = new Set(); // "tripId|sn" (ausgelöst, im Verlauf als ⏰ sichtbar)
// Wecker dauerhaft speichern (ueberleben ein Neuladen der Seite / App-Start)
function saveAlarms() {
  try { localStorage.setItem("kvg-alarms", JSON.stringify([...alarms].map(([k, a]) => ({ key: k, a: a })))); } catch (e) {}
  try { clkMsgUpdate(false); } catch (e) {}   // v1.6.42: ⏰-Nachrichtenfenster mitführen
}
function loadAlarms() {
  try {
    const arr = JSON.parse(localStorage.getItem("kvg-alarms") || "[]");
    for (const it of arr) if (it && it.key && it.a && !alarms.has(it.key)) alarms.set(it.key, it.a);
  } catch (e) {}
}
loadAlarms();
try { clkMsgUpdate(false); } catch (e) {}   // v1.6.42: ⏰-Fenster beim Start synchronisieren
try { fhMsgUpdate(false); } catch (e) {}    // v1.6.42: 🏠-Fenster beim Start synchronisieren
let audioCtx = null;

// Wecker-Klang einstellbar: Ton (Geräteklang in der App, Klangmuster im Browser)
// und Lautstärke (0..1). Gesichert unter "kvg-alarmcfg" (auch im Zustand-Export).
const ALARM_SOUNDS = [
  ["alarm", "Wecker"],        // Standard-Alarmton des Geräts
  ["ring", "Klingelton"],
  ["notif", "Nachricht"]];
function alarmCfg() {
  let o = {};
  try { o = JSON.parse(localStorage.getItem("kvg-alarmcfg") || "{}") || {}; } catch (e) {}
  return {
    snd: ALARM_SOUNDS.some(s => s[0] === o.snd) ? o.snd : "alarm",
    vol: isFinite(o.vol) ? Math.min(1, Math.max(0.1, Number(o.vol))) : 1
  };
}
function saveAlarmCfg(c) {
  try { localStorage.setItem("kvg-alarmcfg", JSON.stringify(c)); } catch (e) {}
}
// Im Browser: Klangmuster je Tonart (Frequenzen in Hz), Lautstärke über Gain
const BEEP_FREQ = { alarm: [660, 880], ring: [950, 1250], notif: [740, 990] };
function alarmBeep(vol, snd) {
  try {
    const cfg = alarmCfg();
    const v = vol != null ? vol : cfg.vol;
    const s = snd || cfg.snd;
    audioCtx = audioCtx || new (window.AudioContext || window.webkitAudioContext)();
    if (audioCtx.state === "suspended") audioCtx.resume();
    const t0 = audioCtx.currentTime;
    const cycles = arguments.length > 2 ? arguments[2] : 4;   // 4 Signale ≙ 2,4 s; Wecker: 5 ≙ 3 s
    for (let i = 0; i < cycles; i++) {
      const o = audioCtx.createOscillator(), g = audioCtx.createGain();
      o.type = "sine"; o.frequency.value = (BEEP_FREQ[s] || BEEP_FREQ.alarm)[i % 2];
      g.gain.setValueAtTime(0.001, t0 + i * 0.6);
      g.gain.exponentialRampToValueAtTime(Math.max(0.02, 0.4 * v), t0 + i * 0.6 + 0.05);
      g.gain.exponentialRampToValueAtTime(0.001, t0 + i * 0.6 + 0.5);
      o.connect(g); g.connect(audioCtx.destination);
      o.start(t0 + i * 0.6); o.stop(t0 + i * 0.6 + 0.55);
    }
  } catch (e) {}
}
// Vibration: im WebView existiert navigator.vibrate evtl. nicht (oder greift
// nicht); deshalb in der App ZUSÄTZLICH über die native Brücke schwingen lassen.
function vibratePattern(pat) {
  if (navigator.vibrate) { try { navigator.vibrate(pat); } catch (e) {} }
  if (window.KvgNative) {
    nativeVibrate(pat);   // Variante 2: natives Wellenmuster über die Brücke
    // Variante 3 (Failsafe): einfacher Ein-Schlag über die zweite Brücken-Methode,
    // falls das Wellenmuster auf dem Gerät nicht greift (z. B. WebView-Quirk).
    let onMs = 0;
    for (let i = 0; i < pat.length; i += 2) onMs += Number(pat[i]) || 0;
    if (onMs > 0) nativeCall("vibrateLong", String(onMs));
  }
}
// ---------- Durchgehendes Läuten ----------
// Der Wecker wiederholt sich, bis er am ⏰-Symbol gelöscht wird:
// 3 s klingeln/vibrieren, 5 s Pause, dann von vorne.
const ringing = new Map();   // aKey -> { timer, name }
function startRinging(aKey, a) {
  const prev = ringing.get(aKey);
  if (prev) { if (prev.timer != null) return; ringing.delete(aKey); }  // native-only: übernehmen
  const cycle = () => {
    if (a.tone !== false) alarmBeep(a.vol, a.snd, 5);   // 5 Signale ≙ 3 s
    if (a.vib !== false) vibratePattern([3000]);        // 3 s vibrieren
  };
  cycle();
  ringing.set(aKey, { timer: setInterval(cycle, 8000), name: a.name });
}
// In der App: Hat der AlarmManager geläutet, während die Seite neu geladen war,
// übernimmt die Seite das ⏰-Symbol (native Kette läutet bereits selbst);
// Antippen ruft stopRinging -> cancelAlarm und beendet die Kette.
function syncNativeRinging() {
  if (!window.KvgNative || typeof window.KvgNative.ringingAlarms !== "function") return;
  let keys = [];
  try { keys = JSON.parse(window.KvgNative.ringingAlarms()); } catch (e) { return; }
  let changed = false;
  for (const k of keys) {
    if (!ringing.has(k) && !alarms.has(k)) {
      ringing.set(k, { timer: null, name: "Wecker" });
      firedAlarms.add(k);
      changed = true;
    }
  }
  if (changed && currentBus) renderBusPanel();
  try { clkMsgUpdate(false); } catch (e) {}   // v1.6.42: nativ geläutete Wecker auch im ⏰-Fenster zeigen
}
function stopRinging(aKey, keepActive) {
  const r = ringing.get(aKey);
  if (r) { clearInterval(r.timer); ringing.delete(aKey); }
  if (navigator.vibrate) { try { navigator.vibrate(0); } catch (e) {} }
  nativeCall("vibrate", "[]");       // native Vibration abbrechen
  nativeCall("cancelAlarm", aKey);   // ggf. laufende native Läut-Kette stoppen
  // Distanz-Wecker (ohne Zeitbedingung) bleiben gestellt, werden aber
  // deaktiviert und lassen sich spaeter per ▶ wieder scharf schalten
  const a = alarms.get(aKey);
  if (!keepActive && a && a.leadMin == null) { a.paused = true; saveAlarms(); }
}
function fireAlarm(aKey, a) {
  a.lastMsg = "🚨 " + a.name + " – Bus/Zug ist da bzw. fährt gleich ab!";   // v1.6.42: Fenster-Meldung
  a.lastMsgTs = Date.now();
  clkMsgUpdate(true);   // v1.6.42: eigenes Nachrichtenfenster der Art zeigt sich beim Auslösen sicher
  if (alarmsOff) return;   // global aus: nicht läuten, Wecker bleibt gestellt
  if (a.paused) return;     // deaktiviert (⏸): nicht läuten
  if (ringing.has(aKey)) return;   // läutet bereits
  if (a.leadMin != null) {
    alarms.delete(aKey);   // Zeit-Wecker: einmalig, danach weg
    saveAlarms();
  }   // Distanz-Wecker bleiben gestellt (werden beim Stoppen nur deaktiviert)
  nativeCall("cancelAlarm", aKey);   // nativen Wecker mitauslösen (falls in App gestellt)
  firedAlarms.add(aKey);
  startRinging(aKey, a);   // klingelt/vibriert im 3 s/5 s-Rhythmus bis weggeklickt
  setLocNote("⏰ Wecker: " + a.name + " – Bus/Zug ist da bzw. fährt gleich ab! Zum Beenden ⏰ antippen.");
  renderTabs();
  renderAlarmInd();
  if (currentBus) renderBusPanel();
}

// ---------- v1.6.42: eigene Nachrichtenfenster je Alarm-Art (⏰ / 🏠) ----------
// Timo-Wunsch 26.11.2026, 23:33: Alle drei Alarm-Arten (⏰ Wecker, 🏠 Finde
// nach Hause, 🐿️ Eichhörnchen) bekommen je ein eigenes Nachrichtenfenster und
// je Alarm eine Checkbox "Eigenes Nachrichtenfenster": Angehakt bleibt das
// Fenster der Art sichtbar (solange mindestens ein Alarm der Art den Haken
// hat), ausgehakt verschwindet es - aber nur so lange, bis ein Alarm der Art
// auslöst; dann erscheint das zugehörige Fenster auf jeden Fall wieder.
// Mechanik baugleich zum 🐿️-Fenster (pkgMsgWin), ✕ blendet es bis zum nächsten
// Auslösen aus. Im Hintergrund (Android) melden zusätzlich die System-Nachrichten
// der Art (Kanäle wecker/hinweise), die Fenster sind die In-App-Ansicht.
function alarmMsgEnsure(id, title) {
  let el = document.getElementById(id);
  if (!el) {
    el = document.createElement("div");
    el.id = id; el.className = "pkgmsg"; el.hidden = true;
    el.innerHTML = '<div class="pkgmsghead"><span>' + title + '</span>' +
      '<button class="pkgmsgx" title="Fenster schließen (Alarme bleiben gestellt)">✕</button></div>' +
      '<div class="pkgmsgbody"></div>';
    el.addEventListener("click", e => {
      if (e.target.closest(".pkgmsgx")) { el.hidden = true; el.dataset.hide = "1"; return; }
    });
    document.body.appendChild(el);
  }
  return el;
}
function alarmMsgSync(id, title, rowsHTML, anyWin, forceShow) {
  const el0 = document.getElementById(id);
  if (!rowsHTML) { if (el0) { el0.hidden = true; delete el0.dataset.hide; } return; }
  const el = alarmMsgEnsure(id, title);
  const body = el.querySelector(".pkgmsgbody");
  if (body.dataset.last !== rowsHTML) { body.dataset.last = rowsHTML; body.innerHTML = rowsHTML; }
  if (forceShow) { el.hidden = false; delete el.dataset.hide; return; }
  if (!el.dataset.hide) el.hidden = !anyWin;
}
function clkMsgUpdate(forceShow) {   // ⏰ Wecker-Fenster: alle gestellten Wecker mit Zustand und letzter Meldung
  const rows = [];
  for (const [k, a] of alarms) {
    const cond = (a.dist ? "ab " + formatDist(a.dist) + " zur Station" : "") +
      (a.dist && a.leadMin ? " oder " : "") + (a.leadMin ? a.leadMin + " min vor Abfahrt" : "") || "gestellt";
    const msg = a.lastMsgTs && Date.now() - a.lastMsgTs < 36 * 3600000 ? a.lastMsg : "";
    rows.push('<div class="pkgmsgrow' + (ringing.has(k) ? " ring" : "") + '">' +
      '<div class="pkgmsgl">⏰ ' + escapeHtml(a.name || k) + (a.paused ? ' <span class="dim">(⏸ pausiert)</span>' : "") + "</div>" +
      '<div class="dim">' + escapeHtml(cond) + (ringing.has(k) ? " · 🚨 läutet gerade" : "") + "</div>" +
      (msg ? '<div class="' + (String(msg).indexOf("🚨") === 0 ? "pkgwarn" : "dim") + '">' + escapeHtml(msg) + "</div>" : "") +
      "</div>");
  }
  let anyWin = false;
  for (const [, a] of alarms) if (a.msgWin !== false) anyWin = true;
