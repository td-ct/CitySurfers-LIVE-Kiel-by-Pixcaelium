    // Sekunden-Countdown (Standard v1.3.10): Delay-Chip bleibt stehen, dahinter
    // tickt "in M:SS". Ziel normal = Live-/Fahrplan-Zeit (GPS-ETA an der
    // eigenen Haltestelle sekundengenau, sonst Ist-/Plan-Minute); kursiv in
    // Klammern dahinter = Raum-Zeit-Ziel (erkannte Fahrt per sztRowEta, sonst
    // Watch-Voraussage), nur wenn es abweicht. Eigene GPS-Halte OHNE ETA
    // (laufende Uhr): kein Countdown, das Ziel laege in der Gegenwart.
    let cdHTML = "";
    {
      const gpsRow = !!(gpsKey && key === gpsKey);
      const etaOn = !!(gpsRow && mark && mark.idx === i && mark.etaTs && mark.etaTs > Date.now() + 1500);
      const primMs = etaOn ? mark.etaTs : (gpsRow ? null : hhmmAbsMs(actual || planned || ""));
      let sztMs = null;
      if (!gpsRow) {
        const sMin = sztRv != null ? sztRv.eta :
          ((sztW && sztW.delay != null && !actual && planned) ? hhmmToMin(planned) + sztW.delay : null);
        if (sMin != null) {
