// ---------- „＋ GPS Position speichern“: GPS-Position als Adressfavorit ----------
// Gute Ortung: sofort die gewohnte Maske (Alias frei benennbar, im Adressfeld stehen
// die Koordinaten in verständlicher Form, exakt hinterlegt wie bei jedem Favorit).
// GPS aus oder ungenau: GPS-Status öffnen und auf gute Ortung warten – „Übernehmen“
// nimmt die Ortung früher, „Abbrechen“ schließt alles, ohne zu speichern.
function gpsAddrSaveFlow() {
  gpsTakeTarget = "addrSave";
  if (!("geolocation" in navigator) || !isSecure()) {
    setLocNote("GPS nicht verfügbar – Position lässt sich nicht erfassen.");
    return;
  }
  if (gpsState === "on" && myPos && (myPos.accuracy == null || myPos.accuracy <= GPS_ACC_DIRECT_M)) {
    saveGpsAddrFav(myPos);
    return;
  }
  gpsWasOff = gpsState === "off";
  if (gpsState === "off") gpsStart();
  openGpsDlg("takeover");
  setLocNote("GPS-Ortung läuft – nach guter Ortung (oder „Übernehmen“) öffnet die Maske zum Speichern.");
}
function saveGpsAddrFav(p) {
  if (!p) return;
  const coordLabel = p.lat.toFixed(6) + ", " + p.lon.toFixed(6);   // verständlich und per parseLocText wieder einlesbar
  addrFavs.push({ name: "GPS-Position", lat: p.lat, lon: p.lon, label: coordLabel,
    osmLat: p.lat, osmLon: p.lon });
  saveAddrFavs();
  renderAddrFavs();
  openFavDlg(addrFavs.length - 1);   // gewohnte Maske: Alias frei benennbar, Koordinaten genau hinterlegt
}

