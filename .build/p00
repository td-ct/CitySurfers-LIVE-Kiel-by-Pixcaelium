// ---------- Unplausible GPS-Nähe: GPS-Knopf blinkt rot, Linie echtzeit-nachfragen ----------
// Steht das GPS im Stationsradius, obwohl die Abfahrtszeit der Linie dort (erweitertes
// Fenster ± 2 min) gar nicht zur Systemzeit passt, kann die Fahrt dort gar nicht sein.
// Dann: kleiner runder GPS-Knopf rot aufblinken lassen, genau in dem Moment sowie
// noch mal 2 Minuten später die Echtzeitdaten der Linie abfragen; danach wird der
// alte Zustand des GPS-Knopfes wiederhergestellt (falls nicht neu gesetzt).
function renderGpsSuspect() {
  locBtn.classList.toggle("suspect", gpsSuspect);
}
function triggerSuspectRefetch(sn, tripId) {
  if (gpsSuspect) return;   // Ereignis triggert nur einmal
  gpsSuspect = true;
  renderGpsSuspect();
  refetchTripRealtime(sn, tripId);   // Echtzeitabfrage der Linie sofort …
  setTimeout(() => {
    refetchTripRealtime(sn, tripId);   // … und noch mal 2 Minuten später
    gpsSuspect = false;               // alter Zustand des GPS-Knopfes wiederherstellen
    renderGpsSuspect();
  }, SUSPECT_REFETCH_MS);
}

