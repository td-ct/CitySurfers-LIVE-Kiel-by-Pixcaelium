  clearTimeout(rsSearchTimer);
  rsSearchTimer = setTimeout(() => rsSearch((search.value || "").trim()), 400);
});
/* v1.6.34: Aktive Adresse weit weg von Kiel - Fern-Stationen in ihrem Umkreis
