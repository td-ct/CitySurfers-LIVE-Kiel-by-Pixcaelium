      if (wantNahsh && lid) tried.push("nah.sh");
      if (dfrTried) tried.push("delfirouting");
      v.atSrc = tried.join(" + ") || (cat === "nahsh" ? "nah.sh" : cat === "delfi" ? "delfirouting" : "kein Katalog");
