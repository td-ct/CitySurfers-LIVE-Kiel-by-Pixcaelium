// ---------- Reiter: mehrere Haltestellen (+Abfahrten, +Fahrtverlauf) parallel ----------
// Unterhalb der Suchfelder lässt sich jede angeschaute Haltestelle als eigener
// Reiter offen halten. Reiter lassen sich verschieben (Drag) und schließen (✕);
// beim Schließen mit gestelltem Wecker gibt es eine Warnung, der Wecker wird
// dann mitgelöscht (und aus dem Wecker-Indikator entfernt).
const tabsbar = document.getElementById("tabsbar");
const tabs = [];        // { sn, bus, trip }  pro Reiter: Haltestelle, Auswahl, Fahrtverlauf
let activeTab = -1;
// v1.5.6: MM-Reiter-Basis (Micromobility) steht absichtlich GANZ OBEN bei den
// Reiter-Grundlagen: Der Wiederhersteller aus kvg-view und jede Render-Runde
// (renderTabs/renderPanels) greifen darauf zu, sobald der Boot startet.
// Frueher standen diese Deklarationen erst viel spaeter im Skript, und jedes
// Rendern in der Luecke davor lief in die Initialisierungs-Totzone und warf
// "Cannot access 'mmTabActive' before initialization" (renderMMPanel). Seit
// v1.5.6 ueberdauern die MM-Reiter zudem den Neustart: saveView sichert sie
// MIT den uebernommenen Routen in kvg-view und der Boot baut sie wieder auf.
const mmPanel = document.getElementById("mmPanel");
let mmTabs = [], mmTabActive = false, mmActiveTab = -1;
let mmPanelSeq = 0;

// Fahrtverlauf unabhängig vom aktiven Reiter finden (für Wecker in Hintergrund-Reitern)
function tripById(tripId) {
  if (currentTrip && currentTrip.tripId === tripId) return currentTrip;
  for (const t of tabs) if (t.trips)
    for (const b of t.trips) if (b.trip && b.trip.tripId === tripId) return b.trip;
  return null;
}
function tabAlarmCount(sn) {
  let n = 0;
  for (const [, a] of alarms) if (a.tabSn === sn) n++;
  return n;
}
// Reiterleiste: Stations-Reiter (🚏) und beliebig viele parallele Route-Reiter
// (🧭) in einer gemeinsamen Leiste; Reihenfolge frei (Drag & Drop bzw. ◀/▶ im
// Umbenennen-Dialog), langes Drücken (oder Rechtsklick) benennt um. Lange
// Namen kürzt die Ellipse, die Leiste bricht auf schmalen Ansichten auf
// mehrere Zeilen um.
function syncBarOrd() {   // Reihenfolge gegen die Livemengen syncen (ohne/plus Tokens)
  const alive = u => {
    if (u === "help") return helpTabOpen;
    if (!u) return false;
    if (u[0] === "u") for (const x of tabs) if (x.uid === u) return true;
    for (const rt of routeTabs) if (rt.uid === u) return true;
    for (const mt of mmTabs) if (mt.uid === u) return true;   // v1.4.14: MM-Reiter leben mit in der Leiste
    return false;
  };
  const keep = barOrd.filter(alive);
  for (const x of tabs) if (!keep.includes(x.uid)) keep.push(x.uid);
  for (const rt of routeTabs) if (!keep.includes(rt.uid)) keep.push(rt.uid);
  for (const mt of mmTabs) if (!keep.includes(mt.uid)) keep.push(mt.uid);   // v1.4.14: MM-Reiter
  if (helpTabOpen && !keep.includes("help")) keep.push("help");
  barOrd = keep;
}
function defTabName(kind, obj) {   // Standardname: Station bzw. "Start → Ziel"
  if (kind === "s") {
    const s = stops.find(x => x.shortName === obj.sn);
    return obj.name || (s ? s.name : obj.sn);
  }
  const a = obj.sel || {};
  return obj.name || ((a.start ? a.start.label : "?") + " → " + (a.dest ? a.dest.label : "?"));
}
function renderTabs() {
  renderStopChip();
  syncBarOrd();
  let h = "";
  for (const uid of barOrd) {
    const si = tabs.findIndex(x => x.uid === uid);
    if (si >= 0) {
      const t = tabs[si];
      const nAl = tabAlarmCount(t.sn);
      const nm = defTabName("s", t);
      h += '<div class="tab' + (si === activeTab ? " on" : "") + '" draggable="true" data-kind="s" data-uid="' + escapeHtml(uid) +
        '" data-ti="' + si + '" title="🚏 ' + escapeHtml(nm) + ' – lange drücken (oder Rechtsklick): umbenennen und verschieben"><span class="tico">🚏</span>' +
        '<span class="tabname">' + escapeHtml(nm) + "</span>" +
        (nAl ? ' <span class="tabal" title="' + nAl + ' Wecker aktiv">⏰ ' + nAl + "</span>" : "") +
        ' <button class="tabx" data-tx="' + si + '" title="Reiter schließen">✕</button></div>';
      continue;
    }
    const ri = routeTabs.findIndex(x => x.uid === uid);
    if (ri >= 0) {
      const rt = routeTabs[ri];
      const nm = defTabName("r", rt);
      h += '<div class="tab k-r' + (ri === routeActiveTab && routeTabActive ? " on" : "") +
        '" draggable="true" data-kind="r" data-uid="' + escapeHtml(uid) + '" data-tr="' + ri +
        '" title="🧭 Route: ' + escapeHtml(nm) + ' – lange drücken (oder Rechtsklick): umbenennen und verschieben"><span class="tico">🧭</span>' +
        '<span class="tabname">' + escapeHtml(nm) + '</span>' +
        ' <button class="tabx" data-tx="r' + ri + '" title="Route-Reiter schließen">✕</button></div>';
      continue;
    }
    const mi = mmTabs.findIndex(x => x.uid === uid);
    if (mi >= 0) {   // v1.4.14: MM-Reiter (Micromobility): Abholstation oben, MM-Routen darunter
      const mt = mmTabs[mi];
      h += '<div class="tab k-m' + (mi === mmActiveTab && mmTabActive ? " on" : "") +
        '" draggable="true" data-kind="m" data-uid="' + escapeHtml(uid) + '" data-mi="' + mi +
        '" title="🚲 MM: ' + escapeHtml(mt.name) + ' · Abholstation mit allen Rädern dort und die übernommenen Leihrad-Routen"><span class="tico">🚲</span>' +
        '<span class="tabname">' + escapeHtml(mt.name) + '</span>' +
        (mt.routes && mt.routes.length ? ' <span class="tabal" title="übernommene MM-Routen in diesem Reiter">🚲 ' + mt.routes.length + "</span>" : "") +
        ' <button class="tabx" data-tx="m' + mi + '" title="MM-Reiter schließen">✕</button></div>';
      continue;
    }
    if (uid === "help" && helpTabOpen)
      h += '<div class="tab' + (helpTabActive ? " on" : "") + '" data-kind="h" data-uid="help" data-ti="help"' +
        ' title="Anleitung: Nutzung, Schwellen und Hintergründe">❓ Anleitung <button class="tabx" data-tx="help" title="Anleitung-Reiter schließen">✕</button></div>';
  }
  if (!h) { tabsbar.hidden = true; tabsbar.innerHTML = ""; saveView(); return; }
  tabsbar.hidden = false;
  tabsbar.innerHTML = h;
  saveView();   // offene Reiter (inkl. Reihenfolge) überdauern einen Neustart
}
// Zustand des aktiven Reiters in sein Reiter-Objekt sichern (vor dem Wechseln)
function saveActiveTab() {
  saveActiveRouteTab();   // Globalzustand des offenen Route-Reiters mitsichern
  const t = tabs[activeTab];
  if (!t) return;
  t.sn = currentStop ? currentStop.shortName : t.sn;
  // Unter-Reiter der Fahrten: currentBus ist die Referenz auf t.trips[t.activeTrip],
  // currentTrip hängt an currentBus.trip – beides bleibt dadurch im Reiter gesichert
}
function activateTab(i, refetch) {
  saveActiveTab();
  activeTab = i;
  routeTabActive = false;
  helpTabActive = false;
  mmTabActive = false;
  const t = tabs[i];
  const stop = t ? (stops.find(s => s.shortName === t.sn) ||
    (isRS(t.sn) ? remoteStops.get(t.sn) : null)) : null;   // v1.5.0: Fern-Stationen leben im selben Reiter-System
  currentStop = stop || null;
  currentBus = null; currentTrip = null;
  if (t && t.trips) {
    const ab = t.trips[t.activeTrip];
    if (ab) { currentBus = ab; currentTrip = ab.trip || null; }
