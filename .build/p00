      if (okBtn.disabled) return;
      const vib = wrap.querySelector(".avib"), tone = wrap.querySelector(".atone"),
            snd = wrap.querySelector(".asnd"), vol = wrap.querySelector(".avol");
      const base = a || {
        id: "PKG|" + cur.sn + "|" + cur.line + "|" + (cur.dir || "") + "|" + Date.now(),
        lid: null, schedTs: 0, lastCheck: 0, lastMsg: "", lastMsgTs: 0, firedFor: ""
      };
      Object.assign(base, {
        sn: cur.sn, name: cur.name, line: cur.line, dir: cur.dir,
        days: cur.days.slice(), on: cur.on.map((b, i) => !!(b && cur.days[i])),
        win: cur.win, vib: !!(vib && vib.checked), tone: !!(tone && tone.checked),
        snd: snd ? snd.value : cfg.snd, vol: vol ? Number(vol.value) : cfg.vol,
        msgWin: !!(wrap.querySelector(".amwin") && wrap.querySelector(".amwin").checked),   // v1.6.42: eigenes Nachrichtenfenster
        msgAnd: !!(wrap.querySelector(".amand") && wrap.querySelector(".amand").checked),   // v1.6.44: Android-Benachrichtigung (nur Anzeige)
        notify: {   // v1.6.45: welche Abweichungs-Arten läuten
          gone: !!(wrap.querySelector(".angone") && wrap.querySelector(".angone").checked),
          time: !!(wrap.querySelector(".antime") && wrap.querySelector(".antime").checked),
          plat: !!(wrap.querySelector(".anplat") && wrap.querySelector(".anplat").checked),
          stn: !!(wrap.querySelector(".anstn") && wrap.querySelector(".anstn").checked)
        },
        src: cur.src, schedSrcs: null   // v1.6.38: Katalog-Wahl; Live-Kette fuellt packSchedOf
      });
      base.lastCheck = 0; base.firedFor = "";
      if (!a) packAlarms.push(base);
      savePackAlarms();
      pkgMsgUpdate();
      setLocNote("🐿️ Eichhörnchen-Alarm " + (a ? "geändert" : "gesetzt") + ": Linie " + cur.line + " -> " + cur.dir +
        " an " + cur.name + ", Tage " + base.on.map((b, i) => b ? PACK_DAYS[i] : null).filter(Boolean).join(", ") +
        ", überwacht ab " + (base.win >= 60 ? base.win / 60 + " h" : base.win + " min") +
        " vor Abfahrt, Fahrplan-Katalog " + packSrcLabel(cur.src) + ".");
      wrap.remove();
      packTick();
      return;
    }
  });
  wrap.addEventListener("change", e => {
    const c = e.target.closest("[data-pkc]");
    if (c) {
      const i = Number(c.dataset.pkc);
      cur.on[i] = c.checked;
      if (c.checked && !cur.days[i]) c.checked = false;   // ohne Uhrzeit kein Haken
      renderRows();
