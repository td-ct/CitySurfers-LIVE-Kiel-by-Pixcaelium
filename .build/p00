const RS_KNOWN_EXT = new Set((DB_STOPS || []).map(d => {
  const m = String(d.lid || "").match(/@L=(\d+)/);
  return m ? m[1] : null;
}).filter(Boolean));
function rsNorm(s) {   // eingabefest normalisieren (Kleinbuchstaben, nur Buchstaben/Ziffern)
  return String(s || "").toLowerCase().replace(/[^a-z0-9äöüß]/g, "");
}
function rsFold(s) {   // zusätzlich Umlaute/transkribierte Formen angleichen (muenchen = münchen)
