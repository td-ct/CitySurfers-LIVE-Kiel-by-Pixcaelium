// OSRM-Fußweg-Routing zwischen zwei Punkten (ohne Cache, für Dialoge):
// liefert { m, est } bzw. null. Luftlinie × 1,3 als Schätzung, wenn der
// Router nicht antwortet.
async function footRouteM(a, b) {
  if (!a || !b) return null;
  try {
    const url = FOOT_ROUTER + "/" + a.lon + "," + a.lat + ";" + b.lon + "," + b.lat + "?overview=false";
    const res = await apiFetch("osrm", url);
    if (res.ok) {
      const data = await res.json();
      if (data.routes && data.routes[0]) return { m: data.routes[0].distance, est: false };
    }
  } catch (e) {}
  return null;
}
function footMin(m) { return m == null ? null : Math.ceil(m / (WALK_SPEED_KMH * 1000 / 60)); }

