      }
    }
    if (list.length) {
      v.atDeps = list;
      const srcs = [];
      if (!(list[0] && list[0].dfr)) srcs.push("nah.sh");
      else srcs.push("delfirouting");
      v.atSrc = srcs.join(" + ");
      v.atErr = null;
    } else {   // gewaehlte Kataloge leer oder gescheitert
      v.atDeps = [];
