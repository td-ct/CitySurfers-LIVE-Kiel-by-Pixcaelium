      const el = wrap.querySelector('[data-supgroup="' + k + '"]');
      return !!(el && el.checked);
    };
    const rtIdx = [...wrap.querySelectorAll("[data-suprt]")].filter(x => x.checked)
      .map(x => Number(x.getAttribute("data-suprt")));
    const stIdx = [...wrap.querySelectorAll("[data-supst]")].filter(x => x.checked)
      .map(x => Number(x.getAttribute("data-supst")));
    const mmIdx = [...wrap.querySelectorAll("[data-supmm]")].filter(x => x.checked)
      .map(x => Number(x.getAttribute("data-supmm")));
    // Offene Vorschlagslisten der Suchfelder als Klartext (max. 20 Einträge)
    const sugTxt = el => (!el || el.hidden) ? "" :
      [...el.querySelectorAll("div, button, li")]
        .map(x => (x.textContent || "").trim().replace(/\s+/g, " "))
        .filter(Boolean).slice(0, 20).join(" | ");
    const av = supportAppVer();
    const cfg = {
      stamp: new Date().toLocaleString("de-DE"),
      ver: pageVersion() || "?",
      appVer: av ? "App " + av : "",
      gps: gpsState === "on" ? "an" : gpsState === "searching" ? "wird gesucht" : "aus",
      problem: document.getElementById("supProblem").value.trim(),
      addr: grp("addr"),
      addrQ: addrSearch.value.trim(),
      pos: addrPos,
      addrSug: sugTxt(document.getElementById("addrSug")),
      stopS: grp("stopS"),
      stopQ: search.value.trim(),
      stopSug: sugTxt(sugBox),
      rtabIdx: rtIdx,
      stabIdx: stIdx,
      mtabIdx: mmIdx,
      addrFav: grp("afav"),
      stopFav: grp("sfav")
    };
    const body = supportStateText(cfg);
    const mail = "mailto:support@pixcaelium.de?subject=" +
      encodeURIComponent("Bugreport CitySurfer v" + (cfg.ver || "?")) +
      "&body=" + encodeURIComponent(body);
    const a = document.createElement("a");
    a.href = mail;
    document.body.appendChild(a);
    a.click();
    a.remove();
    wrap.remove();
    setLocNote("Support-E-Mail vorbereitet – bitte im E-Mail-Programm prüfen und absenden.");
  });
  document.body.appendChild(wrap);
}
