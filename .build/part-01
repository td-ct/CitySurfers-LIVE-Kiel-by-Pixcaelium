      const tv = { stop: v.stop, meters: v.meters, fetchTs: Date.now(),
        deps: v.atDeps, platforms: v.platforms };
      body += busLinesHTML(tv, null, true).map(l => l.html).join("");
    }
  } else if (v && v.fetched) {
    if (v.error)   // letzte Aktualisierung fehlgeschlagen: Altdaten + Hinweis statt Stillstand
      body += '<small class="rowinfo dim">⚠️ Aktualisierung fehlgeschlagen – zeige den letzten Stand. ↻ oben versucht es erneut.</small>';
    // Live-Abfrage leer (z. B. mitten in der Nacht): planmäßige Verbindungen
    // automatisch nachladen (NAH.SH-Fahrplan, gleiche 10-min-TTL wie „später“)
    // und eine entsprechende Anzahl sofort freischalten (erste Seite = 6 Einträge,
    // weitere über „später“). Züge haben von Hause aus ~10 h Live-Fenster.
    if (!(v.deps && v.deps.length) && !v.error && !isDB(v.stop.shortName) && !isRS(v.stop.shortName)) {   // v1.5.0: geplante KVG-Fahrten nur für Kiel
      if ((!v.plannedTried || Date.now() - (v.plannedTs || 0) > 600000) && !v.plannedLoading) {
        v.plannedLoading = true;
        fetchPlannedDeps(v.stop.shortName).catch(() => {}).finally(() => {
          v.plannedLoading = false;
          renderPanels();   // geladene Plan-Verbindungen sofort anzeigen
        });
      }
      if ((v.planned || []).length) {   // Plan vorhanden: erste Seite sofort zeigen
        v.moreOpen = true;
        v.fwdShown = Math.max(v.fwdShown || 0, 6);
      }
    }
    const lines = busLinesHTML(v, (isDB(v.stop.shortName) || isRS(v.stop.shortName)) ? 21600 : null, true);   // v1.5.0: Fern-Stationen wie DB 6 h
    if (!lines.length && v.deps.length && Date.now() - v.fetchTs > 30000 && depsReallyGone(v)) {
      // alle Abfahrten wirklich abgefahren (länger als 3 Minuten weg): automatisch neu abfragen.
      // Vorher IMMER Kopf + Hinweis rendern: die Abfrage dauert einen Moment (und kann
      // bei hängender/schlechter Verbindung länger stocken) – der Reiter darf nie leer
      // bleiben, nur weil die alten Daten weg sind („nur der Reiter, kein Inhalt“).
      body += '<small class="rowinfo dim">Alle angezeigten Abfahrten sind abgefahren – werde neu geladen …</small>';
      stationPanelCache = body;
      const innerStale = head + body;
      stationPanelSetHTML(innerStale, true);
      stationPanel.hidden = false;
      refetchStop(currentStop.shortName, false);
      return;
    }
    if (!lines.length && v.deps.length) {
      body += '<small class="rowinfo dim">Alle Abfahrten sind gerade abgefahren – neue Verbindungen werden geladen …</small>';
    }
    if (!lines.length && !v.deps.length && !v.error) {
      body += '<small class="rowinfo dim">' + (v.plannedLoading
        ? "Keine Live-Abfahrten (z. B. nachts) – planmäßige Verbindungen werden geladen …"
        : "Keine Live-Abfahrten in den nächsten Minuten.") + "</small>";
    }
    body += earlierHTML(v) + lines.map(l => l.html).join("") + laterHTML(v);
  } else if (v && v.error) {
    // Abfrage fehlgeschlagen: klarer Fehler-Hinweis statt ewigem „lädt …“
    // (leerer Reiter). Automatische Neuversuche laufen über den Anzeige-Takt,
    // der 40-s-Cooldown in refetchStop begrenzt die Abfragefrequenz.
    body += '<small class="rowinfo">⚠️ Abfahrten konnten nicht geladen werden (Netzwerk?). ↻ oben versucht es sofort erneut – sonst wird automatisch neu versucht.</small>';
    if (!v.reloading) refetchStop(currentStop.shortName, false);
  } else {
    body += '<small class="rowinfo dim">Daten werden geladen …</small>';
    if (v && !v.reloading && !v.fetchTs) refetchStop(currentStop.shortName, true);   // Sicherheitsnetz: nie ohne laufende Abfrage hängen bleiben
  }
  stationPanelCache = body;   // Körper fürs Einfrieren (Abfahrtszeilen ohne Kopf)
  const inner = head + body;
  stationPanelSetHTML(inner, true);
  stationPanel.hidden = false;
  // Kein Fußweg-Routing, solange der Fahrtverlauf offen ist: Luftlinie reicht
  // (spart Abfragen); im reinen Stations-Panel bleibt das exakte Routing aktiv.
  if (v && v.meters == null && walkOrigin(currentStop.shortName) && !(currentBus && currentBus.tripOpen)) {
    walkMeters(currentStop).then(m => { if (m != null) { v.meters = m; renderStationPanel(); } });
  }
}

// Kopf eines umschaltbaren Blocks (Stationsansicht / Fahrtverlauf)
function secHead(sec, isOpen, label) {
  return '<div class="sechead" data-sec="' + sec + '"><span class="sarr">' +
    (isOpen ? "▾" : "▸") + "</span>" + label +
    (isOpen ? "" : ' <span class="sfrozen" title="Eingefroren: dieser Block aktualisiert sich nicht mehr">❄</span>') + "</div>";
}
function renderBusPanel() {
  if (!currentBus) { busPanel.hidden = true; busPanel.innerHTML = ""; return; }
  const stop = stops.find(s => s.shortName === currentBus.sn);
  const v = stopViews.get(currentBus.sn);
  const pos = walkOrigin(currentBus.sn);
  let meta;
  if (v && v.meters) {
    const pre = isEst(currentBus.sn) ? "~" : "";
    meta = pre + formatDist(v.meters) + " · " + pre +
      Math.ceil(v.meters / (WALK_SPEED_KMH * 1000 / 60)) + " min";
  } else if (pos && stop) {
    const air = dist(pos, stop) * 1.3;
    meta = "~" + formatDist(air) + " · ~" + Math.ceil(air / (WALK_SPEED_KMH * 1000 / 60)) + " min (Luftlinie)";
  } else {
    meta = "";
  }
  // Zustands-Wecker dieser Fahrt (für die Glocke im Linienkopf): gesetzt/ausgelöst?
  let bArm = false, bFire = false;
  const tPfx = String(currentBus.tripId) + "|";
  for (const k of alarms.keys()) if (k.indexOf(tPfx) === 0) { bArm = true; break; }
  if (!bArm) for (const k of ringing.keys()) if (k.indexOf(tPfx) === 0) { bFire = true; break; }
  if (!bFire) for (const k of firedAlarms) if (typeof k === "string" && k.indexOf(tPfx) === 0) { bFire = true; break; }
  const bellCls = bFire ? "abell fired" : bArm ? "abell on" : "abell";
  // Unter-Reiter: jede geöffnete Fahrt dieser Station als eigener kleiner Reiter,
  // Titel = Abfahrtszeit an der ersten Station (mit Echtzeit aktualisiert)
  let inner = "";
  const subTab = tabs[activeTab];
  if (subTab && subTab.trips && subTab.trips.length) {
    inner += '<div class="subtabbar">' + subTab.trips.map((b, bi) =>
      '<div class="subtab' + (b === currentBus ? " on" : "") + '" data-bt="' + bi +
      '" title="Fahrtverlauf dieser Verbindung"><span class="stt">' + escapeHtml(b.time || "…") + "</span>" +
      '<button class="tabx" data-btx="' + bi + '" title="Fahrt-Reiter schließen">✕</button></div>').join("") + "</div>";
  }
  inner +=
    '<div class="phead"><span class="pname">' + escapeHtml(stop ? stop.name : currentBus.sn) + "</span>" +
    '<span class="pmeta">' + meta + "</span>" + starHTML(currentBus.sn) +
    '<button class="rowref" data-ref="' + escapeHtml(currentBus.sn) +
      '" title="Diese Haltestelle neu abfragen">↻</button>' +
    '<button class="' + bellCls + '" data-linalarm="' + escapeHtml(String(currentBus.tripId)) +
      '" title="' + (bFire ? "Wecker ausgelöst – Dialog öffnen" :
        bArm ? "Wecker gestellt – antippen zum Ändern/Löschen" :
        "Wecker für eine Station dieser Linie stellen (lädt nötigenfalls den Fahrtverlauf)") + '">' +
      (bArm || bFire ? "⏰" : "🔔") + "</button></div>";
  // Jeder Block ist unabhängig auf-/zuklappbar; ein zugeklappter Block wird
  // nicht neu generiert (eingefrorener Stand, spart Daten und Aktualisierungen)
  const stOpen = !!currentBus.stationOpen;
  const trOpen = !!currentBus.tripOpen;
  let stationHTML;
  if (stOpen) {
    stationHTML = stationSectionHTML();
    currentBus.cachedStation = stationHTML;
  } else {
    stationHTML = currentBus.cachedStation || "";
  }
  let tripHTML;
  if (trOpen) {
    tripHTML = tripSectionHTML();
    if (currentTrip && currentTrip.tripId === currentBus.tripId)
      currentBus.cachedTrip = { id: currentBus.tripId, html: tripHTML };
  } else {
    tripHTML = (currentBus.cachedTrip && currentBus.cachedTrip.id === currentBus.tripId)
      ? currentBus.cachedTrip.html : "";
  }
  inner += secHead("station", stOpen, "Stationsansicht") + stationHTML;
  inner += secHead("trip", trOpen, "Fahrtverlauf") + tripHTML;
  if (busPanel.dataset.last !== inner) {
    busPanel.dataset.last = inner;
    busPanel.innerHTML = inner;
    marqueeify(busPanel);
  }
  busPanel.hidden = false;
}

// Detailblock der angeklickten Abfahrt (in der Stationsansicht)
function stationSectionHTML() {
  if (!currentBus) return "";
  const v = stopViews.get(currentBus.sn);
  if (v && v.fetched) {
    const ageSec = (Date.now() - v.fetchTs) / 1000;
    const dep = v.deps.find(d => d.tripId === currentBus.tripId);
    if (dep) {
      // kein Weg-Routing mehr im Fahrtverlauf: Luftlinie × 1,3 genügt als Schätzung
      const stopObj = stops.find(x => x.shortName === currentBus.sn);
      const posNow = walkOrigin(currentBus.sn);
      const metersNow = v.meters || (stopObj && posNow ? dist(posNow, stopObj) * 1.3 : 0);
      const estAir = !v.meters && metersNow;
      const walkSec = metersNow ? metersNow / (WALK_SPEED_KMH * 1000 / 3600) : 0;
      const rel = dep.actualRelativeTime - ageSec;
      const losMin = Math.round((rel - walkSec) / 60);
      const plat = v.platforms && v.platforms[dep.tripId];
      const live = dep.status === "PREDICTED" || dep.status === "STOPPING";
      const [ph, pm] = (dep.plannedTime || "").split(":").map(Number);
      const [ah, am] = (dep.actualTime || dep.plannedTime || "").split(":").map(Number);
      const delayMin = (isFinite(ph) && isFinite(pm) && isFinite(ah) && isFinite(am))
        ? (ah * 60 + am) - (ph * 60 + pm) : 0;
      const now = new Date();
      const depClock = (() => {
        const t = new Date(now.getTime() + rel * 1000);
        return String(t.getHours()).padStart(2, "0") + ":" + String(t.getMinutes()).padStart(2, "0");
      })();
      return '<div class="busdetail"><span class="dl">' + escapeHtml(dep.line) +
        '</span> <span class="big">→ ' + escapeHtml(dep.direction) + "</span><br>" +
        (plat ? "Bussteig <b>[" + escapeHtml(plat) + "]</b> · " : "") +
        "Abfahrt <b>" + depClock + " Uhr</b> (" + (live ? "Echtzeit" : "Fahrplan") +
        (delayMin > 0 ? ", +" + delayMin + " min" : delayMin < 0 ? ", " + delayMin + " min" : ", pünktlich") + ")" +
        (live && !dep.planned && !isDB(currentBus.sn) && rel > 0 && rel <= CD_MAX_S
          ? ' · fährt in ' + cdSpan(v.fetchTs + dep.actualRelativeTime * 1000) + " min"
          : "") + "<br>" +
        (metersNow
          ? "Fußweg <b>" + (estAir ? "~" : "") +
            Math.ceil(metersNow / (WALK_SPEED_KMH * 1000 / 60)) + " min</b>" +
            (estAir ? " (Luftlinie)" : "") + " · "
          : "") +
        (rel < 0
          ? '<span style="color:#64748b">abgefahren</span></div>'
          : losMin >= 0
            ? '<span style="color:' + (rel > 180 ? "#4ade80" : "#fbbf24") + '">' +
              "los in " + losMin + " min</span></div>"
            : '<span style="color:#fbbf24">ab in ' + Math.round(rel / 60) + " min</span></div>");
    } else {
      return '<small class="rowinfo dim">Abfahrt nicht mehr in den Daten – ↻ für neue Abfrage.</small>';
    }
  } else {
    return '<small class="rowinfo dim">Daten werden geladen …</small>';
  }
}

// ---------- Fahrtverlauf (Lupe) ----------
let currentTrip = null;   // { tripId, sn, stops:[{shortName,name,time,status,seq}], route, direction, delay:{}, progressIdx, loading }
const tripDelayCache = new Map();   // "sn|tripId" -> { plannedTime, actualTime, delayMin, ts }

// Echtzeitabfrage einer Linie (Fahrtverlauf) ohne kompletten Neuaufbau:
// tripPassages neu laden, Ist-Zeiten und Verspätungen in den bestehenden
// Fahrtverlauf einschmelzen (Soll-Zeiten bleiben stehen).
async function refetchTripRealtime(sn, tripId) {
  const t = tripById(tripId);
  if (!t || !t.tripId || t.tripId !== tripId) return;
  if (isDB(sn)) {
    // Züge: komplette Neuanfrage der Fahrt (mit geplanter Abfahrtszeit)
    if (currentBus && currentBus.tripId === tripId) selectTrip(sn, tripId, true);
    return;
  }
  try {
    const res = await apiFetch("kvg", TRIP_URL, {
      method: "POST",
      headers: { "Content-Type": "application/x-www-form-urlencoded" },
      body: "tripId=" + encodeURIComponent(tripId)
    });
    if (!res.ok) return;
    const data = await res.json();
    const passages = (data.old || []).concat(data.actual || []);
    for (const p of passages) {
      const s = (t.stops || []).find(x => x.shortName === (p.stop && p.stop.shortName));
      if (!s) continue;
      if (p.actualTime) s.time = p.actualTime;
      const key = s.key || (s.shortName + "|" + tripId);
      const planned = (t.delay[key] && t.delay[key].plannedTime) || s.plannedTime || "";
      const [ah, am] = (p.actualTime || "").split(":").map(Number);
      const [ph, pm] = planned.split(":").map(Number);
      if (isFinite(ah) && isFinite(am) && isFinite(ph) && isFinite(pm)) {
        t.delay[key] = { plannedTime: planned, actualTime: p.actualTime,
          delayMin: (ah * 60 + am) - (ph * 60 + pm), ts: Date.now() };
      }
    }
  } catch (e) {}
  renderPanels();
}

// Neue Stationsliste in den bestehenden Fahrtverlauf einschmelzen: bereits
// geladene Stationen (auch solche, die die API später nicht mehr liefert)
// bleiben erhalten, Zeiten werden aktualisiert, neue Stationen ergänzt.
function mergeTripStops(t, newStops) {
  if (!t.stops || !t.stops.length) { t.stops = newStops; return; }
  const byId = new Map(t.stops.map(x => [x.shortName + "#" + (x.seq || 0), x]));
  for (const ns of newStops) {
    const k = ns.shortName + "#" + (ns.seq || 0);
    const old = byId.get(k);
    if (old) {
      if (ns.time) old.time = ns.time;
      if (ns.status) old.status = ns.status;
      if (ns.name) old.name = ns.name;
    } else { t.stops.push(ns); byId.set(k, ns); }
  }
  t.stops.sort((a, b) => (a.seq || 0) - (b.seq || 0));
}
// Abfahrts-Eintrag einer Station suchen: in den Live-Abfahrten (v.deps), den
// geplanten Fahrplan-Einträgen (v.planned, z. B. nachts nachgeladen) und den
// per „früher“ geladenen abgefahrenen Verbindungen (v.earlier). Geplante und
// frühere KVG-Einträge stammen aus dem NAH.SH-Fahrplan (HAFAS-jid), ihre
// Fahrtenverläufe laufen deshalb über NAH.SH-JourneyDetails (dbTrip), nicht
// über die KVG-Live-Schnittstelle.
function findDepOf(sn, tripId) {
  const v = viewOf(sn);
  if (!v) return null;
  for (const d of (v.deps || [])) if (d.tripId === tripId) return d;
  for (const d of (v.planned || [])) if (d.tripId === tripId) return d;
  for (const d of (v.earlier || [])) if (d.tripId === tripId) return d;
  return null;
}

async function selectTrip(sn, tripId, force) {
  if (currentTrip && currentTrip.tripId === tripId && !force) {
    // erneut angeklickt: nur Ansicht öffnen
    renderBusPanel();
    return;
  }
  const reuse = currentTrip && currentTrip.tripId === tripId && currentTrip.sn === sn;
  // Aktualisierung (force): bestehenden Verlauf behalten und sichtbar lassen –
  // die Stationen und bisherigen Inhalte werden nicht gelöscht.
  if (!reuse) currentTrip = { tripId, sn, stops: null, route: "", direction: "", delay: {}, missing: {}, progressIdx: -1, loading: true };
  else currentTrip.loading = true;
  if (currentBus) currentBus.trip = currentTrip;   // Verlauf gehört zu diesem Fahrt-Unter-Reiter
  if (currentBus) currentBus.tripOpen = true;   // Fahrtverlauf auftauen
  if (force) {
    for (const k of [...tripDelayCache.keys()]) {
      if (k.endsWith("|" + tripId)) tripDelayCache.delete(k);
    }
  }
  renderBusPanel();
  const dep = findDepOf(sn, tripId);
  if (isDB(sn) || (dep && dep.planned)) {
    // Züge UND geplante KVG-Fahrten (Nachtfahrplan, „früher“): Der Fahrtverlauf
    // kommt über NAH.SH-JourneyDetails – die KVG-Live-Schnittstelle kennt diese
    // Fahrten (noch) nicht, ihre Trip-IDs sind HAFAS-jids. Bei geplanten KVG-
    // Fahrten werden die NAH.SH-Stationen auf bekannte KVG-Haltestellen
    // abgebildet (klickbar, GPS-Fortschritt, Wecker).
    await dbTrip(tripId, dep ? dep.plannedTime : null, !!dep && !!dep.planned);
    if (currentBus && currentBus.tripId === tripId) { tripTitleSync(); renderBusPanel(); }
    return;
  }
  try {
    const res = await apiFetch("kvg", TRIP_URL, {
      method: "POST",
      headers: { "Content-Type": "application/x-www-form-urlencoded" },
      body: "tripId=" + encodeURIComponent(tripId)
    });
    if (!res.ok) throw new Error("HTTP " + res.status);
    const data = await res.json();
    // bereits befahrene Haltestellen (old, DEPARTED) vor die restliche Fahrt hängen.
    // Die Zeiten aus tripPassages sind die (prognostizierten) IST-Zeiten -> "Aktuell".
    // Sie füllen die Spalte komplett beim Öffnen; die Spalte "Gep." (Soll) kommt je
    // Station aus den Abfahrtstafeln und wird über den globalen ↻-Knopf geladen.
    const mapKvgStop = p => ({
      shortName: p.stop.shortName, name: p.stop.name,
      time: p.actualTime, plannedTime: "",
      status: p.status, seq: Number(p.stop_seq_num) || 0
    });
    mergeTripStops(currentTrip, (data.old || []).map(mapKvgStop)
      .concat((data.actual || []).map(mapKvgStop)));   // einschmelzen statt ersetzen
    currentTrip.route = data.routeName || "";
    currentTrip.direction = data.directionText || "";
    // Soll/Ist der Starthaltestelle aus der Abfahrtstafel übernehmen (keine Zusatzabfrage)
    const dep0 = ((viewOf(sn) && viewOf(sn).deps) || []).find(d => d.tripId === tripId);
    if (dep0 && dep0.plannedTime) {
      const [ph, pm] = dep0.plannedTime.split(":").map(Number);
      const [ah, am] = (dep0.actualTime || dep0.plannedTime).split(":").map(Number);
      currentTrip.delay[sn + "|" + tripId] = {
        plannedTime: dep0.plannedTime, actualTime: dep0.actualTime,
        delayMin: (isFinite(ph) && isFinite(pm) && isFinite(ah) && isFinite(am))
          ? (ah * 60 + am) - (ph * 60 + pm) : null,
        ts: Date.now()
      };
    }
    currentTrip.loading = false;
    tripTitleSync();
    // Einstiegshaltestelle: erster Stations-Durchgang dieser Fahrt an der
    // angeklickten Station. Standardansicht des Verlaufs beginnt dort (Expand-
    // Knopf zeigt den ganzen Lauf). Bestimmung wie bei den Zügen: Durchgang,
    // dessen Zeit der Abfahrtszeit aus der Liste am nächsten kommt.
    let fi = -1, fBest = null;
    const depClock = (dep && (dep.actualTime || dep.plannedTime)) ||
      (currentTrip.delay[sn + "|" + tripId] && currentTrip.delay[sn + "|" + tripId].actualTime) || "";
    const [ch0, cm0] = depClock.split(":").map(Number);
    (currentTrip.stops || []).forEach((s2, idx) => {
      if (s2.shortName !== sn) return;
      if (fi < 0) fi = idx;
      if (!isFinite(ch0) || !isFinite(cm0)) return;
      const t2 = s2.time || s2.plannedTime || "";
      const [h2, m2] = t2.split(":").map(Number);
      if (!isFinite(h2) || !isFinite(m2)) return;
      const diff = Math.abs((h2 * 60 + m2) - (ch0 * 60 + cm0));
      if (fBest == null || diff < fBest) { fBest = diff; fi = idx; }
    });
    currentTrip.fromIdx = fi > 0 ? fi : 0;
    // Soll-Zeiten aller Haltestellen automatisch mitladen (mit Cache-TTL, Batches)
    await kvgFillPlanned();
  } catch (e) {
    currentTrip.loading = false;
    currentTrip.error = !(currentTrip.stops && currentTrip.stops.length);   // Alter Verlauf bleibt nutzbar
  }
  if (currentBus && currentBus.tripId === tripId) renderBusPanel();
}

// (Soll-Zeiten je Station der Kieler Busse sind nur einzeln abfragbar ->
//  gebündelt über den globalen ↻-Knopf des Fahrtverlaufs, s. kvgFillPlanned)

// Globale Aktualisierung für Busse: Soll-Zeit jeder Haltestelle der Fahrt aus
// den Abfahrtstafeln (eine Abfrage je Haltestelle, alle auf einen Schlag)
const TRIP_PLANNED_TTL_MS = 5 * 60 * 1000;   // Soll-Zeit-Abfragen: so lange gelten sie
// Schlauer Abgleich der „Gep.“-Zeiten, wenn die exakte Trip-ID nicht im
// Abfahrtsboard der Station steht (Fahrt schon aus dem Board-Fenster gerutscht,
// Konto der „nächsten Abfahrten“ voll, etc.): Variante A – erwartete Soll-Zeit
// an der Station aus den bekannten Zeiten der Nachbar-Stationen interpolieren
// (beidseitig, ansonsten Näherung über typische 1,5 min je Station);
// Variante B – im Board die Abfahrt derselben Linie + Richtung suchen, deren
// Soll-Zeit der Erwartung am nächsten liegt („letzte live-eintragung“).
function hhmmToMin(t) {
  const [h, m] = String(t == null ? "" : t).split(":").map(Number);
  return (isFinite(h) && isFinite(m)) ? (((h * 60 + m) % 1440) + 1440) % 1440 : null;
}
function circDiff(a, b) {
  let d = a - b;
  if (d > 720) d -= 1440; else if (d < -720) d += 1440;
  return d;
}
function expectedPlannedMin(idxSelf, n, getMin) {
  if (idxSelf == null || idxSelf < 0 || !n) return null;
  let pj = null, pk = null;
  for (let j = idxSelf - 1; j >= 0; j--) { const v = getMin(j); if (v != null) { pj = { i: j, v }; break; } }
  for (let k = idxSelf + 1; k < n; k++) { const v = getMin(k); if (v != null) { pk = { i: k, v }; break; } }
  const STEP = 1.5;   // Näherung: Stationstypische 1,5 min zwischen zwei Halten
  if (pj && pk) return (((pj.v + ((idxSelf - pj.i) / ((pk.i - pj.i) || 1)) * circDiff(pk.v, pj.v)) % 1440) + 1440) % 1440;
  if (pj) return ((pj.v + (idxSelf - pj.i) * STEP) % 1440 + 1440) % 1440;
  if (pk) return (((pk.v - (pk.i - idxSelf) * STEP) % 1440) + 1440) % 1440;
  return null;
}
function tripPlannedFallback(board, line, direction, expMin, tolMin) {
  if (expMin == null) return null;
  if (tolMin == null) tolMin = 25;
  let best = null, bestDiff = null;
  for (const x of (board || [])) {
    if (!x || !x.plannedTime) continue;
    if (line != null && String(x.patternText || "").trim() !== String(line || "").trim()) continue;
    if (direction != null && String(x.direction || "").trim() !== String(direction || "").trim()) continue;
    const xm = hhmmToMin(x.plannedTime);
    if (xm == null) continue;
    const ad = Math.abs(circDiff(xm, expMin));
    if (ad > tolMin) continue;
    if (bestDiff == null || ad < bestDiff) { best = x; bestDiff = ad; }
  }
  return best;
}

async function kvgFillPlanned() {
  const tripId = currentTrip.tripId;
  // nur Stationen ohne frische Soll-Zeit im Cache abfragen (Batches à 8)
  const todo = (currentTrip.stops || []).filter(s => {
    const key = s.key || (s.shortName + "|" + tripId);
    const c = tripDelayCache.get(key);
    return !c || Date.now() - (c.ts || 0) > TRIP_PLANNED_TTL_MS;
  });
  for (let bi = 0; bi < todo.length; bi += 8) {
    await Promise.all(todo.slice(bi, bi + 8).map(async s => {
      const key = s.key || (s.shortName + "|" + tripId);
      const stopsArr = currentTrip.stops || [];
      const idxSelf = stopsArr.indexOf(s);   // -1 möglich (Stopp nicht (mehr) in der Liste) -> ohne Fallback
      try {
        const res = await apiFetch("kvg", DEPART_URL, {
          method: "POST",
          headers: { "Content-Type": "application/x-www-form-urlencoded" },
          body: "stop=" + encodeURIComponent(s.shortName)
        });
        if (!res.ok) return;
        const data = await res.json();
        const board = [...(data.actual || []), ...(data.oldActual || [])];
        const fallbackFrom = Date.now();
        let d = board.find(x => x.tripId === tripId);
        let matched = "exact";
        if (!d || !d.plannedTime) {
          // Exakte Trip-ID nicht im Board -> schlauer Fallback (s. oben)
          d = tripPlannedFallback(board, currentTrip.route, currentTrip.direction,
            expectedPlannedMin(idxSelf, stopsArr.length, i => {
              const s2 = stopsArr[i];
              if (!s2 || i == null) return null;
              const k2 = s2.key || (s2.shortName + "|" + tripId);
              const c2 = tripDelayCache.get(k2) || currentTrip.delay[k2];
              return hhmmToMin((c2 && c2.plannedTime) || s2.plannedTime || s2.time || (c2 && c2.actualTime));
            }));
          matched = "fallback";
        }
        if (!d || !d.plannedTime) return;
        const old = currentTrip.delay[key] || {};
        const actualTime = old.actualTime || d.actualTime || d.plannedTime;
        const [ph, pm] = d.plannedTime.split(":").map(Number);
        const [ah, am] = actualTime.split(":").map(Number);
        const info = {
          plannedTime: d.plannedTime, actualTime,
          delayMin: (isFinite(ph) && isFinite(pm) && isFinite(ah) && isFinite(am))
            ? (ah * 60 + am) - (ph * 60 + pm) : null,
          ts: fallbackFrom
        };
        if (matched === "fallback") info.fallback = true;   // Kennung: nicht exakt zugeordnet
        tripDelayCache.set(key, info);
        currentTrip.delay[key] = info;
      } catch (e) {}
    }));
  }
}

// ---------- GPS-Fortschritt im Fahrtverlauf (reine Funktion, testsicher) ----------
// Station wird als erreicht markiert, sobald die Position auf 50 m heran ist.
// Der Zeitpunkt der Markierung wird anhand der relativen Geschwindigkeit aus dem
// Positionsverlauf auf den Moment projiziert, in dem die Station wirklich
// passiert wird (ETA) – nicht auf den Moment des 50-m-Kreuzens.
// Beim Verlassen des 50-m-Radius entscheidet die BEWEGUNGSRICHTUNG (Vektor aus
// dem Positionsverlauf, verglichen mit den Koordinaten der nächsten und der
// vorherigen Station): Richtung nächste Station -> Fortschritt committen
// (Station bleibt durchgestrichen); Richtung vorherige Station (typische
// Positionsungenauigkeit) -> temporär zurücknehmen, bei erneuter Annäherung
// wird wieder markiert. Ohne nutzbare Richtung gilt das alte Verhalten
// (committen) als Fallback.
const TRIP_MARK_M = 50;            // Annäherung: Station als „erreicht“ markieren
const TRIP_MARK_ETA_MAX_MS = 180000;   // Projektion maximal 3 Minuten voraus
const TRIP_TRAIL_MS = 5 * 60 * 1000;    // Positionsverlauf: letzte 5 Minuten
const TRIP_DOT_MAX_M = 300;        // Leuchtpunkt-Cut-off: Abstand zur Verlaufs-Linie
const TRIP_DOT_NEAR_M = 240;       // Hysterese: erst ab hier blendet der Punkt wieder ein
const TRIP_DOT_PREF_M = 120;        // Kleberei: der LAUFENDE Abschnitt behaelt den Punkt bis zu dieser Distanz-Ersparnis des besten Konkurrenten
const TRIP_AMB_D = 100;             // v1.6.17 Mehrdeutigkeit: Zweit-Kandidat hoechstens so viel Meter weiter entfernt
const TRIP_AMB_GAP = 2;             // und im Verlauf klar versetzt (Stationen/Segmente Abstand): Dann entscheidet die Zeit, sonst die GPS-Geometrie
const ROUTE_DOT_WALK_DET = 1.6;     // Zubringer-Ellipse: das 1,6-fache der Weglaenge begrenzt, wie weit abseits die Strang-Projektion gilt
const ROUTE_DOT_WALK_ADD_M = 250;   // Grund-Spielraum der Ellipse in Metern: erlaubt Umwege entlang des echten Wegs (Strassen, Wege-Schleifen)
let tripDotFar = false, routeDotFar = false;   // Hysterese-Zustand der beiden Leuchtpunkte
function tripProgressUpdate(trip, pos, nowMs, opts) {
  const out = { atIdx: null, commitIdx: null, revoke: false, etaTs: null, suspect: false };
  if (!trip || !trip.stops || !trip.stops.length || !pos) return out;
  const coordsOf = opts && opts.coordsOf;
  if (!coordsOf) return out;
  // Positionsverlauf führen (jeder Aufruf prüft auf neue Position)
  const trail = (trip.gpsTrail = trip.gpsTrail || []);
  const lastT = trail.length ? trail[trail.length - 1] : null;
  if (!lastT || lastT.ts < nowMs - 500 ||
      Math.abs(lastT.lat - pos.lat) > 1e-7 || Math.abs(lastT.lon - pos.lon) > 1e-7) {
    trail.push({ lat: pos.lat, lon: pos.lon, ts: nowMs });
  }
  while (trail.length && (nowMs - trail[0].ts > TRIP_TRAIL_MS || trail.length > 12)) trail.shift();
  // Bewegungsvektor + Geschwindigkeit: ältester Punkt im Verlag gegen aktuell
  let h = null, speed = 0;
  if (trail.length >= 2) {
    const p0 = trail[0];
    const dt = (nowMs - p0.ts) / 1000;
    if (dt >= 3) {
      const dLat = pos.lat - p0.lat, dLon = pos.lon - p0.lon;
      const dm = dist(p0, pos);
      if (dm >= 2) { h = { lat: dLat, lon: dLon }; speed = dm / dt; }   // < 2 m: steht (fast) still
    }
  }
  // Plausibilität: Kann die Fahrt an der Station gerade wirklich sein?
  // (Maßstab: Abfahrtszeit dort, erweitertes Fenster; wie im Rendering)
  const plausible = i => {
    const s = trip.stops[i];
    const key0 = s.key || (s.shortName + "|" + trip.tripId);
    const dl0 = trip.delay[key0];
    const depStr = (dl0 && dl0.actualTime) || s.time || s.plannedTime || "";
    const [dh0, dm0] = depStr.split(":").map(Number);
    if (!isFinite(dh0) || !isFinite(dm0)) return true;   // keine Zeitinfo -> zulassen
    const n0 = new Date(nowMs);
    const nowMin0 = n0.getHours() * 60 + n0.getMinutes() + n0.getSeconds() / 60;
    const depMin0 = dh0 * 60 + dm0;
    let tripLagMin = 0;
    for (const k in trip.delay) {
      const dd = trip.delay[k];
      if (dd && dd.delayMin != null && dd.delayMin > tripLagMin) tripLagMin = dd.delayMin;
    }
    const hasActual = !!(dl0 && dl0.actualTime) || !!s.time;
    const winBefore = 3;
    const winAfter = hasActual ? 5 : tripLagMin + 5;
    if (nowMin0 < depMin0 - winBefore || nowMin0 > depMin0 + winAfter) {
      if (opts && typeof opts.onSuspect === "function") opts.onSuspect(i);
      out.suspect = true;
      return false;
    }
    return true;
  };
  // Nächste plausible Station im 50-m-Radius (bei mehreren die mit dem
  // kleinsten Abstand). opts.skipAt(i) -> true haelt eine Station VON ALLEM
  // GPS fern: keine "hier"-Markierung, keine GPS-Uhr, kein GPS-ETA
  // (v1.6.7: die Einstiegs-/Abfahrtsstation eines Routen-Abschnitts; das
  // eigene Fusz-GPS dort waere eine Abfahrts-Vorhersage aus dem Nichts -
  // am Start zaehlt allein Echtzeit bzw. Fahrplan).
  let best = null;
  const skipAt = opts && typeof opts.skipAt === "function" ? opts.skipAt : null;
  for (let i = 0; i < trip.stops.length; i++) {
    const c = coordsOf(i);
    if (!c) continue;
    if (skipAt && skipAt(i)) continue;
    const dm = dist(pos, c);
    if (dm > TRIP_MARK_M) continue;
    if (best != null && dm >= best.dm) continue;
    if (!plausible(i)) continue;
    best = { i, dm };
  }
  if (best != null) {
    out.atIdx = best.i;
    // ETA: projizierter Moment des Passierens der Station selbst („50 m weiter
    // auf die Station verlegt“). Nur bei Bewegung; sonst live Uhr wie gehabt.
    if (speed >= 0.5 && best.dm > 2) {
      const eta = nowMs + (best.dm / speed) * 1000;
      out.etaTs = Math.min(eta, nowMs + TRIP_MARK_ETA_MAX_MS);
    }
    return out;
  }
  // Kein 50-m-Treffer. Stand die Position zuletzt an einer Station (alter atIdx),
  // entscheidet die Bewegungsrichtung über committen oder temporäres Zurücknehmen.
  const prev = trip.atIdx;
  if (prev == null) return out;
  const posPrev = coordsOf(prev);
  if (!posPrev || dist(pos, posPrev) <= TRIP_MARK_M) return out;   // noch drin (implausibel geworden)
  const prevC = prev > 0 ? coordsOf(prev - 1) : null;
  const nextC = prev < trip.stops.length - 1 ? coordsOf(prev + 1) : null;
  if (h && prevC && nextC) {
    const dotPrev = h.lat * (prevC.lat - pos.lat) + h.lon * (prevC.lon - pos.lon);
    const dotNext = h.lat * (nextC.lat - pos.lat) + h.lon * (nextC.lon - pos.lon);
    if (dotPrev > 0 && dotPrev > dotNext) { out.revoke = true; return out; }   // Richtung vorherige: zurücknehmen
  }
  out.commitIdx = prev;   // Richtung nächste Station / ohne Richtung: committen
  return out;
}

function tripSectionHTML() {
  if (!currentTrip || !currentBus || currentTrip.tripId !== currentBus.tripId) return "";
  let html = '<div class="trip"><i class="tripbeam"></i>';   // v1.6.11: Raum-Zeit-Strahl (Füllung läuft zeitproportional zwischen den Kreisen)
  if (currentTrip.loading && (!currentTrip.stops || !currentTrip.stops.length)) {
    html += '<small class="rowinfo dim">Fahrtverlauf wird geladen …</small></div>';
    return html;
  }
  if (currentTrip.error || !currentTrip.stops || !currentTrip.stops.length) {
    html += '<small class="rowinfo dim">Fahrtverlauf gerade nicht verfügbar.</small></div>';
    return html;
  }
  const pos = livePos();
  const tstops = currentTrip.stops;
  // Raum-Zeit-Fahrtbeobachtung: DER angesehene Verlauf (gesamte Fahrt) füttert
  // die Raum-Zeit-Karte; die Fahrzeug-Erkennung behält Vorrang, wenn sie
  // gerade auf genau dieser Fahrt läuft.
  const sztW = sztTripWatch(currentTrip, tstops);
  const sztWVeh = sztFresh();
  // Fortschritt (GPS, NUR Live-Ortung): Station wird ab 50 m Annäherung als erreicht markiert;
  // Richtung (vorherige/nächste Station) und Geschwindigkeit bestimmen, ob der
  // Stand beim Verlassen committen oder temporär zurückgenommen wird. Details:
  // tripProgressUpdate (reine Funktion, weiter oben).
  let gpsKey = null;   // Station im 50-m-Radius (plausibel): dort live Ist-Abfahrt füllen
  if (pos) {
    const pr = tripProgressUpdate(currentTrip, pos, Date.now(), {
      coordsOf: i => {
        if (tstops[i] && tstops[i].lat != null) return tstops[i];   // NAH.SH-Lauf: eigene Koordinaten
        const st = stops.find(x => x.shortName === tstops[i].shortName) || dbStopOf(tstops[i].shortName);
        return st ? st : null;
      },
      onSuspect: () => triggerSuspectRefetch(currentTrip.sn, currentTrip.tripId)
    });
    if (pr.atIdx != null) {
      currentTrip.atIdx = pr.atIdx;
      currentTrip.mark = pr.etaTs != null ? { idx: pr.atIdx, etaTs: pr.etaTs } : null;
      gpsKey = tstops[pr.atIdx].key || (tstops[pr.atIdx].shortName + "|" + currentTrip.tripId);
      notifyTripProgress(pr.atIdx);
    } else if (currentTrip.atIdx != null) {
      // 50-m-Radius verlassen: Richtung nächste Station -> committen (bleibt
      // durchgestrichen); Richtung vorherige Station -> temporär zurücknehmen.
      if (pr.commitIdx != null) {
        currentTrip.progressIdx = Math.max(currentTrip.progressIdx, pr.commitIdx);
      }
      currentTrip.atIdx = null;
      currentTrip.mark = null;
    }
  }
  const done = currentTrip.progressIdx;
  const last = tstops.length - 1;
  // Standardansicht: nur die Stationen ab der Einstiegshaltestelle (auf Klick im
  // Stationsdialog / Routing). Expand-Knopf oben schaltet auf den ganzen Lauf.
  const fromRaw = currentTrip.expand ? 0 :
    (currentTrip.fromIdx != null ? currentTrip.fromIdx :
      (currentTrip.startIdx != null ? currentTrip.startIdx : 0));
  const theFrom = Math.max(0, Math.min(fromRaw || 0, last));
  const hasFrom = theFrom > 0 || currentTrip.expand;   // Expand-Knopf auch im aufgeklappten Zustand zeigen
  // Eine Glocke für die ganze Fahrt: Zustand = irgendein Wecker dieser Fahrt
  const tKeys = tstops.map(x => currentTrip.tripId + "|" + x.shortName);
  const tRing = tKeys.some(k => ringing.has(k));
  const tFired = tRing || tKeys.some(k => firedAlarms.has(k));
  const tArmed = tKeys.some(k => alarms.has(k));
  const tBellCls = tRing ? " abell fired ring" : tFired ? " abell fired" : tArmed ? " abell on" : " abell";
  html += '<div class="thead"><span class="pname">Fahrtverlauf <span class="rtbadge tripbadge">' +
    escapeHtml(currentTrip.route || "?") + '</span> → ' + escapeHtml(currentTrip.direction) + "</span>" +
    '<button class="rowref" data-tripref="' + escapeHtml(currentTrip.tripId) +
      '" title="Fahrtverlauf und alle Haltestellen global neu abfragen">↻</button>' +
    (hasFrom ? '<button class="rowref" data-tripexp="1" title="' +
      (currentTrip.expand ?
        "Nur die ab der Einstiegshaltestelle verbleibenden Stationen anzeigen" :
        "Ganzer Verlauf von der Start- bis zur Endhaltestelle anzeigen (inkl. geplanter Abfahrten)") +
      '">' + (currentTrip.expand ? "⤡" : "⤢") + "</button>" : "") +
    '<button class="' + tBellCls + '" data-alarmtrip="' + escapeHtml(currentTrip.tripId) +
      '" title="' + (tFired ? "Wecker ausgelöst – Dialog öffnen (Löschen beendet)" :
        tArmed ? "Wecker gestellt – antippen zum Ändern/Löschen" : "Wecker für eine Station dieser Fahrt stellen") +
      '">' + (tArmed || tFired ? "⏰" : "🔔") + "</button>" +
    bikeBtnHTML("trip", "Umstieg aufs Leihfahrrad: Abholrad- und Rückgabe-Pulldown ab der dir nächsten Haltestelle dieser Fahrt, offene 4-Punkte-Route über OSM und uMap") + "</div>" +
    tripFollowHTML(currentTrip, tstops) +
    sztTripHeadHTML(currentTrip) +
    '<div class="tlegend"><span class="lgep">Gep.</span><span class="lakt">Aktuell</span></div>';
  if (gpsState !== "on")
    html += '<small class="rowinfo dim">GPS ist aus – die Live-Verfolgung (Punkt, „≈“-Zeiten, Durchstreichen) ruht. ◎ oben einschalten.</small>';
  for (let i = theFrom; i < tstops.length; i++) {
    const s = tstops[i];
    const key = s.key || (s.shortName + "|" + currentTrip.tripId);
    const dl = currentTrip.delay[key];
    const planned = (dl && dl.plannedTime) || s.plannedTime || "";
    let actual = s.time || (dl && dl.actualTime) || "";
    let delayHtml = "";
    if (dl && dl.delayMin != null) {
      const delayCls = dl.delayMin > 0 ? "up" : dl.delayMin < 0 ? "down" : "ok";
      const delayTxt = dl.delayMin > 0 ? "+" + dl.delayMin + "m" : dl.delayMin < 0 ? dl.delayMin + "m" : "0m";
      delayHtml = '<span class="tdelay ' + delayCls + '">' + delayTxt + "</span>";
    }
    // GPS-Live: eigene Position an dieser Station -> laufend die aktuelle Uhrzeit als
    // Ist-Abfahrt eintragen (+/- Indikator), solange bis die Station wieder verlassen
    // wird; danach bleibt der letzte Stand eingefroren (es sind Abfahrtszeiten).
    // Annäherung mit Geschwindigkeit: Bis zur projizierten Passierzeit (ETA aus dem
    // Positionsverlauf) steht dort zuerst die VORAUSGESICHTE Zeit („50 m weiter
    // auf die Station verlegt“), danach die laufende Uhr.
    const mark = currentTrip.mark;
    if (gpsKey && key === gpsKey && mark && mark.idx === i && mark.etaTs && mark.etaTs > Date.now() + 1500) {
      const eD = new Date(mark.etaTs);
      const [ph, pm] = (planned || "").split(":").map(Number);
      if (isFinite(ph) && isFinite(pm)) {
        const etaClock = String(eD.getHours()).padStart(2, "0") + ":" +
          String(eD.getMinutes()).padStart(2, "0");
        const eMin = (eD.getHours() * 60 + eD.getMinutes()) - (ph * 60 + pm);
        if (Math.abs(eMin) < 720) {
          actual = "≈" + etaClock;
          delayHtml = '<span class="tdelay ' + (eMin > 0 ? "up" : eMin < 0 ? "down" : "ok") + '">' +
            (eMin > 0 ? "+" + eMin + "m" : eMin < 0 ? eMin + "m" : "0m") + "</span>";
        }
      }
    } else if (gpsKey && key === gpsKey) {
