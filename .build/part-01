  // der zugeklappte zeigt den eingefrorenen Stand. Die frühere separate
  // Stationsansicht (Name, Entfernung, Route-Icon, Stern, ↻) ist weg – der
  // Stationsname steht nur noch hier, dahinter Favoritenstern
  // und GPS, Aktualisieren (↻) ganz rechts.
  const rsMeta = isRS(currentStop.shortName) ? (remoteStops.get(currentStop.shortName) || currentStop) : null;   // v1.5.0: Fern-Station
  const head = '<div class="sechead" data-ssec="1"><span class="sarr">' +
    (stationPanelOpen ? "▾" : "▸") + "</span>Abfahrten: " +
    escapeHtml(currentStop.name) +

    (rsMeta   // v1.5.0: statt Stern das Kurzzeichen des Live-Dienstes (Favoriten bleiben Kieler Stationen)
      ? '<span class="regsvc d' + (rsMeta.svc || "nahsh") + '" title="Live-Dienst dieser Fern-Station: ' +
        escapeHtml(RS_SVC_LABEL[rsMeta.svc] || "nah.sh") + ' (regionale Quelle zuerst, sonst nah.sh-Fallback)">' +
        escapeHtml(RS_SVC_LABEL[rsMeta.svc] || "nah.sh") + "</span>"
      : starHTML(currentStop.shortName)) +
    tabGpsBtnHTML(currentStop.shortName) +
    // v1.6.36: Zeit-Auswahl - Abfahrten ab gewaehlter Uhrzeit, Standard jetzt
    '<input type="time" class="depat" data-at="' + escapeHtml(currentStop.shortName) +
      '" value="' + escapeHtml(v && v.atHm || "") +
      '" title="Abfahrten ab dieser Uhrzeit anzeigen (leer oder „Jetzt“ = ab jetzt)">' +
    ((v && v.atHm) ? '<button class="atnow" data-atnow="' + escapeHtml(currentStop.shortName) +
      '" title="Zurück auf jetzt schalten">Jetzt</button>' : "") +
    '<button class="rowref" data-ref="' + escapeHtml(currentStop.shortName) +
