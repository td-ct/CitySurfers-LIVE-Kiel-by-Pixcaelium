        ALARM_SOUNDS.map(x => '<option value="' + x[0] + '"' + (x[0] === cur.snd ? " selected" : "") + ">" + x[1] + "</option>").join("") + "</select></label>" +
      '<label class="dstage">Lautstärke <input type="range" class="avol" min="0.1" max="1" step="0.05" value="' + cur.vol + '"></label>' +
