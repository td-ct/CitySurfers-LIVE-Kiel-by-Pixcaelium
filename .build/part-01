}
function rsAddrCacheKey(addr) {   // grob gerastert (ca. 1 km): eine Suche je Standort-Grobzelle
  return "addr:" + (Math.round(addr.lat * 100) / 100) + "," + (Math.round(addr.lon * 100) / 100);
