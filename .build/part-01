// window.KvgNative wird nur von der App eingespritzt; im Browser bleibt es
// undefiniert und alle Aufrufe sind wirkungslos (Seite läuft unverändert weiter).
function nativeCall(fn, ...args) {
  try { if (typeof window !== "undefined" && window.KvgNative) window.KvgNative[fn](...args); }
  catch (e) {}
}
function nativeVibrate(pat) { nativeCall("vibrate", JSON.stringify(pat)); }
// Weckzeit (Epoch-ms) = geplante/aktuelle Abfahrt minus Vorlauf, inkl. Tagesumbruch
function nativeAlarmEpoch(aKey, leadMin) {
  const trip = tripById(aKey.slice(0, aKey.indexOf("|")));
  let h = NaN, m = NaN;
  if (!trip) {   // Route-Wecker: Zeit direkt aus der gewaehlten Route
    const a = alarms.get(aKey);
    const depMin = a ? routeAlarmDepMin(a) : null;
    if (depMin == null) return null;
    h = Math.floor(depMin / 60); m = depMin % 60;
  } else {
    const sn = aKey.slice(aKey.indexOf("|") + 1);
    const s = (trip.stops || []).find(x => x.shortName === sn);
    if (!s) return null;
    const key = s.key || (sn + "|" + trip.tripId);
    const dl = trip.delay[key] || {};
    const t = dl.plannedTime || dl.actualTime || s.time || s.plannedTime || "";
    const parts = t.split(":").map(Number);
    h = parts[0]; m = parts[1];
  }
  if (!isFinite(h) || !isFinite(m)) return null;
  const now = new Date();
  let depMs = new Date(now.getFullYear(), now.getMonth(), now.getDate(), h, m).getTime();
  if (depMs < Date.now() - 60000) depMs += 86400000;   // nachts: gehört zum nächsten Tag
  // Weckzeit kann knapp in der Vergangenheit liegen (Abfahrt schon nah):
  // AlarmManager löst dann sofort aus, was genau richtig ist.
  return depMs - leadMin * 60000;
}

// Abfahrtszeit (Minuten des Tages) der Wecker-Station aus dem aktuellen Fahrtverlauf
// Route-Wecker (Glocke in der gewaehlten Route): Abfahrtszeit der Station
// direkt aus der Route suchen, Echtzeit vor Plan – dazu muessen Fahrtverlauf
// und tripById nichts wissen; gesucht wird in allen offenen Verbindungen nach
// dem Abschnitt (jid) und dem Stations-Namen.
function routeAlarmDepMin(a) {
  if (!a || !a.jid || a.rtName == null) return null;
  const norm = s => String(s || "").toLowerCase().replace(/[^a-z0-9äöüß]/g, "");
  const want = norm(String(a.rtName).replace(/\s*\(DB\)\s*$/, ""));
  for (const rc of routeChosen) {
    const con = rc && rc.con;
    if (!con) continue;
    for (const sec of con.secs || []) {
      if (!sec || sec.jid !== a.jid) continue;
      const sts = sec.stops || [];   // die Segment-Liste bleibt immer die Basis (Erweiterung nur Anzeige)
      for (const st of sts) {
        if (!st || norm(String(st.name).replace(/\s*\(DB\)\s*$/, "")) !== want) continue;
        const parts = (st.dR || st.dS || "").split(":").map(Number);
        if (parts.length < 2 || !isFinite(parts[0]) || !isFinite(parts[1])) return null;
        return parts[0] * 60 + parts[1];
