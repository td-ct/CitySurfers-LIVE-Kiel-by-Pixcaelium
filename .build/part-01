    '<label class="supchk"><input type="checkbox" data-supgroup="sfav"> Stations-Favoriten</label>' +
    '<div class="dim supnote">Betreff der E-Mail: „Bugreport CitySurfer v' + escapeHtml(pageVersion() || "?") +
