function rsRowHTML(s, pos) {   // v1.5.0: zweizeilige Fern-Stations-Zeile mit Kurzzeichen rechts
  const meta = [];
  if (pos) {
    const air = dist(pos, s) * 1.3;
    meta.push("~" + formatDist(air) + " · ~" + Math.ceil(air / (WALK_SPEED_KMH * 1000 / 60)) + " min (Luftlinie)");
  }
  meta.push("Fern-Station");
