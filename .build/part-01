      if (!sched.days[i] || !sched.days[i].length) return;
      if (cur.selIdx[i] == null || cur.selIdx[i] < 0) { cur.selIdx[i] = 0; }
      let ni = cur.selIdx[i] + dirn;
      let nd = i, warn = false;
      if (ni < 0) { nd = (i + 6) % 7; const L = sched.days[nd] || []; ni = L.length - 1; warn = true; }
      else if (ni >= sched.days[i].length) { nd = (i + 1) % 7; ni = 0; warn = false; }
      const L = sched.days[nd] || [];
      if (ni < 0 || ni >= L.length) return;
      cur.selIdx[i] = ni; cur.selWarn[i] = warn;
      cur.days[i] = L[ni].t;
      renderRows();
      return;
    }
    const lo = e.target.closest("[data-pkopen]");
    if (lo) {
      const x = packAlarms.find(y => y.id === lo.dataset.pkopen);
      if (x) { wrap.remove(); openPackDlg(null, x); }
