    }).join("") || '<div class="dim" style="padding:4px 0">Noch keine 🐿️-Alarme gesetzt.</div>';
    lst.innerHTML = h;
  }
  function renderRows() {
    let any = false;
    const h = PACK_DAYS.map((dn, i) => {
      const t = cur.days[i];
      if (t && cur.on[i]) any = true;
      return '<div class="pkgday">' +
        '<span class="pkd">' + dn + "</span>" +
        '<button class="pkn" data-pkn="-1" data-pkd="' + i + '" title="Frühere Verbindung dieses Tages (ein Druck = ein Schritt); liegt sie am Vortag, erscheint ⚠">◀</button>' +
        '<span class="pkt' + (cur.selWarn[i] ? " warn" : "") + '">' + escapeHtml(t || "–") +
          (cur.selWarn[i] ? ' <span class="pkw" title="Diese Uhrzeit liegt am Vortag">⚠</span>' : "") + "</span>" +
        '<button class="pkn" data-pkn="1" data-pkd="' + i + '" title="Spätere Verbindung dieses Tages (ein Druck = ein Schritt)">▶</button>' +
        '<label class="pkon"><input type="checkbox" data-pkc="' + i + '"' + (cur.on[i] ? " checked" : "") + "> " + dn + "</label>" +
        "</div>";
    }).join("");
    tbl.innerHTML = h;
    okBtn.disabled = !(sched && sched.days && any && cur.days.some(x => x));
  }
  function pickInitial(i, list) {   // Startzeit je Tag: gespeicherte/exakte Zeit, sonst naechste zur Referenz
    if (!list || !list.length) return null;
    const refMin = packMinOf(cur.ref) != null ? packMinOf(cur.ref) : 8 * 60;
    let ex = -1;
    if (a && a.days[i]) ex = list.findIndex(e => e.t === a.days[i]);
    if (ex >= 0) return ex;
    let best = 0;
    for (let k = 0; k < list.length; k++) {
      const m = packMinOf(list[k].t);
      if (m != null && m >= refMin) { best = k; break; }
      best = 0;
    }
    return best;
  }
  async function loadSched(force) {
    try {
      schedEl.textContent = "Fahrplan Mo–So wird geladen …";
      const sc = await packSchedOf({ sn: cur.sn, name: cur.name, line: cur.line, dir: cur.dir }, force);
      if (sc.err || !sc.days) { schedEl.textContent = "⚠ Fahrplanabfrage fehlgeschlagen: " + sc.err; return; }
      sched = sc;
      schedEl.textContent = "Fahrplan " + new Date(sc.ts).toTimeString().slice(0, 5) + " Uhr (nah.sh, ◀/▶ blättert je Tag, ⚠ = Uhrzeit am Vortag):";
      for (let i = 0; i < 7; i++) {
        cur.selIdx[i] = pickInitial(i, sc.days[i]);
        cur.selWarn[i] = false;
        cur.days[i] = cur.selIdx[i] >= 0 ? sc.days[i][cur.selIdx[i]].t : (cur.days[i] || null);
      }
      renderRows();
    } catch (e) {
      schedEl.textContent = "⚠ Fahrplanabfrage fehlgeschlagen (Netzwerk?) – bitte erneut versuchen.";
    }
  }
  wrap.addEventListener("click", async e => {
    if (e.target === wrap) { wrap.remove(); return; }
    if (e.target.closest(".atest")) {
      alarmBeep(Number(wrap.querySelector(".avol").value), wrap.querySelector(".asnd").value, 2);
      if (wrap.querySelector(".avib").checked) vibratePattern([600, 200, 600]);
      return;
    }
    const g = e.target.closest("[data-g]");
    if (g && g.dataset.g === "w") {
      cur.win = Number(g.dataset.v);
      wrap.querySelectorAll('[data-g="w"]').forEach(x => x.classList.toggle("on", x === g));
