async function rsAddrNear(addr) {   // LocMatch mit dem Ort der Adresse + Umkreis-Filter
  if (!addr || addr.gps || listMode === "flat") return;
  if (addr.lat == null || addr.lon == null) return;
  let dmin = Infinity;   // Entfernung zum naechsten Kiel-Halt (ohne Fern-Stationen)
  for (const st of stops) {
    if (isRS(st.shortName) || st.lat == null || st.lon == null) continue;
    const d = dist(addr, st);
    if (d < dmin) dmin = d;
  }
  if (dmin <= RS_ADDR_MIN_KM * 1000) return;   // Kiel-Umfeld: lokale Liste reicht
  const key = rsAddrCacheKey(addr);
  if (rsSearchCache.get(key)) return;   // laeuft schon oder lief (auch leer: 10 min Ruhe)
  rsSearchCache.set(key, { hits: [], ts: Date.now(), addr: true });
  const q = rsAddrCityOf(addr.label);
  if (q.length < RS_MIN_CHARS) return;
  try {
    const res = await routeHafas("LocMatch", { input: { field: "S", loc: { name: q, type: "S" } } });
    const hits = [], seen = new Set();
    for (const x of ((res.match && res.match.locL) || [])) {
      if (!x || x.type !== "S" || !x.lid || seen.has(x.lid)) continue;
      seen.add(x.lid);
      const extM = String(x.lid).match(/@L=(\d+)/);
      const crd = x.crd || {};
      if (!extM || !/^\d+$/.test(extM[1]) || crd.y == null || crd.x == null) continue;
      const nm = String(x.name || "").replace(/…/g, "").trim();
      if (!nm) continue;
      const lat = crd.y / 1e6, lon = crd.x / 1e6;
      if (dist(addr, { lat: lat, lon: lon }) > RS_ADDR_NEAR_KM * 1000) continue;   // Umkreis
      if (RS_KNOWN_EXT.has(extM[1])) continue;   // Kiels DB-Stationen stecken schon fest in der Liste
      let dup = false;
      for (const st of stops) {
        if (isRS(st.shortName) || st.lat == null || st.lon == null) continue;
        if (dist(st, { lat: lat, lon: lon }) < 400 &&
