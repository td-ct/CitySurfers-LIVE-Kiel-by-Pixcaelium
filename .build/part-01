function packDirMatch(want, have) {
  const a = String(want || "").toLowerCase().trim(), b = String(have || "").toLowerCase().trim();
  if (!a || !b) return false;
  return a.indexOf(b) >= 0 || b.indexOf(a) >= 0;
}
async function packSchedOf(a, force) {
  const key = a.sn + "|" + a.line + "|" + (a.dir || "");
  const c = packSchedCache.get(key);
  if (!force && c && Date.now() - c.ts < 6 * 3600000 && !c.err) return c;
  const lid = await packLidOf(a);
  if (!lid) { const e = { ts: Date.now(), days: null, err: "Station nicht in nah.sh gefunden" };
    packSchedCache.set(key, e); return e; }
  const nowD = new Date(), today = packDayIdx(nowD);
  const days = [];
  for (let i = 0; i < 7; i++) {
    const k = (i - today + 7) % 7;
    const T = new Date(nowD.getFullYear(), nowD.getMonth(), nowD.getDate() + k, 0, 0, 0);
    let list = [];
    try {
      const entries = await nahshBoardEntries(lid, T, 511);
      const ln = followNormLine(a.line);
      let hit = entries.filter(e => followNormLine(e.line) === ln && packDirMatch(a.dir, e.direction));
      if (!hit.length) hit = entries.filter(e => followNormLine(e.line) === ln);   // Richtung passt nicht: alle der Linie
      const t0 = T.getTime(), t1 = t0 + 86400000;
      hit = hit.filter(e => e.absMs >= t0 && e.absMs < t1);
      hit.sort((x, y) => x.absMs - y.absMs);
      list = hit.map(e => {
        const d = new Date(e.absMs);
        return { t: String(d.getHours()).padStart(2, "0") + ":" + String(d.getMinutes()).padStart(2, "0"), ms: e.absMs };
      });
    } catch (err) { throw err; }
    days.push(list);
  }
  const res = { ts: Date.now(), days: days, err: null };
  packSchedCache.set(key, res);
  return res;
}
// Naechstes Vorkommen des Alarms: kleinste kommende Zeit ueber alle aktivierten Tage
function packNextOcc(a) {
  const now = Date.now(), nowD = new Date(), today = packDayIdx(nowD);
  let best = null;
  for (let k = 0; k <= 8; k++) {
    const i = (today + k) % 7;
    if (!a.on || !a.on[i] || !a.days || !a.days[i]) continue;
    const m = packMinOf(a.days[i]);
    if (m == null) continue;
    const dayMs = new Date(nowD.getFullYear(), nowD.getMonth(), nowD.getDate() + k).getTime();
    const ms = dayMs + m * 60000;
    if (ms < now - 5 * 60000) continue;
    if (!best || ms < best.ms) best = { wd: i, dayMs: dayMs, t: a.days[i], ms: ms, key: packDateKey(dayMs) + "|" + a.days[i] };
  }
  return best;
}
function packIntervalMs(dMs) {   // dynamisches Pruefintervall nach Restzeit
  if (dMs <= 30 * 60000) return 3 * 60000;
  if (dMs <= 60 * 60000) return 6 * 60000;
  if (dMs <= 6 * 3600000) return 30 * 60000;
  if (dMs <= 12 * 3600000) return 3600000;
  return 2 * 3600000;
}
function packTitle(a) { return "🐿️ " + a.line + " " + a.sn; }
function packMsgSet(a, txt, ts) { a.lastMsg = txt; a.lastMsgTs = ts || Date.now(); pkgMsgUpdate(); }
// Eigenes Nachrichtenfenster fuer diese Alarm-Art: EIN Fenster, das immer
// wieder verwendet und nur inhaltlich veraendert wird.
function pkgMsgEnsure() {
  let el = document.getElementById("pkgMsgWin");
  if (!el) {
    el = document.createElement("div");
    el.id = "pkgMsgWin";
    el.className = "pkgmsg";
    el.hidden = true;
    el.innerHTML = '<div class="pkgmsghead"><span>🐿️ Verbindungs-Wachposten</span>' +
      '<button class="pkgmsgx" title="Fenster schließen (Alarme bleiben gestellt)">✕</button></div>' +
      '<div class="pkgmsgbody"></div>';
    el.addEventListener("click", e => {
      if (e.target.closest(".pkgmsgx")) { el.hidden = true; return; }
      const stp = e.target.closest("[data-pkgo]");
      if (stp) { openPackDlg(null, packAlarms.find(x => x.id === stp.dataset.pkgo)); }
    });
    document.body.appendChild(el);
  }
  return el;
}
