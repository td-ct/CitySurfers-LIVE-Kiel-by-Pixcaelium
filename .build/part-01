  const allChk = wrap.querySelector('[data-sup="all"]');
  const syncAll = () => {
    const ins = [...wrap.querySelectorAll('[data-supgroup], [data-suprt], [data-supst], [data-supmm]')];
    allChk.checked = ins.length > 0 && ins.every(x => x.checked);
  };
  wrap.addEventListener("change", e => {
    const t = e.target;
    if (t.id === "supConfirm") { goBtn.disabled = !t.checked; return; }
    if (t === allChk) {
      wrap.querySelectorAll('[data-supgroup], [data-suprt], [data-supst], [data-supmm]').forEach(x => x.checked = allChk.checked);
      return;
    }
    if (t.getAttribute("data-supgroup") === "rtab")
      wrap.querySelectorAll("[data-suprt]").forEach(x => x.checked = t.checked);
    if (t.getAttribute("data-supgroup") === "stab")
      wrap.querySelectorAll("[data-supst]").forEach(x => x.checked = t.checked);
    if (t.getAttribute("data-supgroup") === "mtab")   // v1.4.15: MM-Reiter-Gruppe
      wrap.querySelectorAll("[data-supmm]").forEach(x => x.checked = t.checked);
    syncAll();
  });
