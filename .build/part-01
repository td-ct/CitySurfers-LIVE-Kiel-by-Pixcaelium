    "</div>" +
    '<div class="dlabel">Gesetzte 🐿️-Alarme</div>' +
    '<div class="pkglist"></div>' +
    '<div class="dbtns">' +
      '<button class="pkcancel">' + (a ? "🗑 Löschen" : "Abbrechen") + "</button>" +
      '<button class="aok" disabled>' + (a ? "🐿️ Ändern" : "🐿️ Alarm setzen") + "</button>" +
    "</div></div>";
  document.body.appendChild(wrap);
  const tbl = wrap.querySelector(".pkgtable");
  const lst = wrap.querySelector(".pkglist");
  const okBtn = wrap.querySelector(".aok");
  const schedEl = wrap.querySelector(".pkgsched");
  let sched = null;   // { days: [ [ {t,ms} ] x7 ] }
  function renderList() {
    const h = packAlarms.map(x => {
      const days = (x.on || []).map((b, i) => b ? PACK_DAYS[i] : null).filter(Boolean).join(", ") || "kein Tag";
      return '<div class="pkgrow' + (a && x.id === a.id ? " on" : "") + '" data-pkopen="' + escapeHtml(x.id) + '">' +
