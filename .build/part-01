// Panels-Klicks (↻ und Buslinien)
stationPanel.addEventListener("click", e => {
  if (e.target.closest(".ricon")) return;   // Route-Icon: nur Routing-Link oeffnen
  const pkchip = e.target.closest(".pkgchip");   // v1.6.31: 🐿️-Alarm regelmäßige Verbindung
  if (pkchip) {
    openPackDlg({ sn: pkchip.dataset.pkgsn, line: pkchip.dataset.pkgline,
      dir: pkchip.dataset.pkgdir, time: pkchip.dataset.pkgtime });
    return;
  }
  const star = e.target.closest("[data-star]");
  if (star) { toggleFavSn(star.dataset.star); renderPanels(); return; }
  const later = e.target.closest("[data-later]");
  if (later) { laterDeps(later.dataset.later); return; }
  const earlier = e.target.closest("[data-earlier]");

  if (earlier) { earlierDeps(earlier.dataset.earlier); return; }
  const dg = e.target.closest("[data-depgps]");
  if (dg) { depGpsToggle(); return; }
  const ref = e.target.closest("[data-ref]");
  if (ref) {   // ↻ sitzt jetzt in der Kopfzeile
    if (refetchGateOk("ref:" + ref.dataset.ref)) refetchStop(ref.dataset.ref, true);
    else setLocNote("↻ zuletzt vor wenigen Sekunden gedrückt – frühestens in 5 Sekunden wieder.");
    return;
  }
  const ssec = e.target.closest("[data-ssec]");
  if (ssec) {
    stationPanelOpen = !stationPanelOpen;   // zugeklappt = eingefroren
    renderStationPanel();
    return;
  }
  const bl = e.target.closest("[data-buslink]");
  if (bl) {
    const [lSn, lId] = bl.dataset.buslink.split("~");
    selectBus(lSn, lId);        // Stationsansicht
    selectTrip(lSn, lId);       // Fahrtverlauf (beide Blöcke aufgetaut)
    return;
  }
  const bus = e.target.closest("[data-bus]");
  if (bus) {
    const [sn, tripId] = bus.dataset.bus.split("~");
    selectBus(sn, tripId);
  }
});
busPanel.addEventListener("click", e => {
  const btx = e.target.closest("[data-btx]");
  if (btx) { closeTripTab(Number(btx.dataset.btx)); return; }
