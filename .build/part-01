  });
  wrap.addEventListener("change", e => {
    const c = e.target.closest("[data-pkc]");
    if (c) {
      const i = Number(c.dataset.pkc);
      cur.on[i] = c.checked;
      if (c.checked && !cur.days[i]) c.checked = false;   // ohne Uhrzeit kein Haken
      renderRows();
