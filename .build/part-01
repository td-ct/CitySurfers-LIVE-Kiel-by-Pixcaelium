        lid: null, schedTs: 0, lastCheck: 0, lastMsg: "", lastMsgTs: 0, firedFor: ""
      };
      Object.assign(base, {
        sn: cur.sn, name: cur.name, line: cur.line, dir: cur.dir,
        days: cur.days.slice(), on: cur.on.map((b, i) => !!(b && cur.days[i])),
        win: cur.win, vib: !!(vib && vib.checked), tone: !!(tone && tone.checked),
        snd: snd ? snd.value : cfg.snd, vol: vol ? Number(vol.value) : cfg.vol
      });
