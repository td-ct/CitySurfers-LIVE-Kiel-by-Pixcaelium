    s = { shortName: h.shortName, name: h.name || "", lat: h.lat, lon: h.lon,
      lid: h.lid || "", extId: h.extId || "", svc: h.svc || svcForCoords(h.lat, h.lon),
      rId: h.rId || null, rs: true };
