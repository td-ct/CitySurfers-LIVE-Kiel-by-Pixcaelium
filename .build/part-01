// ---------- Kontinuierlicher GPS-Fortschritt: Projektion auf Strecken (rein) ----------
// Laengs-Anteil 0..1 von pos auf der Geraden a->b (geclampt); null ohne Koordinaten.
function segFrac(a, b, pos) {
  if (!a || !b || !pos || a.lat == null || b.lat == null) return null;
  const dl = b.lat - a.lat, dn = (b.lon || 0) - (a.lon || 0);
  const den = dl * dl + dn * dn;
  if (den < 1e-18) return null;
  let t = ((pos.lat - a.lat) * dl + ((pos.lon || 0) - (a.lon || 0)) * dn) / den;
  return t < 0 ? 0 : t > 1 ? 1 : t;
}
// Projektion auf einen Polygonzug (Stationen einer Fahrt): nextliegendes
// Segment, Anteil ueber die Gesamtlaenge. Rueckgabe { frac: 0..1, d: m }.
function polyFrac(pts, pos) {
  const p = (pts || []).filter(q => q && q.lat != null && q.lon != null);
  if (!pos || p.length < 2) return null;
  const dms = [];
  let total = 0;
  for (let i = 1; i < p.length; i++) { const dm = dist(p[i - 1], p[i]); dms.push(dm); total += dm; }
  if (total < 1) return { frac: 0, d: dist(pos, p[0]) };
  let cum = 0, best = null;
  for (let i = 1; i < p.length; i++) {
    const t = segFrac(p[i - 1], p[i], pos);
    if (t != null) {
      const proj = { lat: p[i - 1].lat + (p[i].lat - p[i - 1].lat) * t,
                     lon: p[i - 1].lon + (p[i].lon - p[i - 1].lon) * t };
      const d = dist(proj, pos);
      if (best == null || d < best.d) best = { d: d, frac: (cum + t * dms[i - 1]) / total };
    }
    cum += dms[i - 1];
  }
  return best || { frac: 0, d: dist(pos, p[0]) };
}
