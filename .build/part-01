let stationPanelOpen = true;   // Haltestellen-Übersicht: zugeklappt = eingefroren
let stationPanelCache = "";
// Abfahrten: abfahrtszeit-basiert – kein Erreichbarkeits-Filter mehr (v1.2.30).
// GPS-Knopf daneben: Position nur für Abfahrten + Stationsübersicht (depGps).
