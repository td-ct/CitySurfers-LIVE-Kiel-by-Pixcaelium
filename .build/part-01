  let body = "";
  if (v && v.atHm) {   // v1.6.36: Zeit-Anker gesetzt - Liste ab gewählter Uhrzeit
    if (!v.atDeps && !v.atLoading && (!v.atTs || Date.now() - v.atTs > 600000))
      fetchAtDeps(currentStop.shortName);   // 10-min-Frische wie die Plan-Fahrten
    if (v.atLoading)
      body += '<small class="rowinfo dim">Abfahrten ab ' + escapeHtml(v.atHm) + ' Uhr werden geladen …</small>';
    else if (v.atErr)
