function selectBus(sn, tripId) {
  const i = tabs.findIndex(t => t.sn === sn);
  if (i < 0) openTab(sn);                       // Reiter fehlt: öffnen
  else if (i !== activeTab) activateTab(i, false);
  const t = tabs[activeTab];
  if (!t.trips) t.trips = [];
  let bi = t.trips.findIndex(b => b.tripId === tripId);
  if (bi < 0) {
    // Unter-Reiter-Titel vorab: Abfahrtszeit an der geklickten Station; sobald der
    // Fahrtverlauf geladen ist, steht dort die Abfahrtszeit an der ersten Station
    const dep = findDepOf(sn, tripId);   // auch geplante/„früher“-Einträge: deren Zeit als Unter-Reiter-Titel
    t.trips.push({ sn: sn, tripId: tripId, stationOpen: true, tripOpen: false,
      time: (dep && (dep.actualTime || dep.plannedTime)) || "", trip: null });
    bi = t.trips.length - 1;
  }
  t.activeTrip = bi;
  currentBus = t.trips[bi];
  currentTrip = currentBus.trip || null;
  const stop = stops.find(s => s.shortName === sn);
  if (stop) currentStop = stop;
  renderTabs();
  renderPanels();
}

// Unter-Reiter der Fahrten im Bus-Panel: umschalten bzw. schließen (✕).
