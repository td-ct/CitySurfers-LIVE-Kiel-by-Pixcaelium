// ---------- Haltestellensuche: ab 1 Buchstabe, Wortanfang, Tippfehler-Toleranz ----------
function wordsOf(name) {
  return name.toLowerCase().split(/[^a-zäöüß0-9]+/).filter(Boolean);
}
function lev1(a, b) {   // true, wenn max. 1 Buchstabe fehlt/falsch/zu viel ist
  if (a === b) return true;
  if (Math.abs(a.length - b.length) > 1) return false;
  let i = 0, j = 0, diff = 0;
  while (i < a.length && j < b.length) {
    if (a[i] === b[j]) { i++; j++; continue; }
    if (++diff > 1) return false;
    if (a.length > b.length) i++;
    else if (b.length > a.length) j++;
    else { i++; j++; }
  }
  return true;
}
function searchHits(q) {
  const qs = q.toLowerCase().split(/\s+/).filter(Boolean);
  const startHits = [], subHits = [], typoHits = [];
  for (const s of stops) {
    const name = s.name.toLowerCase();
    const words = wordsOf(s.name);
    let tier = -1;   // bester Rang über alle Suchwörter
    let ok = true;
    for (const qw of qs) {
      let t = -1;
      if (name.startsWith(qw) || s.shortName.toLowerCase().startsWith(qw)) t = 0;
      else if (words.some(w => w.startsWith(qw))) t = 0;
      else if (qw.length >= 3) {
        if (name.includes(qw)) t = 1;
        else if (words.some(w => (w.length >= qw.length - 1 && w.length <= qw.length + 1 && lev1(w, qw)) ||
                                lev1(w.slice(0, qw.length), qw))) t = 2;
      }
      if (t < 0) { ok = false; break; }   // ein Suchwort passt nicht: raus
      tier = Math.max(tier, t);
    }
    if (!ok) continue;
    (tier === 0 ? startHits : tier === 1 ? subHits : typoHits).push({ s: s, tier: tier });
  }
  return [...startHits, ...subHits, ...typoHits];
}

// Liste in 10er-Schritten rendern: erst die nächsten/vordersten Stationen,
// weitere Zeilen entstehen erst beim Scrollen (spart Renderzeit und Abfragen)
let sugHits = [], sugRendered = 0;
// v1.4.14: Donkey-Leihstationen (🚲) als eigene Treffer der Haltestellen-Suche:
// gefiltert wie die Haltestellen (Wortanfang vor enthält) und gemeinsam mit
// ihnen sortiert; je Zeile die Anzahl der dort stehenden freien Räder. Der Feed
// wird beim ersten Bedarf geladen, danach aus dem Donkey-Cache gezeichnet.
let mmSugDkTs = 0;
function mmSugStations(q) {
  const d = donkeyCache && donkeyCache.d;
  if (!d || !Array.isArray(d.s)) { mmSugWarmDonkey(); return []; }
  const ql = (q || "").toLowerCase();
  const out = [];
  for (const s of d.s) {
    if (!s || s.lat == null || s.lon == null) continue;
    const nm = String(s.name || "").toLowerCase();
    const tier = !ql ? 0 : nm.indexOf(ql) === 0 ? 0 : nm.indexOf(ql) >= 0 ? 1 : -1;
    if (tier < 0) continue;
    // v1.4.18: Zähler je Station für die zweite Trefferzeile: freie E-Bikes mit
    // mindestens 40 % Akkustand und freie Standardräder (alle Werte nur freie Räder)
    let nBikes = 0, nEb40 = 0, nBstd = 0;
    for (const v of (d.v || [])) {
      if (!v || v.st !== s.id || (v.t !== "bike" && v.t !== "ebike") || v.rs || v.dis) continue;
      nBikes++;
      if (v.t === "ebike") { if (v.fu != null && v.fu >= 40) nEb40++; }
      else nBstd++;
    }
    out.push({ dk: true, id: s.id, name: s.name || "Leihstation", lat: s.lat, lon: s.lon,
      cap: s.cap != null ? s.cap : null, tier: tier, nBikes: nBikes, nEb40: nEb40, nBstd: nBstd });
  }
  return out;
}
function mmSugWarmDonkey() {   // Feed einmal laden und die Trefferliste dann neu aufbauen
  if (donkeyCache && donkeyCache.d) return;
  const now = Date.now();
  if (now - mmSugDkTs < 60000) return;   // Proxy nicht erreichbar: nur einmal pro Minute erneut probieren
  mmSugDkTs = now;
  donkeyData(true).then(ok => { if (ok && !sugBox.hidden) updateSuggestions(); });
}
function rowHTML(s, pos) {
  if (s && s.rs) return rsRowHTML(s, pos);   // v1.5.0: Fern-Station (LocMatch-Treffer auswärts, eigener Reiter)
  if (s && s.dk) {   // v1.4.14: Donkey-Leihstation: eigenes Symbol, eigener Reiter (kein Haltestellen-Enrich)
