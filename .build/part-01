/* v1.5.0 REM-START: Fern-Stationen in der Stationssuche (bundesweit über
   NAH.SH-LocMatch) und regionale Live-Dienste (Facelift-System).
   Ab drei Buchstaben fragt die Stationssuche zusätzlich den NAH.SH-Stations-
   finder ab; Treffer außerhalb Kiels erscheinen als eigene Fern-Stations-
   Zeilen (🚏-Symbol, Name, Luftlinie, Kurzzeichen des Live-Dienstes) unter
   den Kieler Treffern. Antippen öffnet einen Stations-Reiter, dessen
   Abfahrten zuerst den regionalen Live-Dienst der Region fragen
   (VBB Berlin/Brandenburg, VVS Raum Stuttgart, DVB Dresden; Kiel läuft
   wie gehabt direkt über die KVG) und sonst über den deutschlandweiten
   Fallback (NAH.SH-HAFAS) laufen: Fahrplan bundesweit, Echtzeit, soweit
   der Regionaldienst sie nicht selbst hergibt. */
const RS_PREFIX = "RS:";          // Kennzeichen einer Fern-Station im Reiter-System
const RS_MIN_CHARS = 3;           // ab so vielen Buchstaben wird LocMatch gefragt
const RS_MAX_HITS = 6;            // höchstens so viele Fern-Stationen je Suche
const RS_CACHE_TTL = 600000;      // LocMatch-Treffer 10 Minuten im Cache (Rate-Schutz)
const RS_SVC_LABEL = { nahsh: "nah.sh", vbb: "VBB", vvs: "VVS", mvv: "MVV", dvb: "DVB" };
function svcForCoords(lat, lon) {   // Facelift: regionaler Live-Dienst je Grob-BBox, sonst nah.sh
  if (lat >= 51.2 && lat <= 53.7 && lon >= 11.1 && lon <= 14.9) return "vbb";   // Berlin/Brandenburg
  if (lat >= 47.9 && lat <= 49.5 && lon >= 8.6  && lon <= 10.4) return "vvs";   // Stuttgart-Region
  if (lat >= 47.75 && lat <= 48.6 && lon >= 10.95 && lon <= 12.15) return "mvv";   // München und Umland (Freising bis Ebersberg, ohne Augsburg)
  if (lat >= 50.8 && lat <= 51.3 && lon >= 13.0 && lon <= 14.3) return "dvb";   // Raum Dresden
  return "nahsh";
}
const isRS = sn => String(sn || "").indexOf(RS_PREFIX) === 0;
const remoteStops = new Map();    // "RS:<extId>" -> Fern-Station {shortName,name,lat,lon,lid,extId,svc,rId}
const rsSearchCache = new Map();  // Suchtext (klein) -> { hits: [Fern-Station], ts }
let rsSearchTimer = null, rsSearchSeq = 0;
// Kiels DB-Stationen stecken schon fest in der Liste: deren NAH.SH-ExtIds nicht doppeln
const RS_KNOWN_EXT = new Set((DB_STOPS || []).map(d => {
  const m = String(d.lid || "").match(/@L=(\d+)/);
  return m ? m[1] : null;
}).filter(Boolean));
function rsNorm(s) {   // eingabefest normalisieren (Kleinbuchstaben, nur Buchstaben/Ziffern)
  return String(s || "").toLowerCase().replace(/[^a-z0-9äöüß]/g, "");
}
function rsFold(s) {   // zusätzlich Umlaute/transkribierte Formen angleichen (muenchen = münchen)
  return rsNorm(s).replace(/ü/g, "u").replace(/ö/g, "o").replace(/ä/g, "a").replace(/ß/g, "s")
    .replace(/ue/g, "u").replace(/oe/g, "o").replace(/ae/g, "a").replace(/ss/g, "s");
}
function rsNormalizeHit(h) {   // LocMatch-/gespeicherter Treffer -> Station im Register (einmalig)
  let s = remoteStops.get(h.shortName);
  if (!s) {
    s = { shortName: h.shortName, name: h.name || "", lat: h.lat, lon: h.lon,
      lid: h.lid || "", extId: h.extId || "", svc: h.svc || svcForCoords(h.lat, h.lon),
      rId: h.rId || null, rs: true };
    remoteStops.set(h.shortName, s);
  } else {
    if (h.name) s.name = h.name;
    if (h.lat != null) s.lat = h.lat;
    if (h.lon != null) s.lon = h.lon;
    if (h.lid) s.lid = h.lid;
    if (h.svc) s.svc = h.svc;
    if (h.rId) s.rId = h.rId;
  }
  return s;
}
function rsRowHTML(s, pos) {   // v1.5.0: zweizeilige Fern-Stations-Zeile mit Kurzzeichen rechts
  const meta = [];
  if (pos) {
    const air = dist(pos, s) * 1.3;
    meta.push("~" + formatDist(air) + " · ~" + Math.ceil(air / (WALK_SPEED_KMH * 1000 / 60)) + " min (Luftlinie)");
  }
  meta.push("Fern-Station");
  return '<div data-rs="' + escapeHtml(s.shortName) + '" title="Fern-Station öffnen: Live-Abfahrten über ' +
    escapeHtml(RS_SVC_LABEL[s.svc] || "nah.sh") + ' (regionale Quelle zuerst, sonst nah.sh-Fallback)">' +
    '<div class="srow"><span class="sname">🚏 ' + escapeHtml(s.name) + "</span>" +
    '<span class="srowact">' +
    routeIconHTML(s, "Fern-Station an eine externe Karten-App übergeben") +
    '<span class="regsvc d' + (s.svc || "nahsh") + '" title="Live-Dienst: ' + escapeHtml(RS_SVC_LABEL[s.svc] || "nah.sh") + '">' +
    escapeHtml(RS_SVC_LABEL[s.svc] || "nah.sh") + "</span></span></div>" +
    '<div class="srowmeta">' + escapeHtml(meta.join(" · ")) + "</div>" +
    "</div>";
}
async function rsSearch(q) {   // NAH.SH-LocMatch deutschlandweit (nur Stationen), gecached
  q = String(q || "").trim();
  if (q.length < RS_MIN_CHARS || listMode === "flat") return;
  const key = q.toLowerCase();
  const c = rsSearchCache.get(key);
  if (c) { if (!sugBox.hidden) updateSuggestions(); return; }   // Cache (auch leer) genügt
  const seq = ++rsSearchSeq;
  try {
    const res = await routeHafas("LocMatch", { input: { field: "S", loc: { name: q, type: "S" } } });
    if (seq !== rsSearchSeq) return;
    const hits = [], seen = new Set();
    const qF = rsFold(q);
    for (const x of ((res.match && res.match.locL) || [])) {
      if (!x || x.type !== "S" || !x.lid || seen.has(x.lid)) continue;
      seen.add(x.lid);
      const extM = String(x.lid).match(/@L=(\d+)/);
      const crd = x.crd || {};
      if (!extM || !/^\d+$/.test(extM[1]) || crd.y == null || crd.x == null) continue;
      const nm = String(x.name || "").replace(/…/g, "").trim();
      if (!nm) continue;
      if (qF && rsFold(nm).indexOf(qF) < 0) continue;   // nur Treffer, die zur Eingabe passen
      const lat = crd.y / 1e6, lon = crd.x / 1e6;
      if (RS_KNOWN_EXT.has(extM[1])) continue;   // Kiels DB-Stationen stecken schon fest in der Liste
      let dup = false;   // Doppelung zu Kieler Haltestellen in unmittelbarer Nähe vermeiden
      for (const st of stops) {
        if (isRS(st.shortName) || st.lat == null || st.lon == null) continue;
        if (dist(st, { lat: lat, lon: lon }) < 400 &&
            rsFold(st.name).slice(0, 5) === rsFold(nm).slice(0, 5)) { dup = true; break; }
      }
      if (dup) continue;
      hits.push(rsNormalizeHit({ shortName: RS_PREFIX + extM[1], name: nm, lat: lat, lon: lon,
        lid: String(x.lid), extId: extM[1] }));
      if (hits.length >= RS_MAX_HITS) break;
    }
    if (rsSearchCache.size > 40) {   // Cache begrenzen
      const k0 = rsSearchCache.keys().next().value;
      if (k0 != null) rsSearchCache.delete(k0);
    }
    rsSearchCache.set(key, { hits: hits, ts: Date.now() });
    if (seq === rsSearchSeq && !sugBox.hidden &&
        String(search.value || "").trim().toLowerCase() === key) updateSuggestions();
  } catch (e) {   // LocMatch nicht erreichbar: still bleiben (Kiel-Treffer funktionieren weiter)
    if (seq === rsSearchSeq) rsSearchCache.set(key, { hits: [], ts: Date.now() });
  }
}
search.addEventListener("input", () => {   // v1.5.0: Fern-Suche entprellt hinter der lokalen Suche her
  clearTimeout(rsSearchTimer);
  rsSearchTimer = setTimeout(() => rsSearch((search.value || "").trim()), 400);
});
/* v1.6.34: Aktive Adresse weit weg von Kiel - Fern-Stationen in ihrem Umkreis
 * automatisch nachladen (LocMatch mit dem Ort aus dem Adresslabel), damit die
 * Liste bei einer Hamburger Adresse auch den Hamburger Hbf zeigt statt nur
 * der 100 km entfernten Kieler Haltestellen (Timo-Befund 26.11.2026 abends). */
const RS_ADDR_MIN_KM = 15;     // naechster Kiel-Halt weiter als das: Umkreissuche starten
const RS_ADDR_NEAR_KM = 30;    // nur Fern-Stationen in diesem Radius um die Adresse
const RS_ADDR_MAX_HITS = 8;    // Treffer je Adresse
function rsAddrCityOf(label) {   // Ort aus Adresslabel ("Strasse 5, 20095 Hamburg" -> "Hamburg")
  const seg = String(label || "").split(",").map(s => s.trim()).filter(Boolean);
  for (let i = seg.length - 1; i >= 0; i--) {
    const c = seg[i].replace(/^\s*(plz\s+)?\d{4,5}\s+/i, "").trim();
    if (c && !/^\d/.test(c)) return c.slice(0, 40);
  }
  return "";
}
function rsAddrCacheKey(addr) {   // grob gerastert (ca. 1 km): eine Suche je Standort-Grobzelle
  return "addr:" + (Math.round(addr.lat * 100) / 100) + "," + (Math.round(addr.lon * 100) / 100);
}
function rsAddrNearHits(addr) {   // gecachte Treffer der Umkreissuche (oder [])
  if (!addr) return [];
  const c = rsSearchCache.get(rsAddrCacheKey(addr));
  return (c && c.addr && Date.now() - c.ts < RS_CACHE_TTL) ? c.hits : [];
}
async function rsAddrNear(addr) {   // LocMatch mit dem Ort der Adresse + Umkreis-Filter
  if (!addr || addr.gps || listMode === "flat") return;
  if (addr.lat == null || addr.lon == null) return;
  let dmin = Infinity;   // Entfernung zum naechsten Kiel-Halt (ohne Fern-Stationen)
  for (const st of stops) {
    if (isRS(st.shortName) || st.lat == null || st.lon == null) continue;
    const d = dist(addr, st);
    if (d < dmin) dmin = d;
  }
  if (dmin <= RS_ADDR_MIN_KM * 1000) return;   // Kiel-Umfeld: lokale Liste reicht
  const key = rsAddrCacheKey(addr);
  if (rsSearchCache.get(key)) return;   // laeuft schon oder lief (auch leer: 10 min Ruhe)
  rsSearchCache.set(key, { hits: [], ts: Date.now(), addr: true });
  const q = rsAddrCityOf(addr.label);
  if (q.length < RS_MIN_CHARS) return;
  try {
    const res = await routeHafas("LocMatch", { input: { field: "S", loc: { name: q, type: "S" } } });
    const hits = [], seen = new Set();
    for (const x of ((res.match && res.match.locL) || [])) {
      if (!x || x.type !== "S" || !x.lid || seen.has(x.lid)) continue;
      seen.add(x.lid);
      const extM = String(x.lid).match(/@L=(\d+)/);
      const crd = x.crd || {};
      if (!extM || !/^\d+$/.test(extM[1]) || crd.y == null || crd.x == null) continue;
      const nm = String(x.name || "").replace(/…/g, "").trim();
      if (!nm) continue;
      const lat = crd.y / 1e6, lon = crd.x / 1e6;
      if (dist(addr, { lat: lat, lon: lon }) > RS_ADDR_NEAR_KM * 1000) continue;   // Umkreis
      if (RS_KNOWN_EXT.has(extM[1])) continue;   // Kiels DB-Stationen stecken schon fest in der Liste
      let dup = false;
      for (const st of stops) {
        if (isRS(st.shortName) || st.lat == null || st.lon == null) continue;
        if (dist(st, { lat: lat, lon: lon }) < 400 &&
            rsFold(st.name).slice(0, 5) === rsFold(nm).slice(0, 5)) { dup = true; break; }
      }
      if (dup) continue;
      hits.push(rsNormalizeHit({ shortName: RS_PREFIX + extM[1], name: nm, lat: lat, lon: lon,
        lid: String(x.lid), extId: extM[1] }));
      if (hits.length >= RS_ADDR_MAX_HITS) break;
    }
    hits.sort((a, b) => dist(addr, a) - dist(addr, b));   // naechste Station der Adresse zuerst
    rsSearchCache.set(key, { hits: hits, ts: Date.now(), addr: true });
    if (listPos() === addr && !sugBox.hidden && !String(search.value || "").trim())
      updateSuggestions();   // Liste steht schon offen: Treffer sofort einmischen
  } catch (e) {   // LocMatch nicht erreichbar: still bleiben, 10 min nicht erneut probieren
    rsSearchCache.set(key, { hits: [], ts: Date.now(), addr: true });
  }
}
function openRemoteTab(s) {   // v1.5.0: Fern-Station als eigener Reiter (wie selectStop)
  if (!s) return;
  sugBox.hidden = true;
  search.value = s.name;
  updateStopClear();
  const i = tabs.findIndex(t => t.sn === s.shortName);
  if (i < 0) {
    tabs.push({ sn: s.shortName, name: s.name, trips: [], activeTrip: -1,
      uid: newTabUid(), remote: s });
    activateTab(tabs.length - 1);
  } else {
    tabs[i].remote = s;
    activateTab(i);
  }
}
function rsRestoreTab(t) {   // v1.5.0: gespeicherten Fern-Stations-Reiter nach Neustart/Import wiederherstellen
  const r = t.remote || {};
  const sn = t.sn || r.shortName;
  if (!sn || !isRS(sn)) return;
  const s = rsNormalizeHit({ shortName: sn, name: r.name || t.name || "",
    lat: r.lat, lon: r.lon, lid: r.lid || "", extId: r.extId || String(sn).slice(RS_PREFIX.length),
    svc: r.svc, rId: r.rId || null });
  if (!tabs.some(x => x.sn === s.shortName))
    tabs.push({ sn: s.shortName, name: t.name || s.name, uid: t.uid || newTabUid(),
      trips: [], activeTrip: -1, remote: s });
}
/* REM-END */
function updateSuggestions() {
  searchIndex = -1;
  updateGpsBtns();   // GPS-Knöpfe stets zuerst prüfen (gelb, wenn die Position weggewandert ist)
  if (!stops.length) { sugBox.hidden = true; return; }
  if (listMode === "flat") { sugHits = []; sugRendered = 0; buildFlatList(); return; }
  const pos = listPos();
  const q = search.value.trim().toLowerCase();
  let hits = q.length ? searchHits(q).filter(h => sugTypeAllowed(h.s))          // v1.4.18: Quellen-Filter
    : stops.map(s => ({ s: s, tier: 0 })).filter(h => sugTypeAllowed(h.s));
  if (sugDkOn())    // v1.4.18: Donkey-Zeilen nur bei freigegebenem MM-Filter (alles aus = alles an)
    hits = hits.concat(mmSugStations(q).map(s => ({ s: s, tier: s.tier })));   // v1.4.14: Donkey-Leihstationen (🚲) mit in die Trefferliste
  if (q.length >= RS_MIN_CHARS) {   // v1.5.0: Fern-Stationen aus dem LocMatch-Cache, ganz unten in der Liste
    const rc = rsSearchCache.get(q);
    if (rc && rc.hits.length)
      hits = hits.concat(rc.hits.filter(sugTypeAllowed).map(s => ({ s: s, tier: 2 })));
  }
  if (!q.length && addrPos && pos === addrPos) {   // v1.6.34: aktive Adresse = Listen-Ursprung
    const ah = rsAddrNearHits(addrPos);   // Fern-Stationen um die Adresse, Distanz-Sortierung gilt
    if (ah.length) hits = hits.concat(ah.filter(sugTypeAllowed).map(s => ({ s: s, tier: 0 })));
    rsAddrNear(addrPos);   // ggf. erst suchen (fire-and-forget, Cache schuetzt)
  }
  if (!hits.length) { sugBox.hidden = true; return; }
  if (pos && q.length) {
    // Suchtreffer: Haltestellenfavoriten zuerst (als ⭐ markiert), danach die
    // Relevanz-Stufe (Wortanfang vor enthält vor Tippfehler) und erst innerhalb
    // derselben Stufe nach Entfernung – die passendsten Treffer stehen oben.
    hits = hits.slice().sort((a, b) =>
      (favs.includes(a.s.shortName) ? 0 : 1) - (favs.includes(b.s.shortName) ? 0 : 1) ||
      a.tier - b.tier ||
      dist(pos, a.s) - dist(pos, b.s));
  } else if (pos) {
    hits = hits.slice().sort((a, b) => dist(pos, a.s) - dist(pos, b.s));
  }
  sugHits = hits.map(h => h.s);
  sugRendered = 0;
  sugBox.innerHTML = "";
  sugBox.hidden = false;
  sugBox.scrollTop = 0;
  renderMoreRows(SUGGEST_CHUNK_ROWS);   // die nächsten Treffer zuerst
  if (pos) enrichVisible(false);   // auch während der Suche laden
}

// Tastatursteuerung der Haltestellenliste – gilt für Fokus im Suchfeld
// oder Fokus auf einem Listeneintrag (mobiles Öffnen ohne Tastatur)
function handleSugNav(e) {
  const items = [...sugBox.querySelectorAll("div[data-sn], div[data-fsn], div[data-dk], div[data-rs]")];   // v1.5.0: auch Fern-Stationen
  if (sugBox.hidden || !items.length) return;
  if (e.key === "ArrowDown" || e.key === "ArrowUp") {
    e.preventDefault();
    searchIndex = e.key === "ArrowDown"
      ? Math.min(searchIndex + 1, items.length - 1)
      : Math.max(searchIndex - 1, 0);
    items.forEach((el, i) => el.classList.toggle("active", i === searchIndex));
    items[searchIndex].focus({ preventScroll: false });
    items[searchIndex].scrollIntoView({ block: "nearest" });
  } else if (e.key === "Enter") {
    const el = searchIndex >= 0 ? items[searchIndex] : items[0];
    if (el && el.dataset.ftrip) {   // Flachmodus-Zeile: Station + Buslinie
      const [fSn, fId] = el.dataset.ftrip.split("~");
      selectBus(fSn, fId);
      selectTrip(fSn, fId);
      sugBox.hidden = true;
      return;
    }
    if (el && el.dataset.dk) { openMMTabById(el.dataset.dk); sugBox.hidden = true; return; }   // v1.4.14: Donkey-Leihstation
    if (el && el.dataset.rs) { openRemoteTab(remoteStops.get(el.dataset.rs)); sugBox.hidden = true; return; }   // v1.5.0: Fern-Station
    if (el) selectStop(el.dataset.sn || el.dataset.fsn);
  } else if (e.key === "Escape") {
    sugBox.hidden = true;
  }
}

// ---------- Flachmodus der Haltestellensuche (⏱): Abfahrten in Laufweite ----------
// Alle Haltestellen, die in FLAT_WALK_MAX_MIN Minuten zu Fuß erreichbar sind,
// in einer Abfrage (OSRM-Tabelle) entfernen, deren Abfahrten der nächsten
// FLAT_DEP_MAX_MIN Minuten einsammeln und ALLE Treffer GEMEINSAM nach Fußweg
// zur Station sortieren (innerhalb derselben Station nach Abfahrtszeit) – ganz
// ohne Stationsüberschriften, die Station steht in jeder Zeile. Läuft derselbe
// Bus (tripId) an mehreren erreichbaren Stationen, bleibt nur die Verbindung
// mit dem kürzesten Fußweg stehen.
const FLAT_WALK_MAX_MIN = 15;      // Laufweite in Gehminuten
const FLAT_AIR_FACTOR = 1.3;      // Luftlinie × Faktor als Höchstwert für Kandidaten
const FLAT_MAX_STOPS = 20;        // Kandidaten vor der Fußweg-Abfrage (nächste zuerst)
const FLAT_REFRESH_MS = 45000;    // Abfahrten im Flachmodus so frisch halten
const FLAT_DEP_MAX_MIN = 30;      // nur Abfahrten der nächsten 30 Minuten zeigen
let listMode = "tree";            // "tree" = Hierarchie nach Haltestellen, "flat" = Laufweite
let flatBusy = false, flatTs = 0;
const listModeBtn = document.getElementById("listModeBtn");
listModeBtn.addEventListener("click", () => {
  listMode = listMode === "tree" ? "flat" : "tree";
  listModeBtn.textContent = listMode === "tree" ? "☰" : "⏱";
  listModeBtn.classList.toggle("active", listMode === "flat");
  listModeBtn.title = listMode === "tree"
    ? "Listenansicht wechseln: Hierarchisch (nach Haltestellen) oder Abfahrten in Laufweite (nächste 30 Minuten, gemeinsam nach Fußweg sortiert)"
    : "Listenansicht wechseln: zurück zur Hierarchie nach Haltestellen";
  searchIndex = -1;
  updateSuggestions();
});
async function buildFlatList() {
  if (flatBusy) return;
  flatBusy = true;
  flatTs = Date.now();
  try {
    const pos = listPos();
    sugBox.innerHTML = "";
    if (!pos) {
      sugBox.innerHTML = '<div class="srow"><span class="sname dim">Keine Position aktiv – für Abfahrten in Laufweite GPS antippen oder eine Adresse/Startpunkt einloggen.</span></div>';
      sugBox.hidden = false;
      return;
    }
    // Kandidaten: Luftlinie × 1.3 als Fußweg-Obergrenze, die nächsten 20
    const near = stops.map(s => ({ s: s, air: dist(pos, s) }))
      .filter(c => c.air * FLAT_AIR_FACTOR <= FLAT_WALK_MAX_MIN * WALK_SPEED_KMH * 1000 / 60)
      .sort((a, b) => a.air - b.air)
      .slice(0, FLAT_MAX_STOPS);
    // v1.4.18: Quellen-Filter gilt auch im ⏱-Laufweiten-Modus (der zeigt nur Busse und Bahnen)
    const cands = near.filter(c => sugTypeAllowed(c.s));
    if (!near.length) {
      sugBox.innerHTML = '<div class="srow"><span class="sname dim">Keine Haltestellen in ' + FLAT_WALK_MAX_MIN + ' Minuten Laufweite.</span></div>';
      sugBox.hidden = false;
      return;
    }
    if (!cands.length) {
      sugBox.innerHTML = '<div class="srow"><span class="sname dim">Die aktiven Filter schließen gerade alle Bus- und Bahn-Haltestellen aus; der ⏱-Modus zeigt nur Busse und Bahnen. Oben mindestens einen der Filter 🚆 DB oder 🚌 ÖPNV einschalten.</span></div>';
      sugBox.hidden = false;
      return;
    }
    sugBox.innerHTML = '<div class="srow"><span class="sname dim">Laufweite wird berechnet …</span></div>';
    sugBox.hidden = false;
    // echte Fußwege in einer Tabellen-Abfrage (OSRM)
    const footM = {};
    try {
      const url = FOOT_TABLE + "/" + pos.lon + "," + pos.lat + ";" +
        cands.map(c => c.s.lon + "," + c.s.lat).join(";") +
        "?sources=0&annotations=distance,duration";
      const res = await apiFetch("osrm", url);
      if (res.ok) {
        const data = await res.json();
        const ds = data.distances && data.distances[0];
        if (ds) cands.forEach((c, i) => {
          const m = ds[i + 1];
          if (m != null && m >= 0) footM[c.s.shortName] = m;
        });
      }
    } catch (e) {}
    // erreichbar: Fußweg (OSRM, sonst Schätzung) in Laufweite
    const reach = cands.map(c => ({
        s: c.s,
        footM: footM[c.s.shortName] != null ? footM[c.s.shortName] : c.air * FLAT_AIR_FACTOR
      }))
      .filter(c => c.footM / (WALK_SPEED_KMH * 1000 / 60) <= FLAT_WALK_MAX_MIN);
    if (!reach.length) {
      sugBox.innerHTML = '<div class="srow"><span class="sname dim">Keine Haltestellen in ' + FLAT_WALK_MAX_MIN + ' Minuten Laufweite.</span></div>';
      return;
    }
    // Abfahrtstafeln aller erreichbaren Stationen (Cache je Station umgehen)
    const rows = [];
    await Promise.all(reach.map(async c => {
      depCache.delete(c.s.shortName);
      const [deps, platforms] = await Promise.all([getDepartures(c.s.shortName), loadPlatforms(c.s.shortName)]);
      for (const d of (deps || [])) {
        if (d.actualRelativeTime == null || d.actualRelativeTime > FLAT_DEP_MAX_MIN * 60) continue;   // nur nächste 30 Minuten
        rows.push({
          sn: c.s.shortName, name: c.s.name, footM: c.footM,
          tripId: d.tripId, line: d.line, direction: d.direction,
          rel: d.actualRelativeTime, plat: platforms && platforms[d.tripId],
          status: d.status
        });
      }
    }));
    // Dedup: derselbe Bus (tripId) nur mit dem kürzesten Fußweg
    const best = {};
    for (const r of rows) {
      const prev = best[r.tripId];
      if (!prev || r.footM < prev.footM) best[r.tripId] = r;
    }
    const list = Object.values(best).sort((a, b) => a.footM - b.footM || a.rel - b.rel);   // gemeinsam nach Fußweg zur Station, dann Abfahrtszeit
    const walkSecOf = m => m / (WALK_SPEED_KMH * 1000 / 3600);
    let html = "";
    const now0 = Date.now();
    for (const r of list) {
      const losMin = Math.round((r.rel - (now0 - flatTs) / 1000 - walkSecOf(r.footM)) / 60);
      if (losMin < -2) continue;   // mehr als 2 Minuten abgefahren
      const t = new Date(now0 + r.rel * 1000);
      const clock = String(t.getHours()).padStart(2, "0") + ":" + String(t.getMinutes()).padStart(2, "0");
      const walkMin = Math.ceil(r.footM / (WALK_SPEED_KMH * 1000 / 60));
      html += '<div class="srow flatrow bl' + (losMin < 0 ? " missed" : (losMin <= 3 ? " soon" : "")) +
        '" data-fsn="' + escapeHtml(r.sn) + '" data-ftrip="' +
        escapeHtml(r.sn + "~" + r.tripId) + '" title="Station und Buslinie öffnen">' +
        '<span class="dl blink">' + escapeHtml(r.line) + "</span>" +
        (r.plat ? '<span class="plat">[' + escapeHtml(r.plat) + ']</span>' : "") +
        '<span class="mqwrap"><span class="mqi">' + escapeHtml(r.direction) +
          " (ab " + escapeHtml(r.name) + ")</span></span>" +
        '<span class="fdst">' + escapeHtml(formatDist(r.footM)) + " · " + walkMin + " min</span>" +
        '<span class="btime">' + clock + " · " +
        ((r.status === "PREDICTED" || r.status === "STOPPING") && !isDB(r.sn) &&
          (r.rel - (now0 - flatTs) / 1000) > 0 && (r.rel - (now0 - flatTs) / 1000) <= CD_MAX_S
          ? "fährt in " + cdSpan(flatTs + r.rel * 1000) + " min"
          : "los in " + losMin + " min") + "</span></div>";
    }
    sugBox.innerHTML = html || '<div class="srow"><span class="sname dim">Gerade keine Abfahrten in den nächsten ' + FLAT_DEP_MAX_MIN + ' Minuten.</span></div>';
    sugBox.hidden = false;
    marqueeify(sugBox);   // Lauftext: Fahrtrichtung + Abfahrtsstation gemeinsam lesbar
    flatHasCd = html.indexOf("data-cd") >= 0;   // OKW: mit Countdown dichter nachladen
  } finally {
    flatBusy = false;
  }
}
// Flachmodus: Abfahrten laufend frisch halten (nur solange die Liste offen ist)
let flatHasCd = false;  // sichtbarer Sekunden-Countdown → verkürztes Intervall
