// Ausloesung: laeut wie die anderen Wecker (Vibration/Weckton, bis ⏰/🔕 stoppt)
function firePack(a, txt) {
  const aKey = a.id;
  packMsgSet(a, "🚨 " + txt);
  pkgMsgEnsure().hidden = false;   // Popup NUR beim neu ausgeloeesten Alarm
  if (alarmsOff) return;   // globale Aus-Taste: nicht laeuten, Meldung steht im Fenster
  if (ringing.has(aKey)) return;
  firedAlarms.add(aKey);
  startRinging(aKey, { name: packTitle(a), vib: a.vib, tone: a.tone, vol: a.vol, snd: a.snd });
  setLocNote("🐿️ Eichhörnchen-Alarm: Linie " + a.line + " an " + (a.name || a.sn) + " – " + txt);
  renderTabs();
  renderAlarmInd();
}
// Eine Pruefung des naechsten Vorkommens: Echtzeit-Board um die Abfahrt,
// Abgleich mit der Planzeit; Verspaetung >= 1 min oder Ausfall -> Alarm.
async function packCheck(a) {
  const occ = packNextOcc(a);
  a.lastCheck = Date.now();
  if (!occ) return;
  try {
    const lid = await packLidOf(a);
    if (!lid) { packMsgSet(a, "⚠ Station nicht in nah.sh auflösbar – Prüfung nicht möglich."); return; }
    const entries = await nahshBoardEntries(lid, new Date(occ.ms - 90 * 60000), 511);
    const ln = followNormLine(a.line);
    let hit = entries.filter(e => followNormLine(e.line) === ln && packDirMatch(a.dir, e.direction));
    if (!hit.length) hit = entries.filter(e => followNormLine(e.line) === ln);
    const trip = hit.find(e => Math.abs(e.absMs - occ.ms) <= 2 * 60000);
    if (trip) {
      const dly = trip.hasRT ? packDiffMin(trip.plannedTime, trip.actualTime) : null;
      if (dly != null && dly >= 1) {
        if (a.firedFor !== occ.key) { a.firedFor = occ.key; savePackAlarms(); firePack(a, "Verspätung +" + dly + " min: Abfahrt jetzt ca. " + trip.actualTime + " Uhr."); }
        else packMsgSet(a, "🚨 Verspätung +" + dly + " min (bereits gemeldet).");
        return;
      }
      packMsgSet(a, "✓ pünktlich: Abfahrt " + occ.t + " Uhr an " + (a.name || a.sn) + " geprüft " +
        new Date().toTimeString().slice(0, 5) + ".");
    } else {
      const near = hit.filter(e => Math.abs(e.absMs - occ.ms) <= 45 * 60000);
      if (hit.length) {
        if (a.firedFor !== occ.key) { a.firedFor = occ.key; savePackAlarms();
          firePack(a, "Verbindung fällt aus: keine Abfahrt Linie " + a.line + " um " + occ.t + " Uhr" +
            (near.length ? " (die Linie fährt um " + near[0].plannedTime + " Uhr)" : "") + "."); }
        else packMsgSet(a, "🚨 Verbindung fällt aus (bereits gemeldet).");
      } else {
        packMsgSet(a, "⚠ Linie " + a.line + " um " + occ.t + " Uhr nicht im Board gefunden – Fahrplan prüfen.");
      }
    }
  } catch (err) {
    packMsgSet(a, "⚠ Prüfung fehlgeschlagen (Netzwerk/nah.sh?) – nächste Prüfung folgt automatisch.");
  }
}
// Ticker: alle 20 s faellige Prüfungen + ungefragte Fahrplan-Auffrischung
async function packTick() {
  const now = Date.now();
  for (const a of packAlarms) {
    if (!a.on || !a.on.some(x => x)) continue;
    try {
      if (!a.schedTs || now - a.schedTs > 12 * 3600000) {   // Fahrplan ungefragt wiederholen
        const sc = await packSchedOf(a, true);
        a.schedTs = sc.ts;
        if (sc.err) { packMsgSet(a, "⚠ Fahrplanabfrage fehlgeschlagen: " + sc.err + " – wird automatisch erneut versucht."); }
        else {
          // gewaehlte Uhrzeiten gegen den frischen Fahrplan halten
          let miss = 0;
          for (let i = 0; i < 7; i++) if (a.on[i] && a.days[i] &&
              !(sc.days[i] || []).some(e => e.t === a.days[i])) miss++;
          if (miss) packMsgSet(a, "⚠ " + miss + " aktive Abfahrtszeit(en) steht nicht mehr im aktuellen Fahrplan – bitte im 🐿️-Dialog anpassen.");
          else packMsgSet(a, "✓ Fahrplan aktuell (automatisch geprüft).");
        }
        savePackAlarms();
      }
      const occ = packNextOcc(a);
      if (!occ) continue;
      const dMs = occ.ms - now;
      if (dMs > (a.win || 60) * 60000) {   // noch vor dem Ueberwachungsfenster
        if (a.lastMsgTs && now - a.lastMsgTs < 36 * 3600000 && a.lastMsg.indexOf("✓") === 0) { /* nichts */ }
        continue;
      }
      if (now - (a.lastCheck || 0) >= packIntervalMs(dMs)) await packCheck(a);
    } catch (e) {}
  }
}
setInterval(() => { packTick(); }, 20000);
setTimeout(() => { pkgMsgUpdate(); }, 3000);   // nach Start einmal fuellen (versteckt; Popup nur bei Ausloesung)
