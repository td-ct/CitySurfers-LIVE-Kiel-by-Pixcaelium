// ---------- Glocke in der gewählten Route: Wecker für die GESAMT-Route ----------
// Stations-Liste der gewählten Route: alle Haltestellen aller Fahrzeug-Abschnitte
// in Fahrtrichtung gemeinsam (Zubringer haben keine Haltestellen). Jede Station
// wird auf eine KVG-/DB-Station abgebildet (exakter Name, sonst Koordinate
// <= 250 m); fremde Stationen bekommen ein Pseudo-sn UND die Koordinaten aus
// der Route mit, damit Distanz-Wecker und Geofence auch dort arbeiten.
function routeAlarmStations(rc) {
  const out = [];
  const con = rc && rc.con;
  const norm = s => String(s || "").toLowerCase().replace(/[^a-z0-9äöüß]/g, "");
  (con && con.secs || []).forEach(sec => {
    if (!sec || sec.kind !== "jny") return;
    const sts = sec.stops || [];   // die Segment-Liste bleibt immer die Basis (Erweiterung nur Anzeige)
    sts.forEach(st => {
      if (!st || st.name == null) return;
      const stN = norm(String(st.name).replace(/\s*\(DB\)\s*$/, ""));
      const byName = stops.find(s => norm(String(s.name || "").replace(/\s*\(DB\)\s*$/, "")) === stN);
      let sn = byName ? byName.shortName : null;
      if (!sn && st.lat != null && st.lon != null) {
        let best = null;
        for (const s of stops) {
          if (s.lat == null || s.lon == null) continue;
          const d = dist(st, s);
          if (d < 250 && (!best || d < best.d)) best = { s: s, d: d };
        }
        sn = best ? best.s.shortName : null;
      }
      if (!sn) sn = "N:" + stN;
      if (out.some(x => x.jid === sec.jid && x.sn === sn)) return;   // Durchgang im selben Lauf nur einmal
      out.push({ jid: sec.jid, tripId: "rt!" + sec.jid, sn: sn, name: String(st.name),
        lat: st.lat, lon: st.lon, rail: !!sec.rail,
        time: (st.dR || st.dS || st.aR || st.aS || "") });
    });
  });
  out.forEach(x => { x.aKey = x.tripId + "|" + x.sn; });
  return out;
}
