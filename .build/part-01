      (msg ? '<div class="' + (a.lastMsg.indexOf("⚠") === 0 || a.lastMsg.indexOf("🚨") === 0 ? "pkgwarn" : "dim") + '">' + escapeHtml(msg) + "</div>" : "") +
      "</div>";
