    const eb40 = s.nEb40 != null ? "⚡ " + s.nEb40 + " E-Bikes ≥ 40 % Akku" : "";
    const bstd = s.nBstd != null ? "🚲 " + s.nBstd + (s.nBstd === 1 ? " Standardrad" : " Standardräder") : "";
