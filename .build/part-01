    if (!lid) { v.atDeps = null; v.atErr = "Haltestelle im nah.sh-Fahrplan unbekannt."; }
    else {
      const raw = await nahshBoardEntries(lid, new Date(T - 60000), mask);
      v.atDeps = raw.filter(e => e.absMs >= T - 60000)
        .sort((a, b) => a.absMs - b.absMs).slice(0, 40).map(e => {
          const now = Date.now();
          return {
            tripId: e.tripId, line: e.line, direction: e.direction,
            plannedTime: e.plannedTime, actualTime: e.actualTime,
            status: e.hasRT ? "PREDICTED" : "PLANNED",
            actualRelativeTime: (e.absMs - now) / 1000,
            absMs: e.absMs, plat: e.plat || null, alerts: []
          };
        });
      v.atErr = null;
    }
  } catch (e) { v.atDeps = null; v.atErr = "Abfrage fehlgeschlagen (Netzwerk?)."; }
  v.atTs = Date.now();
  v.atLoading = false;
  renderPanels();
}
// Zeit-Auswahl setzen ("" = jetzt): Liste neu laden und anzeigen
function setDepAt(sn, hm) {
  const v = viewOf(sn);
  if (!v) return;
  v.atHm = hm || "";
  v.atDeps = null; v.atTs = 0; v.atErr = null;
  if (v.atHm) fetchAtDeps(sn);
  else { setLocNote("Abfahrten wieder ab jetzt."); renderPanels(); }
  renderViews();
}
function renderStationPanel() {
  if (!currentStop) { stationPanel.hidden = true; stationPanel.innerHTML = ""; return; }
