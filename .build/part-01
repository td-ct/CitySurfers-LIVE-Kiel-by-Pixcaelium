  if (!stops.length) { sugBox.hidden = true; return; }
  if (listMode === "flat") { sugHits = []; sugRendered = 0; buildFlatList(); return; }
  const pos = listPos();
  const q = search.value.trim().toLowerCase();
  let hits = q.length ? searchHits(q).filter(h => sugTypeAllowed(h.s))          // v1.4.18: Quellen-Filter
    : stops.map(s => ({ s: s, tier: 0 })).filter(h => sugTypeAllowed(h.s));
  if (sugDkOn())    // v1.4.18: Donkey-Zeilen nur bei freigegebenem MM-Filter (alles aus = alles an)
