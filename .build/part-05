        listEl().innerHTML = '<div class="rtrow"><span class="rtname" style="color:#94a3b8">Mindestens 3 Zeichen eingeben …</span></div>';
        return;
      }
      listEl().innerHTML = '<div class="rtrow"><span class="rtname" style="color:#94a3b8">Suche …</span></div>';
      const words = qv.toLowerCase().split(/\s+/).filter(Boolean);
      const pos = sink ? sinkPos() : pickOrigin(which);   // GPS-Sortierung dieses Feldes: Treffer nach Entfernung
      let found = addrFavs
        .filter(f => words.every(w => (f.name || "").toLowerCase().includes(w) || (f.label || "").toLowerCase().includes(w)))
        .map(f => ({ label: f.name, sub: (f.label && f.label !== f.name) ? f.label : "",
          kkind: "addr", key: "addr:" + f.name,
          name: f.label || f.name, lat: f.lat, lon: f.lon, star: "⭐ ",
          distTxt: (pos && f.lat != null) ? formatDist(dist(pos, f)) : "" }));
      found.sort((a, b) => pos ? dist(pos, a) - dist(pos, b) : String(a.label).localeCompare(String(b.label), "de"));
      try {
        const u = await unifiedAddrSearch(qv);   // OSM + NAH.SH, gemergte Treffer
        if (!u || (input.value || "").trim() !== qv) return;   // Eingabe inzwischen geändert
        found = found.concat(u.list.map(e => ({
          label: e.label, kkind: "addr", key: null, name: e.label,
          lat: e.lat, lon: e.lon, nahsh: e.nahsh || null, src: e.src, dPair: e.dPair,
          sub: addrSrcBadge(e) })));
      } catch (e) {}
      if ((input.value || "").trim() === qv) rows(found);   // nur bei noch aktuellem Text
    };
    input.addEventListener("input", () => { clearTimeout(timer); timer = setTimeout(upd, 700); });   // NAH.SH-Gate: Abstand zwischen Anfragen
    listEl().innerHTML = '<div class="rtrow"><span class="rtname" style="color:#94a3b8">Adresse eingeben – gespeicherte Favoriten erscheinen zuerst.</span></div>';
  }
  routePickRefreshFn = () => {   // GPS-Update: Chip-Zustand + Liste des offenen Dialogs nachziehen
    if (!document.body.contains(wrap)) return;
    const chip = wrap.querySelector("[data-rpickgps]");
    if (chip) {
      chip.className = "achip rtgps" + gpsBtnCls(routePickGpsState(which));
      chip.title = routePickGpsTitle(which);
    }
    refreshList();
  };
  wrap.addEventListener("click", e => {
    if (e.target === wrap || e.target.closest(".acancel")) { routePickRefreshFn = null; wrap.remove(); return; }
    const rpChip = e.target.closest("[data-rpickgps]");
    if (rpChip) { routePickGpsClick(rpChip.dataset.rpickgps); return; }
    const row = e.target.closest("[data-rt]");
    if (row) { const en = cur[Number(row.dataset.rt)]; if (en) pickEntry(en); }
  });
  document.body.appendChild(wrap);
}

// ---------- App-Feature-Handshake: Seite meldet, welche App-Funktionen sie nutzt ----------
// Die App liest denselben Katalog aus dem <!-- CSLK-BRIDGE: … -->-Marker im <head> und
// warnt beim „Web-Version übernehmen“, wenn die SEITE neuere App-Funktionen braucht,
// als diese APK kennt. Umgekehrt prüft die Seite hier zur Laufzeit, ob die APP
// alles mitbringt, und meldet fehlende Funktionen (einmal pro Seiten-Version).
const CSLK_BRIDGE = [
  // [Bruecken-Funktion, Label, minimaler versionCode, App-Version der Einfuehrung].
  // versionCode/App-Version = die APK, die die Funktion EINGEFUEHRT hat (Android-
  // Chronik des Repos). Die Warnung nennt sie namentlich, damit klar ist, welche
  // APK-Version mindestens noetig ist.
  ["vibrate", "Vibration", 3, "1.0.3"],
  ["vibrateLong", "Vibrations-Failsafe", 24, "1.1.0"],
  ["setAlarm", "native Zeit-Wecker", 3, "1.0.3"],
  ["cancelAlarm", "Wecker abbrechen", 3, "1.0.3"],
  ["ringingAlarms", "Läut-Übernahme", 9, "1.0.9"],
  ["syncAlarms", "Wecker-Benachrichtigung", 12, "1.0.12"],
  ["notify", "System-Hinweise", 19, "1.0.19"],
  ["cancelNotify", "Hinweise löschen", 19, "1.0.19"],
  ["hasNotifPerm", "Benachrichtigungs-Freigabe", 19, "1.0.19"],
  ["requestNotifPerm", "Benachrichtigungs-Freigabe", 19, "1.0.19"],
  ["syncGeofences", "Geofence-Wecker", 15, "1.0.15"],
  ["pendingGeofenceEvents", "Geofence-Übernahme", 15, "1.0.15"],
  ["openMenu", "App-Menü-Knopf", 27, "1.1.3"],
  ["checkWebUpdate", "Update-Knopf (Web-Version suchen)", 28, "1.1.4"],
  ["appVersion", "App-Versionsanzeige", 28, "1.1.4"],
  ["alarmActions", "Wecker-Knöpfe in der Benachrichtigung", 30, "1.1.6"]
];
// Was DIESE Web-Version mindestens an App verlangt (hoechste Einzel-Anforderung
// des Katalogs) und was sie EMPFEHLT (zuverlaessiges Hintergrund-Geofencing):
const APP_MIN_NEEDED = 30, APP_MIN_VER_NEEDED = "1.1.6";
const APP_RECOMM_VC = 63, APP_RECOMM_VER = "1.2.17";
function pageVersion() {
  try { return (document.querySelector(".verline").textContent.match(/Version (\d+\.\d+\.\d+)/) || [])[1] || ""; }
  catch (e) { return ""; }
}
// versionCode der installierten App aus dem appVersion()-String "1.2.32 (78)";
// null, wenn die Bruecke appVersion nicht anbietet (App aelter als v1.1.4)
// oder sich der String nicht lesen laesst.
function appVcOf() {
  if (!window.KvgNative || typeof window.KvgNative.appVersion !== "function") return null;
  try {
    const m = /\((\d+)\)/.exec(window.KvgNative.appVersion() || "");
    return m ? Number(m[1]) : null;
  } catch (e) { return null; }
}
function appCompatMiss() {
  const miss = CSLK_BRIDGE.filter(p => typeof window.KvgNative[p[0]] !== "function");
  const vc = appVcOf();
  // "alarmActions" ist KEINE Bruecken-Methode, sondern ein Benachrichtigungs-
  // Feature der App (Wecker-Knöpfe, automatisch seit v1.1.6): Die reine
  // Funktionspruefung wuerde es auf JEDER App als fehlend melden. Bewertet wird
  // es deshalb per App-Version - das beendet die falsche Warnung.
  const i = miss.findIndex(p => p[0] === "alarmActions");
  if (i >= 0 && vc != null && vc >= 30) miss.splice(i, 1);
  return { miss: miss, vc: vc };
}
(function checkAppFeatures() {
  if (!window.KvgNative) return;   // im Browser: nichts zu melden
  const miss = appCompatMiss().miss;
  if (!miss.length) return;
  const sig = pageVersion() + ":" + miss.map(m => m[0]).join(",");
  let last = "";
  try { last = localStorage.getItem("kvg-appwarn") || ""; } catch (e) {}
  if (last === sig) return;   // nur einmal pro Version/Fehlstand melden
  try { localStorage.setItem("kvg-appwarn", sig); } catch (e) {}
  setLocNote("⚠️ App-Update empfohlen: Diese Web-Version benötigt mindestens App v" + APP_MIN_VER_NEEDED +
    " (versionCode " + APP_MIN_NEEDED + ") und nutzt App-Funktionen, die die installierte App noch nicht kennt: " +
    miss.map(m => m[1] + " (seit App v" + m[3] + ", versionCode " + m[2] + ")").join(", ") +
    ". Bitte cslk.apk aktualisieren und danach „Web-Version übernehmen“ wiederholen.");
})();

// ---------- Über-Sektion im Fuß: beim Aufklappen füllen (Version, Idee, App-Info, Update) ----------
function fillAbout() {
  const vl = document.querySelector(".verline").textContent;
  const ver = pageVersion() || "?";
  const build = (vl.match(/Build: ([\d.]+)/) || [])[1] || "?";
  document.getElementById("aboutVer").textContent = "Version " + ver + " · Build: " + build +
    (window.KvgNative ? " · läuft in der Android-App" : " · Web-Version im Browser");
  const app = document.getElementById("aboutApp");
  const upd = document.getElementById("aboutUpdate");
  const appUpd = document.getElementById("aboutAppUpd");
  const menu = document.getElementById("aboutMenu");
  if (window.KvgNative) {
    let av = "";
    if (typeof window.KvgNative.appVersion === "function") {
      try { av = window.KvgNative.appVersion(); } catch (e) {}
    }
    const cm = appCompatMiss();
    // App- UND Service-Version (HTML-Seite = geladener Service) direkt nebeneinander,
    const acLine = "App v" + (av || "?") + " / Service v" + ver;
    if (cm.miss.length) {
      app.textContent = acLine + " – ⚠️ App älter, als dieser Service benötigt: " +
        cm.miss.map(m => m[1] + " (seit App v" + m[3] + ")").join(", ") +
        " fehlen. Bitte cslk.apk aktualisieren (nötig: App v" + APP_MIN_VER_NEEDED +
        " / versionCode " + APP_MIN_NEEDED + ", empfohlen: v" + APP_RECOMM_VER + ").";
    } else {
      app.textContent = acLine + " · App passt zu diesem Service (nötig mindestens App v" +
        APP_MIN_VER_NEEDED + " / versionCode " + APP_MIN_NEEDED +
        ", empfohlen v" + APP_RECOMM_VER + " wegen Hintergrund-Weckern; an der App-Brücke hat sich seit v1.2.17 nichts geändert).";
    }
    // "App Update suchen"-Knopf (grün, unterhalb des Service-Update-Knopfs): erscheint NUR,
    // wenn der geladene Service eine neuere App-Datei verlangt;
    // Klick = cslk.apk herunterladen (Installation danach auf dem Geraet).
    appUpd.hidden = !cm.miss.length;
    if (cm.miss.length) {
      appUpd.title = "Der geladene Service v" + ver + " benötigt eine neuere App als installiert: cslk.apk herunterladen, installieren und die App danach neu starten.";
      appUpd.onclick = () => { try { window.location.href = "cslk.apk"; } catch (e) {} };
    }
    if (typeof window.KvgNative.checkWebUpdate === "function") {
      upd.hidden = false;
      upd.disabled = false;
      upd.textContent = "🔃 Service Update suchen";
      upd.onclick = () => {
        upd.disabled = true;
        upd.textContent = "⏳ Suche läuft …";
        nativeCall("checkWebUpdate", "https://pixcaelium.timo-damm.de/apps/citysurfers/cslk.html", pageVersion());
        setTimeout(() => { upd.disabled = false; upd.textContent = "🔃 Service Update suchen"; }, 5000);
      };
    } else {
      upd.hidden = true;
      app.textContent = (app.textContent ? app.textContent + " " : "") +
        "⬆ App-Update nötig: Der Update-Knopf braucht die neueste APK (cslk.apk).";
    }
    menu.hidden = !(typeof window.KvgNative.openMenu === "function");
  } else {
    app.textContent = "Es gibt eine Android-App: dieselbe Seite als rahmenlose Vollbild-App mit nativen Weckern (läuten bei ausgeschaltetem Display), Geofence-Erinnerungen, Vibration und System-Benachrichtigungen – cslk.apk im selben Verzeichnis wie diese Seite.";
    upd.hidden = true;
    appUpd.hidden = true;
    menu.hidden = true;
  }
}
document.getElementById("about").addEventListener("toggle", () => {
  if (document.getElementById("about").open) fillAbout();
});

