}
// Frische GPS-Position einmalig abfragen (uMap-fuenfter-Punkt nach der
// Gesamtroute): Die Berechtigungsfrage stellt DIESE Seite (Browser-Standort,
// abgefragt direkt im Klick), uMap selbst braucht keine eigene Freigabe, die
// Koordinaten stecken im data=-Parameter der Karten-URL. Ohne Erlaubnis oder
// Fix gilt die letzte bekannte Position (bzw. gar keine).
function mmFreshPos(sec) {
  return new Promise(res => {
    const fb = () => res((gpsState === "on" && myPos) ? myPos : null);
    if (!(("geolocation" in navigator) && isSecure())) { fb(); return; }
    try {
      navigator.geolocation.getCurrentPosition(g =>
        res({ lat: g.coords.latitude, lon: g.coords.longitude, accuracy: g.coords.accuracy }), fb,
        { enableHighAccuracy: true, timeout: (sec || 8) * 1000, maximumAge: 20000 });
    } catch (e) { fb(); }
  });
}
function mmUmapFeats(mm) {
