  const upd = document.getElementById("aboutUpdate");
  const appUpd = document.getElementById("aboutAppUpd");
  const menu = document.getElementById("aboutMenu");
  if (window.KvgNative) {
    let av = "";
    if (typeof window.KvgNative.appVersion === "function") {
      try { av = window.KvgNative.appVersion(); } catch (e) {}
    }
    const cm = appCompatMiss();
    // App- UND Service-Version (HTML-Seite = geladener Service) direkt nebeneinander,
    const acLine = "App v" + (av || "?") + " / Service v" + ver;
    if (cm.miss.length) {
      app.textContent = acLine + " – ⚠️ App älter, als dieser Service benötigt: " +
        cm.miss.map(m => m[1] + " (seit App v" + m[3] + ")").join(", ") +
        " fehlen. Bitte cslk.apk aktualisieren (nötig: App v" + APP_MIN_VER_NEEDED +
        " / versionCode " + APP_MIN_NEEDED + ", empfohlen: v" + APP_RECOMM_VER + ").";
    } else {
