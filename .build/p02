function openMMTabById(id) {   // aus der Stationssuche: MM-Reiter der Leihstation (vorhandenen aktivieren)
  if (id == null) return;
  let i = mmTabs.findIndex(t => t.stId === id);
  if (i < 0) {
    const stn = mmStationById(id);
    mmTabs.push({ uid: newTabUid(), stId: id, name: stn ? (stn.name || "Leihstation") : "Leihstation", routes: [], active: -1, more: {} });
    i = mmTabs.length - 1;
