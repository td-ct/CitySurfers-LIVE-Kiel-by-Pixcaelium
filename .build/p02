function mmRouteFromBkLast(L) {   // v1.4.14: ohne OEPNV-Sprung-Kontext, dafuer mit Abhol-Station (stId) fuer den MM-Reiter
  if (!L) return null;
  const now = Date.now();
  const tot = L.tot || ((L.w1 || 0) + (L.rb || 0) + (L.w2 || 0) + DONKEY_HANDLE_MIN);
  const mm = {
    t0ms: now, w1: L.w1 || 0, rb: L.rb || 0, w2: L.w2 || 0, tot: tot,
    from: L.from, bike: L.bike, drop: L.drop, dest: L.dest, legs: L.legs,
    handle: DONKEY_HANDLE_MIN, planArrMs: now + tot * 60000,
    stId: (L.bike && L.bike.st != null) ? L.bike.st : null,
    umapCenter: L.center || { lat: (L.bike.lat + L.drop.lat) / 2, lon: (L.bike.lon + L.drop.lon) / 2 }
  };
  return mm;
}
// Farbige Fuellungen + wandernder Punkt im MM-Reiter (gleiche Taktung wie die
// pinke Route): Ring-Mitten der Zeilen als Anker, w = zurueckgelegte Meter.
function mmUpdateProgress(mm, wrapEl) {   // v1.4.14: das mm-Objekt direkt
  const dot = wrapEl.querySelector(".rtdot");
  wrapEl.querySelectorAll(".rfill[data-rsi]").forEach(el => { el.style.height = "0%"; });
  if (!mm || !dot) return;
  if (!(gpsState === "on" && myPos)) { dot.style.display = "none"; return; }
  const pr = mmProject(mm, myPos);
  if (!pr) { dot.style.display = "none"; return; }
  const dms = pr.dms, w = pr.w;
  const fr = [
    Math.max(0, Math.min(1, w / Math.max(1, dms[0]))),
    Math.max(0, Math.min(1, (w - dms[0]) / Math.max(1, dms[1]))),
    Math.max(0, Math.min(1, (w - dms[0] - dms[1]) / Math.max(1, dms[2])))
  ];
  wrapEl.querySelectorAll(".rfill[data-rsi]").forEach(el => {
    const f = fr[Number(el.dataset.rsi)];
    el.style.height = ((f == null ? 0 : f) * 100) + "%";
  });
  const rowEl = i => wrapEl.querySelector('.routesec[data-rsi="' + i + '"]');
  const r0 = rowEl(0), r1 = rowEl(1), r3 = rowEl(3), r4 = rowEl(4);
  if (!(r0 && r1 && r3 && r4)) { dot.style.display = "none"; return; }
  const a = r0.offsetTop + 10, b = r1.offsetTop + 10, c = r3.offsetTop + 10, e = r4.offsetTop + r4.offsetHeight - 10;
  let y;
  if (w <= dms[0]) y = a + (w / Math.max(1, dms[0])) * (b - a);
  else if (w <= dms[0] + dms[1]) y = b + ((w - dms[0]) / Math.max(1, dms[1])) * (c - b);
  else y = c + ((w - dms[0] - dms[1]) / Math.max(1, dms[2])) * (e - c);
  dot.style.display = "";
  dot.style.top = (y - 5) + "px";
}
// 500-ms-Takt des aktiven MM-Reiters: Aktuell-Uhrzeit, Verspaetung und der
// gruene Fortschritts-Strahl (Fuellung + GPS-Punkt) ohne Neu-Rendern auffrischen
function mmTick() {
  if (!(mmTabActive && mmActiveTab >= 0 && mmTabs[mmActiveTab])) return;
  const mt = mmTabs[mmActiveTab];
  const mm = (mt.routes && mt.active != null) ? mt.routes[mt.active] : null;
  if (!mm) return;
  const rail = mmPanel.querySelector(".rtrail.mmrail");
  if (rail) { paintRouteSpine(rail, MMSpineCol); mmUpdateProgress(mm, rail); }
  const wrapEl = document.getElementById("mmaktwrap");
  if (!wrapEl) return;
  const pred = mmPredArr(mm);
  const actC = pred ? mmClockOfMs(pred.arrMs) : mmClockOfMs(mm.planArrMs);
  if (wrapEl.textContent !== actC) {
    wrapEl.textContent = actC;
    wrapEl.className = pred ? "szt" : "dim";
    const de = document.getElementById("mmdelayspan");
    if (de) de.outerHTML = mmDelaySpanHTML(pred ? Math.round((pred.arrMs - mm.planArrMs) / 60000) : null, !!pred);
  }
  // v1.6.9: Die Zeilen des MM-Fahrtverlaufs (Gep./Aktuell, Abweichung,
  // Sekunden-Countdown) im selben Takt auffrischen, ohne neu zu rendern:
  // Aktuell-Uhr kursiv nachführen, Chips und Countdown-Ziele neu setzen (der
  // 1-s-Ticker pflegt die M:SS-Anzeige zwischen den Ticks).
  const rows = mmPanel.querySelectorAll("[data-mmsrow]");
  if (!rows.length) return;
  const pp = mmPredPoints(mm), nowMs = Date.now();
  const pOf = k => (pp ? (k === 1 ? pp.bike : k === 2 ? pp.ride : k === 3 ? pp.drop : k === 4 ? pp.dest : null) : null);
  rows.forEach(row => {
    const k = Number(row.dataset.mmsrow), planMs = Number(row.dataset.mmplan);
    if (!(planMs > 0)) return;
    let predMs = pOf(k);
    if (predMs != null && predMs <= nowMs - 60000) predMs = null;   // vergangene Punkte gelten als ohne Voraussage
    const ak = row.querySelector("[data-mmakt]");
    if (ak) {
      const t = predMs != null ? "≈" + mmClockOfMs(predMs) : mmClockOfMs(planMs);
      if (ak.textContent !== t) { ak.textContent = t; ak.className = "takt " + (predMs != null ? "szt" : "dim"); }
    }
    const wx = row.querySelector("[data-mmx]");
    if (wx) {
      const inner = mmRowXtraHTML(planMs, predMs);
      if (wx.innerHTML !== inner) wx.innerHTML = inner;
    }
  });
}

