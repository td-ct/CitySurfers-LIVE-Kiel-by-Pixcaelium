function activateMMTab(i) {
  saveActiveTab();
  if (!mmTabs[i]) return;
  activeTab = -1; currentStop = null; currentBus = null; currentTrip = null;
  stationPanelOpen = true; stationPanelCache = "";
  routeTabActive = false; helpTabActive = false;
  mmTabActive = true; mmActiveTab = i;
  renderTabs(); renderPanels(); renderAlarmInd();
}
function closeMMTab(i) {
  mmTabs.splice(i, 1);
  if (mmActiveTab === i) {
    mmActiveTab = -1; mmTabActive = false;
    if (mmTabs.length) activateMMTab(Math.min(i, mmTabs.length - 1));
    else if (routeTabs.length) activateRouteTab(0);
    else if (tabs.length) activateTab(0, false);
    else { renderTabs(); renderPanels(); renderAlarmInd(); }
    return;
  }
  if (mmActiveTab > i) mmActiveTab--;
