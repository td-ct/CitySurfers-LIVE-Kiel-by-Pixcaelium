  if (!window.KvgNative || typeof window.KvgNative.appVersion !== "function") return null;
  try {
    const m = /\((\d+)\)/.exec(window.KvgNative.appVersion() || "");
    return m ? Number(m[1]) : null;
  } catch (e) { return null; }
}
function appCompatMiss() {
  const miss = CSLK_BRIDGE.filter(p => typeof window.KvgNative[p[0]] !== "function");
  const vc = appVcOf();
  // "alarmActions" ist KEINE Bruecken-Methode, sondern ein Benachrichtigungs-
  // Feature der App (Wecker-Knöpfe, automatisch seit v1.1.6): Die reine
  // Funktionspruefung wuerde es auf JEDER App als fehlend melden. Bewertet wird
  // es deshalb per App-Version - das beendet die falsche Warnung.
  const i = miss.findIndex(p => p[0] === "alarmActions");
  if (i >= 0 && vc != null && vc >= 30) miss.splice(i, 1);
  return { miss: miss, vc: vc };
}
(function checkAppFeatures() {
  if (!window.KvgNative) return;   // im Browser: nichts zu melden
  const miss = appCompatMiss().miss;
  if (!miss.length) return;
  const sig = pageVersion() + ":" + miss.map(m => m[0]).join(",");
  let last = "";
  try { last = localStorage.getItem("kvg-appwarn") || ""; } catch (e) {}
  if (last === sig) return;   // nur einmal pro Version/Fehlstand melden
  try { localStorage.setItem("kvg-appwarn", sig); } catch (e) {}
  setLocNote("⚠️ App-Update empfohlen: Diese Web-Version benötigt mindestens App v" + APP_MIN_VER_NEEDED +
    " (versionCode " + APP_MIN_NEEDED + ") und nutzt App-Funktionen, die die installierte App noch nicht kennt: " +
    miss.map(m => m[1] + " (seit App v" + m[3] + ", versionCode " + m[2] + ")").join(", ") +
    ". Bitte cslk.apk aktualisieren und danach „Web-Version übernehmen“ wiederholen.");
})();

// ---------- Über-Sektion im Fuß: beim Aufklappen füllen (Version, Idee, App-Info, Update) ----------
function fillAbout() {
  const vl = document.querySelector(".verline").textContent;
