function mmStationById(id) {
  const d = donkeyCache && donkeyCache.d;
  return (id != null && d && Array.isArray(d.s)) ? d.s.find(s => s && s.id === id) : null;
}
function mmDefaultStart() {   // Punkt-1-Regel: GPS-Position des Stationssuchfelds, sonst Eintrag des Adressfelds, sonst Live-GPS
  const p = listPos();
  if (p && p.lat != null) return { name: p.label || "📍 GPS-Position (Stationssuche)", lat: p.lat, lon: p.lon };
  const lp = livePos();
