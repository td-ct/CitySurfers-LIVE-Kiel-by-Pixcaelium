        ", empfohlen v" + APP_RECOMM_VER + " wegen Hintergrund-Weckern; an der App-Brücke hat sich seit v1.2.17 nichts geändert).";
    }
    // "App Update suchen"-Knopf (grün, unterhalb des Service-Update-Knopfs): erscheint NUR,
    // wenn der geladene Service eine neuere App-Datei verlangt;
    // Klick = cslk.apk herunterladen (Installation danach auf dem Geraet).
    appUpd.hidden = !cm.miss.length;
    if (cm.miss.length) {
      appUpd.title = "Der geladene Service v" + ver + " benötigt eine neuere App als installiert: cslk.apk herunterladen, installieren und die App danach neu starten.";
      appUpd.onclick = () => { try { window.location.href = "cslk.apk"; } catch (e) {} };
    }
    if (typeof window.KvgNative.checkWebUpdate === "function") {
      upd.hidden = false;
      upd.disabled = false;
      upd.textContent = "🔃 Service Update suchen";
      upd.onclick = () => {
        upd.disabled = true;
        upd.textContent = "⏳ Suche läuft …";
        nativeCall("checkWebUpdate", "https://pixcaelium.timo-damm.de/apps/citysurfers/cslk.html", pageVersion());
        setTimeout(() => { upd.disabled = false; upd.textContent = "🔃 Service Update suchen"; }, 5000);
      };
    } else {
      upd.hidden = true;
      app.textContent = (app.textContent ? app.textContent + " " : "") +
        "⬆ App-Update nötig: Der Update-Knopf braucht die neueste APK (cslk.apk).";
    }
    menu.hidden = !(typeof window.KvgNative.openMenu === "function");
  } else {
    app.textContent = "Es gibt eine Android-App: dieselbe Seite als rahmenlose Vollbild-App mit nativen Weckern (läuten bei ausgeschaltetem Display), Geofence-Erinnerungen, Vibration und System-Benachrichtigungen – cslk.apk im selben Verzeichnis wie diese Seite.";
    upd.hidden = true;
    appUpd.hidden = true;
    menu.hidden = true;
  }
}
